// 读一棵源码树：找到文件、读它、把它的 引入 也读掉。
//
// 为什么单独立一份（2026-11-05）：run.hmoca 有八百五十九条、五十八个函数，而没有特别大的
// 一个 —— 它的问题是「中等函数太多」。十二个函数构成一整条链（含路、读一棵、读多从、
// 是路径、是绝对、解析路、找导入批、导入批从、找引号、引号里、去首、导入词长），
// 共七十九行，彼此闭合：它们只调路径那几件（拼路径、目录部分、找包根从、拆行）与内置的
// 文件读写。所以整组能搬走而不带反向依赖。
//
// 路径那几件在 self/paths.hmoca 里，所以这一份引入它。

引入 "./paths.hmoca"

// 一条 引入 说明是不是「路径」：./ ../ 开头的、绝对路径。其余（形如一个名字）是包名。
// 与宿主 loader 的判据同一条。
//
// 注意这一份原先是把同名的另一个函数抽错了 —— run.hmoca 里有两个 是路径：一个判斜杠
// （那是「像不像包名」的辅助），一个判 ./ ../ 与绝对（解析路 要的是这个）。
// 抽错那次没报错，只是 006 警告说「是路径 在 run.hmoca 声明、在 run-load 被调」，
// 而真正的后果是 解析路 会把 ./x 当成包名 —— 一种不会立刻炸的错。
公开 函数 是路径(相对: String) -> Bool {
  若 len(相对) >= 2 && slice(相对, 0, 2) == "./" { 返回 真 }
  若 len(相对) >= 3 && slice(相对, 0, 3) == "../" { 返回 真 }
  若 是绝对(相对) { 返回 真 }
  返回 假
}
公开 函数 引号里(行: String) -> String {
  定 去 = 去首(行)
  定 起 = 导入词长(去)
  若 起 < 0 { 返回 "" }
  // 词界与词法那条规矩一样：importx 的前六个字符也是 import，而它不是那件事。
  若 len(去) > 起 && 去[起] != " " && 去[起] != chr(9) && 去[起] != chr(34) { 返回 "" }
  定 开 = 找引号(去, 起)
  若 开 < 0 { 返回 "" }
  定 闭 = 找引号(去, 开 + 1)
  若 闭 < 0 { 返回 "" }
  返回 slice(去, 开 + 1, 闭)
}
公开 函数 导入词长(去: String) -> Int {
  若 len(去) >= 6 && slice(去, 0, 6) == "import" { 返回 6 }
  若 len(去) >= 2 && slice(去, 0, 2) == "引入" { 返回 2 }
  返回 -1
}
公开 函数 去首(行: String) -> String {
  若 len(行) == 0 { 返回 行 }
  若 行[0] == " " || 行[0] == chr(9) { 返回 去首(slice(行, 1, len(行))) }
  返回 行
}
公开 函数 找引号(文本: String, 起: Int) -> Int {
  // 这里要改 i，所以是 变 而不是 定——定 声明的东西不可变。
  变 i = 起
  当 i < len(文本) && 文本[i] != chr(34) { i = i + 1 }
  若 i >= len(文本) { 返回 -1 }
  返回 i
}
公开 函数 导入批从(行批: Int, i: Int, acc: Int) -> Int {
  若 i >= len(行批) { 返回 acc }
  定 路 = 引号里(行批[i])
  若 路 == "" { 返回 导入批从(行批, i + 1, acc) }
  返回 导入批从(行批, i + 1, acc + (路,))
}
公开 函数 找导入批(源码: String) -> Int {
  返回 导入批从(拆行(源码), 0, ())
}
公开 函数 含路(已读: Int, 路: String, i: Int) -> Bool {
  若 i >= len(已读) { 返回 假 }
  若 已读[i] == 路 { 返回 真 }
  返回 含路(已读, 路, i + 1)
}
公开 函数 读多从(目录: String, 路串: Int, i: Int, 已读: Int, 源码批: Int) 效果串(file) {
  若 i >= len(路串) { 返回 {已读: 已读, 源码批: 源码批, 错: ""} }
  定 r = 读一棵(目录, 路串[i], 已读, 源码批)
  若 r.错 != "" { 返回 {已读: r.已读, 源码批: r.源码批, 错: r.错} }
  返回 读多从(目录, 路串, i + 1, r.已读, r.源码批)
}
公开 函数 是绝对(相对: String) -> Bool {
  若 len(相对) >= 1 && slice(相对, 0, 1) == "/" { 返回 真 }
  若 len(相对) >= 2 && slice(相对, 1, 2) == ":" { 返回 真 }
  返回 假
}
公开 函数 解析路(目录: String, 相对: String) -> String 效果串(file) {
  若 是绝对(相对) { 返回 相对 }
  若 是路径(相对) { 返回 拼路径(目录, 相对) }
  返回 找包根从(目录, 目录, 0) + "/" + 相对 + "/index.hmoca"
}
公开 函数 读一棵(目录: String, 相对: String, 已读: Int, 源码批: Int) 效果串(file) {
  定 路 = 解析路(目录, 相对)
  若 含路(已读, 路, 0) { 返回 {已读: 已读, 源码批: 源码批, 错: ""} }
  // 缺一份 import 是一件事，不是「可选」：self/ 里三十七处引入全是 ./ 或 ../，
  // 没有一处可省。宿主装载器对同一件事报 HMYR-載-003 并停下，而这一层原来静默跳过 ——
  // 于是同一条源码在两台机器上两种答案（2026-11-04 量出来的，见 FULLSELF 第五十五件）。
  若 file_exists(路) == 假 {
    返回 {已读: 已读 + (路,), 源码批: 源码批, 错: "HMYR-載-003 " + 路}
  }
  定 源码 = read_text(路, "utf8")
  // 子模块的 引入 相对**它自己**的目录，不是相对顶层目标。
  返回 读多从(目录部分(路), 找导入批(源码), 0, 已读 + (路,), 源码批 + (源码,))
}