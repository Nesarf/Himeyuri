// 适配层的入口：把「加载顺序」交回宿主。
//
// 用法：hmyr self/adapter.hmoca <目录> <相对路径>
// 输出：一个文件一行（从目录算起）；出错时第一行以「错」开头。
//
// 为什么要有这一份（2026-11-01）：src/loader.mjs 的替身要拿自举层的加载顺序，
// 而宿主与自举层之间需要一个能对上的出口 —— 这一份就是那个出口。
// 它只交回顺序与源码，语法树由宿主的 subset-parse 建，形状才自动一致
// （design/FULLSELF.txt 第五节）。
import "./run.hmoca"

fn main() -> Int effects(process, file) {
  let 参们 = argv()
  // argv 的形状两台机器实测一致：[0] 程序或字节码的路径、[1] 目录、[2] 相对路径。
  // 所以这里用固定下标 —— 之前试过「取最后两个」（参们[len(参们) - 2]），
  // 而 C 机器上那一个算出来不对（它读到的目录后面没有相对路径）。
  // 固定下标更笨，但它只依赖形状，不依赖表达式优先级。
  if len(参们) < 3 {
    print("用法：adapter.hmoca <目录> <相对路径>" + chr(10))
    return 1
  }
  let 目录 = 参们[1]
  let 相对 = 参们[2]
  // 诊断用 print 而不是 print_err：后者在 C 机器上可能什么都不吐。
  print("目录=[" + 目录 + "] 相对=[" + 相对 + "]" + chr(10))
  print(加载顺序公开(目录, 相对))
  return 0
}
