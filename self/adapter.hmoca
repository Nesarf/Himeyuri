// 适配层的入口：把「加载顺序」交回宿主。
//
// 用法：hmyr self/adapter.hmoca <目录> <相对路径>
// 输出：一个文件一行（从目录算起）；出错时第一行以「错」开头。
//
// 为什么要有这一份（2026-11-01）：src/loader.mjs 的替身要拿自举层的加载顺序，
// 而宿主与自举层之间需要一个能对上的出口 —— 这一份就是那个出口。
// 它只交回顺序与源码，语法树由宿主的 subset-parse 建，形状才自动一致
// （design/FULLSELF.txt 第五节）。
import "./run.hmoca"

// C 机器的约定（vm/hmyr.c 第 5754 行）：带参数时入口换成「命令行入口」，
// 不带参数时才是 main。而 run.hmoca 里已经有一个命令行入口（它读文件、跑程序），
// 合并规矩是后到者覆盖先到者 —— 所以这一份定义自己的，就把那一个盖住了。
//
// 这一条是这一轮最贵的一课：之前所有的 print 都不出现，是因为程序根本没跑到 main。
fn 命令行入口() -> Int effects(process, file) {
  print("adapter 的命令行入口被叫到了" + chr(10))
  let 参们 = argv()
  if len(参们) < 3 {
    print("用法：adapter.hmoca <目录> <相对路径>" + chr(10))
    return 1
  }
  print(加载顺序公开(参们[1], 参们[2]))
  return 0
}

fn main() -> Int effects(process) {
  print("adapter：请带 <目录> <相对路径> 两个参数" + chr(10))
  return 0
}
