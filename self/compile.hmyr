// HMYR 自己的编译器：AST → 字节码指令。
//
// 为什么要有这一份：src/bytecode.mjs 是 JS 写的编译器，而那正是「HMYR 不依赖宿主」
// 最后一块借来的东西。这一份把它逐步搬进语言自己里。
//
// 输入是**自举 parser 交出来的 AST**（形状与 self/eval.hmyr 的 求值 认的那些一致）。
// 输出是**指令记录**的元组，形状与 src/code-file.mjs 写文件时吃的一样。
//
// 这一版能编什么，说清楚：算术与比较、字符串与数字字面量、按名字取值与调用、
// return、let 与 var（按出现顺序分槽）、if 的两支（跳转位置事后回填）。
// 还不编：while、记录、元组、字段、下标、逻辑短路、内置调用。
// 那些照旧交给 JS 那一份 —— 一条腿一条腿换过来，比一次换整条腿稳。
//
// 三条老规矩照旧：没有复合条件、没有 break、没有整数除法。

// 切词与声明解析来自自举层自己那两份 —— 编译器吃的正是它们交出来的 AST。
import "./lex.hmyr"
import "./body.hmyr"

// 编译状态是三件：已发出的指令、下一个空槽号、名字到槽号的对照表。
// 名字表也要跟着状态走 —— 否则 let 之后的分支就看不见那个名字了。
fn 状态(指令们: Int, 下个槽: Int, 名表: Int) {
  return {码: 指令们, 槽: 下个槽, 名表: 名表}
}

fn 发(状态: Int, 指令: Int) -> Int {
  return 状态(状态.码 + (指令,), 状态.槽, 状态.名表)
}

// 在名表里找槽号，从后往前找 —— 最近的绑定赢。
//
// 这一处吃过亏：早先从前往后找，于是同名变量第二次 let 之后，
// 读的还是第一次那个槽。自编译时它表现成「field next read off a value that
// is not a record」—— 因为那个槽里放的是上一轮的值（或空）。
fn 找槽从(名表: Int, 名: String, i: Int) -> Int {
  if i < 0 { return 0 - 1 }
  if 名表[i][0] == 名 { return 名表[i][1] }
  return 找槽从(名表, 名, i - 1)
}

fn 找槽(名表: Int, 名: String) -> Int {
  return 找槽从(名表, 名, len(名表) - 1)
}

// 这个名字是不是内置。CALLB 与 CALLF 的区别只在编译期定 —— 名字不在这一张表里，
// 就按用户函数发 CALLF，运行时查不到会报 R0104，与 JS 那一份一致。
//
// 这张表要与 src/bytecode.mjs 的 内置名、src/vm-builtins.mjs 与 vm/hmyr.c 里那一套对齐。
fn 是内置(名: String) -> Bool {
  if 名 == "abs" { return true }
  if 名 == "argv" { return true }
  if 名 == "chr" { return true }
  if 名 == "field_get" { return true }
  if 名 == "field_has" { return true }
  if 名 == "field_names" { return true }
  if 名 == "file_exists" { return true }
  if 名 == "floor" { return true }
  if 名 == "int" { return true }
  if 名 == "is_letter" { return true }
  if 名 == "is_mark" { return true }
  if 名 == "len" { return true }
  if 名 == "max" { return true }
  if 名 == "min" { return true }
  if 名 == "nfc" { return true }
  if 名 == "ord" { return true }
  if 名 == "print" { return true }
  if 名 == "print_err" { return true }
  if 名 == "read_text" { return true }
  if 名 == "record_new" { return true }
  if 名 == "slice" { return true }
  if 名 == "str" { return true }
  if 名 == "to_int" { return true }
  if 名 == "to_lower" { return true }
  if 名 == "to_upper" { return true }
  if 名 == "write_text" { return true }
  if 名 == "write_bytes" { return true }
  if 名 == "f64_bytes" { return true }
  if 名 == "pack_value" { return true }
  return false
}

fn 二元码(op: String) -> String {  if op == "+" { return "ADD" }
  if op == "-" { return "SUB" }
  if op == "*" { return "MUL" }
  if op == "/" { return "DIV" }
  if op == "%" { return "MOD" }
  if op == "==" { return "EQ" }
  if op == "!=" { return "NE" }
  if op == "<" { return "LT" }
  if op == "<=" { return "LE" }
  if op == ">" { return "GT" }
  if op == ">=" { return "GE" }
  return ""
}

// 一个数字字面量 → 数。
//
// 词法层把整数、小数、指数都收成一段文本（lex.hmyr 的 read_number），
// 而这里要把它变成数。早先这一层直接交给 to_int，于是 2.7 一进编译器就报
// 「不是整数字面量」—— 而同一条源码走解释那条路（eval.hmyr 的数到）跑得动。
// 两条路对同一份源码给出两种答案，是最难查的那一类：你以为自己在查算术。
fn 数字值(s: String) -> Int {
  var i = 0
  var 负 = false
  if i < len(s) {
    if s[i] == "-" {
      负 = true
      i = i + 1
    }
  }
  var 整 = 0
  var 小 = 0
  var 小长 = 0
  var 在整 = true
  var 在指 = false
  var 指负 = false
  var 指数 = 0
  while i < len(s) {
    let c = s[i]
    let 码 = ord(c)
    if 码 >= 48 {
      if 码 <= 57 {
        let 位 = 码 - 48
        if 在指 {
          指数 = 指数 * 10 + 位
        } else {
          if 在整 {
            整 = 整 * 10 + 位
          } else {
            小 = 小 * 10 + 位
            小长 = 小长 + 1
          }
        }
      }
    }
    if c == "." { 在整 = false }
    if c == "e" { 在指 = true }
    if c == "E" { 在指 = true }
    if c == "-" {
      if 在指 { 指负 = true }
    }
    i = i + 1
  }
  var 值 = 整
  if 小长 > 0 {
    var 除 = 1
    var k = 0
    while k < 小长 {
      除 = 除 * 10
      k = k + 1
    }
    值 = 值 + 小 / 除
  }
  if 在指 {
    var 倍 = 1
    var t = 0
    while t < 指数 {
      倍 = 倍 * 10
      t = t + 1
    }
    if 指负 {
      值 = 值 / 倍
    } else {
      值 = 值 * 倍
    }
  }
  if 负 { return 0 - 值 }
  return 值
}

// 一个表达式：交回 {ok, 状态}。
fn 表达(节点: Int, 状态: Int) {
  let 种 = 节点.kind
  if 种 == "num" {
    return {ok: true, 状态: 发(状态, {op: "CONST", a: 数字值(节点.text)})}
  }
  if 种 == "str" {
    return {ok: true, 状态: 发(状态, {op: "CONST", a: 节点.text})}
  }
  if 种 == "name" {
    // true 与 false 到这一步是「一个名字」：自举的切词器把关键字一律当成标识符
    // （见 lex.hmyr 开头那段）。求值器里有这个特判，编译器也要有 ——
    // 少了它的症状是「没有这个槽：true」，而那句话会让你去查作用域。
    if 节点.text == "true" { return {ok: true, 状态: 发(状态, {op: "CONST", a: true})} }
    if 节点.text == "false" { return {ok: true, 状态: 发(状态, {op: "CONST", a: false})} }
    let 号 = 找槽(状态.名表, 节点.text)
    if 号 < 0 { return {ok: false, 错: "没有这个槽：" + 节点.text} }
    return {ok: true, 状态: 发(状态, {op: "LOAD", a: 号})}
  }
  if 种 == "bin" {
    // 短路那两个不是一条指令的事：左操作数算出之后留在栈上，
    // 由 JMP*_KEEP 决定「跳过右边」还是「弹掉它继续算」。
    // 两条路的最后都要把留下的那个值转成布尔 —— 那是 BOOL 的活。
    if 节点.op == "&&" { return 编短路(节点, 状态, "JMPF_KEEP") }
    if 节点.op == "||" { return 编短路(节点, 状态, "JMPT_KEEP") }
    let l = 表达(节点.left, 状态)
    if l.ok == false { return l }
    let r = 表达(节点.right, l.状态)
    if r.ok == false { return r }
    let 码 = 二元码(节点.op)
    if 码 == "" { return {ok: false, 错: "不认的二元运算：" + 节点.op} }
    return {ok: true, 状态: 发(r.状态, {op: 码})}
  }
  if 种 == "unary" {
    let o = 表达(节点.operand, 状态)
    if o.ok == false { return o }
    if 节点.op == "-" { return {ok: true, 状态: 发(o.状态, {op: "NEG"})} }
    if 节点.op == "!" { return {ok: true, 状态: 发(o.状态, {op: "NOT"})} }
    return {ok: false, 错: "不认的一元运算：" + 节点.op}
  }
  if 种 == "call" {
    let 参 = 编实参(节点.args, 状态, 0)
    if 参.ok == false { return 参 }
    if 是内置(节点.callee.text) {
      return {ok: true, 状态: 发(参.状态, {op: "CALLB", a: 节点.callee.text, b: len(节点.args)})}
    }
    return {ok: true, 状态: 发(参.状态, {op: "CALLF", a: 节点.callee.text, b: len(节点.args)})}
  }
  if 种 == "tuple" {
    let 项 = 编实参(节点.items, 状态, 0)
    if 项.ok == false { return 项 }
    return {ok: true, 状态: 发(项.状态, {op: "TUPLE", a: len(节点.items)})}
  }
  if 种 == "record" {
    return 编记录(节点.fields, 状态, 0)
  }
  if 种 == "field" {
    let t = 表达(节点.target, 状态)
    if t.ok == false { return t }
    return {ok: true, 状态: 发(t.状态, {op: "FIELD", a: 节点.name})}
  }
  if 种 == "index" {
    let t = 表达(节点.target, 状态)
    if t.ok == false { return t }
    let i = 表达(节点.index, t.状态)
    if i.ok == false { return i }
    return {ok: true, 状态: 发(i.状态, {op: "INDEX"})}
  }
  return {ok: false, 错: "这一版还编不了这种表达式：" + 种}
}

// 记录：先把每个字段的值编出来（按顺序压栈），再发一条 RECORD 带名字表。
fn 编记录(字段们: Int, 状态: Int, i: Int) -> Int {
  if i >= len(字段们) { return 发记录(状态, 字段们, 0, ()) }
  let r = 表达(字段们[i].value, 状态)
  if r.ok == false { return r }
  return 编记录(字段们, r.状态, i + 1)
}

fn 发记录(状态: Int, 字段们: Int, i: Int, 名们: Int) {
  if i >= len(字段们) { return {ok: true, 状态: 发(状态, {op: "RECORD", a: 名们})} }
  return 发记录(状态, 字段们, i + 1, 名们 + (字段们[i].name,))
}

// 短路：左操作数留在栈上，JMP*_KEEP 按它的真假决定跳不跳。
//
//   左
//   JMPF_KEEP 到 补      （&& ：左假就跳过右边，左值留着）
//   右
//   BOOL
//   JMP 到 过
// 补:
//   BOOL                 （把留下的那个左值转成布尔）
// 过:
//
// `Keep` 那两条指令的语义是：跳走时不动栈顶，不跳时弹掉它。
fn 编短路(节点: Int, 状态: Int, 码: String) {
  let l = 表达(节点.left, 状态)
  if l.ok == false { return l }
  let 位短 = len(l.状态.码)
  let s1 = 发(l.状态, {op: 码, a: 0 - 1})
  let r = 表达(节点.right, s1)
  if r.ok == false { return r }
  let s2 = 发(r.状态, {op: "BOOL"})
  let 位过 = len(s2.码)
  let s3 = 发(s2, {op: "JMP", a: 0 - 1})
  let 补 = len(s3.码)
  let s4 = 发(s3, {op: "BOOL"})
  let 过 = len(s4.码)
  let 修1 = 换(s4.码, 位短, {op: 码, a: 补})
  let 修2 = 换(修1, 位过, {op: "JMP", a: 过})
  return {ok: true, 状态: 状态(修2, s4.槽, s4.名表), 结束: false}
}

fn 编实参(们: Int, 状态: Int, i: Int) {  if i >= len(们) { return {ok: true, 状态: 状态} }
  let r = 表达(们[i], 状态)
  if r.ok == false { return r }
  return 编实参(们, r.状态, i + 1)
}

// 一条语句。交回 {ok, 状态, 结束}；结束表示这一支已经 return 过，后面的不该再编。
fn 语句(节点: Int, 状态: Int) {
  let 种 = 节点.kind
  if 种 == "return" {
    let v = 表达(节点.value, 状态)
    if v.ok == false { return v }
    return {ok: true, 状态: 发(v.状态, {op: "RET"}), 结束: true}
  }
  if 种 == "let" || 种 == "var" {
    let v = 表达(节点.value, 状态)
    if v.ok == false { return v }
    let 号 = v.状态.槽
    let 记过 = 状态(v.状态.码, 号 + 1, v.状态.名表 + ((节点.name, 号),))
    return {ok: true, 状态: 发(记过, {op: "STORE", a: 号, b: 种 == "var"}), 结束: false}
  }
  if 种 == "assign" {
    let 号 = 找槽(状态.名表, 节点.name)
    if 号 < 0 { return {ok: false, 错: "赋给一个不在作用域里的名字：" + 节点.name} }
    let v = 表达(节点.value, 状态)
    if v.ok == false { return v }
    return {ok: true, 状态: 发(v.状态, {op: "ASSIGN", a: 号}), 结束: false}
  }
  if 种 == "expr" {
    // 表达式语句：只编表达式，丢不丢值由 编块 决定 —— 它知道这是不是最后一条。
    // 早先在这里无条件发 POP，于是 if 的真支里多出一条，字节流与 JS 那侧对不上。
    let v = 表达(节点.value, 状态)
    if v.ok == false { return v }
    return {ok: true, 状态: v.状态, 结束: false}
  }
  if 种 == "if" {
    return 编如果(节点, 状态)
  }
  if 种 == "while" {
    // while：条件 → JMPF 到尾 → 体 → JMP 回条件 → 尾。
    // 起点的位置要记下来，而目标要回填 —— 与 if 同一个做法。
    let 起 = len(状态.码)
    let c = 表达(节点.cond, 状态)
    if c.ok == false { return c }
    let 位跳尾 = len(c.状态.码)
    let s1 = 发(c.状态, {op: "JMPF", a: 0 - 1})
    let 体 = 编块不留值(节点.body, s1, 0)
    if 体.ok == false { return 体 }
    let s2 = 发(体.状态, {op: "JMP", a: 起})
    // while 整个算出一个值（空），与 JS 那一份一致；而 JS 那边它是「表达式语句」，
    // 所以值还要丢掉 —— 两条合起来才是对的字节。
    let 尾 = len(s2.码)
    let s3 = 发(发(s2, {op: "CONST", a: ()}), {op: "POP"})
    let 修 = 换(s3.码, 位跳尾, {op: "JMPF", a: 尾})
    return {ok: true, 状态: 状态(修, s3.槽, s3.名表), 结束: false}
  }
  return {ok: false, 错: "这一版还编不了这种语句：" + 种}
}

// 在某个位置上把指令换掉。元组不可变，所以是重建。
fn 换从(码: Int, 位: Int, 新: Int, i: Int, acc: Int) -> Int {
  if i >= len(码) { return acc }
  if i == 位 { return 换从(码, 位, 新, i + 1, acc + (新,)) }
  return 换从(码, 位, 新, i + 1, acc + (码[i],))
}

fn 换(码: Int, 位: Int, 新: Int) -> Int {
  return 换从(码, 位, 新, 0, ())
}

// if：条件 → JMPF 占位 → 真支 → JMP 占位 → 假支 → POP。
//
// 末尾那条 POP 与「没有 else 时补一个交回空」是照 JS 那一份的写法：
// if 是语句，它的值要丢掉。少了这两条的字节流与 JS 不一样 —— 而这一层要的是
// 「两位打包者交出同样的字节」，所以连「怎么写」都要对齐，不只是「算出什么」。
fn 编如果(节点: Int, 状态: Int) {
  let c = 表达(节点.cond, 状态)
  if c.ok == false { return c }
  let 位跳假 = len(c.状态.码)
  let s1 = 发(c.状态, {op: "JMPF", a: 0 - 1})
  let 真 = 编块(节点.then, s1, 0)
  if 真.ok == false { return 真 }
  let 位跳尾 = len(真.状态.码)
  let s2 = 发(真.状态, {op: "JMP", a: 0 - 1})
  let 假起 = len(s2.码)
  var 假 = s2
  if len(节点.otherwise) > 0 {
    let r = 编块(节点.otherwise, s2, 0)
    if r.ok == false { return r }
    假 = r.状态
  } else {
    假 = 发(s2, {op: "CONST", a: ()})
  }
  let 位尾 = len(假.码)
  let s3 = 发(假, {op: "POP"})
  let 修1 = 换(s3.码, 位跳假, {op: "JMPF", a: 假起})
  let 修2 = 换(修1, 位跳尾, {op: "JMP", a: 位尾})
  return {ok: true, 状态: 状态(修2, s3.槽, s3.名表), 结束: false}
}

// 逐条编语句，**一条都不留值**。
//
// while 的体用这一份：循环体里每条表达式语句的值都要丢掉，包括最后一条 ——
// 留一个值在栈上，下一轮循环就会把它当成新压进来的东西。
fn 编块不留值(语句们: Int, 状态: Int, i: Int) {
  if i >= len(语句们) { return {ok: true, 状态: 状态, 结束: false} }
  let r = 语句(语句们[i], 状态)
  if r.ok == false { return r }
  if r.结束 { return {ok: true, 状态: r.状态, 结束: true} }
  var 下 = r.状态
  if 语句们[i].kind == "expr" {
    下 = 发(下, {op: "POP"})
  }
  return 编块不留值(语句们, 下, i + 1)
}

// 逐条编语句。
//
// 一条语句「不是最后一条」时，它算出来的值要丢掉 —— 而最后一条的值留着，
// 由调用它的人决定怎么处理（if 的收尾 POP、函数的 RET、块的末尾）。
// 这是 JS 那一份的规矩，而这一层要的是两位打包者交出同样的字节。
fn 编块(语句们: Int, 状态: Int, i: Int) {
  if i >= len(语句们) { return {ok: true, 状态: 状态, 结束: false} }
  let r = 语句(语句们[i], 状态)
  if r.ok == false { return r }
  if r.结束 { return {ok: true, 状态: r.状态, 结束: true} }
  var 下 = r.状态
  if i + 1 < len(语句们) && 语句们[i].kind == "expr" {
    下 = 发(下, {op: "POP"})
  }
  return 编块(语句们, 下, i + 1)
}

// 一个函数：参数按顺序占前几个槽，然后编体，末尾补「交回空」。
fn 编函数(函数: Int) {
  let 名 = 函数[0]
  let 参名们 = 函数[1]
  let 体 = 函数[2]
  var 名表 = ()
  var i = 0
  while i < len(参名们) {
    名表 = 名表 + ((参名们[i], i),)
    i = i + 1
  }
  let r = 编块(体, 状态((), len(参名们), 名表), 0)
  if r.ok == false { return {ok: false, 错: 名 + "：" + r.错} }
  let 码 = r.状态.码 + ({op: "CONST", a: ()}, {op: "RET"})
  return {ok: true, 函数: {名: 名, 参数量: len(参名们), 槽数: r.状态.槽, 效果: (), 码: 码}}
}

fn 编函数们(函数们: Int, i: Int, acc: Int) {
  if i >= len(函数们) { return {ok: true, 函数们: acc} }
  let r = 编函数(函数们[i])
  if r.ok == false { return r }
  return 编函数们(函数们, i + 1, acc + (r.函数,))
}

// 入口：源码 → 函数表。
fn 编源码(源码: String) -> Int {
  let 声明们 = parse_decls(scan_lines(源码))
  return 编函数们(声明们.fns, 0, ())
}

fn main() -> Int {
  let r = 编源码("fn 加(a: Int, b: Int) -> Int {" + chr(10) + "  return a + b" + chr(10) + "}" + chr(10))
  if r.ok == false {
    print("错：" + r.错)
    return 1
  }
  print(str(len(r.函数们)) + " 个函数，" + str(len(r.函数们[0].码)) + " 条指令，槽 " + str(r.函数们[0].槽数))
  return 0
}
