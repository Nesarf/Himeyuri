// HMYR 自己的编译器：AST → 字节码指令。
//
// 为什么要有这一份：src/bytecode.mjs 是 JS 写的编译器，而那正是「HMYR 不依赖宿主」
// 最后一块借来的东西。这一份把它逐步搬进语言自己里。
//
// 输入是**自举 parser 交出来的 AST**（形状与 self/eval.hmyr 的 求值 认的那些一致）。
// 输出是**指令记录**的元组，形状与 src/code-file.mjs 写文件时吃的一样。
//
// 这一版能编什么，说清楚：算术与比较、字符串与数字字面量、按名字取值与调用、
// 返回、定 与 变（按出现顺序分槽）、若 的两支（跳转位置事后回填）。
// 还不编：当、记录、元组、字段、下标、逻辑短路、内置调用。
// 那些照旧交给 JS 那一份 —— 一条腿一条腿换过来，比一次换整条腿稳。
//
// 三条老规矩照旧：没有复合条件、没有 break、没有整数除法。

// 切词与声明解析来自自举层自己那两份 —— 编译器吃的正是它们交出来的 AST。
引入 "./lex.hmoca"
引入 "./body.hmoca"
引入 "./f64.hmoca"
引入 "./compile-number.hmoca"

// 编译状态是四件：已封的块、当前块、下一个空槽号、名字到槽号的对照表。
// 名字表也要跟着状态走 —— 否则 定 之后的分支就看不见那个名字了。
//
// 为什么要分块：以前是「码 + (一条,)」，每发一条就复制一次已经发出的全部 ——
// 平方级。五千条指令就是一千三百万次指令副本，而 C 那台分配了不回收，
// 实测那一次跑到九千兆（见 design/COMPILER.txt）。
//
// 第五件是契约盒（见 空契）：它得一路漂到每一条 返回 那里，因为出口那半段
// 是在 返回 之前发的，而 返回 出现在函数体的任意深度。做成状态的一件，
// 就不必给 语句 / 编块 / 编如果 每一个都加一个参数。
//
// 第六件是档（2026-11-02）：1 是强档，契约那几段照编；0 是弱档，一段都不编。
// 它也得漂到深的地方 —— 循环不变式是在编一条循环那里发的，而那里只拿得到状态，
// 拿不到 编函数 的参数。放进来就不必再给那条路加一个参数。
//
// 弱档怎么做到「不编」：进 编函数 时把契约盒换成 空契，于是 有入口契约 与
// 有出口契约 都答假，入场与出场两段自然空掉，返回值 那个槽也不占。循环那一路
// 看的是 节点.invariant 而不是契约盒，所以它另外看一次档。
函数 状态(块堆: Int, 小: Int, 下个槽: Int, 名表: Int, 契: Int, 档: Int) {
  返回 {块: 块堆, 小: 小, 槽: 下个槽, 名表: 名表, 契: 契, 档: 档}
}

公开 函数 块长() -> Int {
  返回 256
}

函数 发(状态: Int, 指令: Int) -> Int {
  定 小 = 状态.小 + (指令,)
  若 len(小) >= 块长() {
    返回 状态(状态.块 + (小,), (), 状态.槽, 状态.名表, 状态.契, 状态.档)
  }
  返回 状态(状态.块, 小, 状态.槽, 状态.名表, 状态.契, 状态.档)
}

// 已经发出多少条。块都是满的，只有最后那一块可能不满。
函数 码长(状态: Int) -> Int {
  返回 len(状态.块) * 块长() + len(状态.小)
}

// 把所有块拼成一条完整的指令序列 —— 只在交函数的时候拼一次。
//
// 顺序要紧：块堆在前，那半块「小」在最后。上一次这里写成
// 拼块(状态.块, 0, 状态.小)，于是拼出来是「小 + 块」——
// 程序大于一块（256 条指令）时指令整段错位，而小于一块时看起来全对。
// 那种错最费时间：四份小程序逐字节相同，只有大程序才露头。
//
// 拼法是「折半、两半各自拼好再一次接上」，不是「从头一块一块往尾部加」：
// 后者每一步都要复制已拼好的全部，块一多又是一次平方级 ——
// 量到的那三千兆里，多半有它一份。
函数 拼两半(块堆: Int, 起: Int, 止: Int) -> Int {
  若 止 - 起 <= 1 { 返回 块堆[起] }
  // 中点靠「两头各收一步」找，不用除法：stage 0 那几份只许用白名单内置，
  // 而 int 不在里面。
  //
  // 停的条件是「差 2」，不是「差 1」：差 1 时 左 + 1 正好等于 止，
  // 左半 [起, 中) 就成了整个 [起, 止) —— 同一段再交给自己，永远不缩小。
  // 2026 实测：一份大源码里有个函数超过两块，递归就一路挖到机器栈底
  // （C 机器退出码 0xC00000FD，深度三万层）。
  变 左 = 起
  变 右 = 止
  当 右 - 左 > 2 {
    左 = 左 + 1
    右 = 右 - 1
  }
  定 中 = 左 + 1
  返回 拼两半(块堆, 起, 中) + 拼两半(块堆, 中, 止)
}

函数 拼状态(状态: Int) -> Int {
  // 「一块都还没封」的那条路单独写：这时拼两半没有东西可拼，
  // 而让它去交一个空元组会被返回类型核查拦下（那一层拦得对）。
  若 len(状态.块) == 0 { 返回 状态.小 }
  返回 拼两半(状态.块, 0, len(状态.块)) + 状态.小
}

// 把第 位 条指令换掉（回填跳转目标用）。
// 块化之后只重建那一块，代价是两百五十六条而不是五千条。
函数 改位(状态: Int, 位: Int, 新: Int) -> Int {
  // 块号用减法算，不用除法：这门语言的除号是浮点除法，而 stage 0 那几份
  // 只许用白名单里的内置（int 不在里面）。块长是 256、块数不到五十，
  // 减法几轮就到了 —— 比借一个内置便宜，也比截断浮点数说得清。
  变 块号 = 0
  变 余 = 位
  当 余 >= 块长() {
    余 = 余 - 块长()
    块号 = 块号 + 1
  }
  若 块号 >= len(状态.块) {
    返回 状态(状态.块, 换(状态.小, 余, 新), 状态.槽, 状态.名表, 状态.契, 状态.档)
  }
  返回 状态(换(状态.块, 块号, 换(状态.块[块号], 余, 新)), 状态.小, 状态.槽, 状态.名表, 状态.契, 状态.档)
}

// 在名表里找槽号，从后往前找 —— 最近的绑定赢。
//
// 这一处吃过亏：早先从前往后找，于是同名变量第二次 定 之后，
// 读的还是第一次那个槽。自编译时它表现成「field next read off a value that
// is not a record」—— 因为那个槽里放的是上一轮的值（或空）。
函数 找槽从(名表: Int, 名: String, i: Int) -> Int {
  若 i < 0 { 返回 0 - 1 }
  若 名表[i][0] == 名 { 返回 名表[i][1] }
  返回 找槽从(名表, 名, i - 1)
}

函数 找槽(名表: Int, 名: String) -> Int {
  返回 找槽从(名表, 名, len(名表) - 1)
}

// 这个名字是不是内置。CALLB 与 CALLF 的区别只在编译期定 —— 名字不在这一张表里，
// 就按用户函数发 CALLF，运行时查不到会报 HMYR-行-005，与 JS 那一份一致。
//
// 这张表要与 src/bytecode.mjs 的 内置名、src/vm-builtins.mjs 与 vm/hmyr.c 里那一套对齐。
函数 是内置(名: String) -> Bool {
  若 名 == "abs" { 返回 真 }
  若 名 == "argv" { 返回 真 }
  若 名 == "chr" { 返回 真 }
  // 可变数组：编译期认这两个名字，运行时落到 vm/hmyr.c 的 name_is 上。
  若 名 == "数组" { 返回 真 }
  若 名 == "设" { 返回 真 }
  // 位运算：八个别名，名字带前缀以免与用户函数同名。
  若 名 == "位与" { 返回 真 }
  若 名 == "位或" { 返回 真 }
  若 名 == "位异或" { 返回 真 }
  若 名 == "位非" { 返回 真 }
  若 名 == "位右移" { 返回 真 }
  若 名 == "位加" { 返回 真 }
  若 名 == "位循环右移" { 返回 真 }
  若 名 == "位循环左移" { 返回 真 }
  若 名 == "field_get" { 返回 真 }
  若 名 == "field_has" { 返回 真 }
  若 名 == "field_names" { 返回 真 }
  若 名 == "file_exists" { 返回 真 }
  若 名 == "floor" { 返回 真 }
  若 名 == "int" { 返回 真 }
  若 名 == "校验和" { 返回 真 }
  若 名 == "is_dir" { 返回 真 }
  若 名 == "is_letter" { 返回 真 }
  若 名 == "is_mark" { 返回 真 }
  若 名 == "len" { 返回 真 }
  若 名 == "max" { 返回 真 }
  若 名 == "min" { 返回 真 }
  若 名 == "nfc" { 返回 真 }
  若 名 == "ord" { 返回 真 }
  若 名 == "print" { 返回 真 }
  若 名 == "print_err" { 返回 真 }
  若 名 == "read_dir" { 返回 真 }
  若 名 == "read_text" { 返回 真 }
  若 名 == "record_new" { 返回 真 }
  若 名 == "slice" { 返回 真 }
  若 名 == "str" { 返回 真 }
  若 名 == "to_int" { 返回 真 }
  若 名 == "to_lower" { 返回 真 }
  若 名 == "to_upper" { 返回 真 }
  若 名 == "write_text" { 返回 真 }
  若 名 == "write_bytes" { 返回 真 }
  若 名 == "f64_bytes" { 返回 真 }
  若 名 == "pack_value" { 返回 真 }
  // 契约失败：三只旋钮里第三只的收尾（design/CONTRACTS.txt）。
  // 这张表若漏了它，编一条契约的最后一条指令就成了「调一个用户函数」，
  // 运行时给出 HMYR-行-005 —— 于是一份写错契约的程序报的是「没有这个函数」。
  若 名 == "契约失败" { 返回 真 }
  // 补：宿主那份名单有、这张表以前漏掉的。2026-10-25 一次补齐。
  // 依据是 tools/seed-gap.mjs：它量的正是「种子认得哪些内置」，而种子就是这个函数的字节码。
  若 名 == "arena" { 返回 真 }
  若 名 == "owned" { 返回 真 }
  若 名 == "bytes_view" { 返回 真 }
  若 名 == "view_len" { 返回 真 }
  若 名 == "view_get" { 返回 真 }
  若 名 == "view_set" { 返回 真 }
  若 名 == "fmt_number" { 返回 真 }
  若 名 == "bytes_to_text" { 返回 真 }
  若 名 == "chdir" { 返回 真 }
  若 名 == "console_codepage" { 返回 真 }
  若 名 == "cwd" { 返回 真 }
  若 名 == "home_dir" { 返回 真 }
  若 名 == "index_get" { 返回 真 }
  若 名 == "index_has" { 返回 真 }
  若 名 == "index_keys" { 返回 真 }
  若 名 == "index_len" { 返回 真 }
  若 名 == "index_new" { 返回 真 }
  若 名 == "index_set" { 返回 真 }
  若 名 == "key_available" { 返回 真 }
  若 名 == "key_push" { 返回 真 }
  若 名 == "key_read" { 返回 真 }
  若 名 == "key_start" { 返回 真 }
  若 名 == "locale_current" { 返回 真 }
  若 名 == "locale_env" { 返回 真 }
  若 名 == "locale_set" { 返回 真 }
  若 名 == "now_ms" { 返回 真 }
  若 名 == "python_path" { 返回 真 }
  若 名 == "read_bytes" { 返回 真 }
  若 名 == "read_line" { 返回 真 }
  若 名 == "read_lines" { 返回 真 }
  若 名 == "read_stdin_bytes" { 返回 真 }
  若 名 == "read_stdin_line" { 返回 真 }
  若 名 == "repo_path" { 返回 真 }
  若 名 == "run_program" { 返回 真 }
  若 名 == "sleep_ms" { 返回 真 }
  若 名 == "split" { 返回 真 }
  若 名 == "temp_path" { 返回 真 }
  若 名 == "term_clear" { 返回 真 }
  若 名 == "term_color" { 返回 真 }
  若 名 == "term_escape" { 返回 真 }
  若 名 == "term_hide" { 返回 真 }
  若 名 == "term_show" { 返回 真 }
  若 名 == "term_size" { 返回 真 }
  若 名 == "thr_cancel" { 返回 真 }
  若 名 == "thr_count" { 返回 真 }
  若 名 == "thr_join" { 返回 真 }
  若 名 == "thr_spawn" { 返回 真 }
  返回 假
}

函数 二元码(op: String) -> String {  若 op == "+" { 返回 "加" }
  若 op == "-" { 返回 "减" }
  若 op == "*" { 返回 "乘" }
  若 op == "/" { 返回 "除" }
  若 op == "%" { 返回 "余" }
  若 op == "==" { 返回 "等" }
  若 op == "!=" { 返回 "不等" }
  若 op == "<" { 返回 "小" }
  若 op == "<=" { 返回 "小等" }
  若 op == ">" { 返回 "大" }
  若 op == ">=" { 返回 "大等" }
  返回 ""
}


// 一个表达式：交回 {ok, 状态}。
函数 表达(节点: Int, 状态: Int) {
  定 种 = 节点.kind
  若 种 == "字" && 节点.类型 == "int" {
    返回 {ok: 真, 状态: 发(状态, {op: "常量", a: 数字值(节点.text)})}
  }
  若 种 == "字" && 节点.类型 == "string" {
    返回 {ok: 真, 状态: 发(状态, {op: "常量", a: 节点.text})}
  }
  若 种 == "名" {
    // 真 与 假 到这一步是「一个名字」：自举的切词器把关键字一律当成标识符
    // （见 lex.hmyr 开头那段）。求值器里有这个特判，编译器也要有 ——
    // 少了它的症状是「没有这个槽：真」，而那句话会让你去查作用域。
    若 节点.text == "true" { 返回 {ok: 真, 状态: 发(状态, {op: "常量", a: 真})} }
    若 节点.text == "false" { 返回 {ok: 真, 状态: 发(状态, {op: "常量", a: 假})} }
    定 号 = 找槽(状态.名表, 节点.text)
    // 槽里没有就是全局：模块级 常量 走这一条。宿主那一份（src/bytecode.mjs）
    // 一直是这么做的 —— 「若 (!有) 发 GLOBAL」—— 而这一份少了它，于是任何读
    // 模块级常量的函数都编不出来，报的却是「没有这个槽」，那句话会让人去查作用域。
    若 号 < 0 { 返回 {ok: 真, 状态: 发(状态, {op: "全域取", a: 节点.text})} }
    返回 {ok: 真, 状态: 发(状态, {op: "取", a: 号})}
  }
  若 种 == "二元" {
    // 短路那两个不是一条指令的事：左操作数算出之后留在栈上，
    // 由 JMP*_KEEP 决定「跳过右边」还是「弹掉它继续算」。
    // 两条路的最后都要把留下的那个值转成布尔 —— 那是 BOOL 的活。
    若 节点.op == "&&" { 返回 编短路(节点, 状态, "假跳留") }
    若 节点.op == "||" { 返回 编短路(节点, 状态, "真跳留") }
    定 l = 表达(节点.left, 状态)
    若 l.ok == 假 { 返回 l }
    定 r = 表达(节点.right, l.状态)
    若 r.ok == 假 { 返回 r }
    定 码 = 二元码(节点.op)
    若 码 == "" { 返回 {ok: 假, 错: "不认的二元运算：" + 节点.op} }
    返回 {ok: 真, 状态: 发(r.状态, {op: 码})}
  }
  若 种 == "一元" {
    定 o = 表达(节点.operand, 状态)
    若 o.ok == 假 { 返回 o }
    若 节点.op == "-" { 返回 {ok: 真, 状态: 发(o.状态, {op: "负"})} }
    若 节点.op == "!" { 返回 {ok: 真, 状态: 发(o.状态, {op: "非"})} }
    返回 {ok: 假, 错: "不认的一元运算：" + 节点.op}
  }
  若 种 == "调用" {
    // 方法调用（a.alloc(16)）：主先压栈，参数按序压，最后一条 CALLM。
    // 与 src/bytecode.mjs 那一份发同一条指令 —— 两台编译器要给同一个字节流，
    // 而这一点由 selfvmcompile 那套盯着。
    若 节点.callee.kind == "字段" {
      定 主 = 表达(节点.callee.target, 状态)
      若 主.ok == 假 { 返回 主 }
      定 方的参 = 编实参(节点.args, 主.状态, 0)
      若 方的参.ok == 假 { 返回 方的参 }
      返回 {ok: 真, 状态: 发(方的参.状态, {op: "调方法", a: 节点.callee.name, b: len(节点.args)})}
    }
    定 参 = 编实参(节点.args, 状态, 0)
    若 参.ok == 假 { 返回 参 }
    若 是内置(节点.callee.text) {
      返回 {ok: 真, 状态: 发(参.状态, {op: "调内置", a: 节点.callee.text, b: len(节点.args)})}
    }
    返回 {ok: 真, 状态: 发(参.状态, {op: "调函数", a: 节点.callee.text, b: len(节点.args)})}
  }
  若 种 == "组" {
    定 项 = 编实参(节点.items, 状态, 0)
    若 项.ok == 假 { 返回 项 }
    返回 {ok: 真, 状态: 发(项.状态, {op: "组", a: len(节点.items)})}
  }
  若 种 == "记录" {
    返回 编记录(节点.fields, 状态, 0)
  }
  若 种 == "字段" {
    定 t = 表达(节点.target, 状态)
    若 t.ok == 假 { 返回 t }
    返回 {ok: 真, 状态: 发(t.状态, {op: "字段", a: 节点.name})}
  }
  若 种 == "索引" {
    定 t = 表达(节点.target, 状态)
    若 t.ok == 假 { 返回 t }
    定 i = 表达(节点.index, t.状态)
    若 i.ok == 假 { 返回 i }
    返回 {ok: 真, 状态: 发(i.状态, {op: "索引"})}
  }
  返回 {ok: 假, 错: "这一版还编不了这种表达式：" + 种 + "〔" + 节点.text + "〕@" + str(节点.line) + ":" + str(节点.column)}
}

// 记录：先把每个字段的值编出来（按顺序压栈），再发一条 RECORD 带名字表。
函数 编记录(字段批: Int, 状态: Int, i: Int) -> Int {
  若 i >= len(字段批) { 返回 发记录(状态, 字段批, 0, ()) }
  定 r = 表达(字段批[i].value, 状态)
  若 r.ok == 假 { 返回 r }
  返回 编记录(字段批, r.状态, i + 1)
}

函数 发记录(状态: Int, 字段批: Int, i: Int, 名册: Int) {
  若 i >= len(字段批) { 返回 {ok: 真, 状态: 发(状态, {op: "记录", a: 名册})} }
  返回 发记录(状态, 字段批, i + 1, 名册 + (字段批[i].name,))
}

// 短路：左操作数留在栈上，JMP*_KEEP 按它的真假决定跳不跳。
//
//   左
//   JMPF_KEEP 到 补      （&& ：左假就跳过右边，左值留着）
//   右
//   BOOL
//   JMP 到 过
// 补:
//   BOOL                 （把留下的那个左值转成布尔）
// 过:
//
// `Keep` 那两条指令的语义是：跳走时不动栈顶，不跳时弹掉它。
函数 编短路(节点: Int, 状态: Int, 码: String) {
  定 l = 表达(节点.left, 状态)
  若 l.ok == 假 { 返回 l }
  定 位短 = 码长(l.状态)
  定 s1 = 发(l.状态, {op: 码, a: 0 - 1})
  定 r = 表达(节点.right, s1)
  若 r.ok == 假 { 返回 r }
  定 s2 = 发(r.状态, {op: "布尔"})
  定 位过 = 码长(s2)
  定 s3 = 发(s2, {op: "跳", a: 0 - 1})
  定 补 = 码长(s3)
  定 s4 = 发(s3, {op: "布尔"})
  定 过 = 码长(s4)
  定 修1 = 改位(s4, 位短, {op: 码, a: 补})
  定 修2 = 改位(修1, 位过, {op: "跳", a: 过})
  返回 {ok: 真, 状态: 修2, 结束: 假}
}

函数 编实参(们: Int, 状态: Int, i: Int) {  若 i >= len(们) { 返回 {ok: 真, 状态: 状态} }
  定 r = 表达(们[i], 状态)
  若 r.ok == 假 { 返回 r }
  返回 编实参(们, r.状态, i + 1)
}

// 一条语句。交回 {ok, 状态, 结束}；结束表示这一支已经 返回 过，后面的不该再编。
函数 语句(节点: Int, 状态: Int) {
  定 种 = 节点.kind
  若 种 == "返回" {
    定 v = 表达(节点.value, 状态)
    若 v.ok == 假 { 返回 v }
    // 出口那一段贴在 返回 之前：契约要看的就是这个值，而 返回 一执行就再没有机会。
    // 没有出口契约时 编出场 原样交回，所以这里是「每条 返回 都过一遍」而代价为零。
    定 o = 编出场(v.状态)
    若 o.ok == 假 { 返回 o }
    返回 {ok: 真, 状态: 发(o.状态, {op: "返回"}), 结束: 真}
  }
  若 种 == "定" || 种 == "变" {
    定 v = 表达(节点.value, 状态)
    若 v.ok == 假 { 返回 v }
    定 号 = v.状态.槽
    定 记过 = 状态(v.状态.块, v.状态.小, 号 + 1, v.状态.名表 + ((节点.name, 号),), v.状态.契, v.状态.档)
    返回 {ok: 真, 状态: 发(记过, {op: "存", a: 号, b: 种 == "变"}), 结束: 假}
  }
  若 种 == "赋值" {
    定 号 = 找槽(状态.名表, 节点.name)
    // 槽里没有就是模块级的名字：写它走 SETGLOBAL，与读它走 GLOBAL 对称。
    // 宿主那一份（src/bytecode.mjs）也是这么做的 —— 两台编译器给同一份字节流。
    若 号 < 0 {
      定 v = 表达(节点.value, 状态)
      若 v.ok == 假 { 返回 v }
      返回 {ok: 真, 状态: 发(v.状态, {op: "全域存", a: 节点.name}), 结束: 假}
    }
    定 v = 表达(节点.value, 状态)
    若 v.ok == 假 { 返回 v }
    返回 {ok: 真, 状态: 发(v.状态, {op: "赋值", a: 号}), 结束: 假}
  }
  若 种 == "表达式语句" {
    // 表达式语句：只编表达式，丢不丢值由 编块 决定 —— 它知道这是不是最后一条。
    // 早先在这里无条件发 POP，于是 若 的真支里多出一条，字节流与 JS 那侧对不上。
    定 v = 表达(节点.value, 状态)
    若 v.ok == 假 { 返回 v }
    返回 {ok: 真, 状态: v.状态, 结束: 假}
  }
  若 种 == "若" {
    返回 编如果(节点, 状态)
  }
  若 种 == "当" {
    // 当：入口不变式 → 条件 → JMPF 到尾 → 体 → 体末不变式 → JMP 回条件 → 尾。
    // 起点的位置要记下来，而目标要回填 —— 与 若 同一个做法。
    //
    // 循环不变式（design/INVARIANTS.txt 第八节）：入口一次，每轮体末一次。
    // 入口那段摆在 起 之前 —— 跳回去的只有条件求值，而入口只该跑一次。
    定 入 = 编循环不变(节点.invariant, 状态)
    若 入.ok == 假 { 返回 入 }
    定 起 = 码长(入.状态)
    定 c = 表达(节点.cond, 入.状态)
    若 c.ok == 假 { 返回 c }
    定 位跳尾 = 码长(c.状态)
    定 s1 = 发(c.状态, {op: "假跳", a: 0 - 1})
    定 体 = 编块不留值(节点.body, s1, 0)
    若 体.ok == 假 { 返回 体 }
    定 保 = 编循环不变(节点.invariant, 体.状态)
    若 保.ok == 假 { 返回 保 }
    定 s2 = 发(保.状态, {op: "跳", a: 起})
    // 末尾不补 POP，与 若 同一条：值留给外层处理。
    定 尾 = 码长(s2)
    定 s3 = 发(s2, {op: "常量", a: ()})
    定 修 = 改位(s3, 位跳尾, {op: "假跳", a: 尾})
    返回 {ok: 真, 状态: 修, 结束: 假}
  }
  返回 {ok: 假, 错: "这一版还编不了这种语句：" + 种}
}

// 在某个位置上把指令换掉。元组不可变，所以是重建。
函数 换从(码: Int, 位: Int, 新: Int, i: Int, acc: Int) -> Int {
  若 i >= len(码) { 返回 acc }
  若 i == 位 { 返回 换从(码, 位, 新, i + 1, acc + (新,)) }
  返回 换从(码, 位, 新, i + 1, acc + (码[i],))
}

函数 换(码: Int, 位: Int, 新: Int) -> Int {
  返回 换从(码, 位, 新, 0, ())
}

// 若：条件 → JMPF 占位 → 真支 → JMP 占位 → 假支 → POP。
//
// 末尾那条 POP 与「没有 否则 时补一个交回空」是照 JS 那一份的写法：
// 若 是语句，它的值要丢掉。少了这两条的字节流与 JS 不一样 —— 而这一层要的是
// 「两位打包者交出同样的字节」，所以连「怎么写」都要对齐，不只是「算出什么」。
函数 编如果(节点: Int, 状态: Int) {
  定 c = 表达(节点.cond, 状态)
  若 c.ok == 假 { 返回 c }
  定 位跳假 = 码长(c.状态)
  定 s1 = 发(c.状态, {op: "假跳", a: 0 - 1})
  定 真支 = 编块(节点.then, s1, 0)
  若 真支.ok == 假 { 返回 真支 }
  定 位跳尾 = 码长(真支.状态)
  定 s2 = 发(真支.状态, {op: "跳", a: 0 - 1})
  定 假起 = 码长(s2)
  变 假支 = s2
  若 len(节点.otherwise) > 0 {
    定 r = 编块(节点.otherwise, s2, 0)
    若 r.ok == 假 { 返回 r }
    假支 = r.状态
  } 否则 {
    假支 = 发(s2, {op: "常量", a: ()})
  }
  // 末尾不补 POP：值与 JS 那一份的 if 一样留给外层（见 编块 与 编块不留值 里对 若/当 的处理）。
  // 2026-11-02 用 tools/compile-diff.mjs 与一份二分探针定位到这里：触发点是「嵌套 若」——
  // 内层恒丢一次、外层又丢一次，两个 弃；而 JS 的 if 字节不丢，只由外层丢一次。
  定 位尾 = 码长(假支)
  定 修1 = 改位(假支, 位跳假, {op: "假跳", a: 假起})
  定 修2 = 改位(修1, 位跳尾, {op: "跳", a: 位尾})
  返回 {ok: 真, 状态: 修2, 结束: 假}
}

// 一条语句算出的值要不要在这里丢掉。
//
// 表达式语句要丢；若 与 当 也要丢 —— 它们自己的字节里不再丢值（见 编如果 与 编当），
// 值与 JS 那一份一样留给外层。JS 的 if/while 字节不含 POP，这一条是照着它对齐的。
//
// 做成函数而不是内联判断：这个条件在 编块 与 编块不留值 两处都要用，而内联写法里
// 「单标识符当条件」会让自举 parser 把它读成表达式语句（2026-11-02 连撞两次）。
函数 该丢(语句: Int) -> Bool {
  定 种 = 语句.kind
  若 种 == "表达式语句" { 返回 真 }
  若 种 == "若" { 返回 真 }
  若 种 == "当" { 返回 真 }
  返回 假
}

// 逐条编语句，**一条都不留值**。
//
// 当 的体用这一份：循环体里每条表达式语句的值都要丢掉，包括最后一条 ——
// 留一个值在栈上，下一轮循环就会把它当成新压进来的东西。
函数 编块不留值(语句批: Int, 状态: Int, i: Int) {
  若 i >= len(语句批) { 返回 {ok: 真, 状态: 状态, 结束: 假} }
  定 r = 语句(语句批[i], 状态)
  若 r.ok == 假 { 返回 r }
  若 r.结束 { 返回 {ok: 真, 状态: r.状态, 结束: 真} }
  变 下 = r.状态
  // 「要丢」的判据见 该丢：表达式语句，以及 若 与 当 —— 后两者自己的字节里不再丢值。
  若 该丢(语句批[i]) == 真 {
    下 = 发(下, {op: "弃"})
  }
  返回 编块不留值(语句批, 下, i + 1)
}

// 逐条编语句。
//
// 一条语句「不是最后一条」时，它算出来的值要丢掉 —— 而最后一条的值留着，
// 由调用它的人决定怎么处理（若 的收尾 POP、函数的 RET、块的末尾）。
// 这是 JS 那一份的规矩，而这一层要的是两位打包者交出同样的字节。
函数 编块(语句批: Int, 状态: Int, i: Int) {
  若 i >= len(语句批) { 返回 {ok: 真, 状态: 状态, 结束: 假} }
  定 r = 语句(语句批[i], 状态)
  若 r.ok == 假 { 返回 r }
  若 r.结束 { 返回 {ok: 真, 状态: r.状态, 结束: 真} }
  变 下 = r.状态
  若 i + 1 < len(语句批) {
    // 与 编块不留值 同一条：判据见 该丢。
    若 该丢(语句批[i]) == 真 {
      下 = 发(下, {op: "弃"})
    }
  }
  返回 编块(语句批, 下, i + 1)
}

// ---- 契约盒 ----
//
// 一个盒子里装五件：须、保、不变、返槽号，以及函数名。
// 为什么把函数名也装进来：失败那句话里要它，而 编一条契约 在函数体深处被调用；
// 让它一路把名字传下去，与装在盒子里带过去是同一件事，而盒子已经在手上了。
//
// 返槽号 -1 表示「这个函数没有出口契约」。那时 返回值 不占槽，ensures 里也就写不出它 ——
// 与 JS 那一份的 返槽 = -1 是同一个意思。
//
// 没有 -> Int：这一份文件里带注解的函数都交回 Int，而这一位交回的是记录。
// 挂上注解会被静态核对当场拦下（「声明返回 Int，交回的是 {…}」），而那条拦得对。
函数 空契(名: String) {
  返回 {须: (), 保: (), 不变: (), 返槽: 0 - 1, 名: 名}
}

// 从声明里取契约。
//
// 函数声明是九件，契约排第九格；宏是十件，第九格是 "macro" 这个标记（第十格才是契约）。
// 这一层不编宏，所以遇到宏就交回空盒 —— 而不是拿下标去撞那个字符串：
// "macro" 的 len 是 5，若先判长度就会一路走进 项[0]，取出一个 "m" 再往下传。
函数 契约在(声明: Int) {
  若 len(声明) <= 8 { 返回 空契(声明[0]) }
  定 项 = 声明[8]
  若 项 == "macro" { 返回 空契(声明[0]) }
  若 len(项) < 3 { 返回 空契(声明[0]) }
  返回 {须: 项[0], 保: 项[1], 不变: 项[2], 返槽: 0 - 1, 名: 声明[0]}
}

// 入口要查 须 与 不变；出口要查 保 与 不变。
// 两处都判「不变」—— 它在两端各查一次，那正是它与另外两样的不同之处。
函数 有入口契约(契: Int) -> Bool {
  若 len(契.须) > 0 { 返回 真 }
  若 len(契.不变) > 0 { 返回 真 }
  返回 假
}

函数 有出口契约(契: Int) -> Bool {
  若 len(契.保) > 0 { 返回 真 }
  若 len(契.不变) > 0 { 返回 真 }
  返回 假
}

// 一条契约的字节：求条件，真就跳过，假就把码与话压栈、调 契约失败 停下。
//
// 用 真跳 而不是 假跳：跳过的是「报错那一段」，而条件成立是常态，跳走的是多数。
// 话由调用点拼好交进来 —— 三样函数契约与循环不变式共用这一段字节，只是话说得不同。
// 每一个字都要与 src/bytecode.mjs 那一份相同：selfvmcompile 逐字节比，
// 差一个空格就是两份字节流，而那个差异在别处一声不响。
函数 编一条契约(条件: Int, 状态: Int, 码: String, 话: String) {
  定 c = 表达(条件, 状态)
  若 c.ok == 假 { 返回 c }
  定 位跳 = 码长(c.状态)
  定 s1 = 发(c.状态, {op: "真跳", a: 0 - 1})
  定 s2 = 发(s1, {op: "常量", a: 码})
  定 s3 = 发(s2, {op: "常量", a: 话})
  定 s4 = 发(s3, {op: "调内置", a: "契约失败", b: 2})
  返回 {ok: 真, 状态: 改位(s4, 位跳, {op: "真跳", a: 码长(s4)})}
}

// 一批契约，按出现的顺序一条接一条。
// 序 从 0 起，而话里报的是 序 + 1 —— 与 JS 那一份的 i + 1 对齐。
函数 编一批契约(批: Int, 状态: Int, 码: String, 名: String, 序: Int, 函数名: String) {
  若 序 >= len(批) { 返回 {ok: 真, 状态: 状态} }
  定 话 = "函数 " + 函数名 + " 的第 " + str(序 + 1) + " 条 " + 名 + " 不成立"
  定 r = 编一条契约(批[序], 状态, 码, 话)
  若 r.ok == 假 { 返回 r }
  返回 编一批契约(批, r.状态, 码, 名, 序 + 1, 函数名)
}

// 循环不变式（design/INVARIANTS.txt 第八节）：入口一次，每轮体末一次。
//
// 消息带行号，不带函数名与序号：循环在同一个函数里可以有若干个，「第几条」对它没有意义。
// 与 src/bytecode.mjs 那一份逐字相同。
//
// 没有这一样时（假）直接放行。
// 判的是 假 而不是空元组：self/stmt.hmoca 交回的「没有」就是 假，
// 而空元组在这一层的比较里靠不住（2026-11-02 实测，见那一边的注释）。
//
// 这一路原来不看档 —— 编源码 不带选项，写了就编。2026-11-02 加了弱档之后它要
// 看一次：循环不变式不是从契约盒里发出来的（盒里没有这一项，它挂在 当 那一行上），
// 所以「弱档换成空契」那一招管不到它，得在这里单独判。
函数 编循环不变(条件: Int, 状态: Int) {
  若 条件 == 假 { 返回 {ok: 真, 状态: 状态} }
  若 状态.档 == 0 { 返回 {ok: 真, 状态: 状态} }
  返回 编一条契约(条件, 状态, "HMYR-契-004", "第 " + str(条件.line) + " 行的循环不变式不成立")
}

// 入场：先 须，再 不变（design/INVARIANTS.txt 第四节）。
// 与出口那一半不同，这里不必动栈顶 —— 体还没开始，栈上什么都没有。
函数 编入场(状态: Int) {
  定 契 = 状态.契
  定 a = 编一批契约(契.须, 状态, "HMYR-契-001", "requires", 0, 契.名)
  若 a.ok == 假 { 返回 a }
  返回 编一批契约(契.不变, a.状态, "HMYR-契-003", "invariant", 0, 契.名)
}

// 出场：要交回的那个值先落槽，查完再取回来。
//
// 三步的顺序不能反：契约求值会把栈弄乱，而栈顶上那一个正是要交回去的值。
// 「存 → 查 → 取」与 JS 那一份的 359-367 行同形，连 取 的时机也一样。
// 没有出口契约时整个跳过 —— 那时连 返回值 的槽都没占，存 无处可存。
函数 编出场(状态: Int) {
  若 有出口契约(状态.契) == 假 { 返回 {ok: 真, 状态: 状态} }
  定 契 = 状态.契
  // 存 要带 b：打包器（self/pack.hmoca 的 放指令）在 存 那一格读 码.b 决定落 0 还是 1。
  // 缺了这一格，自举层拿到的是「no field 'b'」—— 一句与契约毫无关系的话。
  // 值给 假：返回值那个槽不可写，而 JS 那一份的 undefined 也落成 0，两边字节相同。
  定 s = 发(状态, {op: "存", a: 契.返槽, b: 假})
  定 a = 编一批契约(契.保, s, "HMYR-契-002", "ensures", 0, 契.名)
  若 a.ok == 假 { 返回 a }
  定 b = 编一批契约(契.不变, a.状态, "HMYR-契-003", "invariant", 0, 契.名)
  若 b.ok == 假 { 返回 b }
  返回 {ok: 真, 状态: 发(b.状态, {op: "取", a: 契.返槽})}
}

// 一个函数：参数按顺序占前几个槽，然后编体，末尾补「交回空」。
// 参数叫 声明 而不是 函数：函数 要做 函数 的汉字写法（关键字），而关键字不能当参数名。
// 而下面 586 行那个 函数: 是记录字面量的字段名 —— 那个位置接受声明修饰类的关键字，
// 与 公开: 同一个道理（{公开: ...} 一直是能跑的）。
函数 编函数(声明: Int, 强档: Int) {
  定 名 = 声明[0]
  定 参名册 = 声明[1]
  定 体 = 声明[2]
  变 名表 = ()
  变 i = 0
  当 i < len(参名册) {
    名表 = 名表 + ((参名册[i], i),)
    i = i + 1
  }
  // 契约盒与 返回值 那个槽。
  //
  // 只有当出口有东西要查（保 或 不变）时才占这一个槽，名字就叫 返回值 ——
  // ensures 里写的是这个名字，而编译这一层给的是这个名字，两边必须是同一串。
  // 槽号排在参数之后，所以函数表记的参数量（len(参名册)）不受影响：那一个数与槽数是两回事。
  // 档就在这一行落地：弱档时盒子换成空的，于是 有入口契约 与 有出口契约 都答假，
  // 入场与出场两段自然空掉，返回值 那个槽也不占。契约那几段的字节于是一条都不发 ——
  // 这与 JS 那一份把 options.contracts 关掉是同一条路，不是两套实现。
  变 契 = 空契(名)
  若 强档 == 1 { 契 = 契约在(声明) }
  变 起槽 = len(参名册)
  若 有出口契约(契) {
    名表 = 名表 + (("返回值", 起槽),)
    契 = {须: 契.须, 保: 契.保, 不变: 契.不变, 返槽: 起槽, 名: 契.名}
    起槽 = 起槽 + 1
  }
  定 头 = 编入场(状态((), (), 起槽, 名表, 契, 强档))
  若 头.ok == 假 { 返回 {ok: 假, 错: 名 + "：" + 头.错} }
  定 r = 编块(体, 头.状态, 0)
  若 r.ok == 假 { 返回 {ok: 假, 错: 名 + "：" + r.错} }
  // 体走完之后补「交回空」：先压空，再走出场，最后 返回。
  //
  // 与 JS 那一份的 417-419 行同形。那三条在每条 返回 之后都是死的，
  // 但它们仍在字节流里 —— 逐字节比的是字节，不是「跑得到那几条」。
  定 补 = 发(r.状态, {op: "常量", a: ()})
  定 尾 = 编出场(补)
  若 尾.ok == 假 { 返回 {ok: 假, 错: 名 + "：" + 尾.错} }
  定 码 = 拼状态(尾.状态) + ({op: "返回"},)
  // 效果从声明里取：声明[3] 是效册（见 self/body.hmoca 的 decls_from）。
  // 2026-11-02 之前这里是硬编码的空元组，于是子集编译器编出的每个函数都「什么都不碰」，
  // 两份编译器对同一份源码给出不同字节，而那个差异当场不报。三层链的修法记在
  // design/COMPILER.txt。
  返回 {ok: 真, 函数: {名: 名, 参数量: len(参名册), 槽数: 尾.状态.槽, 效果: 声明[3], 码: 码}}
}

函数 编函数族(函数族: Int, i: Int, acc: Int, 强档: Int) {
  若 i >= len(函数族) { 返回 {ok: 真, 函数族: acc} }
  定 r = 编函数(函数族[i], 强档)
  若 r.ok == 假 { 返回 r }
  返回 编函数族(函数族, i + 1, acc + (r.函数,), 强档)
}

// 顶层常量：每一条编成「初始化式 → SETGLOBAL 名字」。
// 它们被收进一个零参数的函数，机器在调 main 之前跑它一次 —— 名字与宿主那一份
// （src/bytecode.mjs 的 顶层段名）是同一串，改一处要两处一起改。
函数 编常量册(常量册: Int, i: Int, 状态盒: Int) {
  若 i >= len(常量册) { 返回 {ok: 真, 状态: 状态盒} }
  定 项 = 常量册[i]
  定 r = 表达(项[1], 状态盒)
  若 r.ok == 假 { 返回 {ok: 假, 错: "常量 " + 项[0] + "：" + r.错} }
  返回 编常量册(常量册, i + 1, 发(r.状态, {op: "全域存", a: 项[0]}))
}

函数 编顶层段(常量册: Int) {
  // 顶层段不是用户写的那种函数：零参数、没有契约，名字是宿主那一份认的那一串。
  // 契约盒照样要给一个 —— 状态是六件的，缺一件去读它就会落到「没有这个字段」上。
  // 档给 1：顶层段里根本没有契约可编，两个档在这里交出同样的字节。
  定 r = 编常量册(常量册, 0, 状态((), (), 0, (), 空契("__hmyr_top__"), 1))
  若 r.ok == 假 { 返回 r }
  定 码 = 拼状态(r.状态) + ({op: "常量", a: ()}, {op: "返回"})
  返回 {ok: 真, 函数: {名: "__hmyr_top__", 参数量: 0, 槽数: r.状态.槽, 效果: (), 码: 码}}
}

// 入口：源码 → 函数表。
//
// 第二个参数是档（2026-11-02）：1 强档，契约那几段照编；0 弱档，一段都不编。
// 两台编译器（这一份与 src/bytecode.mjs）比字节之前要先对齐档 —— 以前这一位只
// 服务强档，于是比字节时只能让 JS 那一份也跟着开强档；现在两边都能关。
//
// 交回的是一份记录 {ok, 函数族}，而声明写的是 Int —— 这一份文件里所有函数的返回类型
// 注解都是 Int（自举层的类型注解今天只是注解，不当契约用）。所以最后那一句不直接把
// 记录字面量交出去，而是先放进一个变量：核对返回类型 对字面量说得清，对变量说
// 「说不清」而放过。这不是修好，是把那条检查的边界写在它碰得到的地方。
公开 函数 编源码(源码: String, 强档: Int) -> Int {
  定 声明批 = parse_decls(scan_lines(源码))
  定 r = 编函数族(声明批.fns, 0, (), 强档)
  若 r.ok == 假 { 返回 r }
  若 len(声明批.consts) == 0 { 返回 r }
  定 顶 = 编顶层段(声明批.consts)
  若 顶.ok == 假 { 返回 顶 }
  定 合起来的函数族 = r.函数族 + (顶.函数,)
  定 带顶层段 = {ok: 真, 函数族: 合起来的函数族}
  返回 带顶层段
}

函数 main() -> Int {
  定 r = 编源码("fn 加(a: Int, b: Int) -> Int {" + chr(10) + "  return a + b" + chr(10) + "}" + chr(10), 1)
  若 r.ok == 假 {
    print("错：" + r.错)
    返回 1
  }
  print(str(len(r.函数族)) + " 个函数，" + str(len(r.函数族[0].码)) + " 条指令，槽 " + str(r.函数族[0].槽数))
  返回 0
}
