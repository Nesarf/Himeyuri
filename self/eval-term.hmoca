// 终端与按键这十个内置：求调用 那一大块分派的第四刀（第三刀是 eval-index）。
//
// 为什么单独立一份（2026-11-05）：与前两刀同形 —— 十条分支各四五行，只依赖
// eval-core.hmoca 里的 好 坏 要效果，交回 {有, 结果}，由 求调用 按顺序问。
//
// 这一组是自举层里最边缘的一块：终端大小、清屏、颜色、光标、按键队列。它们不参与
// 求值本身，所以搬出去之后 eval.hmoca 里剩下的分派都是「语言自己那套东西」。

引入 "./eval-core.hmoca"

公开 函数 求内置终端(名: String, 值簇: Int, 环境: Int) {
若 名 == "key_available" {
    若 len(值簇) != 0 { 返回 {有: 真, 结果: 坏("key_available 不要参数")} }
    返回 {有: 真, 结果: 好(key_available())}
  }
若 名 == "key_push" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("key_push 要一个参数")} }
    返回 {有: 真, 结果: 好(key_push(值簇[0]))}
  }
若 名 == "key_read" {
    若 len(值簇) != 0 { 返回 {有: 真, 结果: 坏("key_read 不要参数")} }
    返回 {有: 真, 结果: 好(key_read())}
  }
若 名 == "key_start" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("key_start 要一个参数")} }
    返回 {有: 真, 结果: 好(key_start(值簇[0]))}
  }
若 名 == "term_clear" {
    若 len(值簇) != 0 { 返回 {有: 真, 结果: 坏("term_clear 不要参数")} }
    返回 {有: 真, 结果: 好(term_clear())}
  }
若 名 == "term_color" {
    若 len(值簇) == 1 { 返回 {有: 真, 结果: 好(term_color(值簇[0]))} }
    若 len(值簇) == 2 { 返回 {有: 真, 结果: 好(term_color(值簇[0], 值簇[1]))} }
    返回 {有: 真, 结果: 坏("term_color 要一个或两个参数")}
  }
若 名 == "term_escape" {
    若 len(值簇) != 2 { 返回 {有: 真, 结果: 坏("term_escape 要两个参数")} }
    返回 {有: 真, 结果: 好(term_escape(值簇[0], 值簇[1]))}
  }
若 名 == "term_hide" {
    若 len(值簇) != 0 { 返回 {有: 真, 结果: 坏("term_hide 不要参数")} }
    返回 {有: 真, 结果: 好(term_hide())}
  }
若 名 == "term_show" {
    若 len(值簇) != 0 { 返回 {有: 真, 结果: 坏("term_show 不要参数")} }
    返回 {有: 真, 结果: 好(term_show())}
  }
若 名 == "term_size" {
    若 len(值簇) != 0 { 返回 {有: 真, 结果: 坏("term_size 不要参数")} }
    返回 {有: 真, 结果: 好(term_size())}
  }
  返回 {有: 假, 结果: 0}
}
