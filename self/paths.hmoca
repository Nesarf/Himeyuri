// 加载路径上的六件公用零件：拆行、拼路径、是包名字、找包根从、目录部分、最后一个分隔从。
//
// 为什么单独立一份（2026-11-05）：前四件原先在 self/run.hmoca 与 self/pack.hmoca 各一份，
// 逐字相同；目录部分 与 最后一个分隔从 同样各一份 —— 它们只有四行，所以「同名同体、
// 八行以上」那条判据没报它们，但它们是同一处逻辑的两份拷贝。
//
// 六个函数里有一整条依赖链：找包根从 → 目录部分 → 最后一个分隔从。前一次尝试回滚，
// 就是因为只搬了四个函数而把 目录部分 留在原处 —— 于是 paths.hmoca 自己站不住。
// 这一次六个一起搬，链是闭合的。
//
// 全部带 公开：跨模块调用要 pub，这是 HMYR-載-006 提醒的那件事（那一轮 leaves 也栽在它上面）。

公开 函数 拆行(文本: String) {
  若 文本 == "" { 返回 () }
  变 i = 0
  变 起 = 0
  变 acc = ()
  当 i < len(文本) {
    若 文本[i] == chr(10) {
      acc = acc + (slice(文本, 起, i),)
      i = i + 1
      起 = i
    } 否则 {
      i = i + 1
    }
  }
  返回 acc + (slice(文本, 起, len(文本)),)
}

公开 函数 拼路径(目录: String, 相对: String) -> String {
  // 绝对路径原样返回。桥与测试会把临时目录里的文件交进来，那些不在仓库下，
  // 而「相对本目录」对它们没有意义 —— 说清这条边界，比让它们安静地读失败好。
  若 len(相对) >= 2 && slice(相对, 1, 2) == ":" { 返回 相对 }
  若 len(相对) >= 1 && slice(相对, 0, 1) == "/" { 返回 相对 }
  若 len(相对) >= 2 && slice(相对, 0, 2) == "./" {
    返回 目录 + "/" + slice(相对, 2, len(相对))
  }
  返回 目录 + "/" + 相对
}

公开 函数 是包名字(s: String) -> Bool {
  若 len(s) == 0 { 返回 假 }
  若 is_digit(s[0]) { 返回 假 }
  若 s[0] == "-" || s[0] == "." { 返回 假 }
  变 i = 0
  当 i < len(s) {
    若 s[i] == "/" { 返回 假 }
    i = i + 1
  }
  返回 真
}

公开 函数 找包根从(目录: String, 最后: String, 次: Int) -> String 效果串(file) {
  若 次 > 64 { 返回 最后 }
  变 记 = 最后
  若 file_exists(目录 + "/hmyr.hmkit") { 记 = 目录 }
  定 上 = 目录部分(目录)
  若 上 == 目录 { 返回 记 }
  返回 找包根从(上, 记, 次 + 1)
}

公开 函数 目录部分(路: String) -> String {
  定 i = 最后一个分隔从(路, 0, 0 - 1)
  若 i < 0 { 返回 "." }
  返回 slice(路, 0, i)
}

公开 函数 最后一个分隔从(路: String, i: Int, 末: Int) -> Int {
  若 i >= len(路) { 返回 末 }
  定 c = 路[i]
  若 c == "/" || c == chr(92) { 返回 最后一个分隔从(路, i + 1, i) }
  返回 最后一个分隔从(路, i + 1, 末)
}
