// 一条 OpenSSH 分离签名与它签的文件：读进来、拼被签数据、交给 Ed25519 验。
//
// 这是发布链的最后一跳：manifest.json 与 manifest.json.sig 都由 HMYR 自己验，
// 不需要 ssh-keygen，也不需要 node。
引入 "./ssh.hmoca"
引入 "./curve.hmoca"

函数 验文件(签名路: String, 消息路: String) -> Bool 效果串(file, process) {
  定 解 = 解签名(read_text(签名路))
  定 消哈 = sha512字节(read_bytes(消息路))
  // 被签数据里没有版本与公钥 —— 见 ssh.hmyr 里 造签名数据 的注释。
  定 数据 = 造签名数据(解.名, 解.保, 解.哈希算法, 消哈)
  // 签名 blob 是「算法名 + 64 字节」，尾巴才是 R 与 S。
  定 签 = 后几(解.签, 64)
  返回 验签(解.公钥点, 前几(签, 32), 前几(从第(签, 32), 32), 数据)
}

// ---- 生成那一半（2026-11-03 补） ----
//
// 上面那个 验文件 是发布链的最后一跳；这一段是它的对偶：同一个算法，反方向。
// 有了它，「与 ssh-keygen 的双向互通」才有得验 —— 验旧包早已通了，缺的一直是
// 「旧验签器能不能验新包」。
//
// Ed25519 的 sign，按 RFC 8032 的五步：
//   h = SHA512(seed)；a = clamp(h[0..32])；prefix = h[32..64]
//   r = SHA512(prefix || M) mod L；R = r·B
//   k = SHA512(R || A || M) mod L；S = (r + k·a) mod L
// 而签名就是 R || S 共 64 字节。它是确定性的：同一份 seed 与消息永远给同一串字节，
// 所以判据可以「逐字节比」，不必只比「验得过」。

// 夹紧：把哈希的前 32 字节改成 Ed25519 的标量。
// 最低字节清低三位、最高字节清最高位再置次高位 —— 那三处是曲线阶与余因子要求的。
函数 夹紧(字节串: Int) {
  变 出 = ()
  变 i = 0
  当 i < 32 {
    变 v = 字节串[i]
    若 i == 0 {
      v = v - v % 8
    }
    若 i == 31 {
      v = v % 128
      v = v + 64
    }
    出 = 出 + (v,)
    i = i + 1
  }
  返回 出
}

// 接：两个字节串前后接起来。没有内置的串接，所以自己走一遍。
函数 接(a: Int, b: Int) {
  变 出 = a
  变 i = 0
  当 i < len(b) {
    出 = 出 + (b[i],)
    i = i + 1
  }
  返回 出
}

// 到三十二：一个大整数 → 32 字节小端。
// curve.hmoca 只有反方向（从字节串），因为验签那边只读不写。签名要写。
函数 到三十二(a: Int) {
  变 出 = ()
  变 i = 0
  当 i < 32 {
    定 位 = (i - i % 3) / 3
    变 剩 = a[位]
    变 k = i % 3
    当 k > 0 {
      剩 = (剩 - 剩 % 256) / 256
      k = k - 1
    }
    出 = 出 + (剩 % 256,)
    i = i + 1
  }
  返回 出
}

// 从种子交出公钥与私钥那两串字节（私钥是 seed || 公钥，64 字节 —— 那是 Ed25519 的约定）。
公开 函数 从种子(种子: Int) {
  定 哈 = sha512字节(种子)
  定 a = 夹紧(前几(哈, 32))
  定 公 = 压缩点(标量乘(基点(), 从字节串(a)))
  返回 {公: 公, 私: 接(种子, 公), 前: 从第(哈, 32)}
}

// 签名：交回 64 字节（R || S）。
//
// 公钥那一次标量乘复用 从种子 的结果，不再自己算一遍 —— 一次标量乘是 256 次倍点，
// 而这台机器上一次要两秒上下。2026-11-03 第一次跑的时候它算了三遍，撞在步数上限上。
//
// 现状：这个函数今天还给不出正确的 S。
//   S = (r + k·a) mod L 里的加与乘必须是**模 L** 的，而 curve.hmoca 的 模加 与 模乘
//   是模 p 的（那是验签用的）。用 RFC 8032 的 Test 1 试过：公钥完全正确
//   （d75a9801…f707511a），签名不对 —— 差的就是这一步。
//   要补的是 模L加 与 模L乘：k·a 有 504 位，而 模L 只会减 L，减不了那么多次，
//   所以模 L 的乘要自己写一条（逐位「乘 2 加，再模 L」，或者一条真正的约简）。
//   于是它现在不接进任何判据 —— 一个会交回错数的函数不该被当成对的。
公开 函数 签名(种子: Int, 消息: Int) {
  定 哈 = sha512字节(种子)
  定 a = 从字节串(夹紧(前几(哈, 32)))
  定 前 = 从第(哈, 32)
  定 公 = 压缩点(标量乘(基点(), a))
  定 r = 模L长(sha512字节(接(前, 消息)))
  定 R = 压缩点(标量乘(基点(), 从字节串(r)))
  定 k = 模L长(sha512字节(接(接(R, 公), 消息)))
  定 S = 模L加(r, 模L乘(k, a))
  返回 接(R, 到三十二(S))
}

函数 main() -> Int 效果串(file, process) {
  定 参 = argv()
  若 len(参) < 3 {
    print("用法：hmyr self/sign.hmyr <签名.sig> <被签文件>" + chr(10))
    返回 2
  }
  若 验文件(参[1], 参[2]) {
    print("通过" + chr(10))
  } 否则 {
    print("不通过" + chr(10))
  }
  返回 0
}
