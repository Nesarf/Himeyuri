// 验一份清单：逐行扫，不做整份解析。
//
// 为什么不解析整份：json.hmyr 的解析器用元组追加写，二十一 KB 的清单会让它平方级超时。
// 而清单是 JSON.stringify(x, null, 2) 生成的，形状固定 —— 每项一行，键在值的前面。
// 于是这里按行扫，快得多；代价写明：结构丢了，两个前缀只能靠「这一行落在哪一段里」推。
//
// 验两样：每一项的哈希，以及整份的 digest。
// digest 那一条同样不用解析：清单是 JSON.stringify 的产物，把 digest 那行删掉、再把前一行
// 末尾的逗号去掉，得到的就是「不含 digest 的那份」—— 那正是 tools/manifest.mjs 算哈希的对象。
// 这条规则先在 node 里对着真清单验过（重建的字节与 JSON.stringify 逐字节相同），才写到这里。
//
// 进度走 stderr（每五十项一行）：长跑时能看出它在动，而 stdout 只留结论。

引入 "./sha256.hmoca"
引入 "../json.hmoca"

fn 前16(十六: String) -> String {
  返回 slice(十六, 0, 16)
}

fn 找(s: String, 片: String, i: Int) -> Int {
  若 i + len(片) > len(s) { 返回 0 - 1 }
  若 slice(s, i, i + len(片)) == 片 { 返回 i }
  返回 找(s, 片, i + 1)
}

// 一行里「第一个引号对」之间的那段，也就是键名。
//
// 这个函数是一次真实的错误换来的：早先判断的是「这一行含不含某个键的字符串」，
// 而清单里有一个套件就叫 sha256，它的 name 行写着 "name": "sha256" ——
// 于是那一行被当成了哈希行，读出来的「哈希」是字面量 sha256，
// 标签却是上一项的路径。症状是「有一项莫名其妙不对，而且写着 sha256」。
// 判键名，不判内容。
fn 键(s: String) -> String {
  定 一 = 找(s, "\"", 0)
  若 一 < 0 { 返回 "" }
  定 二 = 找(s, "\"", 一 + 1)
  若 二 < 0 { 返回 "" }
  返回 slice(s, 一 + 1, 二)
}

// 冒号之后第一对引号之间：值。
fn 值(s: String) -> String {
  定 冒 = 找(s, ":", 0)
  若 冒 < 0 { 返回 "" }
  定 一 = 找(s, "\"", 冒 + 1)
  若 一 < 0 { 返回 "" }
  定 二 = 找(s, "\"", 一 + 1)
  若 二 < 0 { 返回 "" }
  返回 slice(s, 一 + 1, 二)
}

// 找某个顶层键所在的行号（"tools" 与 "documents" 两段的分界）。
// 同样用键名比：有个套件可能就叫 tools。
fn 行号(s: String, 名: String) -> Int {
  定 行批 = split(s, chr(10))
  var i = 0
  当 i < len(行批) {
    若 键(行批[i]) == 名 { 返回 i }
    i = i + 1
  }
  返回 0 - 1
}

// 去掉行尾那一个逗号（只有 digest 之前那一行用得上）。
fn 去尾逗号(s: String) {
  若 len(s) == 0 { 返回 s }
  若 slice(s, len(s) - 1, len(s)) == "," { 返回 slice(s, 0, len(s) - 1) }
  返回 s
}

// 重建「不含 digest 的那份」的字节：跳过 digest 那行、去掉它前一行的尾逗号、
// 并丢掉文件末尾那个空元素（写出时补的换行）。
//
// 每 128 行封一块再折平 —— 逐行往一个串上接在这里是平方级，这个仓库里已经栽过四次。
//
// 换行写在块内（每行后面都带一个），不要在块与块之间去补：折平是用 + 拼字符串，
// 块边界上没有位置插那个 chr(10)。这一处错过一次，症状很有教育意义 ——
// 二十几行的小清单只有一块，全对；九百多行分成八块，digest 立刻不对。
fn 重建文本(行批: Int, dig: Int) {
  var 前 = dig - 1
  当 前 >= 0 && 行批[前] == "" { 前 = 前 - 1 }
  var 块堆 = ()
  var 块 = ""
  var 块行数 = 0
  var i = 0
  当 i < len(行批) {
    var 取 = i != dig
    若 i == len(行批) - 1 && 行批[i] == "" { 取 = false }
    若 取 {
      定 原行 = 行批[i]
      var 行 = 原行
      若 i == 前 { 行 = 去尾逗号(原行) }
      块 = 块 + 行 + chr(10)
      块行数 = 块行数 + 1
      若 块行数 >= 128 {
        块堆 = 块堆 + (块,)
        块 = ""
        块行数 = 0
      }
    }
    i = i + 1
  }
  若 块行数 > 0 { 块堆 = 块堆 + (块,) }
  若 len(块堆) == 0 { 返回 "" }
  定 拼 = 拼平(块堆, 0, len(块堆))
  // 每行后面那个换行多出来一个：JSON.stringify 的输出不以换行结尾。
  若 len(拼) > 0 { 返回 slice(拼, 0, len(拼) - 1) }
  返回 拼
}

// 一件：标签（用来印）、路（要读的文件）、写（清单里写的哈希前十六位）、
// 行（那一行的原文 —— 不通过时一起印出来，证据跟着结论走）。
fn 验一件(标签: String, 路: String, 写: String, 对: Int, 错: Int, 缺: Int, 说: String, 行: String) 效果串(file) {
  若 file_exists(路) == false {
    返回 {对: 对, 错: 错, 缺: 缺 + 1, 说: 说 + "  [缺] " + 标签 + chr(10)}
  }
  定 算 = 前16(sha256(read_bytes(路)))
  若 算 == 写 {
    返回 {对: 对 + 1, 错: 错, 缺: 缺, 说: 说}
  }
  返回 {对: 对, 错: 错 + 1, 缺: 缺, 说: 说 + "  [不通过] " + 标签 + "：写着 " + 写 + "，算出来 " + 算 + chr(10) + "  那一行是 " + 行 + chr(10)}
}

fn main() -> Int 效果串(file, process) {
  定 参 = argv()
  若 len(参) < 2 {
    print("用法：hmyr self/verify.hmyr <清单.json>" + chr(10))
    返回 2
  }
  定 文 = read_text(参[1])
  定 行批 = split(文, chr(10))
  // 两段的分界：name 那几项要补前缀，而补哪一个由「它在哪一段里」决定。
  定 工具起 = 行号(文, "tools")
  定 文档起 = 行号(文, "documents")

  var 对 = 0
  var 错 = 0
  var 缺 = 0
  var 说 = ""
  var 上键 = ""
  var 上值 = ""
  var 已验 = 0

  var i = 0
  当 i < len(行批) {
    定 行 = 行批[i]
    定 键名 = 键(行)
    // 只在哈希行上动手：它的上一行给出路径。
    若 键名 == "sha256" {
      定 写 = 值(行)
      var 路 = 上值
      若 上键 == "name" {
        // 名字要补前缀：tools 段补 tools/，documents 段补 design/。
        若 文档起 >= 0 && i > 文档起 {
          路 = "design/" + 上值
        } 否则 若 工具起 >= 0 && i > 工具起 {
          路 = "tools/" + 上值
        }
      }
      定 r = 验一件(路, 路, 写, 对, 错, 缺, 说, 行)
      对 = r.对
      错 = r.错
      缺 = r.缺
      说 = r.说
      已验 = 已验 + 1
      若 已验 % 50 == 0 { print_err("  已验 " + str(已验) + " 项" + chr(10)) }
    } 否则 若 键名 == "file" {
      上键 = "file"
      上值 = 值(行)
    } 否则 若 键名 == "path" {
      上键 = "path"
      上值 = 值(行)
    } 否则 若 键名 == "name" {
      上键 = "name"
      上值 = 值(行)
    }
    i = i + 1
  }

  print(说)
  print("  对得上 " + str(对) + " 项 · 不对 " + str(错) + " 项 · 缺 " + str(缺) + " 项" + chr(10))

  var 整份对 = true
  定 码 = 行号(文, "digest")
  若 码 < 0 {
    print("  清单里没有 digest，整份这一步跳过" + chr(10))
  } 否则 {
    定 写 = 值(行批[码])
    若 写 == "" {
      print("  digest 是空的，整份这一步跳过" + chr(10))
    } 否则 {
      定 重建 = 重建文本(行批, 码)
      定 算 = sha256(从文本(重建))
      若 算 == 写 {
        print("  整份的 digest 对得上（重算 " + str(len(重建)) + " 字符）" + chr(10))
      } 否则 {
        print("  整份的 digest 对不上：写着 " + 写 + "，算出来 " + 算 + chr(10))
        整份对 = false
      }
    }
  }

  若 错 == 0 && 缺 == 0 && 整份对 {
    print("  通过" + chr(10))
    返回 0
  }
  print("  不通过" + chr(10))
  返回 1
}
