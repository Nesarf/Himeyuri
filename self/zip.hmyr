}

fn crc32(字节们: Int) {
  let 表们 = 表()
  var c = 4294967295
  var i = 0
  while i < len(字节们) {
    let 索 = 异或8(c, to_int(字节们[i]))
    let 项 = to_int(表们[索])
    c = 异或((c - c % 256) / 256, 项)
    i = i + 1
  }
  return 4294967295 - c
}

// ---- 小端与拼接 ----

fn 写短(值: Int, 字节数: Int) {
  var 出 = ()
  var v = 值
  var i = 0
  while i < 字节数 {
    let b = v % 256
    出 = 出 + (b,)
    v = (v - b) / 256
    i = i + 1
  }
  return 出
}

fn 写串(文: String) {
  var 出 = ()
  var i = 0
  while i < len(文) {
    出 = 出 + (ord(文[i]),)
    i = i + 1
  }
  return 出
}

fn 拼(段们: Int) {
  // 段数不多，但每段可能很长 —— 逐字节往一个元组上拼是平方级，四万三千字节会卡到分钟级。
  // 折半拼接让复制量降到「段数乘对数」。
  if len(段们) == 0 { return () }
  return 拼平(段们, 0, len(段们))
}

fn 拼平(块们: Int, 起: Int, 止: Int) {
  if 止 - 起 <= 1 { return 块们[起] }
  var 左 = 起
  var 右 = 止
  while 右 - 左 > 2 {
    左 = 左 + 1
    右 = 右 - 1
  }
  let 中 = 左 + 1
  return 拼平(块们, 起, 中) + 拼平(块们, 中, 止)
}

// ---- deflate 的固定 Huffman（与 self/deflate.hmyr 同一份算法） ----

fn 倍(n: Int) -> Int {
  var v = 1
  var i = 0
  while i < n {
    v = v * 2
    i = i + 1
  }
  return v
}

fn 反转位(码: Int, 位数: Int) -> Int {
  var 出 = 0
  var 值 = 码
  var i = 0
  while i < 位数 {
    let 位 = 值 % 2
    出 = 出 * 2 + 位
    值 = (值 - 位) / 2
    i = i + 1
  }
  return 出
}

fn 放位(状: Int, 值: Int, 位数: Int) {
  var 字节们 = 状.字节们
  var 当前 = 状.当前
  var 已 = 状.已
  var v = 值
  var i = 0
  while i < 位数 {
    let 位 = v % 2
    当前 = 当前 + 位 * 倍(已)
    已 = 已 + 1
    if 已 >= 8 {
      字节们 = 字节们 + (当前,)
      当前 = 0
      已 = 0
    }
    v = (v - 位) / 2
    i = i + 1
  }
  return {字节们: 字节们, 当前: 当前, 已: 已}
}

fn 刷(状: Int) {
  var 字节们 = 状.字节们
  if 状.已 > 0 { 字节们 = 字节们 + (状.当前,) }
  return {字节们: 字节们, 已: 0, 当前: 0}
}

fn 符号码(s: Int) -> Int {
  if s <= 143 { return 48 + s }
  if s <= 255 { return 400 + (s - 144) }
  if s <= 279 { return s - 256 }
  return 192 + (s - 280)
}

fn 符号位数(s: Int) -> Int {
  if s <= 143 { return 8 }
  if s <= 255 { return 9 }
  if s <= 279 { return 7 }
  return 8
}

fn 长表() {
  return ((3, 257, 0), (4, 258, 0), (5, 259, 0), (6, 260, 0), (7, 261, 0), (8, 262, 0), (9, 263, 0), (10, 264, 0),
    (11, 265, 1), (13, 266, 1), (15, 267, 1), (17, 268, 1), (19, 269, 2), (23, 270, 2), (27, 271, 2), (31, 272, 2),
    (35, 273, 3), (43, 274, 3), (51, 275, 3), (59, 276, 3), (67, 277, 4), (83, 278, 4), (99, 279, 4), (115, 280, 4),
    (131, 281, 5), (163, 282, 5), (195, 283, 5), (227, 284, 5), (258, 285, 0))
}

fn 距表() {
  return ((1, 0, 0), (2, 1, 0), (3, 2, 0), (4, 3, 0), (5, 4, 1), (7, 5, 1), (9, 6, 2), (13, 7, 2),
    (17, 8, 3), (25, 9, 3), (33, 10, 4), (49, 11, 4), (65, 12, 5), (97, 13, 5), (129, 14, 6), (193, 15, 6),
    (257, 16, 7), (385, 17, 7), (513, 18, 8), (769, 19, 8), (1025, 20, 9), (1537, 21, 9), (2049, 22, 10), (3073, 23, 10),
    (4097, 24, 11), (6145, 25, 11), (8193, 26, 12), (12289, 27, 12), (16385, 28, 13), (24577, 29, 13))
}

fn 查表(表: Int, 值: Int) -> Int {
  var i = len(表) - 1
  while i >= 0 {
    if 表[i][0] <= 值 { return 表[i] }
    i = i - 1
  }
  return 表[0]
}

fn 找匹配(字节们: Int, i: Int) {
  let 总 = len(字节们)
  var 最 = 0
  var 距 = 0
  var 起 = i - 4096
  if 起 < 0 { 起 = 0 }
  var j = 起
  while j < i {
    var 长 = 0
    var 继续 = true
    while 继续 && 长 < 258 && i + 长 < 总 && j + 长 < 总 {
      if 字节们[i + 长] == 字节们[j + 长] { 长 = 长 + 1 } else { 继续 = false }
    }
    if 长 > 最 {
      最 = 长
      距 = i - j
    }
    j = j + 1
  }
  return {长: 最, 距: 距}
}

fn 固定压(字节们: Int) {
  let 总 = len(字节们)
  var 状 = 放位({字节们: (), 当前: 0, 已: 0}, 3, 3)
  var 块们 = ()
  var i = 0
  while i < 总 {
    let 匹 = 找匹配(字节们, i)
    if 匹.长 >= 3 {
      let 长 = 查表(长表(), 匹.长)
      状 = 放位(状, 反转位(符号码(长[1]), 符号位数(长[1])), 符号位数(长[1]))
      if 长[2] > 0 { 状 = 放位(状, 匹.长 - 长[0], 长[2]) }
      let 距 = 查表(距表(), 匹.距)
      状 = 放位(状, 反转位(距[1], 5), 5)
      if 距[2] > 0 { 状 = 放位(状, 匹.距 - 距[0], 距[2]) }
      i = i + 匹.长
    } else {
      let b = to_int(字节们[i])
      状 = 放位(状, 反转位(符号码(b), 符号位数(b)), 符号位数(b))
      i = i + 1
    }
    let 小块 = 状.字节们
    if len(小块) >= 1024 {
      块们 = 块们 + (小块,)
      状 = {字节们: (), 当前: 状.当前, 已: 状.已}
    }
  }
  状 = 放位(状, 0, 7)
  状 = 刷(状)
  let 尾 = 状.字节们
  if len(尾) > 0 { 块们 = 块们 + (尾,) }
  if len(块们) == 0 { return () }
  return 拼平(块们, 0, len(块们))
}

// ---- ZIP 的三段 ----

fn 本地头(crc: Int, 压缩: Int, 原始: Int, 名们: Int, 方法: Int) {
  return 拼(((80, 75, 3, 4),
    写短(20, 2), 写短(0, 2), 写短(方法, 2), 写短(0, 2), 写短(0, 2),
    写短(crc, 4), 写短(压缩, 4), 写短(原始, 4),
    写短(len(名们), 2), 写短(0, 2), 名们))
}

fn 一个中心(crc: Int, 压缩: Int, 原始: Int, 名们: Int, 偏移: Int, 方法: Int) {
  return 拼(((80, 75, 1, 2),
    写短(20, 2), 写短(20, 2), 写短(0, 2), 写短(方法, 2), 写短(0, 2), 写短(0, 2),
    写短(crc, 4), 写短(压缩, 4), 写短(原始, 4),
    写短(len(名们), 2), 写短(0, 2), 写短(0, 2),
    写短(0, 2), 写短(0, 2), 写短(0, 4), 写短(偏移, 4), 名们))
}

fn 尾(条数: Int, 目录大小: Int, 目录偏移: Int) {
  return 拼(((80, 75, 5, 6),
    写短(0, 2), 写短(0, 2), 写短(条数, 2), 写短(条数, 2),
    写短(目录大小, 4), 写短(目录偏移, 4), 写短(0, 2)))
}

// 一个成员：本地头 + 负载，外加它在中央目录里的那一条。
fn 成员(路: String, 名: String, 压: Bool, 偏移: Int) {
  let 数据 = read_bytes(路)
  let 名们 = 写串(名)
  let crc = crc32(数据)
  let 原始 = len(数据)
  var 方法 = 0
  var 负载 = 数据
  if 压 {
    方法 = 8
    负载 = 固定压(数据)
  }
  let 压缩 = len(负载)
  let 本地 = 本地头(crc, 压缩, 原始, 名们, 方法)
  let 块 = 拼((本地, 负载))
  let 中心 = 一个中心(crc, 压缩, 原始, 名们, 偏移, 方法)
  return {块: 块, 中心: 中心, 原始: 原始, 压缩: 压缩}
}

fn main() -> Int effects(file) {
  let 参 = argv()
  var 压 = false
  var 多 = false
  var i = 0
  while i < len(参) {
    if 参[i] == "--压" { 压 = true }
    if 参[i] == "--多" { 多 = true }
    i = i + 1
  }
  if 多 {
    // --多 <包.zip> <文件...>：成员名就是参数里的相对路径。
    var 包位 = 0 - 1
    i = 0
    while i < len(参) {
      if 参[i] == "--多" { 包位 = i + 1 }
      i = i + 1
    }
    if 包位 < 0 || 包位 >= len(参) {
      print("用法：hmyr self/zip.hmyr --多 <包.zip> <文件...> [--压]" + chr(10))
      return 2
    }
    let 包路 = 参[包位]
    var 本地们 = ()
    var 中心们 = ()
    var 偏移 = 0
    var 计数 = 0
    i = 包位 + 1
    while i < len(参) {
      let p = 参[i]
      if p != "--压" && p != "--多" {
        let r = 成员(p, p, 压, 偏移)
        本地们 = 本地们 + (r.块,)
        中心们 = 中心们 + (r.中心,)
        偏移 = 偏移 + len(r.块)
        计数 = 计数 + 1
      }
      i = i + 1
    }
    var 本地全 = ()
    var 中心全 = ()
    if 计数 > 0 {
      本地全 = 拼平(本地们, 0, 计数)
      中心全 = 拼平(中心们, 0, 计数)
    }
    let 包 = 拼((本地全, 中心全, 尾(计数, len(中心全), 偏移)))
    write_bytes(包路, 包)
    print("收了 " + str(计数) + " 个文件，包 " + str(len(包)) + " 字节" + chr(10))
    return 0
  }
  if len(参) < 3 {
    print("用法：hmyr self/zip.hmyr <成员文件> <包.zip> [--压]" + chr(10))
    print("      hmyr self/zip.hmyr --多 <包.zip> <文件...> [--压]" + chr(10))
    return 2
  }
  let 数据 = read_bytes(参[1])
  let 名 = 参[1]
  var 短名 = ""
  i = 0
  while i < len(名) {
    if 名[i] == "/" || 名[i] == "\\" { 短名 = "" } else { 短名 = 短名 + 名[i] }
    i = i + 1
  }
  let 名们 = 写串(短名)
  let crc = crc32(数据)
  let 原始 = len(数据)
  var 方法 = 0
  var 负载 = 数据
  if 压 {
    方法 = 8
    负载 = 固定压(数据)
  }
  let 压缩 = len(负载)
  let 本地 = 本地头(crc, 压缩, 原始, 名们, 方法)
  let 本地全 = 拼((本地, 负载))
  let 中心 = 一个中心(crc, 压缩, 原始, 名们, 0, 方法)
  let 包 = 拼((本地全, 中心, 尾(1, len(中心), len(本地全))))
  write_bytes(参[2], 包)
  print(短名 + "：" + str(原始) + " → " + str(压缩) + " 字节（方法 " + str(方法) + "），包 " + str(len(包)) + " 字节" + chr(10))
  return 0
}
