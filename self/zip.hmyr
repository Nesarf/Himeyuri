// ZIP 容器：stored 与 deflate 两种成员。用自家写的压缩器与 CRC32，不借 zlib。
//
// 为什么压缩那一段是复制过来的：import 会把两份源码合成一份，而 self/deflate.hmyr
// 与 self/zip.hmyr 各有一个 main —— 合并的规矩是「重名先到者赢」，于是 import 进来的
// 那份 main 会赢，zip 就变成了一个压缩工具。复制一份核心函数是这里最省事的诚实做法，
// 代价是同一个算法有两处；改的时候两处一起改，注释里互相指一下。
//
// 语言里没有位运算，所以 CRC32 只能按位算：异或拆成「逐位比较 + 加权重」。
// 这很慢 —— 所以这一件现在许的承诺是「几 KB 的包」。
//
// 结构（APPNOTE 6.3）；字段一律小端：
//   本地头  50 4b 03 04 · 版本 20 · 标志 0 · 方法（0 stored / 8 deflate）· 时间 0 · 日期 0
//           · CRC · 压缩后 · 原始 · 名长 · 额外长 0 · 名 · 数据
//   中央    50 4b 01 02 · 版本 20 · 需要 20 · 标志 0 · 方法 · 时间 0 · 日期 0
//           · CRC · 压缩后 · 原始 · 名长 · 额外 0 · 注释 0
//           · 盘号 0 · 内部属性 0 · 外部属性 0 · 本地头偏移 · 名
//   尾      50 4b 05 06 · 盘号 0 · 目录起始盘 0 · 本盘条数 1 · 总条数 1
//           · 目录大小 · 目录偏移 · 注释长 0
//
// 用法：hmyr self/zip.hmyr <成员文件> <包.zip> [--压]

// ---- 位与 CRC ----

// 只算低八位的异或：CRC 每字节的那一次「c 与字节异或」只用到低八位，
// 拿 32 位版本去算是白跑二十四轮。
fn 异或8(a: Int, b: Int) -> Int {
  var 出 = 0
  var 倍 = 1
  var x = a % 256
  var y = b % 256
  var i = 0
  while i < 8 {
    let 甲 = x % 2
    let 乙 = y % 2
    if 甲 != 乙 { 出 = 出 + 倍 }
    x = (x - 甲) / 2
    y = (y - 乙) / 2
    倍 = 倍 * 2
    i = i + 1
  }
  return 出
}

fn 异或(a: Int, b: Int) -> Int {
  var 出 = 0
  var 倍 = 1
  var x = a
  var y = b
  var i = 0
  while i < 32 {
    let 甲 = x % 2
    let 乙 = y % 2
    if 甲 != 乙 { 出 = 出 + 倍 }
    x = (x - 甲) / 2
    y = (y - 乙) / 2
    倍 = 倍 * 2
    i = i + 1
  }
  return 出
}

// CRC32 的 256 项查表：每字节两次异或，而不是八次逐位运算。
// 表是常量，写在这里而不是现算 —— 现算一次要两百万次位比较，那和逐位版一样慢。
