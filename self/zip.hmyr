// ZIP 容器：stored 模式（不压缩）。用自家的 deflate 之外的那一半 —— 帧结构。
//
// 为什么先做 stored：打包最先要的是「一个标准工具打得开的包」，而不是压缩率。
// 结构对了，把成员换成 deflate 流只改方法字段与一段数据。
//
// 语言里没有位运算，所以 CRC32 只能按位算：异或拆成「逐位比较 + 加权重」。
// 这很慢 —— 一个 4 KB 的文件要几秒。所以这一件现在许的承诺是「几 KB 的包」，
// 而提速的办法是把异或换成查表，那是下一步。
//
// 结构（APPNOTE 6.3）；字段一律小端：
//   本地头  50 4b 03 04 · 版本 20 · 标志 0 · 方法 0 · 时间 0 · 日期 0
//           · CRC · 压缩后 · 原始 · 名长 · 额外长 0 · 名 · 数据
//   中央    50 4b 01 02 · 版本 20 · 需要 20 · 标志 0 · 方法 0 · 时间 0 · 日期 0
//           · CRC · 压缩后 · 原始 · 名长 · 额外 0 · 注释 0
//           · 盘号 0 · 内部属性 0 · 外部属性 0 · 本地头偏移 · 名
//   尾      50 4b 05 06 · 盘号 0 · 目录起始盘 0 · 本盘条数 1 · 总条数 1
//           · 目录大小 · 目录偏移 · 注释长 0
//
// 用法：hmyr self/zip.hmyr <成员文件> <包.zip>

// 逐位异或：32 位，从低位往上比。慢，但语言里没有别的路。
fn 异或(a: Int, b: Int) -> Int {
  var 出 = 0
  var 倍 = 1
  var x = a
  var y = b
  var i = 0
  while i < 32 {
    let 甲 = x % 2
    let 乙 = y % 2
    if 甲 != 乙 { 出 = 出 + 倍 }
    x = (x - 甲) / 2
    y = (y - 乙) / 2
    倍 = 倍 * 2
    i = i + 1
  }
  return 出
}

fn crc32步(crc: Int, b: Int) -> Int {
  var c = 异或(crc, b)
  var k = 0
  while k < 8 {
    let 奇 = c % 2
    c = (c - 奇) / 2
    if 奇 == 1 { c = 异或(c, 3988292384) }
    k = k + 1
  }
  return c
}

fn crc32(字节们: Int) -> Int {
  var c = 4294967295
  var i = 0
  while i < len(字节们) {
    c = crc32步(c, to_int(字节们[i]))
    i = i + 1
  }
  return 4294967295 - c
}

// 小端写一个数，宽度按字节数。
fn 写短(值: Int, 字节数: Int) {
  var 出 = ()
  var v = 值
  var i = 0
  while i < 字节数 {
    let b = v % 256
    出 = 出 + (b,)
    v = (v - b) / 256
    i = i + 1
  }
  return 出
}

fn 写串(文: String) {
  var 出 = ()
  var i = 0
  while i < len(文) {
    出 = 出 + (ord(文[i]),)
    i = i + 1
  }
  return 出
}

// 把几段字节拼成一段。段数只有十几，每一段本身不复制。
fn 拼(段们: Int) {
  var 出 = ()
  var i = 0
  while i < len(段们) {
    let 段 = 段们[i]
    var j = 0
    while j < len(段) {
      出 = 出 + (to_int(段[j]),)
      j = j + 1
    }
    i = i + 1
  }
  return 出
}

fn 本地头(crc: Int, 大小: Int, 名们: Int) {
  return 拼(((80, 75, 3, 4),
    写短(20, 2), 写短(0, 2), 写短(0, 2), 写短(0, 2), 写短(0, 2),
    写短(crc, 4), 写短(大小, 4), 写短(大小, 4),
    写短(len(名们), 2), 写短(0, 2), 名们))
}

fn 一个中心(crc: Int, 大小: Int, 名们: Int, 偏移: Int) {
  return 拼(((80, 75, 1, 2),
    写短(20, 2), 写短(20, 2), 写短(0, 2), 写短(0, 2), 写短(0, 2), 写短(0, 2),
    写短(crc, 4), 写短(大小, 4), 写短(大小, 4),
    写短(len(名们), 2), 写短(0, 2), 写短(0, 2),
    写短(0, 2), 写短(0, 2), 写短(0, 4), 写短(偏移, 4), 名们))
}

fn 尾(目录大小: Int, 目录偏移: Int) {
  return 拼(((80, 75, 5, 6),
    写短(0, 2), 写短(0, 2), 写短(1, 2), 写短(1, 2),
    写短(目录大小, 4), 写短(目录偏移, 4), 写短(0, 2)))
}

fn main() -> Int effects(file) {
  let 参 = argv()
  if len(参) < 3 {
    print("用法：hmyr self/zip.hmyr <成员文件> <包.zip>" + chr(10))
    return 2
  }
  let 数据 = read_bytes(参[1])
  let 名 = 参[1]
  // 名字取最后一段：ZIP 里的成员名不该带整条路径。
  var 短名 = ""
  var i = 0
  while i < len(名) {
    if 名[i] == "/" || 名[i] == "\\" { 短名 = "" } else { 短名 = 短名 + 名[i] }
    i = i + 1
  }
  let 名们 = 写串(短名)
  let crc = crc32(数据)
  let 大小 = len(数据)
  let 本地 = 本地头(crc, 大小, 名们)
  let 本地全 = 拼((本地, 数据))
  let 中心 = 一个中心(crc, 大小, 名们, 0)
  let 包 = 拼((本地全, 中心, 尾(len(中心), len(本地全))))
  write_bytes(参[2], 包)
  print(短名 + "：" + str(大小) + " 字节，crc " + str(crc) + "，包 " + str(len(包)) + " 字节" + chr(10))
  return 0
}
