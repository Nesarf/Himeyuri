// ZIP 容器：stored 与 deflate 两种成员。用自家写的压缩器与 CRC32，不借 zlib。
//
// 为什么压缩那一段是复制过来的：import 会把两份源码合成一份，而 self/deflate.hmyr
// 与 self/zip.hmyr 各有一个 main —— 合并的规矩是「重名先到者赢」，于是 import 进来的
// 那份 main 会赢，zip 就变成了一个压缩工具。复制一份核心函数是这里最省事的诚实做法，
// 代价是同一个算法有两处；改的时候两处一起改，注释里互相指一下。
//
// 语言里没有位运算，所以 CRC32 只能按位算：异或拆成「逐位比较 + 加权重」。
// 这很慢 —— 所以这一件现在许的承诺是「几 KB 的包」。
//
// 结构（APPNOTE 6.3）；字段一律小端：
//   本地头  50 4b 03 04 · 版本 20 · 标志 0 · 方法（0 stored / 8 deflate）· 时间 0 · 日期 0
//           · CRC · 压缩后 · 原始 · 名长 · 额外长 0 · 名 · 数据
//   中央    50 4b 01 02 · 版本 20 · 需要 20 · 标志 0 · 方法 · 时间 0 · 日期 0
//           · CRC · 压缩后 · 原始 · 名长 · 额外 0 · 注释 0
//           · 盘号 0 · 内部属性 0 · 外部属性 0 · 本地头偏移 · 名
//   尾      50 4b 05 06 · 盘号 0 · 目录起始盘 0 · 本盘条数 1 · 总条数 1
//           · 目录大小 · 目录偏移 · 注释长 0
//
// 用法：hmyr self/zip.hmyr <成员文件> <包.zip> [--压]

// ---- 位与 CRC ----

fn 异或(a: Int, b: Int) -> Int {
  var 出 = 0
  var 倍 = 1
  var x = a
  var y = b
  var i = 0
  while i < 32 {
    let 甲 = x % 2
    let 乙 = y % 2
    if 甲 != 乙 { 出 = 出 + 倍 }
    x = (x - 甲) / 2
    y = (y - 乙) / 2
    倍 = 倍 * 2
    i = i + 1
  }
  return 出
}

fn crc32步(crc: Int, b: Int) -> Int {
  var c = 异或(crc, b)
  var k = 0
  while k < 8 {
    let 奇 = c % 2
    c = (c - 奇) / 2
    if 奇 == 1 { c = 异或(c, 3988292384) }
    k = k + 1
  }
  return c
}

fn crc32(字节们: Int) -> Int {
  var c = 4294967295
  var i = 0
  while i < len(字节们) {
    c = crc32步(c, to_int(字节们[i]))
    i = i + 1
  }
  return 4294967295 - c
}

// ---- 小端与拼接 ----

fn 写短(值: Int, 字节数: Int) {
  var 出 = ()
  var v = 值
  var i = 0
  while i < 字节数 {
    let b = v % 256
    出 = 出 + (b,)
    v = (v - b) / 256
    i = i + 1
  }
  return 出
}

fn 写串(文: String) {
  var 出 = ()
  var i = 0
  while i < len(文) {
    出 = 出 + (ord(文[i]),)
    i = i + 1
  }
  return 出
}

fn 拼(段们: Int) {
  var 出 = ()
  var i = 0
  while i < len(段们) {
    let 段 = 段们[i]
    var j = 0
    while j < len(段) {
      出 = 出 + (to_int(段[j]),)
      j = j + 1
    }
    i = i + 1
  }
  return 出
}

fn 拼平(块们: Int, 起: Int, 止: Int) {
  if 止 - 起 <= 1 { return 块们[起] }
  var 左 = 起
  var 右 = 止
  while 右 - 左 > 2 {
    左 = 左 + 1
    右 = 右 - 1
  }
  let 中 = 左 + 1
  return 拼平(块们, 起, 中) + 拼平(块们, 中, 止)
}

// ---- deflate 的固定 Huffman（与 self/deflate.hmyr 同一份算法） ----

fn 倍(n: Int) -> Int {
  var v = 1
  var i = 0
  while i < n {
    v = v * 2
    i = i + 1
  }
  return v
}

fn 反转位(码: Int, 位数: Int) -> Int {
  var 出 = 0
  var 值 = 码
  var i = 0
  while i < 位数 {
    let 位 = 值 % 2
    出 = 出 * 2 + 位
    值 = (值 - 位) / 2
    i = i + 1
  }
  return 出
}

fn 放位(状: Int, 值: Int, 位数: Int) {
  var 字节们 = 状.字节们
  var 当前 = 状.当前
  var 已 = 状.已
  var v = 值
  var i = 0
  while i < 位数 {
    let 位 = v % 2
    当前 = 当前 + 位 * 倍(已)
    已 = 已 + 1
    if 已 >= 8 {
      字节们 = 字节们 + (当前,)
      当前 = 0
      已 = 0
    }
    v = (v - 位) / 2
    i = i + 1
  }
  return {字节们: 字节们, 当前: 当前, 已: 已}
}

fn 刷(状: Int) {
  var 字节们 = 状.字节们
  if 状.已 > 0 { 字节们 = 字节们 + (状.当前,) }
  return {字节们: 字节们, 已: 0, 当前: 0}
}

fn 符号码(s: Int) -> Int {
  if s <= 143 { return 48 + s }
  if s <= 255 { return 400 + (s - 144) }
  if s <= 279 { return s - 256 }
  return 192 + (s - 280)
}

fn 符号位数(s: Int) -> Int {
  if s <= 143 { return 8 }
  if s <= 255 { return 9 }
  if s <= 279 { return 7 }
  return 8
}

fn 长表() {
  return ((3, 257, 0), (4, 258, 0), (5, 259, 0), (6, 260, 0), (7, 261, 0), (8, 262, 0), (9, 263, 0), (10, 264, 0),
    (11, 265, 1), (13, 266, 1), (15, 267, 1), (17, 268, 1), (19, 269, 2), (23, 270, 2), (27, 271, 2), (31, 272, 2),
    (35, 273, 3), (43, 274, 3), (51, 275, 3), (59, 276, 3), (67, 277, 4), (83, 278, 4), (99, 279, 4), (115, 280, 4),
    (131, 281, 5), (163, 282, 5), (195, 283, 5), (227, 284, 5), (258, 285, 0))
}

fn 距表() {
  return ((1, 0, 0), (2, 1, 0), (3, 2, 0), (4, 3, 0), (5, 4, 1), (7, 5, 1), (9, 6, 2), (13, 7, 2),
    (17, 8, 3), (25, 9, 3), (33, 10, 4), (49, 11, 4), (65, 12, 5), (97, 13, 5), (129, 14, 6), (193, 15, 6),
    (257, 16, 7), (385, 17, 7), (513, 18, 8), (769, 19, 8), (1025, 20, 9), (1537, 21, 9), (2049, 22, 10), (3073, 23, 10),
    (4097, 24, 11), (6145, 25, 11), (8193, 26, 12), (12289, 27, 12), (16385, 28, 13), (24577, 29, 13))
}

fn 查表(表: Int, 值: Int) -> Int {
  var i = len(表) - 1
  while i >= 0 {
    if 表[i][0] <= 值 { return 表[i] }
    i = i - 1
  }
  return 表[0]
}

fn 找匹配(字节们: Int, i: Int) {
  let 总 = len(字节们)
  var 最 = 0
  var 距 = 0
  var 起 = i - 4096
  if 起 < 0 { 起 = 0 }
  var j = 起
  while j < i {
    var 长 = 0
    var 继续 = true
    while 继续 && 长 < 258 && i + 长 < 总 && j + 长 < 总 {
      if 字节们[i + 长] == 字节们[j + 长] { 长 = 长 + 1 } else { 继续 = false }
    }
    if 长 > 最 {
      最 = 长
      距 = i - j
    }
    j = j + 1
  }
  return {长: 最, 距: 距}
}

fn 固定压(字节们: Int) {
  let 总 = len(字节们)
  var 状 = 放位({字节们: (), 当前: 0, 已: 0}, 3, 3)
  var 块们 = ()
  var i = 0
  while i < 总 {
    let 匹 = 找匹配(字节们, i)
    if 匹.长 >= 3 {
      let 长 = 查表(长表(), 匹.长)
      状 = 放位(状, 反转位(符号码(长[1]), 符号位数(长[1])), 符号位数(长[1]))
      if 长[2] > 0 { 状 = 放位(状, 匹.长 - 长[0], 长[2]) }
      let 距 = 查表(距表(), 匹.距)
      状 = 放位(状, 反转位(距[1], 5), 5)
      if 距[2] > 0 { 状 = 放位(状, 匹.距 - 距[0], 距[2]) }
      i = i + 匹.长
    } else {
      let b = to_int(字节们[i])
      状 = 放位(状, 反转位(符号码(b), 符号位数(b)), 符号位数(b))
      i = i + 1
    }
    let 小块 = 状.字节们
    if len(小块) >= 1024 {
      块们 = 块们 + (小块,)
      状 = {字节们: (), 当前: 状.当前, 已: 状.已}
    }
  }
  状 = 放位(状, 0, 7)
  状 = 刷(状)
  let 尾 = 状.字节们
  if len(尾) > 0 { 块们 = 块们 + (尾,) }
  if len(块们) == 0 { return () }
  return 拼平(块们, 0, len(块们))
}

// ---- ZIP 的三段 ----

fn 本地头(crc: Int, 压缩: Int, 原始: Int, 名们: Int, 方法: Int) {
  return 拼(((80, 75, 3, 4),
    写短(20, 2), 写短(0, 2), 写短(方法, 2), 写短(0, 2), 写短(0, 2),
    写短(crc, 4), 写短(压缩, 4), 写短(原始, 4),
    写短(len(名们), 2), 写短(0, 2), 名们))
}

fn 一个中心(crc: Int, 压缩: Int, 原始: Int, 名们: Int, 偏移: Int, 方法: Int) {
  return 拼(((80, 75, 1, 2),
    写短(20, 2), 写短(20, 2), 写短(0, 2), 写短(方法, 2), 写短(0, 2), 写短(0, 2),
    写短(crc, 4), 写短(压缩, 4), 写短(原始, 4),
    写短(len(名们), 2), 写短(0, 2), 写短(0, 2),
    写短(0, 2), 写短(0, 2), 写短(0, 4), 写短(偏移, 4), 名们))
}

fn 尾(目录大小: Int, 目录偏移: Int) {
  return 拼(((80, 75, 5, 6),
    写短(0, 2), 写短(0, 2), 写短(1, 2), 写短(1, 2),
    写短(目录大小, 4), 写短(目录偏移, 4), 写短(0, 2)))
}

fn main() -> Int effects(file) {
  let 参 = argv()
  if len(参) < 3 {
    print("用法：hmyr self/zip.hmyr <成员文件> <包.zip> [--压]" + chr(10))
    return 2
  }
  var 压 = false
  var i = 0
  while i < len(参) {
    if 参[i] == "--压" { 压 = true }
    i = i + 1
  }
  let 数据 = read_bytes(参[1])
  let 名 = 参[1]
  var 短名 = ""
  i = 0
  while i < len(名) {
    if 名[i] == "/" || 名[i] == "\\" { 短名 = "" } else { 短名 = 短名 + 名[i] }
    i = i + 1
  }
  let 名们 = 写串(短名)
  let crc = crc32(数据)
  let 原始 = len(数据)
  var 方法 = 0
  var 负载 = 数据
  if 压 {
    方法 = 8
    负载 = 固定压(数据)
  }
  let 压缩 = len(负载)
  let 本地 = 本地头(crc, 压缩, 原始, 名们, 方法)
  let 本地全 = 拼((本地, 负载))
  let 中心 = 一个中心(crc, 压缩, 原始, 名们, 0, 方法)
  let 包 = 拼((本地全, 中心, 尾(len(中心), len(本地全))))
  write_bytes(参[2], 包)
  print(短名 + "：" + str(原始) + " → " + str(压缩) + " 字节（方法 " + str(方法) + "），包 " + str(len(包)) + " 字节" + chr(10))
  return 0
}
