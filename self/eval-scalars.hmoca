// 标量这十七个内置：求调用 那一大块分派的第六刀。
//
// 为什么单独立一份（2026-11-05）：与前几刀同形 —— 各四五行的参数检查加一次内置调用，
// 只依赖 eval-core.hmoca 里的 好 坏 要效果，交回 {有, 结果}。
//
// 这一组是这门语言最基础的那一层：长度、转换、大小写、取整、顺序。它们一个自定义
// 函数都不调（量过：只用内置），所以整组搬走不带任何依赖。
//
// 名字与 eval-core 里那些不冲突：core 收的是 好 坏 查找到 查找 效在 我的效果 要效果。

引入 "./eval-core.hmoca"

公开 函数 求内置标量(名: String, 值簇: Int, 环境: Int) {
若 名 == "len" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("len 要一个参数")} }
    返回 {有: 真, 结果: 好(len(值簇[0]))}
  }
若 名 == "str" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("str 要一个参数")} }
    返回 {有: 真, 结果: 好(str(值簇[0]))}
  }
若 名 == "slice" {
    若 len(值簇) != 3 { 返回 {有: 真, 结果: 坏("slice 要三个参数")} }
    返回 {有: 真, 结果: 好(slice(值簇[0], 值簇[1], 值簇[2]))}
  }
若 名 == "bytes_to_text" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("bytes_to_text 要一个参数")} }
    返回 {有: 真, 结果: 好(bytes_to_text(值簇[0]))}
  }
若 名 == "to_upper" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("to_upper 要一个参数")} }
    返回 {有: 真, 结果: 好(to_upper(值簇[0]))}
  }
若 名 == "to_lower" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("to_lower 要一个参数")} }
    返回 {有: 真, 结果: 好(to_lower(值簇[0]))}
  }
若 名 == "abs" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("abs 要一个参数")} }
    返回 {有: 真, 结果: 好(abs(值簇[0]))}
  }
若 名 == "floor" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("floor 要一个参数")} }
    返回 {有: 真, 结果: 好(floor(值簇[0]))}
  }
若 名 == "int" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("int 要一个参数")} }
    返回 {有: 真, 结果: 好(int(值簇[0]))}
  }
若 名 == "min" {
    若 len(值簇) < 1 { 返回 {有: 真, 结果: 坏("min 至少要一个参数")} }
    变 小 = 值簇[0]
    变 甲 = 1
    当 甲 < len(值簇) {
      若 值簇[甲] < 小 { 小 = 值簇[甲] }
      甲 = 甲 + 1
    }
    返回 {有: 真, 结果: 好(小)}
  }
若 名 == "max" {
    若 len(值簇) < 1 { 返回 {有: 真, 结果: 坏("max 至少要一个参数")} }
    变 大 = 值簇[0]
    变 乙 = 1
    当 乙 < len(值簇) {
      若 值簇[乙] > 大 { 大 = 值簇[乙] }
      乙 = 乙 + 1
    }
    返回 {有: 真, 结果: 好(大)}
  }
若 名 == "to_int" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("to_int 要一个参数")} }
    返回 {有: 真, 结果: 好(to_int(值簇[0]))}
  }
若 名 == "chr" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("chr 要一个参数")} }
    返回 {有: 真, 结果: 好(chr(值簇[0]))}
  }
若 名 == "ord" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("ord 要一个参数")} }
    返回 {有: 真, 结果: 好(ord(值簇[0]))}
  }
若 名 == "nfc" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("nfc 要一个参数")} }
    返回 {有: 真, 结果: 好(nfc(值簇[0]))}
  }
若 名 == "is_letter" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("is_letter 要一个参数")} }
    返回 {有: 真, 结果: 好(is_letter(值簇[0]))}
  }
若 名 == "is_mark" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("is_mark 要一个参数")} }
    返回 {有: 真, 结果: 好(is_mark(值簇[0]))}
  }
  返回 {有: 假, 结果: 0}
}
