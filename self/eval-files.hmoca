// 文件类的九个内置：读写、目录、标准输入。求调用 里那一大块分派的第一刀。
//
// 为什么单独立一份（2026-11-05）：self/eval.hmoca 的 求调用 一个函数就占五百八十二行，
// 里面八十九条 若 名 == "..."。这九条是其中一组 —— 它们只依赖 eval-core.hmoca 里的
// 好 坏 要效果，所以能整组搬出来而不必反向引入。
//
// 交回 {有, 结果}：有 是「这名内置归我管」，结果是 好(...) 或 坏(...)。
// 求调用 只按顺序问每一组，谁先认领谁处理 —— 于是分派表变成几张小表。

引入 "./eval-core.hmoca"

公开 函数 求内置文件(名: String, 值簇: Int, 环境: Int) {
若 名 == "read_stdin_bytes" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("read_stdin_bytes 要一个参数")} }
    返回 {有: 真, 结果: 好(read_stdin_bytes(值簇[0]))}
  }
若 名 == "read_stdin_line" {
    若 len(值簇) != 0 { 返回 {有: 真, 结果: 坏("read_stdin_line 不要参数")} }
    返回 {有: 真, 结果: 好(read_stdin_line())}
  }
若 名 == "read_line" {
    定 欠行 = 要效果(环境, "file", "read_line")
    若 欠行 != "" { 返回 {有: 真, 结果: 坏(欠行)} }
    若 len(值簇) != 2 { 返回 {有: 真, 结果: 坏("read_line 要两个参数")} }
    返回 {有: 真, 结果: 好(read_line(值簇[0], 值簇[1]))}
  }
若 名 == "read_lines" {
    定 欠项 = 要效果(环境, "file", "read_lines")
    若 欠项 != "" { 返回 {有: 真, 结果: 坏(欠项)} }
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("read_lines 要一个参数")} }
    返回 {有: 真, 结果: 好(read_lines(值簇[0]))}
  }
若 名 == "write_bytes" {
    定 欠写 = 要效果(环境, "file", "write_bytes")
    若 欠写 != "" { 返回 {有: 真, 结果: 坏(欠写)} }
    若 len(值簇) != 2 { 返回 {有: 真, 结果: 坏("write_bytes 要两个参数")} }
    返回 {有: 真, 结果: 好(write_bytes(值簇[0], 值簇[1]))}
  }
若 名 == "read_bytes" {
    定 欠读 = 要效果(环境, "file", "read_bytes")
    若 欠读 != "" { 返回 {有: 真, 结果: 坏(欠读)} }
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("read_bytes 要一个参数")} }
    返回 {有: 真, 结果: 好(read_bytes(值簇[0]))}
  }
若 名 == "read_dir" {
    定 欠列 = 要效果(环境, "file", "read_dir")
    若 欠列 != "" { 返回 {有: 真, 结果: 坏(欠列)} }
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("read_dir 要一个参数")} }
    返回 {有: 真, 结果: 好(read_dir(值簇[0]))}
  }
若 名 == "read_text" {
    定 欠读 = 要效果(环境, "file", "read_text")
    若 欠读 != "" { 返回 {有: 真, 结果: 坏(欠读)} }
    若 len(值簇) < 1 { 返回 {有: 真, 结果: 坏("read_text 至少要一个参数")} }
    若 len(值簇) == 1 { 返回 {有: 真, 结果: 好(read_text(值簇[0]))} }
    返回 {有: 真, 结果: 好(read_text(值簇[0], 值簇[1]))}
  }
若 名 == "write_text" {
    定 欠写 = 要效果(环境, "file", "write_text")
    若 欠写 != "" { 返回 {有: 真, 结果: 坏(欠写)} }
    若 len(值簇) != 2 { 返回 {有: 真, 结果: 坏("write_text 要两个参数")} }
    返回 {有: 真, 结果: 好(write_text(值簇[0], 值簇[1]))}
  }
  返回 {有: 假, 结果: 0}
}
