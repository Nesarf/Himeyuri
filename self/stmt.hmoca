引入 "./chain.hmoca"

// 用 Himeyuri 写的第六件：语句级解析。
//
// 前一件（chain.hmyr）只把**一个表达式**读成树；这一件把它抬到**一行语句**：
//   定 x = <表达式>   -> {kind: "定", name, value}
//   变 x = <表达式>   -> {kind: "变", name, value}
//   返回 <表达式>    -> {kind: "返回", value}
//   返回（不带值）    -> {kind: "返回", value: {kind: "nil"}}
//     用 空 节点而不是空元组：空元组是一个**值**，而「没有值」不是值。两者混在一起，
//     求值器就分不清 len 该不该收它。
//   <表达式>           -> {kind: "表达式语句", value}
// 认不出来时给 {kind: "误", text}，不猜。
//
// 依赖是明写的：表达式那一层在 chain.hmyr 里，加载器会顺着它把 lex.hmyr 也带进来。
// 关键字在词法里都是 ident（这条边界写在 lex.hmyr 的文件头），所以这里用 text 判断。

公开 函数 is_word(t: Int, w: String) -> Bool {
  返回 t.kind == "ident" && t.text == w
}

// 从第 i 个 token 起，交给链的最外层继续读。
// 最外层是逻辑那两级（|| 与 &&）—— 用 compare 会漏掉它们，
// 而漏掉的样子是「语法层报的错：若」。
函数 from_here(tokens: Int, i: Int) -> Int {
  返回 logic(tokens, i)
}

函数 binding(tokens: Int, i: Int, keyword: String) {
  定 位 = tokens[i]
  若 i + 2 >= len(tokens) {
    返回 {node: {kind: "误", text: keyword, line: 位.line, column: 位.column}, next: i}
  }
  定 name = tokens[i + 1]
  定 sign = tokens[i + 2]
  若 name.kind != "ident" || sign.kind != "punct" || sign.text != "=" {
    返回 {node: {kind: "误", text: keyword + " " + name.text, line: 位.line, column: 位.column}, next: i + 1}
  }
  定 got = from_here(tokens, i + 3)
  若 keyword == "let" {
    返回 {node: {kind: "定", name: name.text, value: got.node, line: 位.line, column: 位.column}, next: got.next}
  }
  返回 {node: {kind: "变", name: name.text, value: got.node, line: 位.line, column: 位.column}, next: got.next}
}

函数 statement(tokens: Int, i: Int) {
  若 i >= len(tokens) {
    返回 {node: {kind: "误", text: "", line: 0, column: 0}, next: i}
  }
  定 t = tokens[i]
  若 is_word(t, "let") || is_word(t, "var") {
    返回 binding(tokens, i, t.text)
  }
  若 is_word(t, "if") { 返回 parse_if(tokens, i + 1) }
  若 is_word(t, "while") { 返回 parse_while(tokens, i + 1) }
  若 is_word(t, "return") {
    若 i + 1 >= len(tokens) {
      返回 {node: {kind: "返回", value: {kind: "nil"}, line: t.line, column: t.column}, next: i + 1}
    }
    // 返回 之后可能先有一个换行，然后是跨行的表达式（返回 ( 换行 元素... ））。
    定 got = from_here(tokens, skip_newlines(tokens, i + 1))
    返回 {node: {kind: "返回", value: got.node, line: t.line, column: t.column}, next: got.next}
  }
  定 got = from_here(tokens, i)
  // 赋值是语句而不是表达式：形状是「裸名字 = 表达式」。
  // 词法把 = 与 == 留成不同的 token，所以比较不会被误读成赋值。
  若 got.node.kind == "名" && got.next < len(tokens) && is_punct(tokens[got.next], "=") {
    定 value = from_here(tokens, got.next + 1)
    返回 {node: {kind: "赋值", name: got.node.text, value: value.node, line: got.node.line, column: got.node.column}, next: value.next}
  }
  返回 {node: {kind: "表达式语句", value: got.node, line: t.line, column: t.column}, next: got.next}
}

// 跳过换行：块内的语句之间有换行，它们只是分隔，不是内容。
函数 skip_newlines(tokens: Int, i: Int) -> Int {
  若 i < len(tokens) && tokens[i].kind == "newline" { 返回 skip_newlines(tokens, i + 1) }
  返回 i
}

// 一个花括号块：逐条读语句，直到右花括号。每条语句各自独立递归，所以深度是「块内语句数」与
// 「单条语句的深度」相加，不是相乘。
函数 block(tokens: Int, i: Int) {
  定 at = skip_newlines(tokens, i)
  若 at >= len(tokens) { 返回 {list: (), next: at} }
  若 is_punct(tokens[at], "}") { 返回 {list: (), next: at + 1} }
  定 one = statement(tokens, at)
  定 rest = block(tokens, one.next)
  返回 {list: (one.node,) + rest.list, next: rest.next}
}

// 若：条件是一个表达式，然后是一个块，可选 否则（块或单条语句）。
函数 parse_if(tokens: Int, i: Int) {
  // 「若 这个节点在哪」= 若 关键字在哪。调用方传进来的是关键字之后那一位，
  // 所以往回看一格；位置与宿主那边同一个规矩（If 记关键字的位置）。
  变 位 = tokens[0]
  若 i > 0 { 位 = tokens[i - 1] }
  定 cond = from_here(tokens, i)
  定 at = skip_newlines(tokens, cond.next)
  若 at >= len(tokens) || !is_punct(tokens[at], "{") {
    返回 {node: {kind: "误", text: "if", line: 位.line, column: 位.column}, next: at}
  }
  定 then = block(tokens, at + 1)
  变 otherwise = ()
  变 next = skip_newlines(tokens, then.next)
  若 next < len(tokens) && is_word(tokens[next], "else") {
    定 e = skip_newlines(tokens, next + 1)
    若 e < len(tokens) && is_punct(tokens[e], "{") {
      定 other = block(tokens, e + 1)
      otherwise = other.list
      next = other.next
    } 否则 {
      定 one = statement(tokens, e)
      otherwise = (one.node,)
      next = one.next
    }
  }
  返回 {node: {kind: "若", cond: cond.node, then: then.list, otherwise: otherwise, line: 位.line, column: 位.column}, next: next}
}

// 当：条件是一个表达式，然后是一个块。
// 与 若 相比它没有 否则——而「什么时候停」由条件说，这一层不管。
函数 parse_while(tokens: Int, i: Int) {
  变 位 = tokens[0]
  若 i > 0 { 位 = tokens[i - 1] }
  定 cond = from_here(tokens, i)
  定 at = skip_newlines(tokens, cond.next)
  若 at >= len(tokens) || !is_punct(tokens[at], "{") {
    返回 {node: {kind: "误", text: "while", line: 位.line, column: 位.column}, next: at}
  }
  定 body = block(tokens, at + 1)
  返回 {node: {kind: "当", cond: cond.node, body: body.list, line: 位.line, column: 位.column}, next: body.next}
}

// 宿主入口：读一条语句。
公开 函数 parse_statement(tokens: Int) -> Int {
  返回 statement(tokens, 0)
}

函数 main() -> Int {
  // 手工造几个 token，验证最小的一步能走
  定 tokens = ({kind: "ident", text: "let"}, {kind: "ident", text: "x"}, {kind: "punct", text: "="}, {kind: "int", text: "7"})
  定 one = parse_statement(tokens)
  print(one.node.kind)
  print(one.node.name)
  返回 0
}
