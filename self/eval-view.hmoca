// 视图这四个内置：bytes_view、view_len、view_get、view_set。
//
// 为什么单独立一份（2026-11-05）：求调用 那一大块分派的第七刀。与前面几刀同形 ——
// 只依赖 eval-core.hmoca 里的 好 坏 要效果，交回 {有, 结果}。
//
// 它们在自举层里是唯一一块「一段只读窗口」的实现：窗口指向源而不拥有源，长度与取值都走它。

引入 "./eval-core.hmoca"

公开 函数 求内置视图(名: String, 值簇: Int, 环境: Int) {
若 名 == "bytes_view" {
    若 len(值簇) != 3 { 返回 {有: 真, 结果: 坏("bytes_view 要三个参数")} }
    定 源 = 值簇[0]
    定 起 = to_int(值簇[1])
    定 长 = to_int(值簇[2])
    若 起 < 0 || 长 < 0 || 起 + 长 > len(源) {
      返回 {有: 真, 结果: 坏("HMYR-行-018 bytes_view: 范围在外面（" + str(len(源)) + "）")}
    }
    定 窗 = index_new()
    index_set(窗, "kind", "view")
    index_set(窗, "源", 源)
    index_set(窗, "起", 起)
    index_set(窗, "长", 长)
    返回 {有: 真, 结果: 好(窗)}
  }
若 名 == "view_len" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("view_len 要一个参数")} }
    若 index_has(值簇[0], "kind") == 假 { 返回 {有: 真, 结果: 坏("HMYR-行-019 view_len: 这不是窗口")} }
    若 index_get(值簇[0], "kind") != "view" { 返回 {有: 真, 结果: 坏("HMYR-行-019 view_len: 这不是窗口")} }
    返回 {有: 真, 结果: 好(index_get(值簇[0], "长"))}
  }
若 名 == "view_get" {
    若 len(值簇) != 2 { 返回 {有: 真, 结果: 坏("view_get 要两个参数")} }
    若 index_has(值簇[0], "kind") == 假 { 返回 {有: 真, 结果: 坏("HMYR-行-019 view_get: 这不是窗口")} }
    若 index_get(值簇[0], "kind") != "view" { 返回 {有: 真, 结果: 坏("HMYR-行-019 view_get: 这不是窗口")} }
    定 长 = index_get(值簇[0], "长")
    定 i = to_int(值簇[1])
    若 i < 0 || i >= 长 { 返回 {有: 真, 结果: 坏("HMYR-行-018 view_get: " + str(i) + " 在窗口外面（" + str(长) + "）")} }
    定 源 = index_get(值簇[0], "源")
    返回 {有: 真, 结果: 好(源[index_get(值簇[0], "起") + i])}
  }
若 名 == "view_set" {
    若 len(值簇) != 3 { 返回 {有: 真, 结果: 坏("view_set 要三个参数")} }
    若 index_has(值簇[0], "kind") == 假 { 返回 {有: 真, 结果: 坏("HMYR-行-019 view_set: 这不是窗口")} }
    若 index_get(值簇[0], "kind") != "view" { 返回 {有: 真, 结果: 坏("HMYR-行-019 view_set: 这不是窗口")} }
    定 长 = index_get(值簇[0], "长")
    定 i = to_int(值簇[1])
    若 i < 0 || i >= 长 { 返回 {有: 真, 结果: 坏("HMYR-行-019 view_set: " + str(i) + " 在窗口外面（" + str(长) + "）")} }
    定 源 = index_get(值簇[0], "源")
    定 位 = index_get(值簇[0], "起") + i
    // 写进源。源不可写时由 设() 那一层判（HMYR-行-018）—— 这一层看不见它的判据，
    // 所以那一侧在这里没有同一句话可给：source-not-writable 在自举层是「设() 报错」。
    设(源, 位, 值簇[2])
    返回 {有: 真, 结果: 好(值簇[2])}
  }
  返回 {有: 假, 结果: 0}
}
