// 输出这两个内置：print 与 print_err。求调用 那一大块分派的第八刀。
//
// 为什么单独立一份（2026-11-05）：与前面几刀同形 —— 只依赖 eval-core.hmoca 里的
// 好 坏 要效果，交回 {有, 结果}。
//
// 这一刀还有一个额外的作用：它是「按文件扫的判据已经收好了」的证明 ——
// 搬它的时候，builtin-gap、stdin-line、embed-hmyr 三份都没有改一个字。

引入 "./eval-core.hmoca"

公开 函数 求内置输出(名: String, 值簇: Int, 环境: Int) {
若 名 == "print" {
    变 出文 = ""
    变 i = 0
    当 i < len(值簇) {
      出文 = 出文 + str(值簇[i])
      i = i + 1
    }
    print(出文)
    返回 {有: 真, 结果: 好(())}
  }
若 名 == "print_err" {
    定 欠错 = 要效果(环境, "process", "print_err")
    若 欠错 != "" { 返回 {有: 真, 结果: 坏(欠错)} }
    变 错文 = ""
    变 j = 0
    当 j < len(值簇) {
      错文 = 错文 + str(值簇[j])
      j = j + 1
    }
    print_err(错文)
    返回 {有: 真, 结果: 好(())}
  }
  返回 {有: 假, 结果: 0}
}
