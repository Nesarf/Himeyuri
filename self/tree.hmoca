// 只建树：输入文件，打印字长与距长的码长分布、最大树深、Kraft 和。
// 不写流。动态 Huffman 卡了三轮，都是「写完整个编码器再看解码器脸色」；
// 这个工具把那件事拆成可以逐个核对的小问题。
//
// Kraft 和用 2^15 为单位：Σ 2^(15-长度) 必须恰好是 32768（即 Σ 2^-长度 = 1）。
//
// 用法：hmyr self/tree.hmyr <文件>

函数 倍(n: Int) -> Int {
  变 v = 1
  变 i = 0
  当 i < n {
    v = v * 2
    i = i + 1
  }
  返回 v
}

函数 置(元组: Int, 下标: Int, 值: Int) -> Int {
  变 出 = ()
  变 i = 0
  当 i < len(元组) {
    若 i == 下标 { 出 = 出 + (值,) } 否则 { 出 = 出 + (to_int(元组[i]),) }
    i = i + 1
  }
  返回 出
}

函数 长表() {
  返回 ((3, 257, 0), (4, 258, 0), (5, 259, 0), (6, 260, 0), (7, 261, 0), (8, 262, 0), (9, 263, 0), (10, 264, 0),
    (11, 265, 1), (13, 266, 1), (15, 267, 1), (17, 268, 1), (19, 269, 2), (23, 270, 2), (27, 271, 2), (31, 272, 2),
    (35, 273, 3), (43, 274, 3), (51, 275, 3), (59, 276, 3), (67, 277, 4), (83, 278, 4), (99, 279, 4), (115, 280, 4),
    (131, 281, 5), (163, 282, 5), (195, 283, 5), (227, 284, 5), (258, 285, 0))
}

函数 距表() {
  返回 ((1, 0, 0), (2, 1, 0), (3, 2, 0), (4, 3, 0), (5, 4, 1), (7, 5, 1), (9, 6, 2), (13, 7, 2),
    (17, 8, 3), (25, 9, 3), (33, 10, 4), (49, 11, 4), (65, 12, 5), (97, 13, 5), (129, 14, 6), (193, 15, 6),
    (257, 16, 7), (385, 17, 7), (513, 18, 8), (769, 19, 8), (1025, 20, 9), (1537, 21, 9), (2049, 22, 10), (3073, 23, 10),
    (4097, 24, 11), (6145, 25, 11), (8193, 26, 12), (12289, 27, 12), (16385, 28, 13), (24577, 29, 13))
}

函数 查表(表: Int, 值: Int) -> Int {
  变 i = len(表) - 1
  当 i >= 0 {
    若 表[i][0] <= 值 { 返回 表[i] }
    i = i - 1
  }
  返回 表[0]
}

函数 找匹配(字节串: Int, i: Int) {
  定 总 = len(字节串)
  变 最 = 0
  变 距 = 0
  变 起 = i - 4096
  若 起 < 0 { 起 = 0 }
  变 j = 起
  当 j < i {
    变 长 = 0
    变 继续 = 真
    当 继续 && 长 < 258 && i + 长 < 总 && j + 长 < 总 {
      若 字节串[i + 长] == 字节串[j + 长] { 长 = 长 + 1 } 否则 { 继续 = 假 }
    }
    若 长 > 最 {
      最 = 长
      距 = i - j
    }
    j = j + 1
  }
  返回 {长: 最, 距: 距}
}

函数 切块(字节串: Int) {
  变 列 = ()
  变 i = 0
  当 i < len(字节串) {
    定 匹 = 找匹配(字节串, i)
    若 匹.长 >= 3 {
      列 = 列 + ({类: 1, 长: 匹.长, 距: 匹.距},)
      i = i + 匹.长
    } 否则 {
      列 = 列 + ({类: 0, 值: to_int(字节串[i])},)
      i = i + 1
    }
  }
  返回 列
}

函数 统计(列: Int) {
  变 字频 = ()
  变 i = 0
  当 i < 286 {
    字频 = 字频 + (0,)
    i = i + 1
  }
  变 距频 = ()
  i = 0
  当 i < 30 {
    距频 = 距频 + (0,)
    i = i + 1
  }
  i = 0
  当 i < len(列) {
    定 t = 列[i]
    若 t.类 == 0 {
      字频 = 置(字频, t.值, to_int(字频[t.值]) + 1)
    } 否则 {
      定 长码 = 查表(长表(), t.长)
      字频 = 置(字频, 长码[1], to_int(字频[长码[1]]) + 1)
      定 距码 = 查表(距表(), t.距)
      距频 = 置(距频, 距码[1], to_int(距频[距码[1]]) + 1)
    }
    i = i + 1
  }
  字频 = 置(字频, 256, to_int(字频[256]) + 1)
  // 距离表至少要有一个码：没有匹配时它是空的，而空表是非法码集。
  // 给它一个不用的距离码 0（不会实际编码任何东西，只是把表撑完整）。
  若 to_int(距频[0]) == 0 { 距频 = 置(距频, 0, 1) }
  返回 {字频: 字频, 距频: 距频}
}

// 建树取码长：频 0 的符号不进树。返回的码长是「到根的边数」。
函数 码长簇(频簇: Int) {
  变 权 = ()
  变 父 = ()
  变 活 = ()
  变 i = 0
  当 i < len(频簇) {
    权 = 权 + (to_int(频簇[i]),)
    父 = 父 + (0 - 1,)
    若 to_int(频簇[i]) > 0 { 活 = 活 + (i,) }
    i = i + 1
  }
  // 单符号特例：一个符号的树深度是 1（RFC 要求它用一位码，不是零位）。
  若 len(活) == 1 {
    变 只 = ()
    i = 0
    当 i < len(频簇) {
      若 i == to_int(活[0]) { 只 = 只 + (1,) } 否则 { 只 = 只 + (0,) }
      i = i + 1
    }
    返回 只
  }
  当 len(活) > 1 {
    变 甲 = 0 - 1
    变 乙 = 0 - 1
    变 甲权 = 0 - 1
    变 乙权 = 0 - 1
    变 k = 0
    当 k < len(活) {
      定 号 = to_int(活[k])
      定 w = to_int(权[号])
      若 甲权 < 0 || w < 甲权 {
        乙 = 甲
        乙权 = 甲权
        甲 = 号
        甲权 = w
      } 否则 若 乙权 < 0 || w < 乙权 {
        乙 = 号
        乙权 = w
      }
      k = k + 1
    }
    定 新 = len(权)
    权 = 权 + (甲权 + 乙权,)
    父 = 父 + (0 - 1,)
    父 = 置(父, 甲, 新)
    父 = 置(父, 乙, 新)
    变 新活 = ()
    k = 0
    当 k < len(活) {
      定 号 = to_int(活[k])
      若 号 != 甲 && 号 != 乙 { 新活 = 新活 + (号,) }
      k = k + 1
    }
    活 = 新活 + (新,)
  }
  变 长簇 = ()
  i = 0
  当 i < len(频簇) {
    变 深 = 0
    若 to_int(频簇[i]) > 0 {
      变 号 = i
      当 to_int(父[号]) >= 0 {
        深 = 深 + 1
        号 = to_int(父[号])
      }
    }
    长簇 = 长簇 + (深,)
    i = i + 1
  }
  返回 长簇
}

函数 看一份(名: String, 长簇: Int) {
  变 和 = 0
  变 最 = 0
  变 用 = 0
  变 i = 0
  当 i < len(长簇) {
    定 l = to_int(长簇[i])
    若 l > 0 {
      用 = 用 + 1
      若 l > 最 { 最 = l }
      若 l <= 15 { 和 = 和 + 倍(15 - l) }
    }
    i = i + 1
  }
  print(名 + "：符号 " + str(用) + " 个，最大深 " + str(最) + "，Kraft 和 " + str(和) + "（要 32768）" + chr(10))
  变 j = 0
  变 前 = ""
  当 j < len(长簇) && j < 24 {
    定 l = to_int(长簇[j])
    若 l > 0 { 前 = 前 + " " + str(j) + ":" + str(l) }
    j = j + 1
  }
  print("  前几个有码的符号（下标:码长）：" + 前 + chr(10))
  返回 0
}

// 验「码长码表」：把 316 个码长值（0-15）各自出现几次当频率，再建一棵十九项的表。
// zlib 拒的是这一层，而它不是数据段的树。
函数 看码长表(字长: Int, 距长: Int) {
  变 全长 = ()
  变 i = 0
  当 i < len(字长) {
    全长 = 全长 + (to_int(字长[i]),)
    i = i + 1
  }
  i = 0
  当 i < len(距长) {
    全长 = 全长 + (to_int(距长[i]),)
    i = i + 1
  }
  变 频 = ()
  i = 0
  当 i < 16 {
    频 = 频 + (0,)
    i = i + 1
  }
  i = 0
  当 i < len(全长) {
    定 l = to_int(全长[i])
    频 = 置(频, l, to_int(频[l]) + 1)
    i = i + 1
  }
  定 码长16 = 码长簇(频)
  变 码长19 = ()
  i = 0
  当 i < 19 {
    若 i < len(码长16) { 码长19 = 码长19 + (to_int(码长16[i]),) } 否则 { 码长19 = 码长19 + (0,) }
    i = i + 1
  }
  看一份("码长码表（19 项，按符号 0-18 排）", 码长19)
  返回 0
}

// 验「写码长层」：写符号时，若某个码长值在码长码表里没有码，那一笔会被静默跳过 ——
// 位流从此错位，而症状会出现在 zlib 的「码长集非法」上。这里把「漏写」数出来。
函数 验写层(字长: Int, 距长: Int) {
  变 全长 = ()
  变 i = 0
  当 i < len(字长) {
    全长 = 全长 + (to_int(字长[i]),)
    i = i + 1
  }
  i = 0
  当 i < len(距长) {
    全长 = 全长 + (to_int(距长[i]),)
    i = i + 1
  }
  变 频 = ()
  i = 0
  当 i < 16 {
    频 = 频 + (0,)
    i = i + 1
  }
  i = 0
  当 i < len(全长) {
    定 l = to_int(全长[i])
    频 = 置(频, l, to_int(频[l]) + 1)
    i = i + 1
  }
  定 码长16 = 码长簇(频)
  变 码长19 = ()
  i = 0
  当 i < 19 {
    若 i < len(码长16) { 码长19 = 码长19 + (to_int(码长16[i]),) } 否则 { 码长19 = 码长19 + (0,) }
    i = i + 1
  }
  变 漏 = 0
  变 位 = 0
  i = 0
  当 i < len(全长) {
    定 v = to_int(全长[i])
    定 l = to_int(码长19[v])
    若 l == 0 {
      漏 = 漏 + 1
      若 漏 <= 5 { print("  漏写：码长值 " + str(v) + "（在码长码表里没有码）" + chr(10)) }
    } 否则 {
      位 = 位 + l
    }
    i = i + 1
  }
  print("写码长层：316 个码长共用 " + str(位) + " 位，漏写 " + str(漏) + " 个" + chr(10))
  返回 0
}

函数 main() -> Int 效果串(file) {
  定 参 = argv()
  若 len(参) < 2 {
    print("用法：hmyr self/tree.hmyr <文件>" + chr(10))
    返回 2
  }
  定 字节串 = read_bytes(参[1])
  print("输入 " + str(len(字节串)) + " 字节" + chr(10))
  定 列 = 切块(字节串)
  print("切出 " + str(len(列)) + " 个 token" + chr(10))
  定 频 = 统计(列)
  定 字长 = 码长簇(频.字频)
  定 距长 = 码长簇(频.距频)
  看一份("字长", 字长)
  看一份("距长", 距长)
  看码长表(字长, 距长)
  验写层(字长, 距长)
  返回 0
}
