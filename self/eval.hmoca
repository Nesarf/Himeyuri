// 用 Himeyuri 写的求值器：吃 self/chain.hmyr 造出来的节点，交回一个值。
//
// 这是自举的最后一格。词法（lex）、语法（chain、stmt）、语句（body）都在 self/ 里了，
// 缺的就是「把节点算成值」。这一件立起来之后，一段源码可以由 Himeyuri 自己读、
// 自己解析、自己求值——宿主只剩下「起它」这一件事。
//
// 节点形状（由 self/chain.hmyr 与 self/stmt.hmyr 定义）：
//   {kind: "int" | "num", text}      整数（原文）
//   {kind: "Literal", type: "string", text}              字符串
//   {kind: "Ident", text}             标识符
//   {kind: "Binary", op, left, right}
//   {kind: "Unary", op, operand}
//   {kind: "Call", callee, args}
//   {kind: "Index", target, index}
//   {kind: "Field", target, name}
//   {kind: "Tuple", items}
//   {kind: "Record", fields}
//   {kind: "Error", text}
//
// 环境是键值对的元组（与 json.hmyr 那边同一个表示）：记录的字段名必须是标识符，
// 而环境里的名字来自程序本身，所以用对表。
//
// 结果统一包成 {ok: true, value} 或 {ok: false, text}——这样错误一路往上走，
// 不会被当成一个值参与计算。这一点比「返回特殊值」可靠。

fn 好(v: Int) {
  return {ok: true, value: v}
}

fn 坏(t: String) {
  return {ok: false, text: t}
}

// 查环境从后往前：后定义要覆盖先定义。正着找会拿到旧值，那是个安静的错。
fn 查找到(环境: Int, 名: String, i: Int) {
  if i < 0 { return {found: false, value: ()} }
  if 环境[i][0] == 名 { return {found: true, value: 环境[i][1]} }
  return 查找到(环境, 名, i - 1)
}

fn 查找(环境: Int, 名: String) -> Int {
  return 查找到(环境, 名, len(环境) - 1)
}

// 一条记录的字段名拼成一行，用在诊断里。
fn 名字们(t: Int) -> String {
  let 列 = field_names(t)
  var 出 = ""
  var i = 0
  while i < len(列) {
    出 = 出 + 列[i] + ","
    i = i + 1
  }
  return 出
}

fn 求二元(op: String, a: Int, b: Int) -> Int {
  if a.ok == false { return a }
  if b.ok == false { return b }
  let x = a.value
  let y = b.value
  if op == "+" { return 好(x + y) }
  if op == "-" { return 好(x - y) }
  if op == "*" { return 好(x * y) }
  if op == "/" { return 好(x / y) }
  if op == "%" { return 好(x % y) }
  if op == "==" { return 好(x == y) }
  if op == "!=" { return 好(x != y) }
  if op == "<" { return 好(x < y) }
  if op == "<=" { return 好(x <= y) }
  if op == ">" { return 好(x > y) }
  if op == ">=" { return 好(x >= y) }
  // 逻辑两级。短路在 求值 的 Binary 分支里做（2026-11-01 补）：
  // 那里先求左边，有结论就不再求右边 —— 所以进到这里的两个操作数都已经求过了。
  // 这一层保留两条完整分支当防御：若哪天短路那一层被简化掉，这里仍然给出正确的值。
  // （原地那句话是「这里不短路」，而它让整个词法器的边界检查失效 ——
  //   见 design/BOARD.txt 第三十五节，以及 test/launcher.test.mjs 里那两条判据。）
  if op == "&&" {
    if x == false { return 好(false) }
    if y == false { return 好(false) }
    return 好(true)
  }
  if op == "||" {
    if x == false {
      if y == false { return 好(false) }
    }
    return 好(true)
  }
  // 走到这里说明链那一层交来的 op 不是它写的那些字符串之一。
  // 若它是一个节点记录，把它的 kind 说出来 —— 「[object Object]」什么都不告诉人，
  // 而 kind 至少能指认「原来这里是个调用 / 一个数 / 一个名字」。
  if field_has(op, "kind") { return 坏("不认识的运算符：一个 " + op.kind + " 节点") }
  if field_has(op, "op") { return 坏("不认识的运算符：一个自己带 op 的记录，它的 op 是 " + op.op) }
  if field_has(op, "name") { return 坏("不认识的运算符：一个带 name 的记录，名字是 " + op.name) }
  if field_has(op, "value") { return 坏("不认识的运算符：一个带 value 的记录，字段是 " + 名字们(op)) }
  return 坏("不认识的运算符：" + op)
}

fn 求一元(op: String, a: Int) -> Int {
  if a.ok == false { return a }
  if op == "-" { return 好(0 - a.value) }
  if op == "!" { return 好(!a.value) }
  return 坏("不认识的一元运算符：" + op)
}

// 一次性把参数都求出来。任一参数出错就整体出错——不跳过、不补默认值。
fn 求参数从(节点们: Int, 环境: Int, i: Int, acc: Int) -> Int {
  if i >= len(节点们) { return 好(acc) }
  let 一个 = 求值(节点们[i], 环境)
  if 一个.ok == false { return 一个 }
  return 求参数从(节点们, 环境, i + 1, acc + (一个.value,))
}

fn 求参数(节点们: Int, 环境: Int) -> Int {
  return 求参数从(节点们, 环境, 0, ())
}

// 调用：先认两个内置（len、str），再查环境里的函数表。
//
// 函数表放在环境里，名字加前缀 "fn:"——这样不必给求值、执行这些函数加参数，
// 而递归也自然成立：函数体在同一个环境里跑，它看得见自己。
//
// 这一版是**动态作用域**（被调函数看得见调用者的局部名字），不是词法作用域。
// 先这样，因为真正的词法作用域要等闭包那一层；这一点写在明处，不装作已经是词法作用域。
// 一个效果名在不在这一串里。
fn 效在(效们: Int, 名: String, i: Int) -> Bool {
  if i >= len(效们) { return false }
  if 效们[i] == 名 { return true }
  return 效在(效们, 名, i + 1)
}

// 交回第一个缺的效果名；一个也不缺就交回空串。
fn 缺效果从(要的: Int, 有的: Int, i: Int) -> String {
  if i >= len(要的) { return "" }
  // realtime 是档位，不是权限 —— 它不沿调用链传（design/MEMORY.txt 第 3 节那处将就）。
  // 传下去的话，每个调用实时函数的人都要声明自己也在实时档位上，而那不是真的。
  if 要的[i] == "realtime" { return 缺效果从(要的, 有的, i + 1) }
  if 效在(有的, 要的[i], 0) == false { return 要的[i] }
  return 缺效果从(要的, 有的, i + 1)
}

fn 缺效果(要的: Int, 有的: Int) -> String {
  return 缺效果从(要的, 有的, 0)
}

// 当前函数有哪些效果：环境里那个 "效果" 键，由调用的那一层放进来。
// 没有就是空 —— 顶层没写 effects(...) 就是不要任何效果。
fn 我的效果(环境: Int) {
  let r = 查找(环境, "效果")
  if r.found { return r.value }
  return ()
}

// 一个内置要的效果够不够。够就交回空串，不够就交回那句话。
fn 要效果(环境: Int, 效: String, 名: String) -> String {
  if 效在(我的效果(环境), 效, 0) { return "" }
  return "HMYR-內-001 " + 名 + " 要 " + 效 + " 效果，而调用它的函数没有声明"
}

// ---- 区：三区模型在自举层的那一半 ----
//
// 区与块都用索引表示，因为它们是**要变**的东西：close 之后块就该死了。
// 记录在这门语言里不可变，装不了这种状态；索引是宿主给的可变容器
// （index_set 交回同一个索引，见 design/INDEX.txt 与 index 那一组内置）。
// 索引这一组在七处内置表里本来就齐，所以这一层没有新加任何内置。
//
// 一个区：{"种": "区", "关": 0/1, "下一个": 下一块号, "活": 活着的块数, "块1": 块, ...}
// 一个块：{"种": "块", "zone": "arena"/"managed", "size": 字节数, "live": 0/1, "号": 块号}
//
// 「这是不是区或块」用 index_has(x, "种") 判：它对任何值都安全 —— 不是索引就交回 false，
// 记录也交回 false（记录不是 Map，见 src/eval.mjs 的 index_has）。所以不必另加 is_index。
//
// 与宿主那一份（src/eval.mjs 的 arena）的差别只有表示：那边是 JS 对象，这边是索引。
// 判据是「两台机器的判词一样」，不是「两台机器的内部一样」。

// 每 每组 位插一个逗号，只动整数部分。
// 三条规矩：分组看档案、小数点是句点、负号前置 —— 所以它只改整数部分的分隔符。
fn 加千分位(文: String, 每组: Int) -> String {
  var 负 = false
  var 体 = 文
  if len(文) > 0 && slice(文, 0, 1) == "-" {
    负 = true
    // slice 的第三个参数是「止」不是「长」—— 写成 len(文) - 1 会吃掉最后一位，
    // 而那正是第一版的样子（-1234567 变成了 -12,3456）。
    体 = slice(文, 1, len(文))
  }
  let 点 = 找点从(体, 0)
  var 整 = 体
  var 尾 = ""
  if 点 >= 0 {
    整 = slice(体, 0, 点)
    尾 = slice(体, 点, len(体))
  }
  var 出 = ""
  var i = 0
  while i < len(整) {
    if i > 0 {
      if (len(整) - i) % 每组 == 0 { 出 = 出 + "," }
    }
    出 = 出 + 整[i]
    i = i + 1
  }
  if 负 { return "-" + 出 + 尾 }
  return 出 + 尾
}

fn 找点从(体: String, i: Int) -> Int {
  if i >= len(体) { return 0 - 1 }
  if 体[i] == "." { return i }
  return 找点从(体, i + 1)
}

fn 新区() -> Int {
  let 区 = index_new()
  index_set(区, "种", "区")
  index_set(区, "关", 0)
  index_set(区, "下一个", 1)
  index_set(区, "活", 0)
  return 区
}

// 一个持有格：只装零个或一个值，取出即转移（design/MEMORY.txt 第 2 节）。
// 取出之后 装 变回 0，于是「两处都声称拥有它」在运行期不成立。
fn 新持有格() -> Int {
  let 格 = index_new()
  index_set(格, "kind", "owner")
  index_set(格, "装", 0)
  index_set(格, "值", ())
  index_set(格, "关", 0)
  return 格
}

fn 分配块(区: Int, 大小: Int) -> Int {
  if index_get(区, "关") != 0 { return 坏("HMYR-碼-002 arena.alloc: that arena is already closed") }
  let 号 = index_get(区, "下一个")
  let 块 = index_new()
  index_set(块, "种", "块")
  index_set(块, "kind", "block")
  index_set(块, "zone", "arena")
  index_set(块, "size", 大小)
  index_set(块, "live", 1)
  index_set(块, "号", 号)
  // 块的格子：按下标的可变内容。没有它，块只有大小，于是「把值放进区里」写不出来 ——
  // 而那也是区一直只能记账的理由。
  index_set(块, "格", index_new())
  index_set(区, "块" + str(号), 块)
  index_set(区, "下一个", 号 + 1)
  index_set(区, "活", index_get(区, "活") + 1)
  return 好(块)
}

// 关区：把它名下的块（还没交出去的）一起标记成死的，再记下「关」。
// 交出去的那些归托管，close 不带它们走 —— 那正是 freeze 的全部意义。
fn 关区(区: Int) -> Int {
  let 下一个 = index_get(区, "下一个")
  var i = 1
  while i < 下一个 {
    let 键 = "块" + str(i)
    if index_has(区, 键) {
      let 块 = index_get(区, 键)
      if index_get(块, "zone") == "arena" { index_set(块, "live", 0) }
    }
    i = i + 1
  }
  index_set(区, "关", 1)
  index_set(区, "活", 0)
  return 好(0)
}

fn 交出去(区: Int, 块: Int) -> Int {
  if index_get(区, "关") != 0 { return 坏("HMYR-碼-002 arena.freeze: that arena is already closed") }
  if index_get(块, "zone") != "arena" { return 坏("HMYR-碼-002 arena.freeze was given a block this arena does not own") }
  index_set(块, "zone", "managed")
  index_set(块, "live", 1)
  index_set(区, "活", index_get(区, "活") - 1)
  return 好(块)
}

fn 收回来(区: Int, 块: Int) -> Int {
  if index_get(区, "关") != 0 { return 坏("HMYR-碼-002 arena.adopt: that arena is already closed") }
  if index_get(块, "zone") != "managed" { return 坏("HMYR-碼-003 arena.adopt: that block was not handed to the managed zone") }
  index_set(块, "zone", "arena")
  index_set(块, "live", 1)
  index_set(区, "活", index_get(区, "活") + 1)
  return 好(块)
}

// 方法分派。这一版只认区上的方法 —— 别的值当主时给一句说得清的话，不崩：
// 而它不会崩的理由是 index_has 对不是索引的值交回 false，而不是抛。
fn 求方法(环境: Int, 主: Int, 名: String, 参: Int) -> Int {
  // 块上的方法：存与取。块的上下文只有它自己，所以这两支必须挂在块上。
  if index_has(主, "kind") {
    if index_get(主, "kind") == "block" {
      let 容量 = index_get(主, "size")
      if 名 == "存" {
        if len(参) != 2 { return 坏("存 要两个参数") }
        if 参[0] < 0 { return 坏("HMYR-行-018 这个格子不在块里（容量 " + str(容量) + "）") }
        if 参[0] >= 容量 { return 坏("HMYR-行-018 这个格子不在块里（容量 " + str(容量) + "）") }
        index_set(index_get(主, "格"), str(参[0]), 参[1])
        return 好(主)
      }
      if 名 == "取" {
        if len(参) != 1 { return 坏("取 要一个参数") }
        if 参[0] < 0 { return 坏("HMYR-行-018 这个格子不在块里（容量 " + str(容量) + "）") }
        if 参[0] >= 容量 { return 坏("HMYR-行-018 这个格子不在块里（容量 " + str(容量) + "）") }
        let 格 = index_get(主, "格")
        if index_has(格, str(参[0])) { return 好(index_get(格, str(参[0]))) }
        return 好(())
      }
      return 坏("块上没有这个方法：" + 名)
    }
  }
  // 持有格上的四个动作（owned）。取出即转移：取走之后 装 变回 0。
  if index_has(主, "kind") {
    if index_get(主, "kind") == "owner" {
      let 关了 = index_get(主, "关")
      if 名 == "放" {
        if len(参) != 1 { return 坏("放 要一个参数") }
        if 关了 != 0 { return 坏("HMYR-碼-005 owned.放: 这条格已经关了") }
        if index_get(主, "装") != 0 { return 坏("HMYR-碼-005 owned.放: 这一格已经有值了，先取走") }
        index_set(主, "装", 1)
        index_set(主, "值", 参[0])
        // 放进去的若是一条持有格，它就离开本帧的登记表 —— 「转移」的第二层意思：
        // 所有权连同「本帧退出时会关掉它」这件事一起交给了这一格。
        // 少了这一句，把一个格子交出去之后它会被造它的那一帧关掉（那是实测撞到的冲突）。
        let 全 = 查找(环境, "全局")
        if 全.found {
          index_set(全.value, "持有格们", 去掉项从(index_get(全.value, "持有格们"), 参[0], 0, ()))
        }
        return 好(主)
      }
      if 名 == "取" {
        if len(参) != 0 { return 坏("取 不要参数") }
        if 关了 != 0 { return 坏("HMYR-碼-005 owned.取: 这条格已经关了") }
        if index_get(主, "装") != 1 { return 坏("HMYR-碼-006 owned.取: 这一格是空的") }
        let v = index_get(主, "值")
        index_set(主, "装", 0)
        index_set(主, "值", ())
        return 好(v)
      }
      if 名 == "有" { return 好(index_get(主, "装")) }
      if 名 == "关" {
        index_set(主, "装", 0)
        index_set(主, "值", ())
        index_set(主, "关", 1)
        return 好(())
      }
      return 坏("持有格上没有这个方法：" + 名)
    }
  }
  if index_has(主, "种") == false { return 坏("这一版只认区与块上的方法：" + 名) }
  if index_get(主, "种") != "区" { return 坏("这一版只认区与块上的方法：" + 名) }
  if 名 == "alloc" {
    if len(参) != 1 { return 坏("alloc 要一个参数") }
    return 分配块(主, 参[0])
  }
  if 名 == "close" { return 关区(主) }
  if 名 == "held" { return 好(index_get(主, "活")) }
  if 名 == "freeze" {
    if len(参) != 1 { return 坏("freeze 要一个参数") }
    return 交出去(主, 参[0])
  }
  if 名 == "adopt" {
    if len(参) != 1 { return 坏("adopt 要一个参数") }
    return 收回来(主, 参[0])
  }
  return 坏("区上没有这个方法：" + 名)
}

fn 求调用(节点: Int, 环境: Int) -> Int {
  // 方法调用（a.alloc(16)）：区是这一层唯一有方法的对象。
  // 别的值当主时求方法给的是一句话，不是崩 —— 见那边对 index_has 的说明。
  if 节点.callee.kind == "Field" {
    let 主 = 求值(节点.callee.target, 环境)
    if 主.ok == false { return 主 }
    let 参 = 求参数(节点.args, 环境)
    if 参.ok == false { return 参 }
    return 求方法(环境, 主.value, 节点.callee.name, 参.value)
  }
  if 节点.callee.kind != "Ident" { return 坏("这一版只认按名字调用") }
  let 名 = 节点.callee.text
  let 参 = 求参数(节点.args, 环境)
  if 参.ok == false { return 参 }
  let 值们 = 参.value
  if 名 == "len" {
    if len(值们) != 1 { return 坏("len 要一个参数") }
    return 好(len(值们[0]))
  }
  if 名 == "str" {
    if len(值们) != 1 { return 坏("str 要一个参数") }
    return 好(str(值们[0]))
  }
  // 字符串那一层还差几个纯函数，而标准库把它们当砖用。
  // 它们不碰世界、不改状态，所以在这一层直接转给语言自己的同名内置。
  if 名 == "slice" {
    if len(值们) != 3 { return 坏("slice 要三个参数") }
    return 好(slice(值们[0], 值们[1], 值们[2]))
  }
  // 字节元组转文本：这一层只转发。解码由下面那一层做。
  if 名 == "bytes_to_text" {
    if len(值们) != 1 { return 坏("bytes_to_text 要一个参数") }
    return 好(bytes_to_text(值们[0]))
  }
  // 从标准输入读 N 个字节：与读一行分成两格，因为请求体未必只有一行。
  if 名 == "read_stdin_bytes" {
    if len(值们) != 1 { return 坏("read_stdin_bytes 要一个参数") }
    return 好(read_stdin_bytes(值们[0]))
  }
  // 从标准输入读一行。这一层只转发 —— 交回的记录里有「行」与「结束」两格。
  if 名 == "read_stdin_line" {
    if len(值们) != 0 { return 坏("read_stdin_line 不要参数") }
    return 好(read_stdin_line())
  }
  // 文件那一组剩下的几格。这一层只转发 —— 读不到由下面那一层说。
  if 名 == "file_exists" {
    let 欠在 = 要效果(环境, "file", "file_exists")
    if 欠在 != "" { return 坏(欠在) }
    if len(值们) != 1 { return 坏("file_exists 要一个参数") }
    return 好(file_exists(值们[0]))
  }
  if 名 == "read_line" {
    let 欠行 = 要效果(环境, "file", "read_line")
    if 欠行 != "" { return 坏(欠行) }
    if len(值们) != 2 { return 坏("read_line 要两个参数") }
    return 好(read_line(值们[0], 值们[1]))
  }
  if 名 == "read_lines" {
    let 欠们 = 要效果(环境, "file", "read_lines")
    if 欠们 != "" { return 坏(欠们) }
    if len(值们) != 1 { return 坏("read_lines 要一个参数") }
    return 好(read_lines(值们[0]))
  }
  if 名 == "write_bytes" {
    let 欠写 = 要效果(环境, "file", "write_bytes")
    if 欠写 != "" { return 坏(欠写) }
    if len(值们) != 2 { return 坏("write_bytes 要两个参数") }
    return 好(write_bytes(值们[0], 值们[1]))
  }
  if 名 == "f64_bytes" {
    if len(值们) != 1 { return 坏("f64_bytes 要一个参数") }
    return 好(f64_bytes(值们[0]))
  }
  if 名 == "pack_value" {
    if len(值们) != 1 { return 坏("pack_value 要一个参数") }
    return 好(pack_value(值们[0]))
  }
  // arena 那一格：区在这一层是真的了（2026-10-27），所以这里不再只是「没有」。
  // 交回的是一条索引；alloc / close / freeze / adopt / held 由求方法分派。
  if 名 == "arena" {
    if len(值们) != 0 { return 坏("arena 不要参数") }
    return 好(新区())
  }
  // owned：单一所有者的持有格。四个动作由 求方法 的 owner 分支分派。
  if 名 == "owned" {
    if len(值们) != 0 { return 坏("owned 不要参数") }
    let 格 = 新持有格()
    // 登记到当前帧：帧退出时会被自动关掉（见 关本帧持有格从）。
    let 全 = 查找(环境, "全局")
    if 全.found {
      let 已有 = index_get(全.value, "持有格们")
      index_set(全.value, "持有格们", 已有 + (格,))
    }
    return 好(格)
  }
  // FFI 的最小形状（design/FFI.txt 第四节）：一段不拷贝的窗口。
  // 用索引表示：kind = "view"，三个字段 源 / 起 / 长。与另两台同一套判词。
  if 名 == "bytes_view" {
    if len(值们) != 3 { return 坏("bytes_view 要三个参数") }
    let 源 = 值们[0]
    let 起 = to_int(值们[1])
    let 长 = to_int(值们[2])
    if 起 < 0 || 长 < 0 || 起 + 长 > len(源) {
      return 坏("HMYR-行-018 bytes_view: 范围在外面（" + str(len(源)) + "）")
    }
    let 窗 = index_new()
    index_set(窗, "kind", "view")
    index_set(窗, "源", 源)
    index_set(窗, "起", 起)
    index_set(窗, "长", 长)
    return 好(窗)
  }
  if 名 == "view_len" {
    if len(值们) != 1 { return 坏("view_len 要一个参数") }
    if index_has(值们[0], "kind") == false { return 坏("HMYR-行-019 view_len: 这不是窗口") }
    if index_get(值们[0], "kind") != "view" { return 坏("HMYR-行-019 view_len: 这不是窗口") }
    return 好(index_get(值们[0], "长"))
  }
  if 名 == "view_get" {
    if len(值们) != 2 { return 坏("view_get 要两个参数") }
    if index_has(值们[0], "kind") == false { return 坏("HMYR-行-019 view_get: 这不是窗口") }
    if index_get(值们[0], "kind") != "view" { return 坏("HMYR-行-019 view_get: 这不是窗口") }
    let 长 = index_get(值们[0], "长")
    let i = to_int(值们[1])
    if i < 0 || i >= 长 { return 坏("HMYR-行-018 view_get: " + str(i) + " 在窗口外面（" + str(长) + "）") }
    let 源 = index_get(值们[0], "源")
    return 好(源[index_get(值们[0], "起") + i])
  }
  if 名 == "view_set" {
    if len(值们) != 3 { return 坏("view_set 要三个参数") }
    if index_has(值们[0], "kind") == false { return 坏("HMYR-行-019 view_set: 这不是窗口") }
    if index_get(值们[0], "kind") != "view" { return 坏("HMYR-行-019 view_set: 这不是窗口") }
    let 长 = index_get(值们[0], "长")
    let i = to_int(值们[1])
    if i < 0 || i >= 长 { return 坏("HMYR-行-019 view_set: " + str(i) + " 在窗口外面（" + str(长) + "）") }
    let 源 = index_get(值们[0], "源")
    let 位 = index_get(值们[0], "起") + i
    // 写进源。源不可写时由 设() 那一层判（R0151）—— 这一层看不见它的判据，
    // 所以那一侧在这里没有同一句话可给：source-not-writable 在自举层是「设() 报错」。
    设(源, 位, 值们[2])
    return 好(值们[2])
  }
  // fmt_number(值, 档案)：按档案格式化数字（design/LOCALES.txt 那一节）。
  // 与另两台同一套规矩：中文按四位分组（万进位），其余按三位；小数点是句点。
  // 这一台不转发，自己拼 —— 因为它要证明的是「这条规矩在 HMYR 里也写得出来」。
  if 名 == "fmt_number" {
    if len(值们) != 2 { return 坏("fmt_number 要两个参数") }
    let 文 = str(值们[0])
    let 档 = 值们[1]
    var 每组 = 3
    if len(档) >= 6 && slice(档, 0, 6) == "zh-CN." { 每组 = 4 }
    return 好(加千分位(文, 每组))
  }
  // 原始字节：嵌入与打包要它。这一层只转发，读不到由下面那一层说。
  if 名 == "read_bytes" {
    let 欠读 = 要效果(环境, "file", "read_bytes")
    if 欠读 != "" { return 坏(欠读) }
    if len(值们) != 1 { return 坏("read_bytes 要一个参数") }
    return 好(read_bytes(值们[0]))
  }
  // 切开：这一层只转发。切法（空分隔按码元、连续分隔留空段）由下面那一层给。
  if 名 == "split" {
    if len(值们) != 2 { return 坏("split 要两个参数") }
    return 好(split(值们[0], 值们[1]))
  }
  // 环境与路径：读这台机器在哪儿。这一层只转发 ——
  // 两台机器给出不同的串是对的（契约写的是「读宿主的位置」）。
  if 名 == "cwd" {
    if len(值们) != 0 { return 坏("cwd 不要参数") }
    return 好(cwd())
  }
  if 名 == "home_dir" {
    if len(值们) != 0 { return 坏("home_dir 不要参数") }
    return 好(home_dir())
  }
  if 名 == "temp_path" {
    if len(值们) != 1 { return 坏("temp_path 要一个参数") }
    return 好(temp_path(值们[0]))
  }
  if 名 == "repo_path" {
    if len(值们) != 1 { return 坏("repo_path 要一个参数") }
    return 好(repo_path(值们[0]))
  }
  if 名 == "python_path" {
    if len(值们) != 0 { return 坏("python_path 不要参数") }
    return 好(python_path())
  }
  if 名 == "locale_current" {
    if len(值们) != 0 { return 坏("locale_current 不要参数") }
    return 好(locale_current())
  }
  if 名 == "locale_set" {
    if len(值们) != 1 { return 坏("locale_set 要一个参数") }
    return 好(locale_set(值们[0]))
  }
  if 名 == "locale_env" {
    if len(值们) != 0 { return 坏("locale_env 不要参数") }
    return 好(locale_env())
  }
  if 名 == "console_codepage" {
    if len(值们) != 0 { return 坏("console_codepage 不要参数") }
    return 好(console_codepage())
  }
  // 线程与 arena：这一层照实转发 —— 下面那一层说「没有」，这一层不替它编。
  if 名 == "thr_spawn" {
    if len(值们) != 2 { return 坏("thr_spawn 要两个参数") }
    return 好(thr_spawn(值们[0], 值们[1]))
  }
  if 名 == "thr_join" {
    if len(值们) < 1 { return 坏("thr_join 至少要一个参数") }
    if len(值们) == 1 { return 好(thr_join(值们[0])) }
    return 好(thr_join(值们[0], 值们[1]))
  }
  if 名 == "thr_cancel" {
    if len(值们) != 1 { return 坏("thr_cancel 要一个参数") }
    return 好(thr_cancel(值们[0]))
  }
  if 名 == "thr_count" {
    if len(值们) != 0 { return 坏("thr_count 不要参数") }
    return 好(thr_count())
  }
  // arena 故意不在这里：它在语言里是关键字（有它自己的语法），
  // 而自举这条 parser 不认它 —— 写出来就是 E0104，字节码路径上它走不到。
  // 进程：跑一个程序。这一层照参数个数转发（1 到 4 个），
  // 记录那五个字段（code stdout stderr timedOut error）由下面那一层给。
  if 名 == "run_program" {
    if len(值们) == 1 { return 好(run_program(值们[0])) }
    if len(值们) == 2 { return 好(run_program(值们[0], 值们[1])) }
    if len(值们) == 3 { return 好(run_program(值们[0], 值们[1], 值们[2])) }
    if len(值们) == 4 { return 好(run_program(值们[0], 值们[1], 值们[2], 值们[3])) }
    return 坏("run_program 最多四个参数")
  }
  // 进程：改工作目录。这一层只转发 —— 进不去时下面那一层报 R0209。
  if 名 == "chdir" {
    if len(值们) != 1 { return 坏("chdir 要一个参数") }
    return 好(chdir(值们[0]))
  }
  // 输入：一条键队列。这一层只转发 —— 队列与「有没有终端」在下面那一层。
  if 名 == "key_push" {
    if len(值们) != 1 { return 坏("key_push 要一个参数") }
    return 好(key_push(值们[0]))
  }
  if 名 == "key_available" {
    if len(值们) != 0 { return 坏("key_available 不要参数") }
    return 好(key_available())
  }
  if 名 == "key_read" {
    if len(值们) != 0 { return 坏("key_read 不要参数") }
    return 好(key_read())
  }
  if 名 == "key_start" {
    if len(值们) != 1 { return 坏("key_start 要一个参数") }
    return 好(key_start(值们[0]))
  }
  // 时间：读一次钟，或等一会儿。这一层只转发 ——
  // 「它们破坏可复现性」那条警告写在契约里，不写在每一次调用上。
  if 名 == "now_ms" {
    if len(值们) != 0 { return 坏("now_ms 不要参数") }
    return 好(now_ms())
  }
  if 名 == "sleep_ms" {
    if len(值们) != 1 { return 坏("sleep_ms 要一个参数") }
    return 好(sleep_ms(值们[0]))
  }
  // 终端那一组：只交回字符串，不写出去。照参数个数转发；
  // term_color 收一个或两个 —— 语言的写法定不了可选参数，所以两条各自写出来。
  if 名 == "term_size" {
    if len(值们) != 0 { return 坏("term_size 不要参数") }
    return 好(term_size())
  }
  if 名 == "term_clear" {
    if len(值们) != 0 { return 坏("term_clear 不要参数") }
    return 好(term_clear())
  }
  if 名 == "term_hide" {
    if len(值们) != 0 { return 坏("term_hide 不要参数") }
    return 好(term_hide())
  }
  if 名 == "term_show" {
    if len(值们) != 0 { return 坏("term_show 不要参数") }
    return 好(term_show())
  }
  if 名 == "term_escape" {
    if len(值们) != 2 { return 坏("term_escape 要两个参数") }
    return 好(term_escape(值们[0], 值们[1]))
  }
  if 名 == "term_color" {
    if len(值们) == 1 { return 好(term_color(值们[0])) }
    if len(值们) == 2 { return 好(term_color(值们[0], 值们[1])) }
    return 坏("term_color 要一个或两个参数")
  }
  // 大小写是规格第一圈里的内置。宿主那一份一直有，自举这一层补上转发就够了。
  if 名 == "to_upper" {
    if len(值们) != 1 { return 坏("to_upper 要一个参数") }
    return 好(to_upper(值们[0]))
  }
  if 名 == "to_lower" {
    if len(值们) != 1 { return 坏("to_lower 要一个参数") }
    return 好(to_lower(值们[0]))
  }
  // 算术那一组。abs、floor、int 是转发；min 与 max 自己走一遍，
  // 因为它们是变长的，而「转给同一个名字」只能写出固定个数的参数。
  if 名 == "abs" {
    if len(值们) != 1 { return 坏("abs 要一个参数") }
    return 好(abs(值们[0]))
  }
  if 名 == "floor" {
    if len(值们) != 1 { return 坏("floor 要一个参数") }
    return 好(floor(值们[0]))
  }
  if 名 == "int" {
    if len(值们) != 1 { return 坏("int 要一个参数") }
    return 好(int(值们[0]))
  }
  if 名 == "min" {
    if len(值们) < 1 { return 坏("min 至少要一个参数") }
    var 小 = 值们[0]
    var 甲 = 1
    while 甲 < len(值们) {
      if 值们[甲] < 小 { 小 = 值们[甲] }
      甲 = 甲 + 1
    }
    return 好(小)
  }
  if 名 == "max" {
    if len(值们) < 1 { return 坏("max 至少要一个参数") }
    var 大 = 值们[0]
    var 乙 = 1
    while 乙 < len(值们) {
      if 值们[乙] > 大 { 大 = 值们[乙] }
      乙 = 乙 + 1
    }
    return 好(大)
  }
  // 记录那一组：造、取、问、列。四个都只是转发 —— 记录的形状由宿主那一层给。
  if 名 == "record_new" {
    if len(值们) != 1 { return 坏("record_new 要一个参数") }
    return 好(record_new(值们[0]))
  }
  if 名 == "field_get" {
    if len(值们) != 2 { return 坏("field_get 要两个参数") }
    return 好(field_get(值们[0], 值们[1]))
  }
  if 名 == "field_has" {
    if len(值们) != 2 { return 坏("field_has 要两个参数") }
    return 好(field_has(值们[0], 值们[1]))
  }
  // 字段名的列表。有了它，「把一条记录摊开」才写得出来 —— 标准库的表那一份卡在这里。
  if 名 == "field_names" {
    if len(值们) != 1 { return 坏("field_names 要一个参数") }
    return 好(field_names(值们[0]))
  }
  // 列一个目录。名字的顺序由下面那一层排好，这一层只转发 ——
  // 排序是「两台机器要交回同一个答案」的事，不该在语言这一侧各写一遍。
  if 名 == "read_dir" {
    let 欠列 = 要效果(环境, "file", "read_dir")
    if 欠列 != "" { return 坏(欠列) }
    if len(值们) != 1 { return 坏("read_dir 要一个参数") }
    return 好(read_dir(值们[0]))
  }
  // 这是不是一个目录。递归要往下走，就得先问这一句。
  if 名 == "is_dir" {
    let 欠问 = 要效果(环境, "file", "is_dir")
    if 欠问 != "" { return 坏(欠问) }
    if len(值们) != 1 { return 坏("is_dir 要一个参数") }
    return 好(is_dir(值们[0]))
  }
  // CRC32：纯算术，不需要效果。收字节元组，元素可以是一字节也可以是一块。
  if 名 == "校验和" {
    if len(值们) != 1 { return 坏("校验和 要一个参数") }
    return 好(校验和(值们[0]))
  }
  // 读一份文本。与 write_text 配成一对，两边都要 file 效果。
  if 名 == "read_text" {
    let 欠读 = 要效果(环境, "file", "read_text")
    if 欠读 != "" { return 坏(欠读) }
    if len(值们) < 1 { return 坏("read_text 至少要一个参数") }
    if len(值们) == 1 { return 好(read_text(值们[0])) }
    return 好(read_text(值们[0], 值们[1]))
  }
  // 写一份文本。这一层只转发 —— 编码与脱敏都在下面那一层管。
  if 名 == "write_text" {
    let 欠写 = 要效果(环境, "file", "write_text")
    if 欠写 != "" { return 坏(欠写) }
    if len(值们) != 2 { return 坏("write_text 要两个参数") }
    return 好(write_text(值们[0], 值们[1]))
  }
  // 位运算：八支转发到宿主内建。名字带前缀，所以不会与本文件里的函数重名。
  if 名 == "位与" {
    if len(值们) != 2 { return 坏("位与 要两个参数") }
    return 好(位与(值们[0], 值们[1]))
  }
  if 名 == "位或" {
    if len(值们) != 2 { return 坏("位或 要两个参数") }
    return 好(位或(值们[0], 值们[1]))
  }
  if 名 == "位异或" {
    if len(值们) != 2 { return 坏("位异或 要两个参数") }
    return 好(位异或(值们[0], 值们[1]))
  }
  if 名 == "位非" {
    if len(值们) != 1 { return 坏("位非 要一个参数") }
    return 好(位非(值们[0]))
  }
  if 名 == "位右移" {
    if len(值们) != 2 { return 坏("位右移 要两个参数") }
    return 好(位右移(值们[0], 值们[1]))
  }
  if 名 == "位加" {
    if len(值们) != 2 { return 坏("位加 要两个参数") }
    return 好(位加(值们[0], 值们[1]))
  }
  if 名 == "位循环右移" {
    if len(值们) != 2 { return 坏("位循环右移 要两个参数") }
    return 好(位循环右移(值们[0], 值们[1]))
  }
  if 名 == "位循环左移" {
    if len(值们) != 2 { return 坏("位循环左移 要两个参数") }
    return 好(位循环左移(值们[0], 值们[1]))
  }
  // 可变数组：这两支只是转发到宿主那一层的内建。
  // 名字相同不会递归 —— 数组/设 不是这个文件里定义的函数，编译器把它们编成内建调用。
  if 名 == "数组" {
    if len(值们) != 1 { return 坏("数组 要一个参数") }
    return 好(数组(值们[0]))
  }
  if 名 == "设" {
    if len(值们) != 3 { return 坏("设 要三个参数") }
    return 好(设(值们[0], 值们[1], 值们[2]))
  }
  // 命令行参数：目标程序看到的是自己的那一份，由调用的那一层放进环境。
  // 早先这里没有这一支，于是程序里写 argv() 会报「没有这个函数：argv」。
  if 名 == "argv" {
    let 欠参 = 要效果(环境, "process", "argv")
    if 欠参 != "" { return 坏(欠参) }
    if len(值们) != 0 { return 坏("argv 不要参数") }
    let r = 查找(环境, "argv")
    if r.found { return 好(r.value) }
    return 好(())
  }
  // 输出：目标程序的 print 要落到宿主那一层去。
  // 早先这里没有这一支 —— 于是「能算但说不出」：任何带 print 的程序都跑不了。
  // 参数按 str 拼起来，因为这门语言的 print 就是「把每个值写成文字，连着写出去」。
  if 名 == "print" {
    var 出文 = ""
    var i = 0
    while i < len(值们) {
      出文 = 出文 + str(值们[i])
      i = i + 1
    }
    print(出文)
    return 好(())
  }
  if 名 == "print_err" {
    let 欠错 = 要效果(环境, "process", "print_err")
    if 欠错 != "" { return 坏(欠错) }
    var 错文 = ""
    var j = 0
    while j < len(值们) {
      错文 = 错文 + str(值们[j])
      j = j + 1
    }
    print_err(错文)
    return 好(())
  }
  if 名 == "chr" {
    if len(值们) != 1 { return 坏("chr 要一个参数") }
    return 好(chr(值们[0]))
  }
  // 码点那一对是配套的：chr 造字符，ord 读回来。少了 ord，任何按码点分类的
  // 字符串处理都得写成逐字符比较 —— 标准库第一份正是这样撞上的。
  if 名 == "ord" {
    if len(值们) != 1 { return 坏("ord 要一个参数") }
    return 好(ord(值们[0]))
  }
  if 名 == "to_int" {
    if len(值们) != 1 { return 坏("to_int 要一个参数") }
    return 好(to_int(值们[0]))
  }
  if 名 == "nfc" {
    if len(值们) != 1 { return 坏("nfc 要一个参数") }
    return 好(nfc(值们[0]))
  }
  if 名 == "is_letter" {
    if len(值们) != 1 { return 坏("is_letter 要一个参数") }
    return 好(is_letter(值们[0]))
  }
  if 名 == "is_mark" {
    if len(值们) != 1 { return 坏("is_mark 要一个参数") }
    return 好(is_mark(值们[0]))
  }
  // 索引：一个按键查的东西。约定见 design/INDEX.txt —— 键是任意字符串，
  // set 交回同一个索引（于是可以写 表 = index_set(表, k, v)），取不到报 R0218。
  // 这六条是自举求值器的分派：它跑在宿主或字节码机上，于是实际调用落到那一层的内置。
  if 名 == "index_new" {
    if len(值们) != 0 { return 坏("index_new 不要参数") }
    return 好(index_new())
  }
  if 名 == "index_set" {
    if len(值们) != 3 { return 坏("index_set 要三个参数") }
    return 好(index_set(值们[0], 值们[1], 值们[2]))
  }
  if 名 == "index_get" {
    if len(值们) != 2 { return 坏("index_get 要两个参数") }
    return 好(index_get(值们[0], 值们[1]))
  }
  if 名 == "index_has" {
    if len(值们) != 2 { return 坏("index_has 要两个参数") }
    return 好(index_has(值们[0], 值们[1]))
  }
  if 名 == "index_len" {
    if len(值们) != 1 { return 坏("index_len 要一个参数") }
    return 好(index_len(值们[0]))
  }
  if 名 == "index_keys" {
    if len(值们) != 1 { return 坏("index_keys 要一个参数") }
    return 好(index_keys(值们[0]))
  }
  let 找 = 查找(环境, "fn:" + 名)
  if 找.found == false { return 坏("没有这个函数：" + 名) }
  // 找.value 是 (参数名们, 语句们, 效果名们)。绑参数要在**新的一层**上绑，
  // 而不是在调用者的环境上——否则函数的局部名字会漏回外面，
  // 而那是一门语言里最难查的一类错。
  let 参名们 = 找.value[0]
  let 体内 = 找.value[1]
  // 效果要往下核：被调的那个要什么，调用者就得声明什么。这一条是效果检查的全部意思，
  // 少了它就只是「把 effects 写进注释」。
  var 子效 = ()
  if len(找.value) > 2 { 子效 = 找.value[2] }
  let 欠 = 缺效果(子效, 我的效果(环境))
  if 欠 != "" { return 坏("HMYR-內-001 调 " + 名 + " 要 " + 欠 + " 效果，而调用它的函数没有声明") }
  if len(参名们) != len(值们) { return 坏("参数个数不对：" + 名 + " 要 " + str(len(参名们)) + " 个，给了 " + str(len(值们))) }
  let 体环境 = 绑参数(环境, 参名们, 值们, 0)
  // 帧边界：进来时把「本帧持有格」清空（上一帧那份先记下来），退出时关掉这一帧登记的。
  // 只到帧级，不到块级 —— 这门语言没有块钩子，而「一次调用一圈」是能写进判据的最小形状。
  let 全 = 查找(环境, "全局")
  var 上一帧 = ()
  var 有表 = false
  if 全.found {
    上一帧 = index_get(全.value, "持有格们")
    index_set(全.value, "持有格们", ())
    有表 = true
  }
  let r = 执行块(体内, 更新(体环境, "效果", 子效))
  var 本帧 = ()
  if 有表 {
    本帧 = index_get(全.value, "持有格们")
    index_set(全.value, "持有格们", 上一帧)
    关本帧持有格从(本帧, 0)
  }
  if r.ok == false { return 坏(r.text) }
  if r.done == true { return 好(r.value) }
  return 好(())
}

// 十的幂。小数与指数解析都要用它。
// 负指数是除以十的正次幂 —— 1e-3 那一类写法要有落点。
fn 幂十(n: Int) -> Int {
  if n < 0 {
    return 1 / 幂十(0 - n)
  }
  var 出 = 1
  var i = 0
  while i < n {
    出 = 出 * 10
    i = i + 1
  }
  return 出
}

fn 小数点位置(s: String) -> Int {
  var i = 0
  while i < len(s) {
    if s[i] == "." {
      return i
    }
    i = i + 1
  }
  return 0 - 1
}

// 指数的位置：e 或 E。没有就交回 -1。
fn 指数位置(s: String) -> Int {
  var i = 0
  while i < len(s) {
    if s[i] == "e" { return i }
    if s[i] == "E" { return i }
    i = i + 1
  }
  return 0 - 1
}

// 没有指数的那些：整数交给 to_int，带小数点的自己拆。
fn 小数到(s: String) -> Int {
  let 位 = 小数点位置(s)
  if 位 < 0 {
    return to_int(s)
  }
  let 整 = slice(s, 0, 位)
  let 小 = slice(s, 位 + 1, len(s))
  let 值 = to_int(小)
  return to_int(整) + 值 / 幂十(len(小))
}

// 一个数字字面量 → 数。
//
// 三件都要处理：整数、小数、指数。早先这一层把所有字面量都交给 to_int，
// 于是 1.5 报「不是整数字面量」；只补小数之后，1e3 还是被切成 1 与 e3。
// 现在先看有没有指数，有就拆成「尾数乘十的幂」，尾数再走小数那一条。
// 按基数读一串数字：0x 十六进制、0b 二进制、0o 八进制。下划线是分隔符，不参与计算。
// 十进制仍交给 数到（它认得小数与指数）—— 复用一份比再写一份好。
// 这一对原先只写在包装层（run.hmyr），于是「造树」那条路认得 0x1_0，而求值器那条路不认得。
fn 按基读(s: String, 起: Int, 基: Int) -> Int {
  var 出 = 0
  var i = 起
  while i < len(s) {
    let c = ord(slice(s, i, i + 1))
    var 值 = c - 48
    if c >= 97 && c <= 102 { 值 = c - 87 }
    if c >= 65 && c <= 70 { 值 = c - 55 }
    if c != 95 { 出 = 出 * 基 + 值 }
    i = i + 1
  }
  return 出
}

pub fn 数字值(s: String) -> Int {
  if len(s) >= 2 {
    let 标 = slice(s, 1, 2)
    if 标 == "x" || 标 == "X" { return 按基读(s, 2, 16) }
    if 标 == "b" || 标 == "B" { return 按基读(s, 2, 2) }
    if 标 == "o" || 标 == "O" { return 按基读(s, 2, 8) }
  }
  return 数到(s)
}
fn 数到(s: String) -> Int {
  let 指 = 指数位置(s)
  if 指 >= 0 {
    let 尾 = slice(s, 0, 指)
    let 次 = to_int(slice(s, 指 + 1, len(s)))
    return 小数到(尾) * 幂十(次)
  }
  return 小数到(s)
}

// 求一个节点。这是核心：节点种类一分派，其余都交给上面的帮手。
pub fn 求值(节点: Int, 环境: Int) -> Int {
  let 种 = 节点.kind
  if 种 == "int" { return 好(to_int(节点.text)) }
  if 种 == "Literal" && 节点.type == "int" { return 好(数字值(节点.text)) }
  if 种 == "Literal" && 节点.type == "string" { return 好(节点.text) }
  // nil：这门语言没有 null，空元组就是它。而求值器要认得出 {kind: "nil"} 这种节点，
  // 因为 stmt.hmyr 用它在「return 不带值」时占位。
  if 种 == "nil" { return 好(()) }
  if 种 == "Ident" {
    // 布尔字面量：自举那一层的切词器把关键字一律当成标识符（见 lex.hmyr 开头那段），
    // 于是 true 与 false 到这一步是「一个名字」。要在这里把它们认回来，
    // 否则目标程序里写一个 true 就会报「没有这个名字：true」。
    // 这两个词是语言的关键字，不可能是用户起的名字，所以先认它们没有歧义。
    if 节点.text == "true" { return 好(1 == 1) }
    if 节点.text == "false" { return 好(1 == 2) }
    // nil 同理：宿主把那两个字当关键字，自举这一层得自己认回来。
    if 节点.text == "nil" { return 好(()) }
    let r = 查找(环境, 节点.text)
    if r.found { return 好(r.value) }
    // 模块级 var 住在环境之外的一张小表里（见 装常量从 与 Assign）。
    // 为什么不能也放环境里：环境是纯传递的 —— 函数体里改的那一层，函数一返回就没了。
    // 可写的名字需要一块共享的地方，而索引就是这门语言里那块地方。
    let 全 = 查找(环境, "全局")
    if 全.found {
      if index_has(全.value, 节点.text) { return 好(index_get(全.value, 节点.text)) }
    }
    return 坏("没有这个名字：" + 节点.text)
  }
  if 种 == "Binary" {
    // && 与 || 要短路：右边在有结论时不该被求值。
    //
    // 2026-11-01 补。在这一天之前，两个操作数在调进 求二元 之前都求过 ——
    // 那条限制写在 求二元 的注释里，而它让 lex.hmoca 里「先检查再访问」的写法
    // 全部失效：s[i] == "/" && i + 1 < len(s) && s[i + 1] == "/" 的右边会被求值，
    // 越界就在那里（design/BOARD.txt 第三十五节）。
    // 短路是规范的一部分，所以这一条不是优化，是补语义。
    if 节点.op == "&&" {
      let 左 = 求值(节点.left, 环境)
      if 左.ok == false { return 左 }
      if 左.value == false { return 好(false) }
      return 求值(节点.right, 环境)
    }
    if 节点.op == "||" {
      let 左 = 求值(节点.left, 环境)
      if 左.ok == false { return 左 }
      if 左.value == true { return 好(true) }
      return 求值(节点.right, 环境)
    }
    return 求二元(节点.op, 求值(节点.left, 环境), 求值(节点.right, 环境))
  }
  if 种 == "Unary" { return 求一元(节点.op, 求值(节点.operand, 环境)) }
  if 种 == "Call" { return 求调用(节点, 环境) }
  if 种 == "Index" {
    let 标 = 求值(节点.target, 环境)
    if 标.ok == false { return 标 }
    let 位 = 求值(节点.index, 环境)
    if 位.ok == false { return 位 }
    // 越界要自己报，不能交给机器去决定（2026-11-01）。
    //
    // 为什么：这一句原来是 好(标.value[位.value])，于是「越界」这件事交由各台机器
    // 自己处置 —— C 机器容忍它，最小求值器报 HMYR-行-018，两边对同一份源码给出不同
    // 结论。而自举层的词法器在那之前就已经在某个下标上越了界，正是这台宽松的机器
    // 让它一直没被发现（design/BOARD.txt 第三十三节）。
    if 位.value < 0 || 位.value >= len(标.value) {
      return 坏("下标越界：" + str(位.value) + "，而长度是 " + str(len(标.value))
        + "，在第 " + str(节点.line) + " 行")
    }
    return 好(标.value[位.value])
  }
  if 种 == "Field" {
    // 不能写 标.value[节点.name]：下标只收数字，而这里字段名是个变量。
    // 先问再取：field_get 取不到会抛（有编号），而这里接不住异常，所以先问 field_has。
    let 标 = 求值(节点.target, 环境)
    if 标.ok == false { return 标 }
    if field_has(标.value, 节点.name) { return 好(field_get(标.value, 节点.name)) }
    // 区与块是索引，它们的字段也要能读（b.zone / b.size / b.live）。
    // index_has 对不是索引的值交回 false 而不是抛，所以这一句对记录与别的值都安全。
    // 记录先问、索引后问：同名时记录赢，这样「记录」这个意思不被索引借走。
    if index_has(标.value, 节点.name) { return 好(index_get(标.value, 节点.name)) }
    return 坏("没有这个字段：" + 节点.name)
  }
  if 种 == "Tuple" { return 求参数(节点.items, 环境) }
  if 种 == "Record" { return 求记录(节点, 环境) }
  if 种 == "Error" { return 坏("语法层报的错：" + 节点.text) }
  return 坏("不认识的节点：" + 种)
}

// 一段节点求值并直接把结果打成文字。给示例与测试用。
fn 求值成文字(节点: Int, 环境: Int) -> String {
  let r = 求值(节点, 环境)
  if r.ok == false { return "错：" + r.text }
  return str(r.value)
}

// ---- 语句层 ----
//
// 表达式求值不改变环境，而语句需要：let/var/assign 都让名字指向新的值。
// 这门语言的 let 不可变，所以环境用「追加一对」的方式更新——不引入可变状态。
// 查找从后往前，于是后定义自然覆盖先定义。
//
// 执行的结果统一成一个记录：
//   {ok: true,  env: 新环境, done: false, value: ()}     正常走完
//   {ok: true,  env: 新环境, done: true,  value: 返回值}  遇到 return
//   {ok: false, env: (),     done: true,  text: 原因}     出错（done 也是真：不能再往下走）

// 绑参数：把 值们 挨个绑到 名们 上，交回一层新环境。
// 「新的一层」这件事在 执行块 里由它自己管（它把 let 绑在局部），
// 而参数这一层必须先于函数体的第一个 let 就位。
fn 绑参数从(环境: Int, 名们: Int, 值们: Int, i: Int) -> Int {
  if i >= len(名们) { return 环境 }
  return 绑参数从(更新(环境, 名们[i], 值们[i]), 名们, 值们, i + 1)
}

fn 绑参数(环境: Int, 名们: Int, 值们: Int, 起: Int) -> Int {
  return 绑参数从(环境, 名们, 值们, 起)
}

fn 更新(环境: Int, 名: String, 值: Int) -> Int {
  return 环境 + ((名, 值),)
}

// 环境里那个名字最后一次出现在第几项。-1 表示没有。
// 「最后一次」与 查找 从后往前是同一条规矩：近的定义盖住远的。
fn 末位(环境: Int, 名: String, i: Int, 局: Int) {
  if i >= len(环境) { return 局 }
  var 新局 = 局
  if 环境[i][0] == 名 { 新局 = i }
  return 末位(环境, 名, i + 1, 新局)
}

// 把第 到 项换成新值，其余原样 —— 交回一张新表。
//
// 为什么不能「追加一条」了事：函数体里的环境是「模块级 + 参数 + 局部」，
// 追加只会落在最内层，函数一返回，模块级那个名字还是旧值。
// 症状是「写了一个模块级 var，读出来永远是初值」—— 而它看起来像赋值没生效。
fn 改在从(环境: Int, 到: Int, 值: Int, i: Int, 出: Int) {
  if i >= len(环境) { return 出 }
  if i == 到 { return 改在从(环境, 到, 值, i + 1, 出 + ((环境[i][0], 值),)) }
  return 改在从(环境, 到, 值, i + 1, 出 + (环境[i],))
}

fn 改在(环境: Int, 到: Int, 值: Int) {
  return 改在从(环境, 到, 值, 0, ())
}

fn 好执行(环境: Int, 完成: Bool, 值: Int) {
  return {ok: true, env: 环境, done: 完成, value: 值}
}

fn 坏执行(原因: String) {
  return {ok: false, env: (), done: true, text: 原因}
}

fn 执行(节点: Int, 环境: Int) -> Int {
  let 种 = 节点.kind
  if 种 == "Let" || 种 == "Var" {
    let v = 求值(节点.value, 环境)
    if v.ok == false { return 坏执行(v.text) }
    return 好执行(更新(环境, 节点.name, v.value), false, ())
  }
  if 种 == "Assign" {
    // 模块级 const 在装进环境时留了一条只读标记（见 装常量从）。
    let 只读 = 查找(环境, "只读:" + 节点.name)
    if 只读.found { return 坏执行("不能给 const 重新绑定：" + 节点.name) }
    // 可写的模块级名字在那张小表里：写它，环境不动。
    let 全 = 查找(环境, "全局")
    if 全.found {
      if index_has(全.value, 节点.name) {
        let v0 = 求值(节点.value, 环境)
        if v0.ok == false { return 坏执行(v0.text) }
        index_set(全.value, 节点.name, v0.value)
        return 好执行(环境, false, ())
      }
    }
    let 位 = 末位(环境, 节点.name, 0, -1)
    if 位 < 0 { return 坏执行("不能给没声明过的名字赋值：" + 节点.name) }
    let v = 求值(节点.value, 环境)
    if v.ok == false { return 坏执行(v.text) }
    // 改那一条，而不是追加一条 —— 见 改在 的注释。
    return 好执行(改在(环境, 位, v.value), false, ())
  }
  if 种 == "ExprStmt" {
    let v = 求值(节点.value, 环境)
    if v.ok == false { return 坏执行(v.text) }
    return 好执行(环境, false, ())
  }
  if 种 == "Return" {
    // 无值时那个位置是 {kind: "nil"}，于是这一层只看 kind——不用 len 去探，
    // 因为值也可能是一个记录，而 len 只收字符串与元组。
    if 节点.value.kind == "nil" { return 好执行(环境, true, ()) }
    let v = 求值(节点.value, 环境)
    if v.ok == false { return 坏执行(v.text) }
    return 好执行(环境, true, v.value)
  }
  if 种 == "If" {
    let c = 求值(节点.cond, 环境)
    if c.ok == false { return 坏执行(c.text) }
    if c.value != false {
      if len(节点.then) == 0 { return 好执行(环境, false, ()) }
      return 执行块(节点.then, 环境)
    }
    if len(节点.otherwise) == 0 { return 好执行(环境, false, ()) }
    return 执行块(节点.otherwise, 环境)
  }
  if 种 == "While" { return 执行反复(节点, 环境, 0) }
  if 种 == "Error" { return 坏执行("语法层报的错：" + 节点.text) }
  return 坏执行("这一版还不认这种语句：" + 种)
}

// while：条件真就跑一遍体，然后拿**体交回的环境**再判一次。
// 体里若有 i = i + 1，新环境在 r.env 里；不看它，循环就永远不前进。
fn 执行反复(节点: Int, 环境: Int, 次数: Int) -> Int {
  if 次数 >= 1000000 { return 坏执行("while 跑过一百万次还没结束") }
  let c = 求值(节点.cond, 环境)
  if c.ok == false { return 坏执行(c.text) }
  if c.value == false { return 好执行(环境, false, ()) }
  let r = 执行块(节点.body, 环境)
  if r.ok == false { return 坏执行(r.text) }
  if r.done == true { return r }
  return 执行反复(节点, r.env, 次数 + 1)
}

fn 执行块从(语句们: Int, 环境: Int, i: Int) -> Int {
  if i >= len(语句们) { return 好执行(环境, false, ()) }
  let r = 执行(语句们[i], 环境)
  if r.ok == false { return r }
  if r.done == true { return r }
  return 执行块从(语句们, r.env, i + 1)
}

fn 执行块(语句们: Int, 环境: Int) -> Int {
  return 执行块从(语句们, 环境, 0)
}

// 跑一段语句：从空环境开始。交回 {ok, env, done, value}。
pub fn 跑程序(语句们: Int) -> Int {
  return 执行块(语句们, ())
}

// 把函数表装进环境：每项是 (名字, 语句们)，装成 ("fn:名字", 语句们)。
// 函数表里每一项是 (名字, 参数名们, 语句们)，而环境里存的是 (参数名们, 语句们)。
// 为什么要带参数名：自举这一层以前执行函数体时不绑参数，于是带参数的函数
// 会以「没有这个名字」失败。那不是错——它诚实地说了——而它让这门语言少了一半。
fn 装函数从(环境: Int, 函数们: Int, i: Int) -> Int {
  if i >= len(函数们) { return 环境 }
  let 项 = 函数们[i]
  // 形状不对就跳过，而不是交回一个错误记录——
  // 这一层的返回类型是环境，把一个记录当成环境装进去，后面每一步都会读到怪东西。
  // 而「跳过」也不是沉默：装表本来就不该收到坏形状，坏形状该在造表那一头被拦住。
  if len(项) < 3 { return 装函数从(环境, 函数们, i + 1) }
  // 第四项是效果名们。老的三项形状也收 —— 那两条给套件用的解析器不带效果，
  // 而「没有效果」与「效果那一项缺了」在这里是同一件事。
  var 效 = ()
  if len(项) > 3 { 效 = 项[3] }
  return 装函数从(更新(环境, "fn:" + 项[0], (项[1], 项[2], 效)), 函数们, i + 1)
}

// 老的入口留着：两个套件按两参数调它，而它们测的是「适配层造出的语句表能不能跑」。
// 新的一层带参数，因为目标程序要看得见自己的 argv —— 那件事以前根本做不到。
fn 跑程序带函数(语句们: Int, 函数们: Int) -> Int {
  return 跑程序带常量与参(语句们, 函数们, (), (), ())
}

// 效们 是 main 自己声明的效果。它要放进环境，因为「当前函数有哪些效果」这件事
// 只能在运行时知道 —— 效果检查靠的就是这个键。
fn 跑程序带函数与参(语句们: Int, 函数们: Int, 参们: Int, 效们: Int) -> Int {
  return 跑程序带常量与参(语句们, 函数们, (), 参们, 效们)
}

// 模块级常量：每项是（名字, 初始化式节点），在这一刻求值并装进环境。
//
// 顺序就是源码顺序，所以一个常量可以先引用前面已经装好的常量。装不上的就跳过 ——
// 与 装函数从 对坏形状的处理同一条规矩：这一层的返回类型是环境，带不了错误记录，
// 而「没有这个名字」会在真正用到它的时候说出来，那时候报得比这里准。
fn 装常量从(环境: Int, 常量们: Int, i: Int) -> Int {
  if i >= len(常量们) { return 环境 }
  let 项 = 常量们[i]
  if len(项) < 2 { return 装常量从(环境, 常量们, i + 1) }
  let 值 = 求值(项[1], 环境)
  if 值.ok == false { return 装常量从(环境, 常量们, i + 1) }
  // 第三项是「可写吗」：没有这一项、或它是 0，就是 const。
  //
  // 可写的（var）进那张共享的小表；不可写的留在环境里，并留一条只读标记。
  // 分开的理由只有一个：环境是纯传递的，写不回去；而索引写得回去。
  var 可写 = 0
  if len(项) > 2 { 可写 = 项[2] }
  if 可写 == 1 {
    let 全 = 查找(环境, "全局")
    if 全.found {
      index_set(全.value, 项[0], 值.value)
      return 装常量从(环境, 常量们, i + 1)
    }
  }
  var 新 = 更新(环境, 项[0], 值.value)
  if 可写 == 0 { 新 = 更新(新, "只读:" + 项[0], 1) }
  return 装常量从(新, 常量们, i + 1)
}

pub fn 跑程序带常量与参(语句们: Int, 函数们: Int, 常量们: Int, 参们: Int, 效们: Int) -> Int {
  let 有函数 = 装函数从((), 函数们, 0)
  // 那张共享的小表先放进去：装常量时（以及运行时赋值）都靠它。
  let 全 = index_new()
  // 「本帧登记的持有格」也住这张表里，因为这一层的环境是纯传递的：
  // 一个更新返回一份新环境，所以「往当前帧登记一个格子」这件事只有共享索引装得下。
  index_set(全, "持有格们", ())
  let 有表 = 更新(有函数, "全局", 全)
  let 有常量 = 装常量从(有表, 常量们, 0)
  return 执行块(语句们, 更新(更新(有常量, "argv", 参们), "效果", 效们))
}

// 把一个值从元组里去掉（只去第一个相等的）。持有格交出去时用。
fn 去掉项从(们: Int, 值: Int, i: Int, acc: Int) {
  if i >= len(们) { return acc }
  if 们[i] == 值 { return 去掉项从(们, 值, i + 1, acc) }
  return 去掉项从(们, 值, i + 1, acc + (们[i],))
}

fn 去掉项(们: Int, 值: Int) -> Int {
  return 去掉项从(们, 值, 0, ())
}

// 把当前帧登记的持有格一个不留地关掉。帧退出时调用（design/MEMORY.txt 第 2 节）。
// 登记表里只有持有格，所以这里不判类型 —— 判错类型的地方在 求方法 的 owner 分支。
fn 关本帧持有格从(格们: Int, i: Int) {
  if i >= len(格们) { return () }
  index_set(格们[i], "关", 1)
  return 关本帧持有格从(格们, i + 1)
}

// 造记录：先把每个值求出来，再交给 record_of。
// 字段名来自源码，所以一定是标识符能写的形状——这正是 record_of 收的那一类。
// 字段的形状来自 self/chain.hmyr：{name, value}——是记录，不是二元元组。
// 所以这里读 .name 与 .value，而不是取下标。
fn 求字段从(字段们: Int, 环境: Int, i: Int, acc: Int) -> Int {
  if i >= len(字段们) { return 好(acc) }
  let 字段 = 字段们[i]
  let v = 求值(字段.value, 环境)
  if v.ok == false { return v }
  return 求字段从(字段们, 环境, i + 1, acc + ((字段.name, v.value),))
}

fn 求记录(节点: Int, 环境: Int) -> Int {
  let 里 = 求字段从(节点.fields, 环境, 0, ())
  if 里.ok == false { return 里 }
  return 好(record_new(里.value))
}

fn main() -> Int effects(process) {
  let 节点 = {kind: "Binary", op: "+", left: {kind: "int", text: "1"}, right: {kind: "Binary", op: "*", left: {kind: "int", text: "2"}, right: {kind: "int", text: "3"}}}
  print(求值成文字(节点, ()) + "\n")
  return 0
}
