// 用 Himeyuri 写的第五件：吃 token 元组的解析器。
//
// 前一件是「两条平行的路」——词法从字符串切 token，语法也从字符串解析，然后两边对一下。
// 这一件才是链：**输入就是词法的产出**（token 元组），游标是一个整数下标。
//
引入 "./lex.hmoca"

// 上面这行是实话：本文件吃的是 lex 切出来的 token，形状由它定义。
// 有了模块加载，宿主不必再手工把两个文件塞进同一个求值器了。
//
// token 的形状来自 self/lex.hmyr：
//   {kind: "ident" | "int" | "string" | "punct", text}
//
// 深度照旧先安排：加减一层、乘除一层、原子一层，尾循环按项数增长；括号按嵌套增长。
// 所以它和字符串版一样，碰不到调用深度那道墙。
//
// 边界写在明处：算术（+ - * / %）、括号、后缀（调用、下标、字段）、比较与逻辑
// （|| 低于 &&，两者都低于比较 —— 三层在下面，左右结合照语言自己的表）；
// 出错时给出 {kind: "误"} 而不猜。
//
// 原地那句只写「只认 + - * / % 与括号」，而它在这之后长出了后缀与逻辑两层 ——
// 2026-11-01 改。一句停在过去的边界说明，比没有说明更容易让人先信后错。

公开 函数 is_punct(t: Int, ch: String) -> Bool {
  返回 t.kind == "punct" && t.text == ch
}

// 原子：整数、标识符、括号里的表达式。
// 后缀层：一个原子之后可以跟调用 f(…) 与下标 x[…]。
// 它们在语法上同属一层，所以放在一起；深度上每次后缀各占一层，链式调用则有几段占几层。
函数 postfix(tokens: Int, i: Int) -> Int {
  定 base = atom(tokens, i)
  返回 postfix_tail(tokens, base.next, base.node)
}

函数 postfix_tail(tokens: Int, i: Int, target: Int) {
  若 i >= len(tokens) { 返回 {node: target, next: i} }
  若 is_punct(tokens[i], "(") {
    定 位 = tokens[i]
    定 got = arg_list(tokens, i + 1, ())
    返回 postfix_tail(tokens, got.next, {kind: "调用", callee: target, args: got.list, line: 位.line, column: 位.column})
  }
  若 is_punct(tokens[i], ".") {
    若 i + 1 < len(tokens) && tokens[i + 1].kind == "ident" {
      // 位置上照抄宿主的一处怪处：它的 Field 记的是**字段名之后**那个 token 的位子
      //（subset-parse 的注释写着「照抄而不是改对」，为的是两棵树能逐节点核）。
      // 这一侧的 token 流不留换行，所以等价写法是「名字的列 + 名字的长度」——
      // 名字后面紧跟的就是那个位子。不照抄，两棵树就永远差一列。
      定 名 = tokens[i + 1]
      返回 postfix_tail(tokens, i + 2, {kind: "字段", target: target, name: 名.text, line: 名.line, column: 名.column + len(名.text)})
    }
    返回 {node: target, next: i + 1}
  }
  若 is_punct(tokens[i], "[") {
    定 位 = tokens[i]
    定 inner = compare(tokens, i + 1)
    若 inner.next < len(tokens) && is_punct(tokens[inner.next], "]") {
      返回 postfix_tail(tokens, inner.next + 1, {kind: "索引", target: target, index: inner.node, line: 位.line, column: 位.column})
    }
    返回 {node: target, next: inner.next}
  }
  返回 {node: target, next: i}
}

// 实参表：每个实参各自独立递归一次，所以层数是「实参个数」与「实参深度」相加。
函数 arg_list(tokens: Int, i: Int, acc: Int) {
  若 i >= len(tokens) { 返回 {list: acc, next: i} }
  若 is_punct(tokens[i], ")") { 返回 {list: acc, next: i + 1} }
  定 one = compare(tokens, i)
  var next = one.next
  若 next < len(tokens) && is_punct(tokens[next], ",") { next = next + 1 }
  返回 arg_list(tokens, next, acc + (one.node,))
}

// 表达式里的换行不是分隔符：宿主 parser 在表达式内部跳换行，( ... ) 与 { ... } 才能跨行写。
// 这一层原来不跳，于是跨行元组被读成「表达式结束 + 一个孤零零的 )」。
// 跳行只移动索引，不改变索引空间，所以交回的 next 仍在原 token 流上。
函数 跳行(tokens: Int, i: Int) -> Int {
  若 i < len(tokens) && tokens[i].kind == "newline" { 返回 跳行(tokens, i + 1) }
  返回 i
}

函数 atom(tokens: Int, i: Int) {
  定 j = 跳行(tokens, i)
  若 j >= len(tokens) { 返回 {node: {kind: "误", text: "", line: 0, column: 0}, next: j} }
  定 t = tokens[j]
  若 t.kind == "int" { 返回 {node: {kind: "字", type: "int", text: t.text, raw: t.text, line: t.line, column: t.column}, next: j + 1} }
  若 t.kind == "string" { 返回 {node: {kind: "字", type: "string", text: t.text, raw: 假, line: t.line, column: t.column}, next: j + 1} }
  若 t.kind == "ident" { 返回 {node: {kind: "名", name: t.text, text: t.text, line: t.line, column: t.column}, next: j + 1} }
  若 is_punct(t, "(") { 返回 paren_or_tuple(tokens, j + 1) }
  若 is_punct(t, "{") { 返回 record_of(tokens, j + 1) }
  返回 {node: {kind: "误", text: t.text, line: t.line, column: t.column}, next: j + 1}
}

// (x) 是分组，(x, …) 是元组——含尾逗号的一元组也算元组。
// 深度：每个元素各自独立递归一次，所以「元素个数」与「元素的深度」相加，不是相乘。
函数 paren_or_tuple(tokens: Int, i: Int) {
  定 j = 跳行(tokens, i)
  若 j < len(tokens) && is_punct(tokens[j], ")") { 返回 {node: {kind: "组", items: ()}, next: j + 1} }
  定 first = logic(tokens, j)
  若 first.next < len(tokens) && is_punct(tokens[first.next], ",") {
    返回 tuple_tail(tokens, first.next + 1, (first.node,))
  }
  若 first.next < len(tokens) && is_punct(tokens[first.next], ")") {
    返回 {node: first.node, next: first.next + 1}
  }
  返回 {node: first.node, next: first.next}
}

函数 tuple_tail(tokens: Int, i: Int, acc: Int) {
  定 j = 跳行(tokens, i)
  若 j >= len(tokens) { 返回 {node: {kind: "组", items: acc}, next: j} }
  若 is_punct(tokens[j], ")") { 返回 {node: {kind: "组", items: acc}, next: j + 1} }
  定 item = logic(tokens, j)
  var next = item.next
  若 next < len(tokens) && is_punct(tokens[next], ",") { next = next + 1 }
  返回 tuple_tail(tokens, next, acc + (item.node,))
}

// {字段: 值, …}：字段名可以是标识符（词法里关键字也归在标识符一类，
// 所以 type、公开、效果串 这些词在这里天然可用）。
函数 record_of(tokens: Int, i: Int) -> Int {
  返回 record_tail(tokens, i, ())
}

函数 record_tail(tokens: Int, i: Int, acc: Int) {
  若 i >= len(tokens) { 返回 {node: {kind: "记录", fields: acc}, next: i} }
  定 t = tokens[i]
  若 is_punct(t, "}") { 返回 {node: {kind: "记录", fields: acc}, next: i + 1} }
  若 t.kind != "ident" { 返回 {node: {kind: "误", text: t.text, line: t.line, column: t.column}, next: i + 1} }
  定 name = t.text
  若 i + 1 >= len(tokens) || !is_punct(tokens[i + 1], ":") {
    返回 {node: {kind: "误", text: name, line: t.line, column: t.column}, next: i + 1}
  }
  定 value = logic(tokens, i + 2)
  var next = value.next
  若 next < len(tokens) && is_punct(tokens[next], ",") { next = next + 1 }
  返回 record_tail(tokens, next, acc + ({name: name, value: value.node},))
}

函数 mul_tail(tokens: Int, i: Int, left: Int) {
  若 i >= len(tokens) { 返回 {node: left, next: i} }
  定 t = tokens[i]
  若 t.kind == "punct" && (t.text == "*" || t.text == "/" || t.text == "%") {
    定 right = postfix(tokens, i + 1)
    返回 mul_tail(tokens, right.next, {kind: "二元", op: t.text, left: left, right: right.node, line: t.line, column: t.column})
  }
  返回 {node: left, next: i}
}

函数 mul(tokens: Int, i: Int) -> Int {
  定 left = postfix(tokens, i)
  返回 mul_tail(tokens, left.next, left.node)
}

函数 add_tail(tokens: Int, i: Int, left: Int) {
  若 i >= len(tokens) { 返回 {node: left, next: i} }
  定 t = tokens[i]
  若 t.kind == "punct" && (t.text == "+" || t.text == "-") {
    定 right = mul(tokens, i + 1)
    返回 add_tail(tokens, right.next, {kind: "二元", op: t.text, left: left, right: right.node, line: t.line, column: t.column})
  }
  返回 {node: left, next: i}
}

// 逻辑层（最低一级）：or 与 and。
//
// 这一层是补上的，而它缺席的样子很难认：源里写 若 a && b { 时，条件解析停在 &&，
// 于是 parse_if 看到的下一个记号不是花括号，报「语法层报的错：若」——
// 错的文字是 若，与 && 一点关系都看不出来。
//
// 优先级：|| 低于 &&，两者都低于比较。左右结合按语言自己的表（src/parser.mjs）。
函数 or_op(t: Int) -> String {
  若 t.kind != "punct" { 返回 "" }
  若 t.text == "||" { 返回 "||" }
  返回 ""
}

函数 and_op(t: Int) -> String {
  若 t.kind != "punct" { 返回 "" }
  若 t.text == "&&" { 返回 "&&" }
  返回 ""
}

公开 函数 logic(tokens: Int, i: Int) -> Int {
  定 left = and_level(tokens, i)
  返回 logic_tail(tokens, left.next, left.node)
}

函数 logic_tail(tokens: Int, i: Int, acc: Int) {
  若 i >= len(tokens) { 返回 {node: acc, next: i} }
  定 t = tokens[i]
  定 op = or_op(t)
  若 op == "" { 返回 {node: acc, next: i} }
  定 right = and_level(tokens, i + 1)
  返回 logic_tail(tokens, right.next, {kind: "二元", op: op, left: acc, right: right.node, line: t.line, column: t.column})
}

函数 and_level(tokens: Int, i: Int) -> Int {
  定 left = compare(tokens, i)
  返回 and_tail(tokens, left.next, left.node)
}

函数 and_tail(tokens: Int, i: Int, acc: Int) {
  若 i >= len(tokens) { 返回 {node: acc, next: i} }
  定 t = tokens[i]
  定 op = and_op(t)
  若 op == "" { 返回 {node: acc, next: i} }
  定 right = compare(tokens, i + 1)
  返回 and_tail(tokens, right.next, {kind: "二元", op: op, left: acc, right: right.node, line: t.line, column: t.column})
}

// 比较层（低于加减，高于逻辑）。
// 优先级取自语言自己的表（src/parser.mjs 的 PRECEDENCE），不是凭手感排的。
函数 cmp_op(t: Int) -> String {
  若 t.kind != "punct" { 返回 "" }
  定 x = t.text
  若 x == "==" || x == "!=" || x == "<" || x == "<=" || x == ">" || x == ">=" { 返回 x }
  返回 ""
}

函数 compare(tokens: Int, i: Int) -> Int {
  定 left = add(tokens, i)
  返回 compare_tail(tokens, left.next, left.node)
}

函数 compare_tail(tokens: Int, i: Int, acc: Int) {
  若 i >= len(tokens) { 返回 {node: acc, next: i} }
  定 t = tokens[i]
  定 op = cmp_op(t)
  若 op == "" { 返回 {node: acc, next: i} }
  定 right = add(tokens, i + 1)
  返回 compare_tail(tokens, right.next, {kind: "二元", op: op, left: acc, right: right.node, line: t.line, column: t.column})
}

// 一元负号只作用在一个乘除项上，然后这个结果回到加减的尾部继续走——
// 于是 -5 + 3 读作 (-5) + 3，而不是只解析到 -5 就收工。
// 一元负号自己也要递归一层，好认得出 --5。
函数 unary_or_mul(tokens: Int, i: Int) {
  若 i < len(tokens) && is_punct(tokens[i], "-") {
    定 位 = tokens[i]
    定 operand = unary_or_mul(tokens, i + 1)
    返回 {node: {kind: "一元", op: "-", operand: operand.node, line: 位.line, column: 位.column}, next: operand.next}
  }
  // 逻辑非：!x。它缺席的样子是「解析器在 ! 上停住，上层报出来的却是别处的错」。
  若 i < len(tokens) && is_punct(tokens[i], "!") {
    定 位 = tokens[i]
    定 operand = unary_or_mul(tokens, i + 1)
    返回 {node: {kind: "一元", op: "!", operand: operand.node, line: 位.line, column: 位.column}, next: operand.next}
  }
  返回 mul(tokens, i)
}

函数 add(tokens: Int, i: Int) -> Int {
  定 left = unary_or_mul(tokens, i)
  返回 add_tail(tokens, left.next, left.node)
}

// 宿主入口：吃掉一串 token，回一棵树和停下的位置。
公开 函数 chain(tokens: Int) -> Int {
  返回 compare(tokens, 0)
}

// 树上的叶子，方便与词法再对一次。
函数 leaves(tree: Int, acc: Int) -> Int {
  若 tree.kind == "二元" {
    返回 leaves(tree.right, leaves(tree.left, acc))
  }
  若 tree.kind == "字" || tree.kind == "名" {
    返回 acc + (tree.text,)
  }
  返回 acc
}

函数 main() -> Int {
  // 手工造三个 token，验证这条链最小的一步能走
  定 tokens = ({kind: "int", text: "1"}, {kind: "punct", text: "+"}, {kind: "int", text: "2"})
  定 tree = chain(tokens)
  print(tree.node.op)
  print(len(leaves(tree.node, ())))
  返回 0
}
