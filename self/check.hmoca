// 测试调度器：读清单，一个一个跑，汇总。
//
// 这是「工具链搬进 HMYR」的第一项。它只用两件世界面：读一份文本、跑一个程序，
// 而两件都已经是 C 机器上的内置。套件本身仍然是 node 脚本 ——
// 它们要拿 src/ 那一侧当对照，而对照必须是另一种实现。
//
// 用法：hmyr self/check.hmyr [清单路径]
// 清单格式：每行「名字<TAB>路径」，由 node tools/check-all.mjs --list 生成。
// 默认读 tools/suite-list.txt。

// 一段输出的最后一行：套件的判定就在那一行（「N passed, M failed」）。
函数 最后一行(文: String) -> String {
  若 len(文) == 0 { 返回 "" }
  定 行批 = split(文, chr(10))
  变 i = len(行批) - 1
  当 i >= 0 {
    定 行 = 行批[i]
    若 len(行) > 0 { 返回 行 }
    i = i - 1
  }
  返回 ""
}

函数 跑一个(名字: String, 路: String) -> Int {
  定 r = run_program("node", (路,))
  若 r.code == 0 {
    print("  通过  " + 名字 + "  " + 最后一行(r.stdout) + chr(10))
    返回 0
  }
  定 错 = 最后一行(r.stderr)
  若 len(错) > 0 {
    print("  不通过  " + 名字 + "  " + 最后一行(r.stdout) + "  " + 错 + chr(10))
  } 否则 {
    print("  不通过  " + 名字 + "  " + 最后一行(r.stdout) + chr(10))
  }
  返回 1
}

函数 main() -> Int 效果串(file, process) {
  定 参 = argv()
  变 清单路 = "tools/suite-list.txt"
  若 len(参) > 1 { 清单路 = 参[1] }
  定 文 = read_text(清单路)
  定 行批 = split(文, chr(10))
  变 过 = 0
  变 败 = 0
  变 i = 0
  当 i < len(行批) {
    定 行 = 行批[i]
    若 len(行) > 0 {
      定 列 = split(行, chr(9))
      若 len(列) >= 2 {
        若 跑一个(列[0], 列[1]) == 0 { 过 = 过 + 1 } 否则 { 败 = 败 + 1 }
      }
    }
    i = i + 1
  }
  print("" + chr(10))
  print(str(过) + " passed, " + str(败) + " failed" + chr(10))
  若 败 > 0 { 返回 1 }
  返回 0
}
