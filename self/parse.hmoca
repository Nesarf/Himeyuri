// 用 Himeyuri 写的第三件前端部件：一个表达式解析器。
//
// 深度是**先安排好的**，不是碰巧够用：优先级只有「加减」与「乘除」两级，加原子一层，
// 括号嵌套按嵌套深度增长。解析单个表达式时，深度是常数；这与前两件（每个 token 一层）不同，
// 所以它不会碰到调用深度上限。
//
// 形状与 JS 版解析器对齐，只保留结构：
//   {kind: "字", type: "int", text}         整数（原文）
//   {kind: "名", text}        标识符
//   {kind: "二元", op, left, right}
// 对拍时 JS 侧做同样的映射，行号一类的位置信息两边都不带。
//
// 自足：模块系统还没有，工具函数在这里重写一份。
// 边界写在明处：只认 + - * / % 与括号，不认一元负号，不认比较与逻辑运算。

fn digits() -> String {
  返回 "0123456789"
}

fn letters() -> String {
  返回 "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
}

fn in_set(ch: String, set: String, i: Int) -> Bool {
  若 i >= len(set) { 返回 false }
  若 ch == set[i] { 返回 true }
  返回 in_set(ch, set, i + 1)
}

fn is_digit_c(c: String) -> Bool {
  返回 in_set(c, digits(), 0)
}

fn is_alpha_c(c: String) -> Bool {
  返回 in_set(c, letters(), 0)
}

fn is_ident_c(c: String) -> Bool {
  返回 is_alpha_c(c) || is_digit_c(c)
}

fn skip_sp(s: String, i: Int) -> Int {
  若 i >= len(s) { 返回 i }
  若 s[i] == " " || s[i] == "\t" { 返回 skip_sp(s, i + 1) }
  返回 i
}

fn read_num(s: String, i: Int, acc: String) {
  若 i >= len(s) { 返回 {next: i, text: acc} }
  若 is_digit_c(s[i]) { 返回 read_num(s, i + 1, acc + s[i]) }
  返回 {next: i, text: acc}
}

fn read_name(s: String, i: Int, acc: String) {
  若 i >= len(s) { 返回 {next: i, text: acc} }
  若 is_ident_c(s[i]) { 返回 read_name(s, i + 1, acc + s[i]) }
  返回 {next: i, text: acc}
}

// 原子：括号、整数、标识符。括号里的解析回到最低优先级那一层。
fn parse_atom(s: String, i: Int) {
  定 j = skip_sp(s, i)
  若 j >= len(s) { 返回 {node: {kind: "误", text: ""}, next: j} }
  定 c = s[j]
  若 c == "(" {
    定 inner = parse_add(s, j + 1)
    定 k = skip_sp(s, inner.next)
    若 k < len(s) && s[k] == ")" { 返回 {node: inner.node, next: k + 1} }
    返回 {node: inner.node, next: k}
  }
  若 is_digit_c(c) {
    定 got = read_num(s, j, "")
    返回 {node: {kind: "字", type: "int", text: got.text}, next: got.next}
  }
  若 is_alpha_c(c) {
    定 got = read_name(s, j, "")
    返回 {node: {kind: "名", text: got.text}, next: got.next}
  }
  返回 {node: {kind: "误", text: c}, next: j + 1}
}

// 乘除一层：左结合，靠尾递归累积，层数不随运算个数增长。
fn mul_tail(s: String, i: Int, left: Int) {
  定 j = skip_sp(s, i)
  若 j >= len(s) { 返回 {node: left, next: j} }
  定 c = s[j]
  若 c == "*" || c == "/" || c == "%" {
    定 right = parse_atom(s, j + 1)
    返回 mul_tail(s, right.next, {kind: "二元", op: c, left: left, right: right.node})
  }
  返回 {node: left, next: j}
}

fn parse_mul(s: String, i: Int) -> Int {
  定 left = parse_atom(s, i)
  返回 mul_tail(s, left.next, left.node)
}

// 加减一层：同样左结合。
fn add_tail(s: String, i: Int, left: Int) {
  定 j = skip_sp(s, i)
  若 j >= len(s) { 返回 {node: left, next: j} }
  定 c = s[j]
  若 c == "+" || c == "-" {
    定 right = parse_mul(s, j + 1)
    返回 add_tail(s, right.next, {kind: "二元", op: c, left: left, right: right.node})
  }
  返回 {node: left, next: j}
}

fn parse_add(s: String, i: Int) -> Int {
  定 left = parse_mul(s, i)
  返回 add_tail(s, left.next, left.node)
}

// 宿主入口：解析一个表达式，返回 {node, next}。
pub fn parse(text: String) -> Int {
  返回 parse_add(text, 0)
}

// 这里原有一个演示用的 main（打印 1 + 2 * 3 的两个运算符）。
// 删掉它是因为 self/fmt.hmyr 要 引入 这一份 —— 两份 main 合在一起只有一个能活，
// 而活着的是先到的那一个，于是格式化器会变成一段「打印 +*」的演示。
// 演示由 test/self-parse.test.mjs 覆盖，它直接调 parse。
