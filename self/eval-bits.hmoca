// 位运算这八个内置：位与、位或、位异或、位非、位右移、位加、位循环右移、位循环左移。
//
// 为什么单独立一份（2026-11-05）：求调用 那一大块分派的第七刀。与前面几刀同形 ——
// 只依赖 eval-core.hmoca 里的 好 坏 要效果，交回 {有, 结果}。
//
// 这一门语言没有内建的位运算（数是双精度），所以这八条是编号、哈希、打包那几处唯一的办法。

引入 "./eval-core.hmoca"

公开 函数 求内置位(名: String, 值簇: Int, 环境: Int) {
若 名 == "位与" {
    若 len(值簇) != 2 { 返回 {有: 真, 结果: 坏("位与 要两个参数")} }
    返回 {有: 真, 结果: 好(位与(值簇[0], 值簇[1]))}
  }
若 名 == "位或" {
    若 len(值簇) != 2 { 返回 {有: 真, 结果: 坏("位或 要两个参数")} }
    返回 {有: 真, 结果: 好(位或(值簇[0], 值簇[1]))}
  }
若 名 == "位异或" {
    若 len(值簇) != 2 { 返回 {有: 真, 结果: 坏("位异或 要两个参数")} }
    返回 {有: 真, 结果: 好(位异或(值簇[0], 值簇[1]))}
  }
若 名 == "位非" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("位非 要一个参数")} }
    返回 {有: 真, 结果: 好(位非(值簇[0]))}
  }
若 名 == "位右移" {
    若 len(值簇) != 2 { 返回 {有: 真, 结果: 坏("位右移 要两个参数")} }
    返回 {有: 真, 结果: 好(位右移(值簇[0], 值簇[1]))}
  }
若 名 == "位加" {
    若 len(值簇) != 2 { 返回 {有: 真, 结果: 坏("位加 要两个参数")} }
    返回 {有: 真, 结果: 好(位加(值簇[0], 值簇[1]))}
  }
若 名 == "位循环右移" {
    若 len(值簇) != 2 { 返回 {有: 真, 结果: 坏("位循环右移 要两个参数")} }
    返回 {有: 真, 结果: 好(位循环右移(值簇[0], 值簇[1]))}
  }
若 名 == "位循环左移" {
    若 len(值簇) != 2 { 返回 {有: 真, 结果: 坏("位循环左移 要两个参数")} }
    返回 {有: 真, 结果: 好(位循环左移(值簇[0], 值簇[1]))}
  }
  返回 {有: 假, 结果: 0}
}
