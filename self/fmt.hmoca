// 格式化器：整文件的缩进与行尾规范化；表达式那一条留在 --expr 上。
//
// 两条路各说各的边界：
//   整文件  按花括号深度重排行首缩进（每层两个空格），行内一个字不动。
//           它不重排表达式、不动注释内容 —— 所以「能编 + 幂等」是它能许的承诺。
//   --expr  走 self/parse.hmyr 的表达式语法树，括号按优先级与结合性补。
//           那是另一件事：重排，而不是缩进。
//
// 为什么整文件那一条不做语法树重排：写这句话的时候，自举侧读函数体的那一件只到
// 函数体，读整份声明的接口还没有。而 body.hmoca 现在有 parse_decls（整套声明），
// 所以「没有接口」这个理由已经不成立 —— 整文件重排缺的是别的东西：时间与判据。
// 于是这条路仍然是「先缩进、再谈重排」，但它已经从「不能」变成了「还没做」
// （2026-11-01 改）。
//
// 用法：hmyr self/fmt.hmyr < 源.hmyr        （整文件，写到标准输出）
//       hmyr self/fmt.hmyr --expr < 表达式.txt

引入 "./parse.hmoca"

函数 去首尾(行: String) -> String {
  变 起 = 0
  变 止 = len(行)
  变 左 = 真
  当 起 < 止 && 左 {
    若 行[起] == " " || 行[起] == chr(9) || 行[起] == chr(13) { 起 = 起 + 1 } 否则 { 左 = 假 }
  }
  变 右 = 真
  当 止 > 起 && 右 {
    若 行[止 - 1] == " " || 行[止 - 1] == chr(9) || 行[止 - 1] == chr(13) { 止 = 止 - 1 } 否则 { 右 = 假 }
  }
  返回 slice(行, 起, 止)
}

函数 以(文: String, 前: String) -> Bool {
  若 len(文) < len(前) { 返回 假 }
  返回 slice(文, 0, len(前)) == 前
}

函数 数(文: String, c: String) -> Int {
  变 数 = 0
  变 i = 0
  当 i < len(文) {
    若 文[i] == c { 数 = 数 + 1 }
    i = i + 1
  }
  返回 数
}

函数 空格册(n: Int) -> String {
  变 出 = ""
  变 i = 0
  当 i < n {
    出 = 出 + "  "
    i = i + 1
  }
  返回 出
}

// 整文件：逐行算缩进。行首是右花括号时先减一层 —— 这与「关了一层」是同一件事，
// 所以新层正好等于输出用的那一层；像 } 否则 { 这种一行里又关又开的，也自洽。
函数 整文件(源: String) -> String {
  定 行批 = split(源, chr(10))
  // 末尾那个空项是「最后一行之后的换行」留下的，不是一行 —— 输出它就会每跑一次多一个空行。
  变 止 = len(行批)
  若 止 > 0 && len(行批[止 - 1]) == 0 { 止 = 止 - 1 }
  变 出 = ""
  变 层 = 0
  变 i = 0
  当 i < 止 {
    定 净 = 去首尾(行批[i])
    若 len(净) == 0 {
      出 = 出 + chr(10)
    } 否则 {
      变 输出层 = 层
      若 以(净, "}") { 输出层 = 层 - 1 }
      若 输出层 < 0 { 输出层 = 0 }
      出 = 出 + 空格册(输出层) + 净 + chr(10)
      层 = 层 + 数(净, "{") - 数(净, "}")
      若 层 < 0 { 层 = 0 }
    }
    i = i + 1
  }
  返回 出
}

// 表达式那一支：括号按优先级与结合性补，打印两次与打印一次一样。
函数 优先(op: String) -> Int {
  若 op == "+" { 返回 1 }
  若 op == "-" { 返回 1 }
  若 op == "*" { 返回 2 }
  若 op == "/" { 返回 2 }
  若 op == "%" { 返回 2 }
  返回 0
}

函数 打印(e: Int, 父: Int, 是右: Bool) -> String {
  若 e.kind == "字" { 返回 e.text }
  若 e.kind == "名" { 返回 e.text }
  定 本 = 优先(e.op)
  定 左 = 打印(e.left, 本, 假)
  定 右 = 打印(e.right, 本, 真)
  定 文 = 左 + " " + e.op + " " + 右
  若 本 < 父 { 返回 "(" + 文 + ")" }
  若 是右 && 本 == 父 { 返回 "(" + 文 + ")" }
  返回 文
}

函数 main() -> Int {
  定 参 = argv()
  变 是表达式 = 假
  变 i = 0
  当 i < len(参) {
    若 参[i] == "--expr" { 是表达式 = 真 }
    i = i + 1
  }
  若 是表达式 {
    变 跑 = 真
    当 跑 {
      定 r = read_stdin_line()
      若 len(r.行) > 0 {
        定 t = parse(r.行)
        print(打印(t.node, 0, 假) + chr(10))
      }
      若 r.结束 { 跑 = 假 }
    }
    返回 0
  }
  变 源 = ""
  变 继续 = 真
  当 继续 {
    定 r = read_stdin_line()
    若 r.结束 {
      // 末尾那一行：有内容就接上，没有就不再补换行 —— 补了会让每跑一次多一个空行，
      // 而「打印两次与打印一次一样」正是这一支要许的承诺。
      若 len(r.行) > 0 { 源 = 源 + r.行 }
      继续 = 假
    } 否则 {
      源 = 源 + r.行 + chr(10)
    }
  }
  print(整文件(源))
  返回 0
}
