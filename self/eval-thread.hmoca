// 线程这四个内置：求调用 那一大块分派的第五刀（第四刀是 eval-term）。
//
// 为什么单独立一份（2026-11-05）：与前几刀同形 —— 四条分支各四五行，只依赖
// eval-core.hmoca 里的 好 坏 要效果，交回 {有, 结果}。
//
// 这一组在自举层里是唯一涉及并发的一块：起、等、取消、数。它们不参与求值本身，
// 但与 eval-term 那种「边缘能力」不同 —— 线程改变的是「同时还有谁在跑」，
// 所以它值得自己一个文件，而不是挤在别处。

引入 "./eval-core.hmoca"

公开 函数 求内置线程(名: String, 值簇: Int, 环境: Int) {
若 名 == "thr_spawn" {
    若 len(值簇) != 2 { 返回 {有: 真, 结果: 坏("thr_spawn 要两个参数")} }
    返回 {有: 真, 结果: 好(thr_spawn(值簇[0], 值簇[1]))}
  }
若 名 == "thr_join" {
    若 len(值簇) < 1 { 返回 {有: 真, 结果: 坏("thr_join 至少要一个参数")} }
    若 len(值簇) == 1 { 返回 {有: 真, 结果: 好(thr_join(值簇[0]))} }
    返回 {有: 真, 结果: 好(thr_join(值簇[0], 值簇[1]))}
  }
若 名 == "thr_cancel" {
    若 len(值簇) != 1 { 返回 {有: 真, 结果: 坏("thr_cancel 要一个参数")} }
    返回 {有: 真, 结果: 好(thr_cancel(值簇[0]))}
  }
若 名 == "thr_count" {
    若 len(值簇) != 0 { 返回 {有: 真, 结果: 坏("thr_count 不要参数")} }
    返回 {有: 真, 结果: 好(thr_count())}
  }
  返回 {有: 假, 结果: 0}
}
