// SHA-256：清单里每一个文件的哈希与整份的 digest 都要它。
//
// 位运算走内建（位与/位或/位异或/位非/位右移/位加/位循环右移/位循环左移）。
// 早先这一份自带逐位的 32 轮循环版本，对 30 KB 跑了三十分钟没出结果 —— 那是把
// 「语言里没有位运算符」的代价摊在每一次调用上。内建之后，一次位运算就是一次。
//
// 用法：hmyr self/sha256.hmyr <文件>       打印 64 位十六进制

// 2 的 n 次幂：十六进制输出要它按 4 位一段往下取。
公开 函数 倍(n: Int) -> Int {
  变 v = 1
  变 i = 0
  当 i < n {
    v = v * 2
    i = i + 1
  }
  返回 v
}

// 折半拼接：把几十块并成一条，复制量是「块数乘对数」而不是平方。
公开 函数 拼平(块堆: Int, 起: Int, 止: Int) {
  若 止 - 起 <= 1 { 返回 块堆[起] }
  变 左 = 起
  变 右 = 止
  当 右 - 左 > 2 {
    左 = 左 + 1
    右 = 右 - 1
  }
  定 中 = 左 + 1
  返回 拼平(块堆, 起, 中) + 拼平(块堆, 中, 止)
}

// 六十四轮常量。
函数 常量册() {
  返回 (1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
    3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
    3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
    2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
    666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
    2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
    430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
    1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298)
}

函数 初值() {
  返回 (1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225)
}

// 小写 sigma0：ror7 异或 ror18 异或 shr3
函数 小零(x: Int) -> Int {
  返回 位异或(位异或(位循环右移(x, 7), 位循环右移(x, 18)), 位右移(x, 3))
}

// 小写 sigma1：ror17 异或 ror19 异或 shr10
函数 小一(x: Int) -> Int {
  返回 位异或(位异或(位循环右移(x, 17), 位循环右移(x, 19)), 位右移(x, 10))
}

// 大写 Sigma0：ror2 异或 ror13 异或 ror22
函数 大零(x: Int) -> Int {
  返回 位异或(位异或(位循环右移(x, 2), 位循环右移(x, 13)), 位循环右移(x, 22))
}

// 大写 Sigma1：ror6 异或 ror11 异或 ror25
函数 大一(x: Int) -> Int {
  返回 位异或(位异或(位循环右移(x, 6), 位循环右移(x, 11)), 位循环右移(x, 25))
}

函数 取字(块: Int, i: Int) -> Int {
  返回 to_int(块[i * 4]) * 16777216 + to_int(块[i * 4 + 1]) * 65536 + to_int(块[i * 4 + 2]) * 256 + to_int(块[i * 4 + 3])
}

// 一个 512 位块压进八个字里，交回新的八个字。
函数 一块(哈希串: Int, 块: Int) {
  定 常 = 常量册()
  // W 用可变数组：64 项，每一轮追加一个 —— 用元组就是每轮重建整条，平方级。
  变 W初 = ()
  变 i = 0
  当 i < 64 {
    W初 = W初 + (0,)
    i = i + 1
  }
  定 W = 数组(W初)
  i = 0
  当 i < 16 {
    设(W, i, 取字(块, i))
    i = i + 1
  }
  当 i < 64 {
    定 x = W[i - 15]
    定 y = W[i - 2]
    设(W, i, 位加(位加(位加(W[i - 16], 小零(x)), W[i - 7]), 小一(y)))
    i = i + 1
  }
  变 a = to_int(哈希串[0])
  变 b = to_int(哈希串[1])
  变 c = to_int(哈希串[2])
  变 d = to_int(哈希串[3])
  变 e = to_int(哈希串[4])
  变 f = to_int(哈希串[5])
  变 g = to_int(哈希串[6])
  变 h = to_int(哈希串[7])
  i = 0
  当 i < 64 {
    // Ch(e,f,g) = (e 与 f) 异或 (非 e 与 g)；Maj(a,b,c) = 三对两两相与再异或。
    定 Ch = 位异或(位与(e, f), 位与(位非(e), g))
    定 Maj = 位异或(位异或(位与(a, b), 位与(a, c)), 位与(b, c))
    定 t1 = 位加(位加(位加(h, 大一(e)), Ch), 位加(to_int(常[i]), to_int(W[i])))
    定 t2 = 位加(大零(a), Maj)
    h = g
    g = f
    f = e
    e = 位加(d, t1)
    d = c
    c = b
    b = a
    a = 位加(t1, t2)
    i = i + 1
  }
  返回 (位加(to_int(哈希串[0]), a), 位加(to_int(哈希串[1]), b), 位加(to_int(哈希串[2]), c), 位加(to_int(哈希串[3]), d),
    位加(to_int(哈希串[4]), e), 位加(to_int(哈希串[5]), f), 位加(to_int(哈希串[6]), g), 位加(to_int(哈希串[7]), h))
}

// 填充：0x80、若干 0、最后八字节是大端位长。
//
// 这里用块化 + 折平拼接，不是 出 = 出 + (...)：三十 KB 的文件那样拼是平方级，
// 而它正是上一版跑十五分钟没结果的真正原因 —— 不是位运算，是这个循环。
函数 填充(字节串: Int) {
  定 原长 = len(字节串)
  变 块堆 = ()
  变 小块 = ()
  变 i = 0
  当 i < 原长 {
    小块 = 小块 + (to_int(字节串[i]),)
    若 len(小块) >= 1024 {
      块堆 = 块堆 + (小块,)
      小块 = ()
    }
    i = i + 1
  }
  小块 = 小块 + (128,)
  当 (len(块堆) * 1024 + len(小块) + 8) % 64 != 0 {
    小块 = 小块 + (0,)
  }
  变 位长 = 原长 * 8
  变 倍量 = 倍(56)
  变 k = 0
  当 k < 8 {
    定 b = (位长 - 位长 % 倍量) / 倍量
    小块 = 小块 + (b % 256,)
    位长 = 位长 - b * 倍量
    倍量 = 倍量 / 256
    k = k + 1
  }
  若 len(小块) > 0 { 块堆 = 块堆 + (小块,) }
  若 len(块堆) == 0 { 返回 () }
  返回 拼平(块堆, 0, len(块堆))
}

函数 十六进制(值: Int) -> String {
  定 表 = "0123456789abcdef"
  变 出 = ""
  变 每 = 8
  当 每 > 0 {
    定 割 = 倍(每 * 4 - 4)
    定 d = (值 - 值 % 割) / 割
    出 = 出 + 表[d]
    值 = 值 - d * 割
    每 = 每 - 1
  }
  返回 出
}

公开 函数 sha256(字节串: Int) -> String {
  定 填 = 填充(字节串)
  变 哈希串 = 初值()
  变 起 = 0
  当 起 < len(填) {
    变 块 = ()
    变 k = 0
    当 k < 64 {
      块 = 块 + (to_int(填[起 + k]),)
      k = k + 1
    }
    哈希串 = 一块(哈希串, 块)
    起 = 起 + 64
  }
  变 出 = ""
  变 i = 0
  当 i < 8 {
    出 = 出 + 十六进制(to_int(哈希串[i]))
    i = i + 1
  }
  返回 出
}

函数 main() -> Int 效果串(file, process) {
  定 参 = argv()
  若 len(参) < 2 {
    print("用法：hmyr self/sha256.hmyr <文件>" + chr(10))
    返回 2
  }
  定 字节串 = read_bytes(参[1])
  print(sha256(字节串) + chr(10))
  返回 0
}
