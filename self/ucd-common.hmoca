// 两个小函数，三份程序都要用它们：修剪 与 十六进制值。
//
// 2026-11-05：它们原先在 self/ucd-case.hmoca 与 self/ucd-nfc.hmoca 各一份，
// 十六进制值 还在 self/ucd-c.hmoca 有第三份，三份逐字相同。
//
// 为什么值得一个文件（2026-11-05）：self/ucd-case.hmoca 与 self/ucd-nfc.hmoca
// 各抄了一份完全一样的 修剪 —— 逐字相同，连两个循环变量的名字都一样（走、走2）。
// 那两份产物是拿这同一个函数去读 UCD 语料的，所以「改一处忘另一处」的代价不是
// 两个程序不一致，而是两个产物由两段不同的代码生成，而它们又要求逐字节相同。
//
// 这份文件没有 main：它只是被那两个程序 引入 的一段函数。
// 认的空白是空格、制表、回车 —— 不含换行，因为 UCD 的字段是按行切的，
// 换行在切好之后已经不在字段里了。

函数 修剪(文: String) -> String {
  变 起 = 0
  变 止 = len(文)
  变 走 = 真
  当 起 < 止 && 走 {
    定 c = 文[起]
    若 c == " " || c == chr(9) || c == chr(13) { 起 = 起 + 1 } 否则 { 走 = 假 }
  }
  变 完 = 止
  变 走2 = 真
  当 完 > 起 && 走2 {
    定 c = 文[完 - 1]
    若 c == " " || c == chr(9) || c == chr(13) { 完 = 完 - 1 } 否则 { 走2 = 假 }
  }
  返回 slice(文, 起, 完)
}

函数 十六进制值(文: String) -> Int {
  变 v = 0
  变 i = 0
  当 i < len(文) {
    定 c = 文[i]
    变 d = 0 - 1
    变 k = 0
    当 k < 10 {
      若 c == "0123456789"[k] { d = k }
      k = k + 1
    }
    变 k2 = 0
    当 k2 < 6 {
      若 c == "abcdef"[k2] { d = 10 + k2 }
      若 c == "ABCDEF"[k2] { d = 10 + k2 }
      k2 = k2 + 1
    }
    若 d >= 0 { v = v * 16 + d }
    i = i + 1
  }
  返回 v
}

函数 十六进制写法(n: Int) -> String {
  若 n == 0 { 返回 "0" }
  定 表 = "0123456789ABCDEF"
  变 出 = ""
  变 v = n
  // 取模与 floor 都要用：这一门语言的数字只有双精度，`v - (v / 16) * 16` 在浮点除法不精确时
  // 会算出负的极小值（实测 -2e-323），而它当下标就是越界。
  当 v > 0 {
    出 = 表[v % 16] + 出
    v = floor(v / 16)
  }
  返回 出
}
