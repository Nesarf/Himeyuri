// 语言服务器：JSON-RPC 走标准输入与标准输出，照 LSP 的 Content-Length 框。
//
// 这是「工具链搬进 HMYR」的最后一件里最难的一件 —— 而它要的东西现在都有了：
// 读一行（头）、读 N 字节（体）、把字节解成文本、一个 JSON 库（lib/json.hmyr）。
//
// 它不重新分析程序：现在只回答「你是谁」与「关掉吧」。符号、定义、悬浮签名
// 都要读语法树，而那件事该由自举侧那一套前端来做 —— 一件一件来。
//
// 回话只用 ASCII：Content-Length 数的是字节，而这里的字符串长度数的是码元；
// 两边只有在全 ASCII 时才相等。要写中文进回话，得先量一次 UTF-8 字节数。
//
// 用法：hmyr self/lsp.hmyr

引入 "../lib/json.hmoca"
引入 "./sig.hmoca"

函数 是长度行(行: String) -> Bool {
  若 len(行) < 16 { 返回 假 }
  返回 slice(行, 0, 15) == "Content-Length:"
}

// " 123" → 123。只看数字，别的字符跳过。
函数 数值(文: String) -> Int {
  var v = 0
  var i = 0
  当 i < len(文) {
    定 o = ord(文[i])
    若 o >= 48 && o <= 57 { v = v * 10 + (o - 48) }
    i = i + 1
  }
  返回 v
}

// 读一条消息：头先读到空行为止，体按长度读。交回 {体, 结束}。
函数 读消息() {
  var 长 = 0 - 1
  var 继续 = 真
  var 完 = 假
  当 继续 {
    定 r = read_stdin_line()
    若 r.结束 {
      完 = 真
      继续 = 假
    } 否则 若 len(r.行) == 0 {
      继续 = 假
    } 否则 若 是长度行(r.行) {
      长 = 数值(slice(r.行, 15, len(r.行)))
    }
  }
  若 完 { 返回 {体: "", 结束: 真} }
  若 长 < 0 { 返回 {体: "", 结束: 真} }
  定 b = read_stdin_bytes(长)
  返回 {体: bytes_to_text(b.字节串), 结束: b.结束}
}

// 从 JSON 对象里取一个键。找不到交回空。
// 键是裸字符串（写对表那一支就是这么写的），值才是带标记的记录。
函数 取(对象: Int, 键: String) {
  若 !field_has(对象, "对象") { 返回 {空值: 1} }
  定 对们 = 对象.对象
  var i = 0
  当 i < len(对们) {
    若 对们[i][0] == 键 { 返回 对们[i][1] }
    i = i + 1
  }
  返回 {空值: 1}
}

函数 取串(对象: Int, 键: String) -> String {
  定 v = 取(对象, 键)
  若 field_has(v, "串") { 返回 v.串 }
  返回 ""
}

// 一段文本按 UTF-8 编码要几个字节。Content-Length 数的是字节，而 len 数的是码元 ——
// 回话里一旦出现中文，两者就不再相等。代理对按四个字节算（两个码元合起来才是一个字符）。
// 一段文本按 UTF-8 编码要几个字节。Content-Length 数的是字节，而 len 数的是码元 ——
// 回话里一旦出现中文，两者就不再相等。代理对按四个字节算（两个码元合起来才是一个字符）。
函数 utf8字节数(文: String) -> Int {
  var 数 = 0
  var i = 0
  当 i < len(文) {
    定 o = ord(文[i])
    var 宽 = 3
    var 是头 = 假
    若 o < 0x80 { 宽 = 1 }
    若 o >= 0x80 && o < 0x800 { 宽 = 2 }
    若 o >= 0xD800 && o <= 0xDBFF {
      宽 = 4
      是头 = 真
    }
    数 = 数 + 宽
    若 是头 { i = i + 1 }
    i = i + 1
  }
  返回 数
}

函数 应答(id: Int, 结果: Int) -> String {
  返回 生成({对象: (("jsonrpc", {串: "2.0"}), ("id", id), ("result", 结果))})
}

函数 应答错(id: Int, 码: Int, 话: String) -> String {
  返回 生成({对象: (("jsonrpc", {串: "2.0"}), ("id", id), ("error", {对象: (("code", {数: 码}), ("message", {串: 话}))}))})
}

// 一个字符算不算「词里的字」。中文与全角都算 —— 这门语言的标识符允许它们。
函数 是词字(c: String) -> Bool {
  定 o = ord(c)
  若 o >= 48 && o <= 57 { 返回 真 }
  若 o >= 65 && o <= 90 { 返回 真 }
  若 o >= 97 && o <= 122 { 返回 真 }
  若 o >= 128 { 返回 真 }
  返回 c == "_"
}

// 按行列从原文里取出那个词。位置给的是零基行列，与 LSP 一致。
函数 词在(文本: String, 行: Int, 列: Int) -> String {
  定 行批 = split(文本, chr(10))
  若 行 >= len(行批) { 返回 "" }
  定 该行 = 行批[行]
  var 起 = 列
  var 左停 = 假
  当 起 > 0 && !左停 {
    若 是词字(该行[起 - 1]) { 起 = 起 - 1 } 否则 { 左停 = 真 }
  }
  var 止 = 列
  var 右停 = 假
  当 止 < len(该行) && !右停 {
    若 是词字(该行[止]) { 止 = 止 + 1 } 否则 { 右停 = 真 }
  }
  若 止 <= 起 { 返回 "" }
  返回 slice(该行, 起, 止)
}

// 码元偏移换成行列。LSP 的 range 要行列，而 token 只记偏移。
函数 at转行列(文本: String, at: Int) {
  var 行 = 0
  var 列 = 0
  var i = 0
  var 止 = at
  若 止 > len(文本) { 止 = len(文本) }
  当 i < 止 {
    若 文本[i] == chr(10) {
      行 = 行 + 1
      列 = 0
    } 否则 {
      列 = 列 + 1
    }
    i = i + 1
  }
  返回 {行: 行, 列: 列}
}

函数 取数(对象: Int, 键: String) -> Int {
  定 v = 取(对象, 键)
  若 field_has(v, "数") { 返回 v.数 }
  返回 0
}

函数 找签名(列: Int, 名: String) {
  var i = 0
  当 i < len(列) {
    若 列[i].name == 名 { 返回 列[i] }
    i = i + 1
  }
  返回 {空值: 1}
}

// 一条签名排成一行：悬浮签名要的就是这一行。
函数 签名文字(签: Int) -> String {
  var 文 = "fn " + 签.name + "("
  var i = 0
  当 i < len(签.params) {
    若 i > 0 { 文 = 文 + ", " }
    文 = 文 + 签.params[i].name
    若 len(签.params[i].类型) > 0 { 文 = 文 + ": " + 签.params[i].类型 }
    i = i + 1
  }
  文 = 文 + ")"
  若 len(签.returns) > 0 { 文 = 文 + " -> " + 签.returns }
  返回 文
}


// 一份文档的符号：名字、类别、位置。
// 位置是零宽度的（起止都给 character 0）—— 与 src/lsp.mjs 同一条规矩：
// 签名只记「声明从哪个码元开始」，行内宽度它没有，编一个出来比留空更糟。
函数 符号表(文本: String, 地址: String) {
  定 tokens = scan(文本)
  定 列 = all_signatures(tokens)
  var 出 = ()
  var i = 0
  当 i < len(列) {
    定 名 = 列[i].name
    定 位 = at转行列(文本, 列[i].at)
    定 点 = {对象: (("line", {数: 位.行}), ("character", {数: 0}))}
    定 范围 = {对象: (("start", 点), ("end", 点))}
    定 地位 = {对象: (("uri", {串: 地址}), ("range", 范围))}
    出 = 出 + ({对象: (("name", {串: 名}), ("kind", {数: 12}), ("location", 地位))},)
    i = i + 1
  }
  返回 {数组: 出}
}

// 补全的候选：这份文档里的声明。与 src/lsp.mjs 那一份同一条约定 ——
// kind 用 CompletionItemKind（函数是 3），而 documentSymbol 用的是 SymbolKind（函数是 12）。
// 两张表各自成立，混用会让编辑器把函数显示成变量。
// 不做前缀过滤：那是客户端的事，编辑器会按已经敲下的几个字自己筛。
函数 补全表(文本: String) {
  定 列 = all_signatures(scan(文本))
  var 出 = ()
  var i = 0
  当 i < len(列) {
    定 签 = 列[i]
    定 一项 = {对象: (("label", {串: 签.name}), ("kind", {数: 3}), ("detail", {串: 签名文字(签)}))}
    出 = 出 + (一项,)
    i = i + 1
  }
  返回 {对象: (("isIncomplete", {假值: 1}), ("items", {数组: 出}))}
}

// ---- 跨模块：uri 与路径 ----
// 编辑器的 uri 是 file:// 的，文件系统要的是路径；换算只做这一处。
// file:///E:/a/b.hmyr → E:/a/b.hmyr（Windows 那个开头的斜杠要去掉）
// file:///tmp/x.hmyr  → /tmp/x.hmyr（在那里它本来就该在）
函数 地址转路径(地址: String) -> String {
  若 len(地址) <= 7 { 返回 "" }
  var 路 = slice(地址, 7, len(地址))
  若 len(路) >= 3 {
    若 路[0] == "/" && 路[2] == ":" { 路 = slice(路, 1, len(路)) }
  }
  返回 路
}

函数 目录名(路: String) -> String {
  var i = len(路) - 1
  当 i >= 0 {
    若 路[i] == "/" { 返回 slice(路, 0, i) }
    i = i - 1
  }
  返回 ""
}

// 引入 的路径相对当前文件所在目录，与加载器同一条规矩。
函数 拼导入(基: String, 相对: String) -> String {
  var 名 = 相对
  若 len(名) >= 2 {
    若 slice(名, 0, 2) == "./" { 名 = slice(名, 2, len(名)) }
  }
  返回 目录名(基) + "/" + 名
}

// 一份文本里的 引入 路径们。关键字在词法里是 ident，后面那一个必须是字符串。
函数 导入路们(文本: String) -> Int {
  定 tokens = scan(文本)
  var 出 = ()
  var i = 0
  当 i < len(tokens) {
    若 tokens[i].kind == "ident" && tokens[i].text == "import" {
      若 i + 1 < len(tokens) {
        若 tokens[i + 1].kind == "string" { 出 = 出 + (tokens[i + 1].text,) }
      }
    }
    i = i + 1
  }
  返回 出
}

// 一份文件的签名册。读不了就交回空元组 —— 问了一个打不开的文件不是错误。
函数 文件签名册(路: String) -> Int {
  var 出 = ()
  若 file_exists(路) { 出 = all_signatures(scan(read_text(路))) }
  返回 出
}

// 一个签名在它自己那份文本里的位置。
函数 地位(地址: String, 那份: String, 签: Int) {
  定 位 = at转行列(那份, 签.at)
  定 起 = {对象: (("line", {数: 位.行}), ("character", {数: 位.列}))}
  定 止 = {对象: (("line", {数: 位.行}), ("character", {数: 位.列 + len(签.name)}))}
  定 范围 = {对象: (("start", 起), ("end", 止))}
  返回 {对象: (("uri", {串: 地址}), ("range", 范围))}
}

// 处理一条消息：交回 {文, 停, 文本}。文本是「当前打开的文档」——
// didOpen 送来它，documentSymbol 用它。状态在这一层过一手，因为语言里没有可变的全局。
函数 处理(体: String, 文本: String) 效果串(file) {
  定 p = 解析(体)
  若 !p.ok { 返回 {文: "", 停: 假, 文本: 文本} }
  定 值 = p.值
  定 方法 = 取串(值, "method")
  定 id = 取(值, "id")
  若 方法 == "initialize" {
    定 能力 = {对象: (("textDocumentSync", {数: 1}), ("hoverProvider", {真值: 1}), ("documentSymbolProvider", {真值: 1}), ("definitionProvider", {真值: 1}), ("completionProvider", {对象: (("resolveProvider", {假值: 1}),)}))}
    定 己 = {对象: (("name", {串: "himeyuri"}), ("version", {串: "0.1.0-m8"}))}
    返回 {文: 应答(id, {对象: (("capabilities", 能力), ("serverInfo", 己))}), 停: 假, 文本: 文本}
  }
  若 方法 == "textDocument/didOpen" {
    定 文档 = 取(取(值, "params"), "textDocument")
    返回 {文: "", 停: 假, 文本: 取串(文档, "text")}
  }
  若 方法 == "textDocument/documentSymbol" {
    定 址 = 取串(取(取(值, "params"), "textDocument"), "uri")
    返回 {文: 应答(id, 符号表(文本, 址)), 停: 假, 文本: 文本}
  }
  若 方法 == "textDocument/completion" {
    返回 {文: 应答(id, 补全表(文本)), 停: 假, 文本: 文本}
  }
  若 方法 == "textDocument/definition" {
    定 位 = 取(取(值, "params"), "position")
    定 名 = 词在(文本, 取数(位, "line"), 取数(位, "character"))
    若 len(名) == 0 { 返回 {文: 应答(id, {空值: 1}), 停: 假, 文本: 文本} }
    定 地址 = 取串(取(取(值, "params"), "textDocument"), "uri")
    定 签 = 找签名(all_signatures(scan(文本)), 名)
    若 !field_has(签, "空值") {
      返回 {文: 应答(id, 地位(地址, 文本, 签)), 停: 假, 文本: 文本}
    }
    // 跨模块：本地没有，就按 引入 去目标文件里找。
    // 本地优先 —— 与 src/lsp.mjs 同一条规矩：同名符号优先离得近的那一个。
    定 基 = 地址转路径(地址)
    定 路们 = 导入路们(文本)
    var i = 0
    当 i < len(路们) {
      定 目标 = 拼导入(基, 路们[i])
      定 命中 = 找签名(文件签名册(目标), 名)
      若 !field_has(命中, "空值") {
        定 那份 = read_text(目标)
        var 址 = "file:///" + 目标
        若 len(目标) > 0 {
          若 目标[0] == "/" { 址 = "file://" + 目标 }
        }
        返回 {文: 应答(id, 地位(址, 那份, 命中)), 停: 假, 文本: 文本}
      }
      i = i + 1
    }
    返回 {文: 应答(id, {空值: 1}), 停: 假, 文本: 文本}
  }
  若 方法 == "textDocument/hover" {
    定 位 = 取(取(值, "params"), "position")
    定 名 = 词在(文本, 取数(位, "line"), 取数(位, "character"))
    若 len(名) == 0 { 返回 {文: 应答(id, {空值: 1}), 停: 假, 文本: 文本} }
    定 签 = 找签名(all_signatures(scan(文本)), 名)
    若 field_has(签, "空值") { 返回 {文: 应答(id, {空值: 1}), 停: 假, 文本: 文本} }
    定 内 = {对象: (("kind", {串: "plaintext"}), ("value", {串: 签名文字(签)}))}
    返回 {文: 应答(id, {对象: (("contents", 内),)}), 停: 假, 文本: 文本}
  }
  若 方法 == "shutdown" {
    返回 {文: 应答(id, {空值: 1}), 停: 假, 文本: 文本}
  }
  若 方法 == "exit" {
    返回 {文: "", 停: 真, 文本: 文本}
  }
  返回 {文: 应答错(id, 0 - 32601, "method not found"), 停: 假, 文本: 文本}
}

函数 main() -> Int 效果串(file) {
  var 跑 = 真
  var 文本 = ""
  当 跑 {
    定 m = 读消息()
    若 m.结束 {
      跑 = 假
    } 否则 {
      定 r = 处理(m.体, 文本)
      文本 = r.文本
      若 len(r.文) > 0 {
        print("Content-Length: " + str(utf8字节数(r.文)) + "\r\n\r\n" + r.文)
      }
      若 r.停 { 跑 = 假 }
    }
  }
  返回 0
}
