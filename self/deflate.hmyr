// deflate：stored 块与固定 Huffman 两支。
//
// 两支的分工写在名字上：
//   压      stored 块（BTYPE=00）。不压，压缩率 1.0 加五字节头；但它是合法的 deflate，
//           任何标准工具都读得懂。它是「格式对不对」的那一支。
//   固定压  固定 Huffman（BTYPE=01）加 LZ77。这一支才真的压。
//   解      只认 stored 块。固定 Huffman 的流现在由 zlib 解 —— 自举侧的解码器是下一步，
//           而这一步能许的承诺是「压出来的东西标准工具读得懂」。
//
// 一个 stored 块（按字节对齐）：
//   字节 0     BFINAL 在 bit0，BTYPE=00 在 bit1-2
//   字节 1-2   LEN，小端
//   字节 3-4   NLEN，LEN 的反码，小端
//   字节 5..   原始数据
//
// 固定 Huffman 的头三位：BFINAL=1、BTYPE=01，按 LSB 先写，值是 3。
//
// 用法：hmyr self/deflate.hmyr <输入> <输出> [--固定] [--解]

// 折半拼接：元组的 + 是复制，逐块拼是平方级 —— 与 self/compile.hmyr 的 拼两半 同一个形状。
fn 拼平(块们: Int, 起: Int, 止: Int) -> Int {
  if 止 - 起 <= 1 { return 块们[起] }
  var 左 = 起
  var 右 = 止
  while 右 - 左 > 2 {
    左 = 左 + 1
    右 = 右 - 1
  }
  let 中 = 左 + 1
  return 拼平(块们, 起, 中) + 拼平(块们, 中, 止)
}

fn 字节值(n: Int) -> Int {
  var v = n % 256
  if v < 0 { v = v + 256 }
  return v
}

fn 剩(总: Int, 起: Int) -> Int {
  let 剩 = 总 - 起
  if 剩 < 0 { return 0 }
  return 剩
}

// ---- stored 块 ----

fn 压(字节们: Int) {
  let 总 = len(字节们)
  var 块们 = ()
  var 小块 = ()
  var 起 = 0
  var 首 = true
  while 起 < 总 || 首 {
    var 块 = 剩(总, 起)
    if 块 > 65535 { 块 = 65535 }
    var 是末 = false
    if 起 + 块 >= 总 { 是末 = true }
    var 头 = 0
    if 是末 { 头 = 1 }
    let 反 = 65535 - 块
    小块 = 小块 + (头, 字节值(块), 字节值((块 - 块 % 256) / 256), 字节值(反), 字节值((反 - 反 % 256) / 256))
    var i = 0
    while i < 块 {
      小块 = 小块 + (字节值(to_int(字节们[起 + i])),)
      if len(小块) >= 1024 {
        块们 = 块们 + (小块,)
        小块 = ()
      }
      i = i + 1
    }
    起 = 起 + 块
    首 = false
  }
  if len(小块) > 0 { 块们 = 块们 + (小块,) }
  return 拼平(块们, 0, len(块们))
}

// 解：只认 BTYPE=00，一路读到 BFINAL=1 为止。
fn 解(字节们: Int) {
  let 总 = len(字节们)
  var 块们 = ()
  var 小块 = ()
  var at = 0
  var 完 = false
  while !完 && at + 5 <= 总 {
    let 头 = to_int(字节们[at])
    at = at + 1
    let 末 = 头 % 2
    let 型 = (头 - 末) / 2 % 4
    if 型 != 0 {
      完 = true
    } else {
      let 长 = to_int(字节们[at]) + to_int(字节们[at + 1]) * 256
      at = at + 4
      var i = 0
      while i < 长 && at < 总 {
        小块 = 小块 + (to_int(字节们[at]),)
        if len(小块) >= 1024 {
          块们 = 块们 + (小块,)
          小块 = ()
        }
        at = at + 1
        i = i + 1
      }
      if 末 == 1 { 完 = true }
    }
  }
  if len(小块) > 0 { 块们 = 块们 + (小块,) }
  if len(块们) == 0 { return () }
  return 拼平(块们, 0, len(块们))
}

// ---- 位流：deflate 的位是按 LSB 先写进字节的 ----

fn 倍(n: Int) -> Int {
  var v = 1
  var i = 0
  while i < n {
    v = v * 2
    i = i + 1
  }
  return v
}

// Huffman 码本身是高位先写，而位流是低位先写 —— 所以先把这个码的位序翻过来。
fn 反转位(码: Int, 位数: Int) -> Int {
  var 出 = 0
  var 值 = 码
  var i = 0
  while i < 位数 {
    let 位 = 值 % 2
    出 = 出 * 2 + 位
    值 = (值 - 位) / 2
    i = i + 1
  }
  return 出
}

fn 放位(状: Int, 值: Int, 位数: Int) {
  var 字节们 = 状.字节们
  var 当前 = 状.当前
  var 已 = 状.已
  var v = 值
  var i = 0
  while i < 位数 {
    let 位 = v % 2
    当前 = 当前 + 位 * 倍(已)
    已 = 已 + 1
    if 已 >= 8 {
      字节们 = 字节们 + (当前,)
      当前 = 0
      已 = 0
    }
    v = (v - 位) / 2
    i = i + 1
  }
  return {字节们: 字节们, 当前: 当前, 已: 已}
}

fn 刷(状: Int) {
  var 字节们 = 状.字节们
  if 状.已 > 0 { 字节们 = 字节们 + (状.当前,) }
  return {字节们: 字节们, 已: 0, 当前: 0}
}

// ---- 固定 Huffman 的码表（RFC 1951） ----

// 固定 Huffman 的符号码覆盖 0-287：字面量、结束码 256 与长度码 257-285 都在这一张表里，
// 但分段不同 —— 把长度码当字面量编，解出来的东西会在第一个匹配处就错。
//   0-143   八位   0x30 + 符号
//   144-255 九位   0x190 + (符号 - 144)
//   256-279 七位   符号 - 256
//   280-287 八位   0xC0 + (符号 - 280)
fn 符号码(s: Int) -> Int {
  if s <= 143 { return 48 + s }
  if s <= 255 { return 400 + (s - 144) }
  if s <= 279 { return s - 256 }
  return 192 + (s - 280)
}

fn 符号位数(s: Int) -> Int {
  if s <= 143 { return 8 }
  if s <= 255 { return 9 }
  if s <= 279 { return 7 }
  return 8
}

// 每一项是 (基值, 码, 额外位)。
fn 长表() {
  return ((3, 257, 0), (4, 258, 0), (5, 259, 0), (6, 260, 0), (7, 261, 0), (8, 262, 0), (9, 263, 0), (10, 264, 0),
    (11, 265, 1), (13, 266, 1), (15, 267, 1), (17, 268, 1), (19, 269, 2), (23, 270, 2), (27, 271, 2), (31, 272, 2),
    (35, 273, 3), (43, 274, 3), (51, 275, 3), (59, 276, 3), (67, 277, 4), (83, 278, 4), (99, 279, 4), (115, 280, 4),
    (131, 281, 5), (163, 282, 5), (195, 283, 5), (227, 284, 5), (258, 285, 0))
}

fn 距表() {
  return ((1, 0, 0), (2, 1, 0), (3, 2, 0), (4, 3, 0), (5, 4, 1), (7, 5, 1), (9, 6, 2), (13, 7, 2),
    (17, 8, 3), (25, 9, 3), (33, 10, 4), (49, 11, 4), (65, 12, 5), (97, 13, 5), (129, 14, 6), (193, 15, 6),
    (257, 16, 7), (385, 17, 7), (513, 18, 8), (769, 19, 8), (1025, 20, 9), (1537, 21, 9), (2049, 22, 10), (3073, 23, 10),
    (4097, 24, 11), (6145, 25, 11), (8193, 26, 12), (12289, 27, 12), (16385, 28, 13), (24577, 29, 13))
}

// 查表：从后往前扫，第一个「基值 <= 值」的就是它。
fn 查表(表: Int, 值: Int) -> Int {
  var i = len(表) - 1
  while i >= 0 {
    if 表[i][0] <= 值 { return 表[i] }
    i = i - 1
  }
  return 表[0]
}

// 在窗口里找最长匹配。窗口取 4096：自举那一层的执行是逐条的，32K 窗口在四十三千字节上
// 会把这一件拖成分钟级；4096 是「够压一点、又不至于太慢」的那一档，写在明处。
// 链：每个位置存「上一个同首字节的位置」（-1 表示没有）。
// 线性版要扫窗口里每一个位置，四万三千字节就是几百亿次比较，步数先耗光。
fn 链们(字节们: Int) {
  var 链 = ()
  var 头 = ()
  var i = 0
  while i < 256 {
    头 = 头 + (0 - 1,)
    i = i + 1
  }
  i = 0
  while i < len(字节们) {
    let b = to_int(字节们[i])
    链 = 链 + (to_int(头[b]),)
    头 = 置(头, b, i)
    i = i + 1
  }
  return 链
}

fn 找匹配(字节们: Int, 链: Int, i: Int) {
  let 总 = len(字节们)
  var 最 = 0
  var 距 = 0
  let 限 = i - 4096
  var j = to_int(链[i])
  while j >= 0 && j >= 限 {
    var 长 = 0
    while 长 < 258 && i + 长 < 总 && j + 长 < 总 && 字节们[i + 长] == 字节们[j + 长] {
      长 = 长 + 1
    }
    if 长 > 最 {
      最 = 长
      距 = i - j
      if 最 == 258 { return {长: 最, 距: 距} }
    }
    j = to_int(链[j])
  }
  return {长: 最, 距: 距}
}

// ---- 动态 Huffman 的编码侧 ----

fn 置(元组: Int, 下标: Int, 值: Int) {
  var 出 = ()
  var i = 0
  while i < len(元组) {
    if i == 下标 { 出 = 出 + (值,) } else { 出 = 出 + (to_int(元组[i]),) }
    i = i + 1
  }
  return 出
}

// 先切 token：字面量或（长度, 距离）。统计与编码都要这一份。
fn 切块(字节们: Int) {
  let 链 = 链们(字节们)
  var 列 = ()
  var i = 0
  while i < len(字节们) {
    let 匹 = 找匹配(字节们, 链, i)
    if 匹.长 >= 3 {
      列 = 列 + ({类: 1, 长: 匹.长, 距: 匹.距},)
      i = i + 匹.长
    } else {
      列 = 列 + ({类: 0, 值: to_int(字节们[i])},)
      i = i + 1
    }
  }
  return 列
}

// 只写字面量：不做匹配。它与 ref-encoder.mjs 用同一份输入时会得到同一棵树，
// 于是两份流可以逐位对照 —— 对着看才能分清「树不同」和「序列化错」。
fn 切字面(字节们: Int) {
  var 列 = ()
  var i = 0
  while i < len(字节们) {
    列 = 列 + ({类: 0, 值: to_int(字节们[i])},)
    i = i + 1
  }
  return 列
}

fn 统计(列: Int) {  var 字频 = ()
  var i = 0
  while i < 286 {
    字频 = 字频 + (0,)
    i = i + 1
  }
  var 距频 = ()
  i = 0
  while i < 30 {
    距频 = 距频 + (0,)
    i = i + 1
  }
  i = 0
  while i < len(列) {
    let t = 列[i]
    if t.类 == 0 {
      字频 = 置(字频, t.值, to_int(字频[t.值]) + 1)
    } else {
      let 长码 = 查表(长表(), t.长)
      字频 = 置(字频, 长码[1], to_int(字频[长码[1]]) + 1)
      let 距码 = 查表(距表(), t.距)
      距频 = 置(距频, 距码[1], to_int(距频[距码[1]]) + 1)
    }
    i = i + 1
  }
  // 结束码 256 至少要出现一次，否则它没有码。
  字频 = 置(字频, 256, to_int(字频[256]) + 1)
  // 距离表至少要有一个码：没有匹配时它是空的，而空表是非法码集。
  if to_int(距频[0]) == 0 { 距频 = 置(距频, 0, 1) }
  return {字频: 字频, 距频: 距频}
}

// 建 Huffman 树再取码长：每次合并权重最小的两个，最后从每个叶子沿父链数层数。
fn 码长们(频们: Int) {
  var 权 = ()
  var 父 = ()
  var 活 = ()
  var i = 0
  while i < len(频们) {
    权 = 权 + (to_int(频们[i]),)
    父 = 父 + (0 - 1,)
    // 频 0 的符号不进树：进了会把树拉深，码长多算一位，Kraft 和就凑不满。
    if to_int(频们[i]) > 0 { 活 = 活 + (i,) }
    i = i + 1
  }
  while len(活) > 1 {
    var 甲 = 0 - 1
    var 乙 = 0 - 1
    var 甲权 = 0 - 1
    var 乙权 = 0 - 1
    var k = 0
    while k < len(活) {
      let 号 = to_int(活[k])
      let w = to_int(权[号])
      if 甲权 < 0 || w < 甲权 {
        乙 = 甲
        乙权 = 甲权
        甲 = 号
        甲权 = w
      } else if 乙权 < 0 || w < 乙权 {
        乙 = 号
        乙权 = w
      }
      k = k + 1
    }
    let 新 = len(权)
    权 = 权 + (甲权 + 乙权,)
    父 = 父 + (0 - 1,)
    父 = 置(父, 甲, 新)
    父 = 置(父, 乙, 新)
    var 新活 = ()
    k = 0
    while k < len(活) {
      let 号 = to_int(活[k])
      if 号 != 甲 && 号 != 乙 { 新活 = 新活 + (号,) }
      k = k + 1
    }
    活 = 新活 + (新,)
  }
  var 长们 = ()
  i = 0
  while i < len(频们) {
    var 深 = 0
    if to_int(频们[i]) > 0 {
      var 号 = i
      while to_int(父[号]) >= 0 {
        深 = 深 + 1
        号 = to_int(父[号])
      }
    }
    长们 = 长们 + (深,)
    i = i + 1
  }
  return 长们
}

// 每长度的第一个规范码：首[长+1] = (首[长] + 数[长]) * 2。
fn 首码们(长们: Int) {
  var 数 = ()
  var i = 0
  while i <= 15 {
    数 = 数 + (0,)
    i = i + 1
  }
  i = 0
  while i < len(长们) {
    let l = to_int(长们[i])
    if l > 0 && l <= 15 { 数 = 置(数, l, to_int(数[l]) + 1) }
    i = i + 1
  }
  var 首 = (0,)
  var 码 = 0
  var 长 = 0
  while 长 < 15 {
    码 = (码 + to_int(数[长])) * 2
    首 = 首 + (码,)
    长 = 长 + 1
  }
  return {数: 数, 首: 首}
}

// 一个符号的规范码：首[长] 加上它在本长度里的序号。
fn 规范码(长们: Int, 信息: Int, 符号: Int) -> Int {
  let 长 = to_int(长们[符号])
  if 长 == 0 { return 0 }
  var 序 = 0
  var i = 0
  while i < 符号 {
    if to_int(长们[i]) == 长 { 序 = 序 + 1 }
    i = i + 1
  }
  return to_int(信息.首[长]) + 序
}

fn 写符号(状: Int, 长们: Int, 信息: Int, 符号: Int) {
  let 长 = to_int(长们[符号])
  if 长 == 0 { return 状 }
  let 码 = 规范码(长们, 信息, 符号)
  return 放位(状, 反转位(码, 长), 长)
}

// 把 316 个码长写成「码长码表」那一层，并且用 16/17/18 压缩连续相同。
// 规则（RFC 1951 §3.2.7）：
//   16  重复前一个码长 3-6 次，后跟 2 位（次数减三）
//   17  重复 0 共 3-10 次，后跟 3 位（次数减三）
//   18  重复 0 共 11-138 次，后跟 7 位（次数减十一）
fn 码长符号(全长: Int) {
  var 列 = ()
  var i = 0
  while i < len(全长) {
    let v = to_int(全长[i])
    var 次 = 1
    while i + 次 < len(全长) && to_int(全长[i + 次]) == v { 次 = 次 + 1 }
    if v == 0 {
      var 余 = 次
      while 余 >= 11 {
        var 用 = 余
        if 用 > 138 { 用 = 138 }
        列 = 列 + ({符: 18, 位: 7, 值: 用 - 11},)
        余 = 余 - 用
      }
      while 余 >= 3 {
        var 用2 = 余
        if 用2 > 10 { 用2 = 10 }
        列 = 列 + ({符: 17, 位: 3, 值: 用2 - 3},)
        余 = 余 - 用2
      }
      while 余 > 0 {
        列 = 列 + ({符: 0, 位: 0, 值: 0},)
        余 = 余 - 1
      }
    } else {
      列 = 列 + ({符: v, 位: 0, 值: 0},)
      var 剩 = 次 - 1
      while 剩 >= 3 {
        var 用3 = 剩
        if 用3 > 6 { 用3 = 6 }
        列 = 列 + ({符: 16, 位: 2, 值: 用3 - 3},)
        剩 = 剩 - 用3
      }
      while 剩 > 0 {
        列 = 列 + ({符: v, 位: 0, 值: 0},)
        剩 = 剩 - 1
      }
    }
    i = i + 次
  }
  return 列
}

fn 写码长层(状: Int, 字长: Int, 距长: Int) {
  var 全长 = ()
  var i = 0
  while i < len(字长) {
    全长 = 全长 + (to_int(字长[i]),)
    i = i + 1
  }
  i = 0
  while i < len(距长) {
    全长 = 全长 + (to_int(距长[i]),)
    i = i + 1
  }
  let 列 = 码长符号(全长)
  // 十九个符号（0-15 加 16/17/18）各自的频率
  var 频 = ()
  i = 0
  while i < 19 {
    频 = 频 + (0,)
    i = i + 1
  }
  i = 0
  while i < len(列) {
    let 符 = to_int(列[i].符)
    频 = 置(频, 符, to_int(频[符]) + 1)
    i = i + 1
  }
  var 长码长 = 码长们(频)
  let 信息 = 首码们(长码长)
  var s = 放位(状, 15, 4)
  let 顺 = (16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15)
  i = 0
  while i < 19 {
    s = 放位(s, to_int(长码长[to_int(顺[i])]), 3)
    i = i + 1
  }
  i = 0
  while i < len(列) {
    let 项 = 列[i]
    s = 写符号(s, 长码长, 信息, to_int(项.符))
    if to_int(项.位) > 0 { s = 放位(s, to_int(项.值), to_int(项.位)) }
    i = i + 1
  }
  return {状: s, 全长: 全长}
}


// 动态 Huffman：BTYPE=10。
fn 动态压(字节们: Int, 字面: Int) {
  var 列 = 切块(字节们)
  if 字面 { 列 = 切字面(字节们) }
  let 频 = 统计(列)
  let 字长 = 码长们(频.字频)
  let 距长 = 码长们(频.距频)
  let 字信 = 首码们(字长)
  let 距信 = 首码们(距长)
  // 头三位：BFINAL=1、BTYPE=10 —— 按 LSB 先写，值是 5。
  var 状 = 放位({字节们: (), 当前: 0, 已: 0}, 5, 3)
  状 = 放位(状, len(字长) - 257, 5)
  状 = 放位(状, len(距长) - 1, 5)
  let 层 = 写码长层(状, 字长, 距长)
  var s = 层.状
  var 出们 = ()
  var 小块 = ()
  var i = 0
  while i < len(列) {
    let t = 列[i]
    if t.类 == 0 {
      s = 写符号(s, 字长, 字信, t.值)
    } else {
      let 长码 = 查表(长表(), t.长)
      s = 写符号(s, 字长, 字信, 长码[1])
      if 长码[2] > 0 { s = 放位(s, t.长 - 长码[0], 长码[2]) }
      let 距码 = 查表(距表(), t.距)
      s = 写符号(s, 距长, 距信, 距码[1])
      if 距码[2] > 0 { s = 放位(s, t.距 - 距码[0], 距码[2]) }
    }
    小块 = s.字节们
    if len(小块) >= 1024 {
      出们 = 出们 + (小块,)
      s = {字节们: (), 当前: s.当前, 已: s.已}
    }
    i = i + 1
  }
  s = 写符号(s, 字长, 字信, 256)
  s = 刷(s)
  let 尾 = s.字节们
  if len(尾) > 0 { 出们 = 出们 + (尾,) }
  if len(出们) == 0 { return () }
  return 拼平(出们, 0, len(出们))
}


// 固定 Huffman：有匹配就放 length + distance，没有就放字面量。末尾放结束码 256。
fn 固定压(字节们: Int) {
  let 总 = len(字节们)
  var 状 = 放位({字节们: (), 当前: 0, 已: 0}, 3, 3)
  var 块们 = ()
  let 链 = 链们(字节们)
  var i = 0
  while i < 总 {
    let 匹 = 找匹配(字节们, 链, i)
    if 匹.长 >= 3 {
      let 长 = 查表(长表(), 匹.长)
      let 长码 = 长[1]
      状 = 放位(状, 反转位(符号码(长码), 符号位数(长码)), 符号位数(长码))
      let 长余 = 长[2]
      if 长余 > 0 { 状 = 放位(状, 匹.长 - 长[0], 长余) }
      let 距 = 查表(距表(), 匹.距)
      // 距离码是五位定长。它在位流里也是「码的高位先写」，所以同样要反转。
      状 = 放位(状, 反转位(距[1], 5), 5)
      let 距余 = 距[2]
      if 距余 > 0 { 状 = 放位(状, 匹.距 - 距[0], 距余) }
      i = i + 匹.长
    } else {
      let b = 字节值(to_int(字节们[i]))
      状 = 放位(状, 反转位(符号码(b), 符号位数(b)), 符号位数(b))
      i = i + 1
    }
    let 小块 = 状.字节们
    if len(小块) >= 1024 {
      块们 = 块们 + (小块,)
      状 = {字节们: (), 当前: 状.当前, 已: 状.已}
    }
  }
  // 结束码 256：七位，码是 0。
  状 = 放位(状, 0, 7)
  状 = 刷(状)
  let 尾 = 状.字节们
  if len(尾) > 0 { 块们 = 块们 + (尾,) }
  if len(块们) == 0 { return () }
  return 拼平(块们, 0, len(块们))
}

fn main() -> Int effects(file) {
  let 参 = argv()
  if len(参) < 3 {
    print("用法：hmyr self/deflate.hmyr <输入> <输出> [--固定] [--解]" + chr(10))
    return 2
  }
  var 固定 = false
  var 动态 = false
  var 字面 = false
  var 解模式 = false
  var i = 0
  while i < len(参) {
    if 参[i] == "--固定" { 固定 = true }
    if 参[i] == "--动态" { 动态 = true }
    if 参[i] == "--字面" {
      动态 = true
      字面 = true
    }
    if 参[i] == "--解" { 解模式 = true }
    i = i + 1
  }
  let 字节们 = read_bytes(参[1])
  var 出 = 压(字节们)
  if 固定 { 出 = 固定压(字节们) }
  if 动态 { 出 = 动态压(字节们, 字面) }
  if 解模式 { 出 = 解(字节们) }
  write_bytes(参[2], 出)
  print(str(len(字节们)) + " → " + str(len(出)) + chr(10))
  return 0
}
