// 求值器的最小零件：一次求值的结果，与环境的查找。
//
// 为什么单独立一份（2026-11-05）：self/eval.hmoca 有一千四百多行，而其中 求调用
// 一个函数就占了五百八十二行（八十九条内置分派）。要把那一块拆出去，先得让它能拿到
// 这七个函数 —— 它们是每一次求值都要用的：好 与 坏 造结果，查找 在环境里找名字，
// 我的效果 与 要效果 判效果，效在 是效果表里的成员判断。
//
// 这七个都是自包含的：好 与 坏 只构造记录，查找到 只读元组，效在 只读元组。
// 所以这一份没有依赖 —— 拆它可以先做，而拆 求调用 要等它在这里。
//
// 全部带 公开：调用它的 求调用、求值、执行 都在 eval.hmoca 里（另一个模块）。

公开 函数 好(v: Int) {
  返回 {ok: 真, value: v}
}

公开 函数 坏(t: String) {
  返回 {ok: 假, text: t}
}

公开 函数 查找到(环境: Int, 名: String, i: Int) {
  若 i < 0 { 返回 {found: 假, value: ()} }
  若 环境[i][0] == 名 { 返回 {found: 真, value: 环境[i][1]} }
  返回 查找到(环境, 名, i - 1)
}

公开 函数 查找(环境: Int, 名: String) -> Int {
  返回 查找到(环境, 名, len(环境) - 1)
}

公开 函数 效在(效册: Int, 名: String, i: Int) -> Bool {
  若 i >= len(效册) { 返回 假 }
  若 效册[i] == 名 { 返回 真 }
  返回 效在(效册, 名, i + 1)
}

公开 函数 我的效果(环境: Int) {
  定 r = 查找(环境, "效果")
  若 r.found { 返回 r.value }
  返回 ()
}

公开 函数 要效果(环境: Int, 效: String, 名: String) -> String {
  若 效在(我的效果(环境), 效, 0) { 返回 "" }
  返回 "HMYR-內-001 " + 名 + " 要 " + 效 + " 效果，而调用它的函数没有声明"
}
