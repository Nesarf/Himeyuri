// 数字字面量 → 值：尾数、指数、快路径与慢路径。
//
// 为什么单独立一份（2026-11-05）：compile.hmoca 的第一刀。这一件八十六行、自包含
// （只调 f64.hmoca 里的 装十进制 与 wide.hmoca 的 宽 那一族），而它是「文本怎么变成一个数」
// 这件事的全部 —— 与「语法树怎么变成指令」无关，所以分区是干净的。
//
// 它是 公开 的，因为 conformance/dec-lit.hmoca 直接把文本交给它 —— 而要能被判据点名，
// 就只能公开。

引入 "./f64.hmoca"

// 一个数字字面量 → 数。
//
// 词法层把整数、小数、指数都收成一段文本（lex.hmyr 的 read_number），
// 而这里要把它变成数。早先这一层直接交给 to_int，于是 2.7 一进编译器就报
// 「不是整数字面量」—— 而同一条源码走解释那条路（eval.hmyr 的数到）跑得动。
// 两条路对同一份源码给出两种答案，是最难查的那一类：你以为自己在查算术。
//
// 2026-11-04 重写：从「整数部分 加 小数部分除十的幂」改成「尾数 乘 十的幂」。
// 两个原因：
//   一、原来那一种做两次舍入（整数一次、小数一次），长尾数会与宿主差一位；
//   二、负指数那一条路「先算 10 的幂再取倒数」会溢出 —— 1e-320 的 10^320 是无穷，
//       一除就是零。于是次正规那一整档字面量全部读成零（design/OPEN.txt 第一条）。
//
// 现在的形状：先扫出尾数与十进制指数，再一次舍入。两条路：
//   快路  尾数装得进 2 的 53 次方、指数绝对值不超过 22 时，直接乘或除一次
//         10 的幂 —— 10 的 22 次方以内每个幂都精确，而乘法与除法在 IEEE 里
//         各自正确舍入，所以一次运算就是对的。常见字面量全走这一条。
//   慢路  其余的（次正规、超大指数、长尾数）交给 装十进制：宽整数乘 5 的幂，
//         再一次舍入到最近的偶数。那一条贵得多，所以只在需要时走。
//
// 负零交回正零：语言里造不出 -0（见 self/f64.hmoca 的说明）。而 -1e-320 这类数
// 读回来带符号，因为符号位在装配那一步是单独给的。
//
// 公开：这一条现在有判据（conformance/dec-lit.hmoca 直接把文本交给它），
// 而判据要能点名它。一个只在内部用、却要被外面验证的函数，要么公开，
// 要么只能从整份编译器的行为去反推 —— 后者报出来的错永远指向「某处解析不对」。
公开 函数 数字值(s: String) -> Int {
  变 i = 0
  变 负 = 假
  若 i < len(s) {
    若 s[i] == "-" {
      负 = 真
      i = i + 1
    }
  }
  变 尾 = 0
  变 尾大 = 假
  变 宽尾 = 宽零()
  变 小长 = 0
  变 在整 = 真
  变 在指 = 假
  变 指负 = 假
  变 指数 = 0
  当 i < len(s) {
    定 c = s[i]
    定 码 = ord(c)
    若 码 >= 48 {
      若 码 <= 57 {
        定 位 = 码 - 48
        若 在指 {
          指数 = 指数 * 10 + 位
        } 否则 {
          // 900719925474098 是「再乘十加九还装得进 2 的 53 次方」的上界。
          // 超过它就从这里改用宽整数 —— 而已经收下的那一段仍然是精确的。
          若 尾大 {
            宽尾 = 宽乘十加(宽尾, 位)
          } 否则 若 尾 > 900719925474098 {
            宽尾 = 宽乘十加(宽数(尾), 位)
            尾大 = 真
          } 否则 {
            尾 = 尾 * 10 + 位
          }
          若 !在整 {
            小长 = 小长 + 1
          }
        }
      }
    }
    若 c == "." { 在整 = 假 }
    若 c == "e" { 在指 = 真 }
    若 c == "E" { 在指 = 真 }
    若 c == "-" {
      若 在指 { 指负 = 真 }
    }
    i = i + 1
  }
  // 十进制指数 = 指数部分 减 小数位数。小数点后面的那些位已经进了尾数。
  变 终指 = 指数
  若 指负 {
    终指 = 0 - 指数
  }
  终指 = 终指 - 小长
  若 !尾大 && 尾 == 0 {
    返回 0
  }
  若 !尾大 && 终指 >= 0 - 22 && 终指 <= 22 {
    变 倍指 = 终指
    若 倍指 < 0 {
      倍指 = 0 - 倍指
    }
    变 倍 = 1.0
    变 k = 0
    当 k < 倍指 {
      倍 = 倍 * 10.0
      k = k + 1
    }
    变 值 = 尾 * 1.0
    若 终指 < 0 {
      值 = 值 / 倍
    } 否则 {
      值 = 值 * 倍
    }
    若 负 {
      返回 0 - 值
    }
    返回 值
  }
  若 尾大 {
    返回 由位(装十进制(宽尾, 终指, 负))
  }
  返回 由位(装十进制(宽数(尾), 终指, 负))
}
