import "./stmt.hmyr"

// 用 Himeyuri 写的第八件：函数体。
//
// 它吃的是**保留换行**的 token 流（self/lex.hmyr 里 scan_lines 的产出），于是语句边界终于有了着落：
// 按换行切开，每条交给 self/stmt.hmyr 的 parse_statement 读成记录。
//
// 深度先算好：外层「一条语句一层」（层数等于语句数），而收集一条语句时最多占「这一条自己的 token 数」
// 那么多层。两者相加而不是相乘，所以一段百来行的体不会碰到调用深度上限。

fn is_punct(t: Int, ch: String) -> Bool {
  return t.kind == "punct" && t.text == ch
}

// 体的起点：第一个左花括号。
fn find_open(tokens: Int, i: Int) -> Int {
  if i >= len(tokens) { return -1 }
  if is_punct(tokens[i], "{") { return i }
  return find_open(tokens, i + 1)
}

// 收集一条语句的 token。
//   depth 用来照顾语句内部的嵌套花括号（例如记录字面量）；
//   顶层的换行表示这一条到此为止；顶层的右花括号表示整个体到此为止。
fn collect(tokens: Int, i: Int, depth: Int, acc: Int) {
  if i >= len(tokens) { return {line: acc, next: i, end: true} }
  let t = tokens[i]
  if is_punct(t, "{") { return collect(tokens, i + 1, depth + 1, acc + (t,)) }
  if is_punct(t, "}") {
    if depth == 0 { return {line: acc, next: i, end: true} }
    return collect(tokens, i + 1, depth - 1, acc + (t,))
  }
  if t.kind == "newline" {
    if depth == 0 { return {line: acc, next: i + 1, end: false} }
    return collect(tokens, i + 1, depth, acc)
  }
  return collect(tokens, i + 1, depth, acc + (t,))
}

// 一条条读下去，直到体的收尾。空行跳过。
// 逐行切语句。
//
// 这里有一处曾经吃过亏：遇到收尾的 } 时，collect 会交回 end 与「还没编的那一行」。
// 多行的写法里那行是空的（上一轮已经按 newline 编过了），所以直接返回没问题；
// 而单行写法 fn f() { return 7 } 里，那一行就是全部内容 —— 早先直接返回，
// 于是函数体被读成空的：编译出来只有「交回空」，跑什么都不对。
fn each(tokens: Int, i: Int, acc: Int) {
  let got = collect(tokens, i, 0, ())
  var 收 = acc
  if len(got.line) > 0 {
    let st = parse_statement(got.line)
    收 = 收 + (st.node,)
  }
  if got.end { return {list: 收, next: got.next} }
  return each(tokens, got.next, 收)
}

// 宿主入口：拿整份函数声明的 token 流，读出它的体。
fn parse_body(tokens: Int) {
  let at = find_open(tokens, 0)
  if at < 0 { return {list: (), next: len(tokens), found: false} }
  let got = each(tokens, at + 1, ())
  return {list: got.list, next: got.next, found: true}
}

// ---- 多声明 ----
//
// parse_body 只找**第一个**花括号之后的体；这一层找**所有的** fn。
// 只认「fn 名字 … { 体 }」这一种声明：返回类型与效果声明都跳过，而参数名收下来——
// 求值器拿它们去绑环境，于那是用得上的东西。用不上的（返回类型、效果）才跳过。
fn next_fn(tokens: Int, i: Int) -> Int {
  if i >= len(tokens) { return -1 }
  let t = tokens[i]
  if t.kind == "ident" && t.text == "fn" { return i }
  return next_fn(tokens, i + 1)
}

fn 名字在(tokens: Int, i: Int) -> String {
  if i + 1 < len(tokens) && tokens[i + 1].kind == "ident" { return tokens[i + 1].text }
  return ""
}

// 从 fn 之后扫到 { 之前，把参数名收出来。
//
// 参数长这样：fn f(a: Int, b: String) -> Int
// 于是「括号里、冒号之前」的那个 ident 就是参数名。
// 而括号里也可能有逗号——逗号之后的第一个 ident 是下一个参数名。
//
// 为什么要它：函数表要带参数名，而求值器靠它把实参绑进环境。
// 以前这一层把它们跳过了，于是带参数的函数跑不了——而那是半个语言。
fn 括号位(tokens: Int, i: Int, 末: Int) -> Int {
  if i >= 末 { return -1 }
  if tokens[i].kind == "punct" && tokens[i].text == "(" { return i }
  return 括号位(tokens, i + 1, 末)
}

// 配对的右括号。深度要跟着算：元组类型 (String,) 里有自己的括号，
// 取第一个 ) 会把参数表的边界切在类型里面 —— 早先正是这样，
// 于是 连接(段们: (String,), 分隔: String) 只认出 段们 一个参数。
fn 反括号位(tokens: Int, i: Int, 末: Int, 深: Int) -> Int {
  if i >= 末 { return -1 }
  let t = tokens[i]
  if t.kind == "punct" && t.text == "(" { return 反括号位(tokens, i + 1, 末, 深 + 1) }
  if t.kind == "punct" && t.text == ")" {
    if 深 <= 0 { return i }
    return 反括号位(tokens, i + 1, 末, 深 - 1)
  }
  return 反括号位(tokens, i + 1, 末, 深)
}

// 在括号里扫：等待一个 ident，收下它，然后等逗号。
// 深 大于零表示正在一个内层括号里（元组类型），那里面的 ident 与逗号都不算数。
fn 收名从(tokens: Int, i: Int, 末: Int, 等下个: Bool, 深: Int, acc: Int) -> Int {
  if i >= 末 { return acc }
  let t = tokens[i]
  if t.kind == "punct" && t.text == "(" { return 收名从(tokens, i + 1, 末, 等下个, 深 + 1, acc) }
  if t.kind == "punct" && t.text == ")" { return 收名从(tokens, i + 1, 末, 等下个, 0, acc) }
  if 深 > 0 { return 收名从(tokens, i + 1, 末, 等下个, 深, acc) }
  if t.kind == "punct" && t.text == "," { return 收名从(tokens, i + 1, 末, true, 深, acc) }
  if 等下个 && t.kind == "ident" { return 收名从(tokens, i + 1, 末, false, 深, acc + (t.text,)) }
  return 收名从(tokens, i + 1, 末, 等下个, 深, acc)
}

fn 参数名们(tokens: Int, 起: Int, 末: Int) {
  let 开 = 括号位(tokens, 起, 末)
  if 开 < 0 { return () }
  let 闭 = 反括号位(tokens, 开 + 1, 末, 0)
  if 闭 < 0 { return () }
  return 收名从(tokens, 开 + 1, 闭, true, 0, ())
}

// 一个词的位置：从 起 扫到 末，找 is_word(t, w)。没有就 -1。
fn 找词(tokens: Int, i: Int, 末: Int, w: String) -> Int {
  if i >= 末 { return -1 }
  if is_word(tokens[i], w) { return i }
  return 找词(tokens, i + 1, 末, w)
}

// 效果名们：在右括号与 { 之间找 effects( … )，收里面的名字。
//
// 为什么需要它：函数表以前只收（名字, 参数名, 语句们），于是「声明了 effects(file)」
// 这件事在自举那一层根本不存在 —— 结果是凡声明效果的程序一调要效果的函数就撞 R0201，
// 只能退回最小求值器跑。收进来之后，那一层才谈得上核对。
fn 效果们(tokens: Int, 起: Int, 末: Int) {
  let at = 找词(tokens, 起, 末, "effects")
  if at < 0 { return () }
  let 开 = 括号位(tokens, at + 1, 末)
  if 开 < 0 { return () }
  let 闭 = 反括号位(tokens, 开 + 1, 末, 0)
  if 闭 < 0 { return () }
  return 收名从(tokens, 开 + 1, 闭, true, 0, ())
}

fn decls_from(tokens: Int, i: Int, acc: Int) {
  let at = next_fn(tokens, i)
  if at < 0 { return {fns: acc, next: len(tokens)} }
  let 名 = 名字在(tokens, at)
  let open = find_open(tokens, at + 1)
  if open < 0 { return {fns: acc, next: len(tokens)} }
  let got = each(tokens, open + 1, ())
  // 四件：名字、参数名们、语句们、效果名们。后两件都从 fn 之后扫到 { 之前。
  let 参名们 = 参数名们(tokens, at + 1, open)
  let 效们 = 效果们(tokens, at + 1, open)
  return decls_from(tokens, got.next, acc + ((名, 参名们, got.list, 效们),))
}

// 交回 {fns: ((名字, 参数名们, 语句们, 效果名们), …), next}。
fn parse_decls(tokens: Int) -> Int {
  return decls_from(tokens, 0, ())
}

fn main() -> Int {
  let tokens = ({kind: "punct", text: "{"}, {kind: "ident", text: "let"}, {kind: "ident", text: "x"},
    {kind: "punct", text: "="}, {kind: "int", text: "1"}, {kind: "newline", text: "\n"},
    {kind: "ident", text: "return"}, {kind: "ident", text: "x"}, {kind: "punct", text: "}"})
  let body = parse_body(tokens)
  print(str(len(body.list)))
  return 0
}
