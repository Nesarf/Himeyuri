// 用 Himeyuri 写的求值器：吃 self/chain.hmyr 造出来的节点，交回一个值。
//
// 这是自举的最后一格。词法（lex）、语法（chain、stmt）、语句（body）都在 self/ 里了，
// 缺的就是「把节点算成值」。这一件立起来之后，一段源码可以由 Himeyuri 自己读、
// 自己解析、自己求值——宿主只剩下「起它」这一件事。
//
// 节点形状（由 self/chain.hmyr 与 self/stmt.hmyr 定义）：
//   {kind: "int" | "num", text}      整数（原文）
//   {kind: "str", text}              字符串
//   {kind: "name", text}             标识符
//   {kind: "bin", op, left, right}
//   {kind: "unary", op, operand}
//   {kind: "call", callee, args}
//   {kind: "index", target, index}
//   {kind: "field", target, name}
//   {kind: "tuple", items}
//   {kind: "record", fields}
//   {kind: "err", text}
//
// 环境是键值对的元组（与 json.hmyr 那边同一个表示）：记录的字段名必须是标识符，
// 而环境里的名字来自程序本身，所以用对表。
//
// 结果统一包成 {ok: true, value} 或 {ok: false, text}——这样错误一路往上走，
// 不会被当成一个值参与计算。这一点比「返回特殊值」可靠。

fn 好(v: Int) {
  return {ok: true, value: v}
}

fn 坏(t: String) {
  return {ok: false, text: t}
}

// 查环境从后往前：后定义要覆盖先定义。正着找会拿到旧值，那是个安静的错。
fn 查找到(环境: Int, 名: String, i: Int) {
  if i < 0 { return {found: false, value: ()} }
  if 环境[i][0] == 名 { return {found: true, value: 环境[i][1]} }
  return 查找到(环境, 名, i - 1)
}

fn 查找(环境: Int, 名: String) -> Int {
  return 查找到(环境, 名, len(环境) - 1)
}

// 一条记录的字段名拼成一行，用在诊断里。
fn 名字们(t: Int) -> String {
  let 列 = field_names(t)
  var 出 = ""
  var i = 0
  while i < len(列) {
    出 = 出 + 列[i] + ","
    i = i + 1
  }
  return 出
}

fn 求二元(op: String, a: Int, b: Int) -> Int {
  if a.ok == false { return a }
  if b.ok == false { return b }
  let x = a.value
  let y = b.value
  if op == "+" { return 好(x + y) }
  if op == "-" { return 好(x - y) }
  if op == "*" { return 好(x * y) }
  if op == "/" { return 好(x / y) }
  if op == "%" { return 好(x % y) }
  if op == "==" { return 好(x == y) }
  if op == "!=" { return 好(x != y) }
  if op == "<" { return 好(x < y) }
  if op == "<=" { return 好(x <= y) }
  if op == ">" { return 好(x > y) }
  if op == ">=" { return 好(x >= y) }
  // 逻辑两级。这里不短路：两个操作数在调进来之前都求过了。
  // 那与语言别处的语义有一处差别（a && f() 里的 f 会不会被调），
  // 写成注释而不是装作没有 —— 要短路得在 求值 的 bin 分支里特殊处理。
  if op == "&&" {
    if x == false { return 好(false) }
    if y == false { return 好(false) }
    return 好(true)
  }
  if op == "||" {
    if x == false {
      if y == false { return 好(false) }
    }
    return 好(true)
  }
  // 走到这里说明链那一层交来的 op 不是它写的那些字符串之一。
  // 若它是一个节点记录，把它的 kind 说出来 —— 「[object Object]」什么都不告诉人，
  // 而 kind 至少能指认「原来这里是个调用 / 一个数 / 一个名字」。
  if field_has(op, "kind") { return 坏("不认识的运算符：一个 " + op.kind + " 节点") }
  if field_has(op, "op") { return 坏("不认识的运算符：一个自己带 op 的记录，它的 op 是 " + op.op) }
  if field_has(op, "name") { return 坏("不认识的运算符：一个带 name 的记录，名字是 " + op.name) }
  if field_has(op, "value") { return 坏("不认识的运算符：一个带 value 的记录，字段是 " + 名字们(op)) }
  return 坏("不认识的运算符：" + op)
}

fn 求一元(op: String, a: Int) -> Int {
  if a.ok == false { return a }
  if op == "-" { return 好(0 - a.value) }
  if op == "!" { return 好(!a.value) }
  return 坏("不认识的一元运算符：" + op)
}

// 一次性把参数都求出来。任一参数出错就整体出错——不跳过、不补默认值。
fn 求参数从(节点们: Int, 环境: Int, i: Int, acc: Int) -> Int {
  if i >= len(节点们) { return 好(acc) }
  let 一个 = 求值(节点们[i], 环境)
  if 一个.ok == false { return 一个 }
  return 求参数从(节点们, 环境, i + 1, acc + (一个.value,))
}

fn 求参数(节点们: Int, 环境: Int) -> Int {
  return 求参数从(节点们, 环境, 0, ())
}

// 调用：先认两个内置（len、str），再查环境里的函数表。
//
// 函数表放在环境里，名字加前缀 "fn:"——这样不必给求值、执行这些函数加参数，
// 而递归也自然成立：函数体在同一个环境里跑，它看得见自己。
//
// 这一版是**动态作用域**（被调函数看得见调用者的局部名字），不是词法作用域。
// 先这样，因为真正的词法作用域要等闭包那一层；这一点写在明处，不装作已经是词法作用域。
// 一个效果名在不在这一串里。
fn 效在(效们: Int, 名: String, i: Int) -> Bool {
  if i >= len(效们) { return false }
  if 效们[i] == 名 { return true }
  return 效在(效们, 名, i + 1)
}

// 交回第一个缺的效果名；一个也不缺就交回空串。
fn 缺效果从(要的: Int, 有的: Int, i: Int) -> String {
  if i >= len(要的) { return "" }
  if 效在(有的, 要的[i], 0) == false { return 要的[i] }
  return 缺效果从(要的, 有的, i + 1)
}

fn 缺效果(要的: Int, 有的: Int) -> String {
  return 缺效果从(要的, 有的, 0)
}

// 当前函数有哪些效果：环境里那个 "效果" 键，由调用的那一层放进来。
// 没有就是空 —— 顶层没写 effects(...) 就是不要任何效果。
fn 我的效果(环境: Int) {
  let r = 查找(环境, "效果")
  if r.found { return r.value }
  return ()
}

// 一个内置要的效果够不够。够就交回空串，不够就交回那句话。
fn 要效果(环境: Int, 效: String, 名: String) -> String {
  if 效在(我的效果(环境), 效, 0) { return "" }
  return "HMYR-R0201 " + 名 + " 要 " + 效 + " 效果，而调用它的函数没有声明"
}

fn 求调用(节点: Int, 环境: Int) -> Int {
  if 节点.callee.kind != "name" { return 坏("这一版只认按名字调用") }
  let 名 = 节点.callee.text
  let 参 = 求参数(节点.args, 环境)
  if 参.ok == false { return 参 }
  let 值们 = 参.value
  if 名 == "len" {
    if len(值们) != 1 { return 坏("len 要一个参数") }
    return 好(len(值们[0]))
  }
  if 名 == "str" {
    if len(值们) != 1 { return 坏("str 要一个参数") }
    return 好(str(值们[0]))
  }
  // 字符串那一层还差几个纯函数，而标准库把它们当砖用。
  // 它们不碰世界、不改状态，所以在这一层直接转给语言自己的同名内置。
  if 名 == "slice" {
    if len(值们) != 3 { return 坏("slice 要三个参数") }
    return 好(slice(值们[0], 值们[1], 值们[2]))
  }
  // 原始字节：嵌入与打包要它。这一层只转发，读不到由下面那一层说。
  if 名 == "read_bytes" {
    let 欠读 = 要效果(环境, "file", "read_bytes")
    if 欠读 != "" { return 坏(欠读) }
    if len(值们) != 1 { return 坏("read_bytes 要一个参数") }
    return 好(read_bytes(值们[0]))
  }
  // 切开：这一层只转发。切法（空分隔按码元、连续分隔留空段）由下面那一层给。
  if 名 == "split" {
    if len(值们) != 2 { return 坏("split 要两个参数") }
    return 好(split(值们[0], 值们[1]))
  }
  // 环境与路径：读这台机器在哪儿。这一层只转发 ——
  // 两台机器给出不同的串是对的（契约写的是「读宿主的位置」）。
  if 名 == "cwd" {
    if len(值们) != 0 { return 坏("cwd 不要参数") }
    return 好(cwd())
  }
  if 名 == "home_dir" {
    if len(值们) != 0 { return 坏("home_dir 不要参数") }
    return 好(home_dir())
  }
  if 名 == "temp_path" {
    if len(值们) != 1 { return 坏("temp_path 要一个参数") }
    return 好(temp_path(值们[0]))
  }
  if 名 == "repo_path" {
    if len(值们) != 1 { return 坏("repo_path 要一个参数") }
    return 好(repo_path(值们[0]))
  }
  if 名 == "python_path" {
    if len(值们) != 0 { return 坏("python_path 不要参数") }
    return 好(python_path())
  }
  if 名 == "locale_current" {
    if len(值们) != 0 { return 坏("locale_current 不要参数") }
    return 好(locale_current())
  }
  if 名 == "locale_set" {
    if len(值们) != 1 { return 坏("locale_set 要一个参数") }
    return 好(locale_set(值们[0]))
  }
  if 名 == "locale_env" {
    if len(值们) != 0 { return 坏("locale_env 不要参数") }
    return 好(locale_env())
  }
  if 名 == "console_codepage" {
    if len(值们) != 0 { return 坏("console_codepage 不要参数") }
    return 好(console_codepage())
  }
  // 线程与 arena：这一层照实转发 —— 下面那一层说「没有」，这一层不替它编。
  if 名 == "thr_spawn" {
    if len(值们) != 2 { return 坏("thr_spawn 要两个参数") }
    return 好(thr_spawn(值们[0], 值们[1]))
  }
  if 名 == "thr_join" {
    if len(值们) < 1 { return 坏("thr_join 至少要一个参数") }
    if len(值们) == 1 { return 好(thr_join(值们[0])) }
    return 好(thr_join(值们[0], 值们[1]))
  }
  if 名 == "thr_cancel" {
    if len(值们) != 1 { return 坏("thr_cancel 要一个参数") }
    return 好(thr_cancel(值们[0]))
  }
  if 名 == "thr_count" {
    if len(值们) != 0 { return 坏("thr_count 不要参数") }
    return 好(thr_count())
  }
  // arena 故意不在这里：它在语言里是关键字（有它自己的语法），
  // 而自举这条 parser 不认它 —— 写出来就是 E0104，字节码路径上它走不到。
  // 进程：跑一个程序。这一层照参数个数转发（1 到 4 个），
  // 记录那五个字段（code stdout stderr timedOut error）由下面那一层给。
  if 名 == "run_program" {
    if len(值们) == 1 { return 好(run_program(值们[0])) }
    if len(值们) == 2 { return 好(run_program(值们[0], 值们[1])) }
    if len(值们) == 3 { return 好(run_program(值们[0], 值们[1], 值们[2])) }
    if len(值们) == 4 { return 好(run_program(值们[0], 值们[1], 值们[2], 值们[3])) }
    return 坏("run_program 最多四个参数")
  }
  // 进程：改工作目录。这一层只转发 —— 进不去时下面那一层报 R0209。
  if 名 == "chdir" {
    if len(值们) != 1 { return 坏("chdir 要一个参数") }
    return 好(chdir(值们[0]))
  }
  // 输入：一条键队列。这一层只转发 —— 队列与「有没有终端」在下面那一层。
  if 名 == "key_push" {
    if len(值们) != 1 { return 坏("key_push 要一个参数") }
    return 好(key_push(值们[0]))
  }
  if 名 == "key_available" {
    if len(值们) != 0 { return 坏("key_available 不要参数") }
    return 好(key_available())
  }
  if 名 == "key_read" {
    if len(值们) != 0 { return 坏("key_read 不要参数") }
    return 好(key_read())
  }
  if 名 == "key_start" {
    if len(值们) != 1 { return 坏("key_start 要一个参数") }
    return 好(key_start(值们[0]))
  }
  // 时间：读一次钟，或等一会儿。这一层只转发 ——
  // 「它们破坏可复现性」那条警告写在契约里，不写在每一次调用上。
  if 名 == "now_ms" {
    if len(值们) != 0 { return 坏("now_ms 不要参数") }
    return 好(now_ms())
  }
  if 名 == "sleep_ms" {
    if len(值们) != 1 { return 坏("sleep_ms 要一个参数") }
    return 好(sleep_ms(值们[0]))
  }
  // 终端那一组：只交回字符串，不写出去。照参数个数转发；
  // term_color 收一个或两个 —— 语言的写法定不了可选参数，所以两条各自写出来。
  if 名 == "term_size" {
    if len(值们) != 0 { return 坏("term_size 不要参数") }
    return 好(term_size())
  }
  if 名 == "term_clear" {
    if len(值们) != 0 { return 坏("term_clear 不要参数") }
    return 好(term_clear())
  }
  if 名 == "term_hide" {
    if len(值们) != 0 { return 坏("term_hide 不要参数") }
    return 好(term_hide())
  }
  if 名 == "term_show" {
    if len(值们) != 0 { return 坏("term_show 不要参数") }
    return 好(term_show())
  }
  if 名 == "term_escape" {
    if len(值们) != 2 { return 坏("term_escape 要两个参数") }
    return 好(term_escape(值们[0], 值们[1]))
  }
  if 名 == "term_color" {
    if len(值们) == 1 { return 好(term_color(值们[0])) }
    if len(值们) == 2 { return 好(term_color(值们[0], 值们[1])) }
    return 坏("term_color 要一个或两个参数")
  }
  // 大小写是规格第一圈里的内置。宿主那一份一直有，自举这一层补上转发就够了。
  if 名 == "to_upper" {
    if len(值们) != 1 { return 坏("to_upper 要一个参数") }
    return 好(to_upper(值们[0]))
  }
  if 名 == "to_lower" {
    if len(值们) != 1 { return 坏("to_lower 要一个参数") }
    return 好(to_lower(值们[0]))
  }
  // 算术那一组。abs、floor、int 是转发；min 与 max 自己走一遍，
  // 因为它们是变长的，而「转给同一个名字」只能写出固定个数的参数。
  if 名 == "abs" {
    if len(值们) != 1 { return 坏("abs 要一个参数") }
    return 好(abs(值们[0]))
  }
  if 名 == "floor" {
    if len(值们) != 1 { return 坏("floor 要一个参数") }
    return 好(floor(值们[0]))
  }
  if 名 == "int" {
    if len(值们) != 1 { return 坏("int 要一个参数") }
    return 好(int(值们[0]))
  }
  if 名 == "min" {
    if len(值们) < 1 { return 坏("min 至少要一个参数") }
    var 小 = 值们[0]
    var 甲 = 1
    while 甲 < len(值们) {
      if 值们[甲] < 小 { 小 = 值们[甲] }
      甲 = 甲 + 1
    }
    return 好(小)
  }
  if 名 == "max" {
    if len(值们) < 1 { return 坏("max 至少要一个参数") }
    var 大 = 值们[0]
    var 乙 = 1
    while 乙 < len(值们) {
      if 值们[乙] > 大 { 大 = 值们[乙] }
      乙 = 乙 + 1
    }
    return 好(大)
  }
  // 记录那一组：造、取、问、列。四个都只是转发 —— 记录的形状由宿主那一层给。
  if 名 == "record_new" {
    if len(值们) != 1 { return 坏("record_new 要一个参数") }
    return 好(record_new(值们[0]))
  }
  if 名 == "field_get" {
    if len(值们) != 2 { return 坏("field_get 要两个参数") }
    return 好(field_get(值们[0], 值们[1]))
  }
  if 名 == "field_has" {
    if len(值们) != 2 { return 坏("field_has 要两个参数") }
    return 好(field_has(值们[0], 值们[1]))
  }
  // 字段名的列表。有了它，「把一条记录摊开」才写得出来 —— 标准库的表那一份卡在这里。
  if 名 == "field_names" {
    if len(值们) != 1 { return 坏("field_names 要一个参数") }
    return 好(field_names(值们[0]))
  }
  // 读一份文本。与 write_text 配成一对，两边都要 file 效果。
  if 名 == "read_text" {
    let 欠读 = 要效果(环境, "file", "read_text")
    if 欠读 != "" { return 坏(欠读) }
    if len(值们) < 1 { return 坏("read_text 至少要一个参数") }
    if len(值们) == 1 { return 好(read_text(值们[0])) }
    return 好(read_text(值们[0], 值们[1]))
  }
  // 写一份文本。这一层只转发 —— 编码与脱敏都在下面那一层管。
  if 名 == "write_text" {
    let 欠写 = 要效果(环境, "file", "write_text")
    if 欠写 != "" { return 坏(欠写) }
    if len(值们) != 2 { return 坏("write_text 要两个参数") }
    return 好(write_text(值们[0], 值们[1]))
  }
  // 命令行参数：目标程序看到的是自己的那一份，由调用的那一层放进环境。
  // 早先这里没有这一支，于是程序里写 argv() 会报「没有这个函数：argv」。
  if 名 == "argv" {
    let 欠参 = 要效果(环境, "process", "argv")
    if 欠参 != "" { return 坏(欠参) }
    if len(值们) != 0 { return 坏("argv 不要参数") }
    let r = 查找(环境, "argv")
    if r.found { return 好(r.value) }
    return 好(())
  }
  // 输出：目标程序的 print 要落到宿主那一层去。
  // 早先这里没有这一支 —— 于是「能算但说不出」：任何带 print 的程序都跑不了。
  // 参数按 str 拼起来，因为这门语言的 print 就是「把每个值写成文字，连着写出去」。
  if 名 == "print" {
    var 出文 = ""
    var i = 0
    while i < len(值们) {
      出文 = 出文 + str(值们[i])
      i = i + 1
    }
    print(出文)
    return 好(())
  }
  if 名 == "print_err" {
    let 欠错 = 要效果(环境, "process", "print_err")
    if 欠错 != "" { return 坏(欠错) }
    var 错文 = ""
    var j = 0
    while j < len(值们) {
      错文 = 错文 + str(值们[j])
      j = j + 1
    }
    print_err(错文)
    return 好(())
  }
  if 名 == "chr" {
    if len(值们) != 1 { return 坏("chr 要一个参数") }
    return 好(chr(值们[0]))
  }
  // 码点那一对是配套的：chr 造字符，ord 读回来。少了 ord，任何按码点分类的
  // 字符串处理都得写成逐字符比较 —— 标准库第一份正是这样撞上的。
  if 名 == "ord" {
    if len(值们) != 1 { return 坏("ord 要一个参数") }
    return 好(ord(值们[0]))
  }
  if 名 == "to_int" {
    if len(值们) != 1 { return 坏("to_int 要一个参数") }
    return 好(to_int(值们[0]))
  }
  if 名 == "nfc" {
    if len(值们) != 1 { return 坏("nfc 要一个参数") }
    return 好(nfc(值们[0]))
  }
  if 名 == "is_letter" {
    if len(值们) != 1 { return 坏("is_letter 要一个参数") }
    return 好(is_letter(值们[0]))
  }
  if 名 == "is_mark" {
    if len(值们) != 1 { return 坏("is_mark 要一个参数") }
    return 好(is_mark(值们[0]))
  }
  let 找 = 查找(环境, "fn:" + 名)
  if 找.found == false { return 坏("没有这个函数：" + 名) }
  // 找.value 是 (参数名们, 语句们, 效果名们)。绑参数要在**新的一层**上绑，
  // 而不是在调用者的环境上——否则函数的局部名字会漏回外面，
  // 而那是一门语言里最难查的一类错。
  let 参名们 = 找.value[0]
  let 体内 = 找.value[1]
  // 效果要往下核：被调的那个要什么，调用者就得声明什么。这一条是效果检查的全部意思，
  // 少了它就只是「把 effects 写进注释」。
  var 子效 = ()
  if len(找.value) > 2 { 子效 = 找.value[2] }
  let 欠 = 缺效果(子效, 我的效果(环境))
  if 欠 != "" { return 坏("HMYR-R0201 调 " + 名 + " 要 " + 欠 + " 效果，而调用它的函数没有声明") }
  if len(参名们) != len(值们) { return 坏("参数个数不对：" + 名 + " 要 " + str(len(参名们)) + " 个，给了 " + str(len(值们))) }
  let 体环境 = 绑参数(环境, 参名们, 值们, 0)
  let r = 执行块(体内, 更新(体环境, "效果", 子效))
  if r.ok == false { return 坏(r.text) }
  if r.done == true { return 好(r.value) }
  return 好(())
}

// 十的幂。小数与指数解析都要用它。
// 负指数是除以十的正次幂 —— 1e-3 那一类写法要有落点。
fn 幂十(n: Int) -> Int {
  if n < 0 {
    return 1 / 幂十(0 - n)
  }
  var 出 = 1
  var i = 0
  while i < n {
    出 = 出 * 10
    i = i + 1
  }
  return 出
}

fn 小数点位置(s: String) -> Int {
  var i = 0
  while i < len(s) {
    if s[i] == "." {
      return i
    }
    i = i + 1
  }
  return 0 - 1
}

// 指数的位置：e 或 E。没有就交回 -1。
fn 指数位置(s: String) -> Int {
  var i = 0
  while i < len(s) {
    if s[i] == "e" { return i }
    if s[i] == "E" { return i }
    i = i + 1
  }
  return 0 - 1
}

// 没有指数的那些：整数交给 to_int，带小数点的自己拆。
fn 小数到(s: String) -> Int {
  let 位 = 小数点位置(s)
  if 位 < 0 {
    return to_int(s)
  }
  let 整 = slice(s, 0, 位)
  let 小 = slice(s, 位 + 1, len(s))
  let 值 = to_int(小)
  return to_int(整) + 值 / 幂十(len(小))
}

// 一个数字字面量 → 数。
//
// 三件都要处理：整数、小数、指数。早先这一层把所有字面量都交给 to_int，
// 于是 1.5 报「不是整数字面量」；只补小数之后，1e3 还是被切成 1 与 e3。
// 现在先看有没有指数，有就拆成「尾数乘十的幂」，尾数再走小数那一条。
fn 数到(s: String) -> Int {
  let 指 = 指数位置(s)
  if 指 >= 0 {
    let 尾 = slice(s, 0, 指)
    let 次 = to_int(slice(s, 指 + 1, len(s)))
    return 小数到(尾) * 幂十(次)
  }
  return 小数到(s)
}

// 求一个节点。这是核心：节点种类一分派，其余都交给上面的帮手。
fn 求值(节点: Int, 环境: Int) -> Int {
  let 种 = 节点.kind
  if 种 == "int" { return 好(to_int(节点.text)) }
  if 种 == "num" { return 好(数到(节点.text)) }
  if 种 == "str" { return 好(节点.text) }
  // nil：这门语言没有 null，空元组就是它。而求值器要认得出 {kind: "nil"} 这种节点，
  // 因为 stmt.hmyr 用它在「return 不带值」时占位。
  if 种 == "nil" { return 好(()) }
  if 种 == "name" {
    // 布尔字面量：自举那一层的切词器把关键字一律当成标识符（见 lex.hmyr 开头那段），
    // 于是 true 与 false 到这一步是「一个名字」。要在这里把它们认回来，
    // 否则目标程序里写一个 true 就会报「没有这个名字：true」。
    // 这两个词是语言的关键字，不可能是用户起的名字，所以先认它们没有歧义。
    if 节点.text == "true" { return 好(1 == 1) }
    if 节点.text == "false" { return 好(1 == 2) }
    let r = 查找(环境, 节点.text)
    if r.found == false { return 坏("没有这个名字：" + 节点.text) }
    return 好(r.value)
  }
  if 种 == "bin" { return 求二元(节点.op, 求值(节点.left, 环境), 求值(节点.right, 环境)) }
  if 种 == "unary" { return 求一元(节点.op, 求值(节点.operand, 环境)) }
  if 种 == "call" { return 求调用(节点, 环境) }
  if 种 == "index" {
    let 标 = 求值(节点.target, 环境)
    if 标.ok == false { return 标 }
    let 位 = 求值(节点.index, 环境)
    if 位.ok == false { return 位 }
    return 好(标.value[位.value])
  }
  if 种 == "field" {
    // 不能写 标.value[节点.name]：下标只收数字，而这里字段名是个变量。
    // 先问再取：field_get 取不到会抛（有编号），而这里接不住异常，所以先问 field_has。
    let 标 = 求值(节点.target, 环境)
    if 标.ok == false { return 标 }
    if field_has(标.value, 节点.name) == false { return 坏("没有这个字段：" + 节点.name) }
    return 好(field_get(标.value, 节点.name))
  }
  if 种 == "tuple" { return 求参数(节点.items, 环境) }
  if 种 == "record" { return 求记录(节点, 环境) }
  if 种 == "err" { return 坏("语法层报的错：" + 节点.text) }
  return 坏("不认识的节点：" + 种)
}

// 一段节点求值并直接把结果打成文字。给示例与测试用。
fn 求值成文字(节点: Int, 环境: Int) -> String {
  let r = 求值(节点, 环境)
  if r.ok == false { return "错：" + r.text }
  return str(r.value)
}

// ---- 语句层 ----
//
// 表达式求值不改变环境，而语句需要：let/var/assign 都让名字指向新的值。
// 这门语言的 let 不可变，所以环境用「追加一对」的方式更新——不引入可变状态。
// 查找从后往前，于是后定义自然覆盖先定义。
//
// 执行的结果统一成一个记录：
//   {ok: true,  env: 新环境, done: false, value: ()}     正常走完
//   {ok: true,  env: 新环境, done: true,  value: 返回值}  遇到 return
//   {ok: false, env: (),     done: true,  text: 原因}     出错（done 也是真：不能再往下走）

// 绑参数：把 值们 挨个绑到 名们 上，交回一层新环境。
// 「新的一层」这件事在 执行块 里由它自己管（它把 let 绑在局部），
// 而参数这一层必须先于函数体的第一个 let 就位。
fn 绑参数从(环境: Int, 名们: Int, 值们: Int, i: Int) -> Int {
  if i >= len(名们) { return 环境 }
  return 绑参数从(更新(环境, 名们[i], 值们[i]), 名们, 值们, i + 1)
}

fn 绑参数(环境: Int, 名们: Int, 值们: Int, 起: Int) -> Int {
  return 绑参数从(环境, 名们, 值们, 起)
}

fn 更新(环境: Int, 名: String, 值: Int) -> Int {
  return 环境 + ((名, 值),)
}

fn 好执行(环境: Int, 完成: Bool, 值: Int) {
  return {ok: true, env: 环境, done: 完成, value: 值}
}

fn 坏执行(原因: String) {
  return {ok: false, env: (), done: true, text: 原因}
}

fn 执行(节点: Int, 环境: Int) -> Int {
  let 种 = 节点.kind
  if 种 == "let" || 种 == "var" {
    let v = 求值(节点.value, 环境)
    if v.ok == false { return 坏执行(v.text) }
    return 好执行(更新(环境, 节点.name, v.value), false, ())
  }
  if 种 == "assign" {
    let 现有 = 查找(环境, 节点.name)
    if 现有.found == false { return 坏执行("不能给没声明过的名字赋值：" + 节点.name) }
    let v = 求值(节点.value, 环境)
    if v.ok == false { return 坏执行(v.text) }
    return 好执行(更新(环境, 节点.name, v.value), false, ())
  }
  if 种 == "expr" {
    let v = 求值(节点.value, 环境)
    if v.ok == false { return 坏执行(v.text) }
    return 好执行(环境, false, ())
  }
  if 种 == "return" {
    // 无值时那个位置是 {kind: "nil"}，于是这一层只看 kind——不用 len 去探，
    // 因为值也可能是一个记录，而 len 只收字符串与元组。
    if 节点.value.kind == "nil" { return 好执行(环境, true, ()) }
    let v = 求值(节点.value, 环境)
    if v.ok == false { return 坏执行(v.text) }
    return 好执行(环境, true, v.value)
  }
  if 种 == "if" {
    let c = 求值(节点.cond, 环境)
    if c.ok == false { return 坏执行(c.text) }
    if c.value != false {
      if len(节点.then) == 0 { return 好执行(环境, false, ()) }
      return 执行块(节点.then, 环境)
    }
    if len(节点.otherwise) == 0 { return 好执行(环境, false, ()) }
    return 执行块(节点.otherwise, 环境)
  }
  if 种 == "while" { return 执行反复(节点, 环境, 0) }
  if 种 == "err" { return 坏执行("语法层报的错：" + 节点.text) }
  return 坏执行("这一版还不认这种语句：" + 种)
}

// while：条件真就跑一遍体，然后拿**体交回的环境**再判一次。
// 体里若有 i = i + 1，新环境在 r.env 里；不看它，循环就永远不前进。
fn 执行反复(节点: Int, 环境: Int, 次数: Int) -> Int {
  if 次数 >= 1000000 { return 坏执行("while 跑过一百万次还没结束") }
  let c = 求值(节点.cond, 环境)
  if c.ok == false { return 坏执行(c.text) }
  if c.value == false { return 好执行(环境, false, ()) }
  let r = 执行块(节点.body, 环境)
  if r.ok == false { return 坏执行(r.text) }
  if r.done == true { return r }
  return 执行反复(节点, r.env, 次数 + 1)
}

fn 执行块从(语句们: Int, 环境: Int, i: Int) -> Int {
  if i >= len(语句们) { return 好执行(环境, false, ()) }
  let r = 执行(语句们[i], 环境)
  if r.ok == false { return r }
  if r.done == true { return r }
  return 执行块从(语句们, r.env, i + 1)
}

fn 执行块(语句们: Int, 环境: Int) -> Int {
  return 执行块从(语句们, 环境, 0)
}

// 跑一段语句：从空环境开始。交回 {ok, env, done, value}。
fn 跑程序(语句们: Int) -> Int {
  return 执行块(语句们, ())
}

// 把函数表装进环境：每项是 (名字, 语句们)，装成 ("fn:名字", 语句们)。
// 函数表里每一项是 (名字, 参数名们, 语句们)，而环境里存的是 (参数名们, 语句们)。
// 为什么要带参数名：自举这一层以前执行函数体时不绑参数，于是带参数的函数
// 会以「没有这个名字」失败。那不是错——它诚实地说了——而它让这门语言少了一半。
fn 装函数从(环境: Int, 函数们: Int, i: Int) -> Int {
  if i >= len(函数们) { return 环境 }
  let 项 = 函数们[i]
  // 形状不对就跳过，而不是交回一个错误记录——
  // 这一层的返回类型是环境，把一个记录当成环境装进去，后面每一步都会读到怪东西。
  // 而「跳过」也不是沉默：装表本来就不该收到坏形状，坏形状该在造表那一头被拦住。
  if len(项) < 3 { return 装函数从(环境, 函数们, i + 1) }
  // 第四项是效果名们。老的三项形状也收 —— 那两条给套件用的解析器不带效果，
  // 而「没有效果」与「效果那一项缺了」在这里是同一件事。
  var 效 = ()
  if len(项) > 3 { 效 = 项[3] }
  return 装函数从(更新(环境, "fn:" + 项[0], (项[1], 项[2], 效)), 函数们, i + 1)
}

// 老的入口留着：两个套件按两参数调它，而它们测的是「适配层造出的语句表能不能跑」。
// 新的一层带参数，因为目标程序要看得见自己的 argv —— 那件事以前根本做不到。
fn 跑程序带函数(语句们: Int, 函数们: Int) -> Int {
  return 跑程序带函数与参(语句们, 函数们, (), ())
}

// 效们 是 main 自己声明的效果。它要放进环境，因为「当前函数有哪些效果」这件事
// 只能在运行时知道 —— 效果检查靠的就是这个键。
fn 跑程序带函数与参(语句们: Int, 函数们: Int, 参们: Int, 效们: Int) -> Int {
  let 环境 = 更新(装函数从((), 函数们, 0), "argv", 参们)
  return 执行块(语句们, 更新(环境, "效果", 效们))
}

// 造记录：先把每个值求出来，再交给 record_of。
// 字段名来自源码，所以一定是标识符能写的形状——这正是 record_of 收的那一类。
// 字段的形状来自 self/chain.hmyr：{name, value}——是记录，不是二元元组。
// 所以这里读 .name 与 .value，而不是取下标。
fn 求字段从(字段们: Int, 环境: Int, i: Int, acc: Int) -> Int {
  if i >= len(字段们) { return 好(acc) }
  let 字段 = 字段们[i]
  let v = 求值(字段.value, 环境)
  if v.ok == false { return v }
  return 求字段从(字段们, 环境, i + 1, acc + ((字段.name, v.value),))
}

fn 求记录(节点: Int, 环境: Int) -> Int {
  let 里 = 求字段从(节点.fields, 环境, 0, ())
  if 里.ok == false { return 里 }
  return 好(record_new(里.value))
}

fn main() -> Int effects(process) {
  let 节点 = {kind: "bin", op: "+", left: {kind: "int", text: "1"}, right: {kind: "bin", op: "*", left: {kind: "int", text: "2"}, right: {kind: "int", text: "3"}}}
  print(求值成文字(节点, ()) + "\n")
  return 0
}
