// 只建树：输入文件，打印字长与距长的码长分布、最大树深、Kraft 和。
// 不写流。动态 Huffman 卡了三轮，都是「写完整个编码器再看解码器脸色」；
// 这个工具把那件事拆成可以逐个核对的小问题。
//
// Kraft 和用 2^15 为单位：Σ 2^(15-长度) 必须恰好是 32768（即 Σ 2^-长度 = 1）。
//
// 用法：hmyr self/tree.hmyr <文件>

fn 倍(n: Int) -> Int {
  var v = 1
  var i = 0
  while i < n {
    v = v * 2
    i = i + 1
  }
  return v
}

fn 置(元组: Int, 下标: Int, 值: Int) -> Int {
  var 出 = ()
  var i = 0
  while i < len(元组) {
    if i == 下标 { 出 = 出 + (值,) } else { 出 = 出 + (to_int(元组[i]),) }
    i = i + 1
  }
  return 出
}

fn 长表() {
  return ((3, 257, 0), (4, 258, 0), (5, 259, 0), (6, 260, 0), (7, 261, 0), (8, 262, 0), (9, 263, 0), (10, 264, 0),
    (11, 265, 1), (13, 266, 1), (15, 267, 1), (17, 268, 1), (19, 269, 2), (23, 270, 2), (27, 271, 2), (31, 272, 2),
    (35, 273, 3), (43, 274, 3), (51, 275, 3), (59, 276, 3), (67, 277, 4), (83, 278, 4), (99, 279, 4), (115, 280, 4),
    (131, 281, 5), (163, 282, 5), (195, 283, 5), (227, 284, 5), (258, 285, 0))
}

fn 距表() {
  return ((1, 0, 0), (2, 1, 0), (3, 2, 0), (4, 3, 0), (5, 4, 1), (7, 5, 1), (9, 6, 2), (13, 7, 2),
    (17, 8, 3), (25, 9, 3), (33, 10, 4), (49, 11, 4), (65, 12, 5), (97, 13, 5), (129, 14, 6), (193, 15, 6),
    (257, 16, 7), (385, 17, 7), (513, 18, 8), (769, 19, 8), (1025, 20, 9), (1537, 21, 9), (2049, 22, 10), (3073, 23, 10),
    (4097, 24, 11), (6145, 25, 11), (8193, 26, 12), (12289, 27, 12), (16385, 28, 13), (24577, 29, 13))
}

fn 查表(表: Int, 值: Int) -> Int {
  var i = len(表) - 1
  while i >= 0 {
    if 表[i][0] <= 值 { return 表[i] }
    i = i - 1
  }
  return 表[0]
}

fn 找匹配(字节们: Int, i: Int) {
  let 总 = len(字节们)
  var 最 = 0
  var 距 = 0
  var 起 = i - 4096
  if 起 < 0 { 起 = 0 }
  var j = 起
  while j < i {
    var 长 = 0
    var 继续 = true
    while 继续 && 长 < 258 && i + 长 < 总 && j + 长 < 总 {
      if 字节们[i + 长] == 字节们[j + 长] { 长 = 长 + 1 } else { 继续 = false }
    }
    if 长 > 最 {
      最 = 长
      距 = i - j
    }
    j = j + 1
  }
  return {长: 最, 距: 距}
}

fn 切块(字节们: Int) {
  var 列 = ()
  var i = 0
  while i < len(字节们) {
    let 匹 = 找匹配(字节们, i)
    if 匹.长 >= 3 {
      列 = 列 + ({类: 1, 长: 匹.长, 距: 匹.距},)
      i = i + 匹.长
    } else {
      列 = 列 + ({类: 0, 值: to_int(字节们[i])},)
      i = i + 1
    }
  }
  return 列
}

fn 统计(列: Int) {
  var 字频 = ()
  var i = 0
  while i < 286 {
    字频 = 字频 + (0,)
    i = i + 1
  }
  var 距频 = ()
  i = 0
  while i < 30 {
    距频 = 距频 + (0,)
    i = i + 1
  }
  i = 0
  while i < len(列) {
    let t = 列[i]
    if t.类 == 0 {
      字频 = 置(字频, t.值, to_int(字频[t.值]) + 1)
    } else {
      let 长码 = 查表(长表(), t.长)
      字频 = 置(字频, 长码[1], to_int(字频[长码[1]]) + 1)
      let 距码 = 查表(距表(), t.距)
      距频 = 置(距频, 距码[1], to_int(距频[距码[1]]) + 1)
    }
    i = i + 1
  }
  字频 = 置(字频, 256, to_int(字频[256]) + 1)
  return {字频: 字频, 距频: 距频}
}

// 建树取码长：频 0 的符号不进树。返回的码长是「到根的边数」。
fn 码长们(频们: Int) {
  var 权 = ()
  var 父 = ()
  var 活 = ()
  var i = 0
  while i < len(频们) {
    权 = 权 + (to_int(频们[i]),)
    父 = 父 + (0 - 1,)
    if to_int(频们[i]) > 0 { 活 = 活 + (i,) }
    i = i + 1
  }
  // 单符号特例：一个符号的树深度是 1（RFC 要求它用一位码，不是零位）。
  if len(活) == 1 {
    var 只 = ()
    i = 0
    while i < len(频们) {
      if i == to_int(活[0]) { 只 = 只 + (1,) } else { 只 = 只 + (0,) }
      i = i + 1
    }
    return 只
  }
  while len(活) > 1 {
    var 甲 = 0 - 1
    var 乙 = 0 - 1
    var 甲权 = 0 - 1
    var 乙权 = 0 - 1
    var k = 0
    while k < len(活) {
      let 号 = to_int(活[k])
      let w = to_int(权[号])
      if 甲权 < 0 || w < 甲权 {
        乙 = 甲
        乙权 = 甲权
        甲 = 号
        甲权 = w
      } else if 乙权 < 0 || w < 乙权 {
        乙 = 号
        乙权 = w
      }
      k = k + 1
    }
    let 新 = len(权)
    权 = 权 + (甲权 + 乙权,)
    父 = 父 + (0 - 1,)
    父 = 置(父, 甲, 新)
    父 = 置(父, 乙, 新)
    var 新活 = ()
    k = 0
    while k < len(活) {
      let 号 = to_int(活[k])
      if 号 != 甲 && 号 != 乙 { 新活 = 新活 + (号,) }
      k = k + 1
    }
    活 = 新活 + (新,)
  }
  var 长们 = ()
  i = 0
  while i < len(频们) {
    var 深 = 0
    if to_int(频们[i]) > 0 {
      var 号 = i
      while to_int(父[号]) >= 0 {
        深 = 深 + 1
        号 = to_int(父[号])
      }
    }
    长们 = 长们 + (深,)
    i = i + 1
  }
  return 长们
}

fn 看一份(名: String, 长们: Int) {
  var 和 = 0
  var 最 = 0
  var 用 = 0
  var i = 0
  while i < len(长们) {
    let l = to_int(长们[i])
    if l > 0 {
      用 = 用 + 1
      if l > 最 { 最 = l }
      if l <= 15 { 和 = 和 + 倍(15 - l) }
    }
    i = i + 1
  }
  print(名 + "：符号 " + str(用) + " 个，最大深 " + str(最) + "，Kraft 和 " + str(和) + "（要 32768）" + chr(10))
  var j = 0
  var 前 = ""
  while j < len(长们) && j < 24 {
    let l = to_int(长们[j])
    if l > 0 { 前 = 前 + " " + str(j) + ":" + str(l) }
    j = j + 1
  }
  print("  前几个有码的符号（下标:码长）：" + 前 + chr(10))
  return 0
}

// 验「码长码表」：把 316 个码长值（0-15）各自出现几次当频率，再建一棵十九项的表。
// zlib 拒的是这一层，而它不是数据段的树。
fn 看码长表(字长: Int, 距长: Int) {
  var 全长 = ()
  var i = 0
  while i < len(字长) {
    全长 = 全长 + (to_int(字长[i]),)
    i = i + 1
  }
  i = 0
  while i < len(距长) {
    全长 = 全长 + (to_int(距长[i]),)
    i = i + 1
  }
  var 频 = ()
  i = 0
  while i < 16 {
    频 = 频 + (0,)
    i = i + 1
  }
  i = 0
  while i < len(全长) {
    let l = to_int(全长[i])
    频 = 置(频, l, to_int(频[l]) + 1)
    i = i + 1
  }
  let 码长16 = 码长们(频)
  var 码长19 = ()
  i = 0
  while i < 19 {
    if i < len(码长16) { 码长19 = 码长19 + (to_int(码长16[i]),) } else { 码长19 = 码长19 + (0,) }
    i = i + 1
  }
  看一份("码长码表（19 项，按符号 0-18 排）", 码长19)
  return 0
}

fn main() -> Int effects(file) {
  let 参 = argv()
  if len(参) < 2 {
    print("用法：hmyr self/tree.hmyr <文件>" + chr(10))
    return 2
  }
  let 字节们 = read_bytes(参[1])
  print("输入 " + str(len(字节们)) + " 字节" + chr(10))
  let 列 = 切块(字节们)
  print("切出 " + str(len(列)) + " 个 token" + chr(10))
  let 频 = 统计(列)
  let 字长 = 码长们(频.字频)
  let 距长 = 码长们(频.距频)
  看一份("字长", 字长)
  看一份("距长", 距长)
  看码长表(字长, 距长)
  return 0
}
