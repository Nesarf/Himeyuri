// 一条命令出一个发布：清单、包、说明书。
//
// 顺序是硬约束 —— 先造清单（它记着每个文件的 sha256），再打包。反过来会得到一份
// 「描述已经不存在的字节」的清单。
//
// 这一版不做两件，写在明处而不是留给人去发现：
//   一、签名的生成。验签已经在 HMYR 里（self/sign.hmyr），但用私钥签一份还得靠
//      ssh-keygen —— 私钥不该进语言运行时，所以这一步永远在外面。
//   二、真发。--upload 一类需要网络与凭据的步骤留在 tools/release.mjs ——
//      它跑 gh release create，那要一张 GitHub 令牌，而凭据不该进语言运行时。
//
// 产物命名用 tag，不用日期：tag 是人给的声明，日期是机器的时间；而发布这件事
// 需要的是「这一次叫什么」，不是「这一次发生在哪一天」。
import "./manifest.hmyr"
import "./package.hmyr"

fn 数字(s: String) -> String {
  return s
}

// 一行一行攒成一段文字：每行后面带换行，末尾再切掉一个。
fn 拼行(行集: Int) {
  var 块 = ()
  var 一段 = ""
  var i = 0
  while i < len(行集) {
    一段 = 一段 + 行集[i] + chr(10)
    i = i + 1
  }
  return slice(一段, 0, len(一段) - 1)
}

fn 说明书(标: String, 包名: String, 清单名: String) effects(file) {
  var 行 = ()
  行 = 行 + ("Himeyuri " + 标,)
  行 = 行 + ("",)
  行 = 行 + ("  这一份发布由 HMYR 自己造：清单、归档、说明书，三样都出自 self/ 下那几个程序。",)
  行 = 行 + ("  数字不在这里重复 —— 清单是机器读的那一份，而它比这段文字更完整。",)
  行 = 行 + ("",)
  行 = 行 + ("要发的资产",)
  行 = 行 + ("--------------------------------------------------------------------",)
  行 = 行 + ("",)
  行 = 行 + ("  " + 包名 + "       归档：仓库里那些目录的逐字节副本",)
  行 = 行 + ("  " + 清单名 + "    每一份文件的 sha256，外加整份的 digest",)
  行 = 行 + ("",)
  行 = 行 + ("哪些资产带签名",)
  行 = 行 + ("--------------------------------------------------------------------",)
  行 = 行 + ("",)
  行 = 行 + ("  清单的分离签名（Ed25519）由 HMYR 自己验：",)
  行 = 行 + ("",)
  行 = 行 + ("    hmyr self/sign.hmyr manifest.json.sig manifest.json",)
  行 = 行 + ("",)
  行 = 行 + ("  签这一步在外面 —— 它要一把私钥，而私钥不该进语言运行时。",)
  行 = 行 + ("  所以这份发布能回答「内容对不对」与「清单是谁给的」（拿到签名时），",)
  行 = 行 + ("  只有「由谁签」这一点取决于钥匙在谁手里。",)
  行 = 行 + ("",)
  行 = 行 + ("哪些没有，以及为什么",)
  行 = 行 + ("--------------------------------------------------------------------",)
  行 = 行 + ("",)
  行 = 行 + ("  归档本身没有内嵌签名 —— ZIP 里没有放签名的地方。所以就算有了签名，",)
  行 = 行 + ("  签的也会是清单，而不是归档：清单里每个文件一个 sha256，整份一个 digest，",)
  行 = 行 + ("  于是「这一包是什么」由清单说，「清单是谁给的」由签名说。",)
  行 = 行 + ("",)
  行 = 行 + ("怎么自己验（不装本项目任何工具）",)
  行 = 行 + ("--------------------------------------------------------------------",)
  行 = 行 + ("",)
  行 = 行 + ("  一、把归档解开到一个空目录。",)
  行 = 行 + ("",)
  行 = 行 + ("  二、逐项比哈希。清单里每条一个 sha256（前十六位），",)
  行 = 行 + ("      用任何 sha256 工具算一遍前十六位就知道了。",)
  行 = 行 + ("",)
  行 = 行 + ("  三、不方便跑任何脚本时，只看一件事：清单的 digest。",)
  行 = 行 + ("      它是「删掉 digest 那一行、去掉它前一行的逗号」之后那份文本的 sha256。",)
  行 = 行 + ("      算出来的值对得上，说明清单本身没被动过。",)
  return 拼行(行) + chr(10)
}

fn 发布(标: String, 出目录: String) effects(file, process) {
  // 目录不存在时，write_text 会抛 R0212 —— 那句话对写程序的人是够用的，对跑发布的人
  // 不够。所以这里先挡一下，把「先建目录」说清楚。
  if !is_dir(出目录) {
    print("  输出目录 " + 出目录 + " 不在。先建它，再跑这一条。" + chr(10))
    return 1
  }
  let 清单路 = 出目录 + "/manifest.json"
  let 包名 = "himeyuri-" + 标 + ".zip"
  let 包路 = 出目录 + "/" + 包名
  let 说明路 = 出目录 + "/release-notes.md"

  // 一、清单
  print("  一、造清单 → " + 清单路 + chr(10))
  let 码 = 主(清单路)
  if 码 != 0 {
    print("  清单没造出来，发布中止。" + chr(10))
    return 1
  }

  // 二、归档。清单自己也被收进去 —— 解包即得清单，包内外是同一批字节。
  print("  二、打包 → " + 包路 + chr(10))
  let 码二 = 打包带(包路, "", false, 清单路, "manifest.json")
  if 码二 != 0 {
    print("  包没打出来，发布中止。" + chr(10))
    return 1
  }

  // 三、说明书
  write_text(说明路, 说明书(标, 包名, "manifest.json"))
  print("  三、说明书 → " + 说明路 + chr(10))
  print("" + chr(10))
  print("  要发的资产：" + chr(10))
  print("    " + 包路 + chr(10))
  print("    " + 清单路 + chr(10))
  print("    " + 说明路 + chr(10))
  print("" + chr(10))
  print("  真发不在这里做 —— gh release create 要一张 GitHub 令牌，" + chr(10))
  print("  而凭据不该进语言运行时。用 tools/release.mjs，或者手工跑 gh。" + chr(10))
  return 0
}

fn main() -> Int effects(file, process) {
  let 参 = argv()
  if len(参) < 2 {
    print("用法：hmyr self/release.hmyr <tag> [输出目录]" + chr(10))
    print("  tag 是这一次的名字，例如 v0.1.0；输出目录缺省是 dist。" + chr(10))
    return 2
  }
  var 出目录 = "dist"
  if len(参) > 2 { 出目录 = 参[2] }
  return 发布(参[1], 出目录)
}
