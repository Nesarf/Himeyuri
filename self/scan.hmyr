// 用 Himeyuri 写的第一个前端部件：把源码切成行，并认出每一行的声明。
//
// 这是 M7（自举）的第一步。它只用语言里已有的东西——字符串下标、字符串拼接、递归、元组、记录——
// 所以「能用它自己写自己」这句话，从今天起有了一个可以跑、可以对拍的实物。
//
// 一条诚实的约束写在前面：这门语言眼下没有尾调用消除，递归深度上限是 500，
// 因此宿主按段喂入（每段最多 100 行）。深度可控，逻辑照旧用 Himeyuri 写。

// 取一段字符串。递归深度等于片段长度，所以调用方要保证片段不长。
fn slice(s: String, from: Int, to: Int) -> String {
  if from >= to { return "" }
  return s[from] + slice(s, from + 1, to)
}

// 一个字符是不是空白。
fn is_space(c: String) -> Bool {
  return c == " " || c == "\t" || c == "\r"
}

// 跳过行首空白，返回第一个非空白字符的位置。
fn skip_space(s: String, i: Int) -> Int {
  if i >= len(s) { return i }
  if is_space(s[i]) { return skip_space(s, i + 1) }
  return i
}

// 在 s 的 from 处，是否以 p 开头。
fn starts_with(s: String, from: Int, p: String, k: Int) -> Bool {
  if k >= len(p) { return true }
  if from + k >= len(s) { return false }
  if s[from + k] != p[k] { return false }
  return starts_with(s, from, p, k + 1)
}

// 从 i 起读一个标识符；遇到分隔符就停。
fn read_word(s: String, i: Int, acc: String) -> String {
  if i >= len(s) { return acc }
  let c = s[i]
  if is_space(c) { return acc }
  if c == "(" { return acc }
  if c == ")" { return acc }
  if c == ":" { return acc }
  if c == "<" { return acc }
  if c == "{" { return acc }
  if c == "=" { return acc }
  if c == "," { return acc }
  return read_word(s, i + 1, acc + c)
}

// 找从 i 起第一个换行的位置（找不到就是末尾）。深度等于一行的长度。
fn find_nl(s: String, i: Int) -> Int {
  if i >= len(s) { return i }
  if s[i] == "\n" { return i }
  return find_nl(s, i + 1)
}

// 把一段文本切成行：外层每行一层递归，行内找换行是独立的一次递归。
// 两者不嵌套在同一层里，所以深度是「行数」与「行长」中的较大者，而不是它们的乘积——
// 逐字符到底的写法会让一段一百行变成几千层，直接撞上调用深度上限。
fn split_each(s: String, at: Int, acc: Int) -> Int {
  if at >= len(s) { return acc }
  let nl = find_nl(s, at)
  let line = slice(s, at, nl)
  if nl >= len(s) { return acc + (line,) }
  return split_each(s, nl + 1, acc + (line,))
}

// 一行的声明：记录 {keyword, name, indent}，不是声明就返回 keyword 为空串的记录。
fn what_is(line: String, line_number: Int) {
  let i = skip_space(line, 0)
  if starts_with(line, i, "pub ", 0) { i = skip_space(line, i + 4) }
  if starts_with(line, i, "fn ", 0) {
    return {kind: "fn", name: read_word(line, i + 3, ""), line: line_number}
  }
  if starts_with(line, i, "type ", 0) {
    return {kind: "type", name: read_word(line, i + 5, ""), line: line_number}
  }
  if starts_with(line, i, "const ", 0) {
    return {kind: "const", name: read_word(line, i + 6, ""), line: line_number}
  }
  if starts_with(line, i, "effect ", 0) {
    return {kind: "effect", name: read_word(line, i + 7, ""), line: line_number}
  }
  return {kind: "", name: "", line: line_number}
}

// 逐行识别，累积成元组。start_line 是本段第一行在整个文件里的行号（从 1 起算）。
fn scan_each(lines: Int, n: Int, start_line: Int, acc: Int) -> Int {
  if n >= len(lines) { return acc }
  let found = what_is(lines[n], start_line + n)
  if found.kind == "" {
    return scan_each(lines, n + 1, start_line, acc)
  }
  return scan_each(lines, n + 1, start_line, acc + (found,))
}

// 宿主调用的入口：给一段文本和它的起始行号，返回这一段里认出的声明。
fn scan(text: String, start_line: Int) -> Int {
  return scan_each(split_each(text, 0, ()), 0, start_line, ())
}

// 让宿主能问一句「你准备好了吗」，也方便人工试跑。
fn main() -> Int {
  let demo = "fn a() {\n  let x = 1\n}\n\ntype T = Int\n"
  let found = scan(demo, 1)
  let i = 0
  while_demo(found, i)
  return len(found)
}

// 没有 while，就用递归打印（只为人工试跑用）。
fn while_demo(found: Int, i: Int) -> Int {
  if i >= len(found) { return 0 }
  print(str(found[i].line) + " " + found[i].kind + " " + found[i].name)
  return while_demo(found, i + 1)
}
