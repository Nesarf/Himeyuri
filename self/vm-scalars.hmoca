// VM 那台机器的标量十七个内置：print、str、chr、ord、len、to_int、floor、nfc、
// is_letter、is_mark、abs、int、to_upper、to_lower、split、slice、bytes_to_text。
// 内置的 那一大块分派的第三刀。
//
// 为什么单独立一份（2026-11-05）：与前两刀同形 —— 各三行（print 十行）、不调任何
// 自定义函数，交回 {认, 值}。这一组是这门语言最基础的一层，所以搬出去之后 内置的
// 里剩下的分派都是「比标量更靠外」的东西：标准输入、路径、本地化、杂项。

公开 函数 求内置标量(名: String, 实参: Int, 圈: Int) {
若 名 == "print" {
    变 串 = ""
    变 i = 0
    当 i < len(实参) {
      串 = 串 + str(实参[i])
      i = i + 1
    }
    print(串)
    返回 {认: 真, 值: {ok: 真, 值: (), 说: ""}}
  }
若 名 == "str" {
    返回 {认: 真, 值: {ok: 真, 值: str(实参[0]), 说: ""}}
  }
若 名 == "chr" {
    返回 {认: 真, 值: {ok: 真, 值: chr(实参[0]), 说: ""}}
  }
若 名 == "ord" {
    返回 {认: 真, 值: {ok: 真, 值: ord(实参[0]), 说: ""}}
  }
若 名 == "len" {
    返回 {认: 真, 值: {ok: 真, 值: len(实参[0]), 说: ""}}
  }
若 名 == "to_int" {
    返回 {认: 真, 值: {ok: 真, 值: to_int(实参[0]), 说: ""}}
  }
若 名 == "floor" {
    返回 {认: 真, 值: {ok: 真, 值: floor(实参[0]), 说: ""}}
  }
若 名 == "nfc" {
    返回 {认: 真, 值: {ok: 真, 值: nfc(实参[0]), 说: ""}}
  }
若 名 == "is_letter" {
    返回 {认: 真, 值: {ok: 真, 值: is_letter(实参[0]), 说: ""}}
  }
若 名 == "is_mark" {
    返回 {认: 真, 值: {ok: 真, 值: is_mark(实参[0]), 说: ""}}
  }
若 名 == "abs" {
    返回 {认: 真, 值: {ok: 真, 值: abs(实参[0]), 说: ""}}
  }
若 名 == "int" {
    返回 {认: 真, 值: {ok: 真, 值: int(实参[0]), 说: ""}}
  }
若 名 == "to_upper" {
    返回 {认: 真, 值: {ok: 真, 值: to_upper(实参[0]), 说: ""}}
  }
若 名 == "to_lower" {
    返回 {认: 真, 值: {ok: 真, 值: to_lower(实参[0]), 说: ""}}
  }
若 名 == "split" {
    返回 {认: 真, 值: {ok: 真, 值: split(实参[0], 实参[1]), 说: ""}}
  }
若 名 == "slice" {
    返回 {认: 真, 值: {ok: 真, 值: slice(实参[0], 实参[1], 实参[2]), 说: ""}}
  }
若 名 == "bytes_to_text" {
    返回 {认: 真, 值: {ok: 真, 值: bytes_to_text(实参[0]), 说: ""}}
  }
  返回 {认: 假, 值: 0}
}
