// 双精度：从那八个字节读回一个数。
//
// 为什么要有这一份：src/f64.mjs 是 JS 侧的家底，而自举那一层一直没有对应的一份 ——
// self/ 里提到 f64 的四份（compile、eval、inflate、pack）都只是调 f64_bytes 那个内置，
// 而那个内置只做「数 → 八个字节」这一个方向（它的注释写着「数怎么变成八个字节由世界
// 那一侧回答」）。于是「读一份 .hmoks」这条路在 HMYR 里走不通：文件里的数字常量是八个
// 字节，而没有任何一层把它变回数。反方向不必写 —— f64_bytes 就是它。
//
// 表示与 src/f64.mjs 同一个：值 = (-1)^s 乘 M 乘 2 的 E 次方。
//   正规数   M 在 [2^52, 2^53)，E = 指数 - 1075
//   次正规   M < 2^52，E 固定 -1074
//   零       M = 0
//
// 这里不重算舍入：八个字节已经是舍好的结果，要做的只是把符号、指数、尾数读出来，
// 再乘回去。这一点与十进制那一侧不同 —— 那边要舍入，这边不用。
//
// 一个已知的慢处：2 的 n 次方是循环乘出来的，最多一千零七十四次。装载一份 .hmoks
// 时的常量个数是几十，所以这一点不算数；要快的话该换成平方乘，那是以后的事。
//
// 还没做的：负零。语言里造不出 -0 的入口（0 乘 0 减 1 那种写法在词法上就过不去），
// 而 f64_bytes 的反向又不存在。遇到负零的位模式时这一份交回正零，差别只在
// 「一除以它会得到负无穷」。真要它，得先有一个能造出它的内置。
//
// 2026-11-04 补：反方向（一个「整数乘二的幂」→ 八个字节）在上面这一段之后补上了，
// 名字是 装配；与它一起补的 装十进制 把「数字、十进制指数、符号」也走同一条路。
// 那两件要 840 位的中间结果（5 的 324 次方），所以引 self/wide.hmoca ——
// 这一份原来一个引入都没有，现在有第一个。

引入 "./wide.hmoca"

// 把一个数乘或除 2 的 n 次方。n 为负就是那个方向。
//
// 用循环而不是一次算 2^n：2^1024 那种中间值会溢出成无穷，而逐步乘除在下溢那一头
// 给出的正是次正规 —— 一步跳到次正规反而是错的。
//
// 每次走十位，因为 1024 就是 2 的 10 次方、它本身不会溢出，而循环次数因此少十倍。
// 一开始是一位一位走的，而第一版 conformance/lib-f64.hmoca 跑它就撞了步限
// （那一条要算七十来个位模式，每个最多一千零七十四步）。分块不是聪明的做法，
// 但它保住了「走到哪儿溢到哪儿」这个语义 —— 那才是这一个函数唯一的难点。
公开 函数 乘二(x: Int, n: Int) {
  变 出 = x * 1.0
  变 指 = n
  若 指 >= 0 {
    当 指 >= 10 {
      出 = 出 * 1024.0
      指 = 指 - 10
    }
    当 指 > 0 {
      出 = 出 * 2.0
      指 = 指 - 1
    }
    返回 出
  }
  指 = 0 - 指
  当 指 >= 10 {
    出 = 出 / 1024.0
    指 = 指 - 10
  }
  当 指 > 0 {
    出 = 出 / 2.0
    指 = 指 - 1
  }
  返回 出
}

// 八个字节（小端，最低位在前）→ 一个数。
//
// 低四字节与高四字节各自拼成一个 32 位的整数：语言里的数精确到 2 的 53 次方，
// 所以这两个都在安全范围里，不必借大整数。
公开 函数 由位(八: Int) {
  定 低 = 字节们(八, 0)
  定 高 = 字节们(八, 4)
  // 符号是指数的上面一位，也就是高 32 位的最上面一位。
  定 负 = 高 >= 2147483648
  // 指数 11 位、尾数 52 位：高 32 位里，低 20 位是尾数的高段，再往上 11 位是指数。
  //
  // 这里的 floor 不是装饰：语言里的 / 是浮点除，% 跟着也是浮点的语义。
  // 高 = 0x7FEFFFFF 时 高 / 1048576 是 2047.9999990463257，而 高 % 1048576 给出 -1
  // —— 于是尾数成了负数，M 全错，最大正规算出来是无穷。1.0 恰好整除，所以它没事，
  // 而这一类「大部分对、边界错」的错最难从现象上认出来（2026-11-04 撞的）。
  定 指 = floor(高 / 1048576) % 2048
  定 尾 = 低 + (高 - floor(高 / 1048576) * 1048576) * 4294967296
  // 指数全一：无穷（尾数为零）与非数（尾数非零）。
  若 指 == 2047 {
    定 大 = 乘二(1.0, 1024)
    若 尾 != 0 { 返回 大 - 大 }
    若 负 { 返回 0 - 大 }
    返回 大
  }
  // 次正规：指数为零，尾数就是 M，E 固定 -1074。
  若 指 == 0 {
    若 尾 == 0 { 返回 0 }
    若 负 { 返回 乘二(0 - 尾, 0 - 1074) }
    返回 乘二(尾, 0 - 1074)
  }
  // 正规：加回那一位隐含的 1，指数减掉偏移。
  定 M = 尾 + 4503599627370496
  若 负 { 返回 乘二(0 - M, 指 - 1075) }
  返回 乘二(M, 指 - 1075)
}

// 从第 起 个字节开始拼一个 32 位的小端整数。
公开 函数 字节们(八: Int, 起: Int) {
  返回 to_int(八[起]) + to_int(八[起 + 1]) * 256 + to_int(八[起 + 2]) * 65536 + to_int(八[起 + 3]) * 16777216
}

// 一个数 → 八个字节。这一层自己不做：f64_bytes 那个内置就是它，而两份实现
// 只会给出两个答案。留这个说明在这里，是为了让读的人不必再猜一次。

// ---- 反方向：从整数与指数装出八个字节 ----
//
// 下面是 src/f64.mjs 的 装配 与 右舍 的搬运，加 src/decimal.mjs 的 装十进制。
// 为什么要搬：编译期解析十进制字面量那一条路（self/compile.hmoca 的数字值）
// 一直是拿双精度直接乘除 10 的幂，于是 1e-320 这种数读成零 ——
// 10^320 溢出成无穷，一除就是零。正确的做法只有一条：把值写成整数乘二的幂，
// 舍入只做一次。这份文件现在有那一条路了。
//
// 位模式在这一层就是八个字节（与 由位 的输入同一个形状），不是 64 位整数 ——
// 语言里的数只精确到 2 的 53 次方，装不下 64 位。所以最后一步是分成
// 高 32 位与低 32 位各自算，再拆成字节。

// 宽整数 → 普通数。只对 53 位以内精确，而装配里用它的地方都满足这一条
// （商一定落在 53 位内：那是装配的前提）。
//
// 三个字就够：2 的 72 次方以内的值，只要它真的小于 2 的 53 次方。
函数 宽成数(a: Int) {
  返回 a[0] + a[1] * 16777216 + a[2] * 281474976710656
}

// 宽整数的第 n 位。装配只用它取一位（移出去的最高位），所以这里只管对、不管快。
函数 取宽位(a: Int, n: Int) -> Int {
  定 字 = floor(n / 24)
  定 位 = n - 字 * 24
  变 倍 = 1
  变 i = 0
  当 i < 位 {
    倍 = 倍 * 2
    i = i + 1
  }
  定 值 = a[字]
  返回 floor(值 / 倍) - floor(值 / (倍 * 2)) * 2
}

// 高 32 位与低 32 位 → 八个字节（小端，最低位在前）。与 由位 的读法相反、顺序相同。
//
// 一行两个，与 self/wide.hmoca 的 零() 同一个排法：这一份语言的元组字面量可以跨行，
// 但每行都得是完整的一项，写成一项分两行就要靠续行规则，那是另一件事。
函数 造位(高: Int, 低: Int) {
  返回 (低 - floor(低 / 256) * 256, floor(低 / 256) - floor(低 / 65536) * 256,
          floor(低 / 65536) - floor(低 / 16777216) * 256, floor(低 / 16777216),
          高 - floor(高 / 256) * 256, floor(高 / 256) - floor(高 / 65536) * 256,
          floor(高 / 65536) - floor(高 / 16777216) * 256, floor(高 / 16777216))
}

// 符号位、指数全一（无穷/非数那一档）、隐含的 1、2 的 53 次方。
// 写成函数而不是散在正文里的字面量，是为了让数字里少一次数错的机会。
函数 符位(负: Bool) -> Int {
  若 负 {
    返回 2147483648
  }
  返回 0
}

函数 无穷高() -> Int {
  返回 2146435072
}

函数 隐含() -> Int {
  返回 4503599627370496
}

函数 顶位() -> Int {
  返回 9007199254740992
}

// 装配：值 = M 乘 2 的 E 次方，交回八个字节。
//
// 有余 是 sticky：M 之外还漏了非零的时候，正好一半那一步要进一。
// 而「有余」只在 装十进制 那一条路上有 —— 它除 5 的幂时把余数丢了，只记真假。
//
// 四条出口，顺序要紧：先零、再溢出、再次正规、最后正规。
// 次正规那一条必须先判 —— 它的指数位是零，与正规的装法不同，装错了不会报错，
// 只会把最小的一档数算大一倍。
公开 函数 装配(M: Int, E: Int, 负: Bool, 有余: Bool) {
  定 符 = 符位(负)
  若 宽是零(M) {
    返回 造位(符, 0)
  }
  定 长 = 宽位长(M)
  定 e = E + 长 - 1
  若 e > 1023 {
    返回 造位(符 + 无穷高(), 0)
  }
  // 目标指数：正规数按 e 减 52，次正规固定在 -1074（于是精度一位一位地少下去）。
  变 目标E = 0 - 1074
  若 e >= 0 - 1022 {
    目标E = e - 52
  }
  定 k = 目标E - E
  变 M2 = 0.0
  若 k <= 0 {
    // 往左移：不丢位，也就没有舍入。
    M2 = 宽成数(宽左移(M, 0 - k))
  } 否则 {
    // 往右移 k 位，舍入到最近的偶数。要三样东西：商、移出去的最高位、更低位有没有非零。
    // 「余比一半大」= 最高位是一、更低还有；「正好一半」= 最高位是一、更低全零。
    // 于是不必真的算出一个 k 位宽的余数 —— 那正是宽整数最不该做的事。
    定 半 = 宽右移(M, k - 1)
    定 高 = 取宽位(半.商, 0)
    定 商 = 宽成数(宽右移(半.商, 1).商)
    若 高 == 0 {
      M2 = 商
    } 否则 若 半.余非零 || 有余 {
      M2 = 商 + 1
    } 否则 若 商 - floor(商 / 2) * 2 == 1 {
      M2 = 商 + 1
    } 否则 {
      M2 = 商
    }
  }
  // 舍入进位可能把 M2 顶到 2 的 53 次方：那就降一格，指数加一。
  若 M2 >= 顶位() {
    M2 = M2 / 2
    目标E = 目标E + 1
  }
  若 M2 == 0 {
    返回 造位(符, 0)
  }
  若 目标E + 52 > 1023 {
    返回 造位(符 + 无穷高(), 0)
  }
  定 藏 = 隐含()
  若 目标E == 0 - 1074 && M2 < 藏 {
    // 次正规：指为零，尾就是 M2 本身。
    返回 造位(符 + floor(M2 / 4294967296), M2 - floor(M2 / 4294967296) * 4294967296)
  }
  定 指 = 目标E + 1075
  定 余数 = M2 - 藏
  定 低 = 余数 - floor(余数 / 4294967296) * 4294967296
  定 高 = 指 * 1048576 + floor(余数 / 4294967296)
  返回 造位(符 + 高, 低)
}

// 十进制装配：值 = 数字 乘 10 的 指 次方，符号另给。交回八个字节。
//
// 数字 是宽整数（尾数），指 是十进制指数。正指数把 5 的幂乘进去、二的幂留给 装配；
// 负指数先把数字左移到还有六十来位，再一路除 5 —— 余数只留「有没有」，
// 那正是 装配 要的 sticky。
//
// 两个界写在前面，因为它们不是优化，是「这一份装不下」的诚实交代：
//   指 > 308   值至少是 10 的 309 次方，一定溢出成无穷；
//   指 < -380  任何不超过四十位十进制的尾数乘上去都小于最小次正规，一定下溢成零。
// 两条都是「一定」，不是「大概」—— 所以它们可以跳过程序，而不只是省时间。
公开 函数 装十进制(数字: Int, 指: Int, 负: Bool) {
  若 宽是零(数字) {
    返回 造位(符位(负), 0)
  }
  若 指 > 308 {
    返回 造位(符位(负) + 无穷高(), 0)
  }
  若 指 >= 0 {
    变 值 = 数字
    变 i = 0
    当 i < 指 {
      值 = 宽乘小(值, 5)
      i = i + 1
    }
    返回 装配(值, 指, 负, 假)
  }
  定 k = 0 - 指
  若 k > 380 {
    返回 造位(符位(负), 0)
  }
  // 5 的 k 次方的位长：分母那一位数要用来定左移多少。
  变 五的 = 宽数(1)
  变 i = 0
  当 i < k {
    五的 = 宽乘小(五的, 5)
    i = i + 1
  }
  // 商要留在六十七位上下：够五十三位的舍入，也够舍入之后还剩一位可判。
  变 移 = 67 + 宽位长(五的) - 宽位长(数字)
  若 移 < 0 {
    移 = 0
  }
  变 被 = 宽左移(数字, 移)
  变 有剩 = 假
  变 j = 0
  当 j < k {
    定 除 = 宽除小(被, 5)
    被 = 除.商
    若 除.余 != 0 {
      有剩 = 真
    }
    j = j + 1
  }
  返回 装配(被, 0 - k - 移, 负, 有剩)
}
