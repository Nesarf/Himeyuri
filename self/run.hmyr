// 自举的最后一步：把四件串起来，让 Himeyuri 自己跑 Himeyuri。
//
//   源码 → lex.scan（token）→ chain.chain（节点）→ eval.求值（值）
//
// 这一件之外没有别的环节：宿主只负责「起它」。也就是说，下面这段程序的每一层
// （怎么切词、怎么搭树、怎么算值）都由 Himeyuri 自己写成，而不是借用别人的语言。
//
// 边界照旧写在明处：
//   ・词法与语法层的错会被原样带上来，不猜、不跳过
//   ・这一版的求值器只认十二种节点里已经实现的部分（记录还不支持）
//   ・调用只认 len 与 str 两个纯函数；打印由这里做，因为这里才该动世界

import "./lex.hmyr"
import "./chain.hmyr"
import "./stmt.hmyr"
import "./body.hmyr"
import "./eval.hmyr"

// 跑一段源码，交回结果文字。语法层的错不必在这里单独拦：eval 认识 {kind: "err"}
// 那一种节点，会把它原样带上来（实测如此，所以这里少一层分支）。
fn 跑(源码: String) -> String {
  let tokens = scan(源码)
  let 树 = chain(tokens)
  let r = 求值(树.node, ())
  if r.ok == false { return "求值错：" + r.text }
  return str(r.value)
}

// 跑一段源码并把它写出来。打印放在这里，因为这一层就是那个「调用方」。
fn 跑并打印(源码: String) -> Int effects(process) {
  print(跑(源码) + "\n")
  return 0
}

// 跑一整段程序：scan_lines 保留换行，于是语句边界有着落；
// parse_body 按换行切开、逐条交给 parse_statement；再交给求值器的语句层。
//
// 与上面那条「跑一个表达式」的路并存：表达式用 scan（不保留换行），程序用 scan_lines。
// 两条路的产出形状不同，所以不能混着用——这一点写在明处。
// 源码里有没有声明：只认「行首（可带空白）是 fn」这一种，够用了。
// 判断它，是为了让「程序以声明为单位」这件事真的成立——有声明就不再包壳。
fn 行首是声明从(s: String, i: Int) -> Bool {
  if i >= len(s) { return false }
  let c = s[i]
  if c == " " || c == "\t" || c == "\n" || c == "\r" { return 行首是声明从(s, i + 1) }
  if c == "/" { return false }
  if i + 1 < len(s) && s[i] == "f" && s[i + 1] == "n" { return true }
  return false
}

fn 行首是声明(s: String) -> Bool {
  return 行首是声明从(s, 0)
}

// 跑一整段源码。
//
//  ・有 fn 声明：源码就是完整的程序，parse_body 直接从它里面找体；
//  ・没有声明：当它是一串裸语句，包一层 fn main 的壳（这是兼容旧用法的路）。
//
// 两条路都交给同一个语句层，所以差别只在「壳由谁提供」。
fn 跑程序文字(源码: String) -> String {
  if 行首是声明(源码) {
    let tokens = scan_lines(源码)
    // 声明里找：有 main 就跑 main，没有就跑第一个函数。
    // 这样「一个文件里几个函数」也认得，只是还不能互相调用（求值器的调用只认内置）。
    let 全部 = parse_decls(tokens)
    if len(全部.fns) == 0 { return "错：声明里没有 fn" }
    let 选 = 选函数(全部.fns, "main")
    let 体 = 选[2]   // 声明现在是（名字, 参数名们, 语句们），语句们是第三件
    let r = 跑程序带函数(体, 全部.fns)
    if r.ok == false { return "错：" + r.text }
    return str(r.value)
  }
  let 有壳 = "fn main() -> Int {\n" + 源码 + "\n}\n"
  let tokens = scan_lines(有壳)
  let 体 = parse_body(tokens)
  if 体.found == false { return "错：找不到函数体" }
  let r = 跑程序(体.list)
  if r.ok == false { return "错：" + r.text }
  return str(r.value)
}

// 按名字挑一个函数；没有就叫第一个（调试单个函数时方便）。
fn 选函数从(们: Int, 名: String, i: Int) -> Int {
  if i >= len(们) { return () }
  if 们[i][0] == 名 { return 们[i] }
  return 选函数从(们, 名, i + 1)
}

fn 选函数(们: Int, 名: String) -> Int {
  let 有 = 选函数从(们, 名, 0)
  if len(有) == 0 { return 们[0] }
  return 有
}

// 跑几个模块：每一段都扫出它的声明，把函数表合起来，然后跑 main。
//
// 合并的规矩是「后到者覆盖先到者」——与 let 的重定义一致。
// 读文件不在这里：那是启动器（能力内核）的事，于是自举不必背上 file 效果。
fn 合并从(已收: Int, 源码们: Int, i: Int) -> Int {
  if i >= len(源码们) { return 已收 }
  let tokens = scan_lines(源码们[i])
  let 全部 = parse_decls(tokens)
  return 合并从(已收 + 全部.fns, 源码们, i + 1)
}

// ---- 认 import：从源码里取出它引的那几个路径 ----
//
// 这一段以前在宿主那边（bin/hmyr.mjs 里一个正则）。搬到这里，是因为
// 「一个文件引了谁」是这门语言自己的事——宿主不该比语言更懂 HMYR 的写法。
//
// 只认「一行 import "路径"」这一种形式。别的一律当没有：
// 认得窄而说清，比认得宽而猜测好。

// 按换行拆。与 拆行 不同，这里不要末尾那一个空段——
// 找 import 只看行，末尾空行没有意义。
fn 拆行从(文本: String, i: Int, 起: Int, acc: Int) -> Int {
  if i >= len(文本) { return acc + (slice(文本, 起, len(文本)),) }
  if 文本[i] == chr(10) {
    return 拆行从(文本, i + 1, i + 1, acc + (slice(文本, 起, i),))
  }
  return 拆行从(文本, i + 1, 起, acc)
}

fn 拆行(文本: String) -> Int {
  if 文本 == "" { return () }
  return 拆行从(文本, 0, 0, ())
}

// 这一行是不是「import "..."」。是就交回引号里的那一段，不是就交回空串。
fn 引号里(行: String) -> String {
  let 去 = 去首(行)
  if len(去) < 9 { return "" }
  if slice(去, 0, 6) != "import" { return "" }
  // 还要看词界：importx 的前六个字符也是 import，而它不是那件事。
  // 与词法那条规矩一样——换记号只看整个记号，不看它里面的一部分。
  if len(去) > 6 && 去[6] != " " && 去[6] != chr(9) && 去[6] != chr(34) { return "" }
  let 开 = 找引号(去, 6)
  if 开 < 0 { return "" }
  let 闭 = 找引号(去, 开 + 1)
  if 闭 < 0 { return "" }
  return slice(去, 开 + 1, 闭)
}

fn 去首(行: String) -> String {
  if len(行) == 0 { return 行 }
  if 行[0] == " " || 行[0] == chr(9) { return 去首(slice(行, 1, len(行))) }
  return 行
}

fn 找引号(文本: String, 起: Int) -> Int {
  // 这里要改 i，所以是 var 而不是 let——let 声明的东西不可变。
  var i = 起
  while i < len(文本) && 文本[i] != chr(34) { i = i + 1 }
  if i >= len(文本) { return -1 }
  return i
}

fn 导入们从(行们: Int, i: Int, acc: Int) -> Int {
  if i >= len(行们) { return acc }
  let 路 = 引号里(行们[i])
  if 路 == "" { return 导入们从(行们, i + 1, acc) }
  return 导入们从(行们, i + 1, acc + (路,))
}

// 一段源码里引了哪些路径，按出现的顺序。
fn 找导入们(源码: String) -> Int {
  return 导入们从(拆行(源码), 0, ())
}

fn 跑模块们(源码们: Int) -> String {
  let 函数们 = 合并从((), 源码们, 0)
  if len(函数们) == 0 {
    // 一个声明也没有：那它可能是裸语句（老用法）。交回那条路，而不是报「没有 fn」。
    if len(源码们) == 0 { return "错：没有源码" }
    return 跑程序文字(源码们[0])
  }
  let 选 = 选函数(函数们, "main")
  let r = 跑程序带函数(选[2], 函数们)
  if r.ok == false { return "错：" + r.text }
  return str(r.value)
}

fn main() -> Int effects(process) {
  print("1 + 2 * 3 → " + 跑("1 + 2 * 3") + "\n")
  print("(1 + 2) * 3 → " + 跑("(1 + 2) * 3") + "\n")
  print("len(\"abcd\") → " + 跑("len(\"abcd\")") + "\n")
  print("10 % 4 → " + 跑("10 % 4") + "\n")
  return 0
}
