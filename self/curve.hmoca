// Ed25519 的曲线运算：twisted Edwards 曲线 -x^2 + y^2 = 1 + d x^2 y^2。
//
// 用扩展坐标 (X, Y, Z, T)，其中 x = X/Z、y = Y/Z、T = XY/Z。
// 为什么不用仿射：仿射一次点加要两次求逆（各 0.3 秒），而一次标量乘有 255 次倍点 ——
// 那就是几分钟。扩展坐标里点加与倍点都只有乘与加减，求逆只在最后转回仿射时做一次。
//
// 公式取自「dbl-2008-hwcd」与「add-2008-hwcd-3」这两套（a = -1 的那一支），
// 也就是 RFC 8032 与多数实现用的那两条。
引入 "./bigint.hmoca"
引入 "./sha512.hmoca"

函数 d_常量() {
  返回 从十六进制("52036cee2b6ffe738cc740797779e89800700a4d4141d8ab75eb4dca135978a3")
}

// k = 2d，点加公式里的常数。
函数 二d() {
  定 d = d_常量()
  返回 模加(d, d)
}

公开 函数 基点() {
  定 x = 从十六进制("216936d3cd6e53fec0a4e231fdd6dc5c692cc7609525a7b2c9562d608f25d51a")
  定 y = 从十六进制("6666666666666666666666666666666666666666666666666666666666666658")
  // Z = 1，所以 T = x*y/Z = x*y。T 不是另算的常数，它是从 x 与 y 推出来的。
  返回 (x, y, 一(), 模乘(x, y))
}

函数 单位元() {
  返回 (零组(11), 一(), 一(), 零组(11))
}

函数 抄(a: Int) {
  定 组 = 零组(11)
  变 i = 0
  当 i < 11 {
    设(组, i, a[i])
    i = i + 1
  }
  返回 组
}

函数 规约(a: Int) {
  变 出 = 抄(a)
  当 出[10] >= 32768 {
    设(出, 10, 出[10] - 32768)
    变 进 = 19
    变 j = 0
    当 进 > 0 && j < 11 {
      定 和 = 出[j] + 进
      // 与 self/bigint.hmoca 同一条：取一次余，给字与进位各用一次（2026-11-02）。
      // 规约 与 模加 是每次点运算都要跑的地方，所以这条在这里比在别处更值钱。
      定 余 = 和 % 16777216
      设(出, j, 余)
      进 = (和 - 余) / 16777216
      j = j + 1
    }
  }
  若 比(出, 模数()) >= 0 { 出 = 减(出, 模数()) }
  返回 出
}

公开 函数 模加(a: Int, b: Int) {
  定 组 = 零组(11)
  变 进 = 0
  变 i = 0
  当 i < 11 {
    定 和 = a[i] + b[i] + 进
    定 余 = 和 % 16777216
    设(组, i, 余)
    进 = (和 - 余) / 16777216
    i = i + 1
  }
  返回 规约(组)
}

函数 模减(a: Int, b: Int) {
  返回 规约(加(加(a, 模数()), 减(零组(11), b)))
}

// 倍点（dbl-2008-hwcd，a = -1）。
函数 倍点(p: Int) {
  定 X1 = p[0]
  定 Y1 = p[1]
  定 Z1 = p[2]
  定 A = 模乘(X1, X1)
  定 B = 模乘(Y1, Y1)
  定 C = 模乘(模加(Z1, Z1), Z1)
  // D = a*A，而 a = -1，所以 D = -A。
  定 D = 模减(零组(11), A)
  定 E = 模减(模减(模乘(模加(X1, Y1), 模加(X1, Y1)), A), B)
  定 G = 模加(D, B)
  定 F = 模减(G, C)
  定 H = 模减(D, B)
  返回 (模乘(E, F), 模乘(G, H), 模乘(F, G), 模乘(E, H))
}

// 点加（add-2008-hwcd-3）：常数是 2d。
函数 点加(p1: Int, p2: Int) {
  定 X1 = p1[0]
  定 Y1 = p1[1]
  定 Z1 = p1[2]
  定 T1 = p1[3]
  定 X2 = p2[0]
  定 Y2 = p2[1]
  定 Z2 = p2[2]
  定 T2 = p2[3]
  定 A = 模乘(模减(Y1, X1), 模减(Y2, X2))
  定 B = 模乘(模加(Y1, X1), 模加(Y2, X2))
  定 C = 模乘(模乘(T1, 二d()), T2)
  // add-2008-hwcd-3：D = 2*Z1*Z2。
  // 这里绕过两次：第一版多乘了一个 Z2（2*Z1*Z2*Z2），第二版又少了个 2（Z1*Z2）。
  // 多乘的那一版在 Z1 = Z2 = 1 时只是把分子分母同时放大，所以「1 到 8 倍基点」
  // 那一组看不出问题；少乘 2 的那一版立刻让三倍以上的点离开曲线。
  定 D = 模加(模乘(Z1, Z2), 模乘(Z1, Z2))
  定 E = 模减(B, A)
  定 F = 模减(D, C)
  定 G = 模加(D, C)
  定 H = 模加(B, A)
  返回 (模乘(E, F), 模乘(G, H), 模乘(F, G), 模乘(E, H))
}

函数 倍点三次(p: Int) {
  返回 倍点(倍点(倍点(p)))
}

// 标量乘：从最高位往下，每步倍点，该位是一就再加一次。
公开 函数 标量乘(点: Int, 标: Int) {
  变 出 = 单位元()
  变 位 = 254
  当 位 >= 0 {
    出 = 倍点(出)
    若 取位(标, 位) == 1 {
      出 = 点加(出, 点)
    }
    位 = 位 - 1
  }
  返回 出
}

// 扩展坐标 → 仿射：x = X/Z、y = Y/Z。只在这里求一次逆。
// 点压缩：仿射坐标的两个大整数 → 32 字节。
//
// 形式：y 的小端 32 字节，而最高字节的最高位换成 x 的奇偶。解压那一段（下面）就是它的逆，
// 所以两段应当往返一致 —— 那正是这一段的判据。
//
// 为什么它现在才落进这一页：design/SIGNING.txt 里记着「压缩函数没有验收套件，但它是对的」——
// 那个函数当时只活在一次实验的输出里。写 OpenSSH 私钥要公钥那 32 字节，而公钥就是
// a·B 的压缩形式，所以它必须落进这一页，并且带上判据。2026-11-03 补双向互通时加的。
公开 函数 压缩点(点: Int) {
  定 仿 = 转仿射(点)
  定 y = 仿[1]
  定 x = 仿[0]
  // 取一个 24 位字的第 k 个字节（k 是 0、1、2，小端）。
  变 出 = ()
  变 i = 0
  当 i < 32 {
    定 位 = (i - i % 3) / 3
    变 剩 = y[位]
    变 k = i % 3
    当 k > 0 {
      剩 = (剩 - 剩 % 256) / 256
      k = k - 1
    }
    出 = 出 + (剩 % 256,)
    i = i + 1
  }
  // 最高位：x 是奇数就置 1。
  变 最 = 出[31]
  若 x[0] % 2 == 1 {
    最 = 最 + 128
  }
  返回 前几(出, 31) + (最,)
}

函数 转仿射(p: Int) {
  定 逆 = 求逆(p[2])
  返回 (模乘(p[0], 逆), 模乘(p[1], 逆))
}

// ---- 点解压：32 字节 → 曲线上的一个点 ----
//
// 压缩形式是「y 的小端 32 字节，最高位换成 x 的符号」。解压就是：
//   u = y^2 - 1，v = d y^2 + 1，x = sqrt(u/v)
// 而 p 与 5 同余（模 8），所以开方有一条直路：x = (u/v)^((p+3)/8)，
// 验一下 x^2 * v 是不是 u；不是的话乘上 sqrt(-1) —— 那两种情形正好覆盖全部平方剩余。

// 从 32 字节小端建一个大整数。一个 24 位字装三个字节，所以是「每三位换一个字」。
公开 函数 从字节串(字节串: Int) {
  定 组 = 零组(11)
  变 i = 0
  当 i < len(字节串) && i < 32 {
    定 位 = (i - i % 3) / 3
    定 值 = to_int(字节串[i])
    定 移 = i % 3
    若 移 == 0 {
      设(组, 位, 组[位] + 值)
    } 否则 {
      若 移 == 1 {
        设(组, 位, 组[位] + 值 * 256)
      } 否则 {
        设(组, 位, 组[位] + 值 * 65536)
      }
    }
    i = i + 1
  }
  返回 组
}

// (p+3)/8 = 2^252 - 2：低 252 位全一，再减一。
函数 指数开方() {
  定 组 = 零组(11)
  变 i = 0
  当 i < 11 {
    设(组, i, 16777215)
    i = i + 1
  }
  设(组, 0, 16777214)
  设(组, 10, 4095)
  返回 组
}

// (p-1)/4 = 2^253 - 5：2 的这个次幂就是 sqrt(-1)。
函数 sqrt负一() 效果串(process) {
  定 组 = 零组(11)
  变 i = 0
  当 i < 11 {
    设(组, i, 16777215)
    i = i + 1
  }
  设(组, 0, 16777211)
  设(组, 10, 8191)
  定 二 = 零组(11)
  设(二, 0, 2)
  返回 模幂(二, 组)
}

// 32 字节 → 点（扩展坐标，Z = 1）。符号位不合法的情形这一版不报错，
// 交回的点仍在曲线上 —— 验签那一步会因为方程不成立而拒绝。
函数 解压(字节串: Int) 效果串(process) {
  定 y = 从字节串(字节串)
  定 顶 = 位右移(y[10], 15)
  设(y, 10, 位与(y[10], 32767))
  定 y2 = 模乘(y, y)
  定 u = 模减(y2, 一())
  定 v = 模加(模乘(d_常量(), y2), 一())
  定 比 = 模乘(u, 求逆(v))
  变 x = 模幂(比, 指数开方())
  定 验 = 模乘(模乘(x, x), v)
  若 比(验, u) != 0 {
    x = 模乘(x, sqrt负一())
  }
  若 取位(x, 0) != 顶 {
    x = 模减(零组(11), x)
  }
  返回 (x, y, 一(), 模乘(x, y))
}

// ---- 验签：S*B = R + H(R || A || M) * A ----

// 曲线阶 L = 2^252 + 27742317777372353535851937790883648493。
函数 阶L() {
  返回 从十六进制("1000000000000000000000000000000014def9dea2f79cd65812631a5cf5d3ed")
}

// 模 L：减到比 L 小为止。256 位 / 252 位最多十六次减法，便宜。
公开 函数 模L(a: Int) {
  变 出 = 抄(a)
  当 比(出, 阶L()) >= 0 {
    出 = 减(出, 阶L())
  }
  返回 出
}

// 任意长字节串模 L：从最高字节往下，每一步「乘 256 加一字节，再模 L」。
// Ed25519 的 k 是 SHA-512 的**整个六十四字节**取模 L —— 第一版只取了前 32 字节，
// 于是每一条合法的签名都被判成不通过。
// 乘二加一：出 < L < 2^253，乘二之后仍不到 2^254，十一个字（264 位）装得下。
函数 乘2加(a: Int, 位: Int) {
  定 组 = 零组(11)
  变 进 = 位
  变 j = 0
  当 j < 11 {
    定 和 = a[j] * 2 + 进
    定 余 = 和 % 16777216
    设(组, j, 余)
    进 = (和 - 余) / 16777216
    j = j + 1
  }
  返回 组
}

// 任意长字节串模 L：逐位「乘二加一，再模 L」。
// 为什么不逐字节乘 256：这个理由在换字宽之后变了。16 位字时 2^261 装不下，
// 进位会被悄悄丢掉（第三版就错在这里）；24 位字之后 264 位装得下，装不下不再是理由。
// 真正让它留在逐位的原因是代价：乘 256 之后要减五百多次 L 才落回模内，
// 而乘二只减一两次 —— 逐位慢八倍地走循环，却省掉一千倍的减法。
//
// 字节要**从最后一个读起**：RFC 8032 把 SHA-512 交回的六十四字节当作 little-endian
// 整数来取模（原文是 "interpret the 64-octet digest as a little-endian integer k"），
// 所以最高有效字节在最后。第四版之前从第一个字节读起，等于按大端解释 ——
// 结果是 k 与每一份正确实现都不同，而它自己与自己始终一致，于是两个月都看着像对的。
// 到字节串：一个大整数 → n 字节小端。
//
// 与 到三十二 同一件事，只是长度可变：签名要 32 字节（R 与 S），而模 L 的乘要 63 字节
// （两个 252 位的数乘起来最多 504 位）。2026-11-03 补：签名的 S 那一步需要一个通用的。
公开 函数 到字节串(a: Int, n: Int) {
  变 出 = ()
  变 i = 0
  当 i < n {
    定 位 = (i - i % 3) / 3
    变 剩 = a[位]
    变 k = i % 3
    当 k > 0 {
      剩 = (剩 - 剩 % 256) / 256
      k = k - 1
    }
    出 = 出 + (剩 % 256,)
    i = i + 1
  }
  返回 出
}

// 模 L 的加法：两个都小于 L，和小于二 L，所以 模L 最多减两次。
公开 函数 模L加(a: Int, b: Int) {
  返回 模L(加(a, b))
}

// 模 L 的乘法：先乘出来，再走 模L长 那条逐位约简。
// 为什么不能复用 模L：它只会一次一次地减 L，而 504 位要减两的二百多次方次。
// 逐位那条路每一步最多减两次，代价是 504 次循环 —— 那才是这片算术里唯一能走的路。
//
// 长度取 64 字节而不是 63：k 是 252 位，而签名里的 a 是**255 位**（clamp 把第 254 位置了 1），
// 所以 k*a 最多 507 位 —— 63 字节（504 位）正好会截掉最高那三位。
// 2026-11-03 撞到：S 一直不对，而反推 a' = (S - r)·k⁻¹ mod L 之后发现 a' == a mod L，
// 于是知道错的不是公式而是宽度。
公开 函数 模L乘(a: Int, b: Int) {
  定 积 = 乘(a, b)
  返回 模L长(到字节串(积, 64))
}

公开 函数 模L长(字节串: Int) {
  变 出 = 零组(11)
  变 i = len(字节串) - 1
  当 i >= 0 {
    定 b = to_int(字节串[i])
    变 k = 7
    当 k >= 0 {
      出 = 乘2加(出, 位与(位右移(b, k), 1))
      出 = 模L(出)
      k = k - 1
    }
    i = i - 1
  }
  返回 出
}

// 取一个字节元组的前 n 个。
公开 函数 前几(字节串: Int, n: Int) {
  变 出 = ()
  变 i = 0
  当 i < n && i < len(字节串) {
    出 = 出 + (字节串[i],)
    i = i + 1
  }
  返回 出
}

// 诊断开关：验签还没对上，把这一段留着但关掉 —— 下一轮打开就能看见中间值。
// 诊断开关：把中间值打印出来用。默认关，开的时候把返回值改成非空串。
函数 参全局() -> String 效果串(process) {
  返回 ""
}

// 验签：公钥 32 字节、R 32 字节、S 32 字节、消息字节。
公开 函数 验签(公钥字节: Int, R半: Int, S半: Int, 消息: Int) 效果串(process) {
  定 A = 解压(公钥字节)
  定 R点 = 解压(R半)
  定 哈 = sha512字节(前几(R半, 32) + 前几(公钥字节, 32) + 消息)
  定 k = 模L长(哈)
  若 len(参全局()) > 0 {
    print("k = " + 成十六进制(k) + chr(10))
    定 A仿 = 转仿射(A)
    print("A x = " + 成十六进制(A仿[0]) + chr(10))
    print("A y = " + 成十六进制(A仿[1]) + chr(10))
  }
  定 S数 = 从字节串(前几(S半, 32))
  若 比(S数, 阶L()) >= 0 { 返回 假 }
  定 左 = 转仿射(标量乘(基点(), S数))
  定 右 = 转仿射(点加(R点, 标量乘(A, k)))
  若 len(参全局()) > 0 {
    print("左 x = " + 成十六进制(左[0]) + chr(10))
    print("左 y = " + 成十六进制(左[1]) + chr(10))
    print("右 x = " + 成十六进制(右[0]) + chr(10))
    print("右 y = " + 成十六进制(右[1]) + chr(10))
    定 R仿 = 转仿射(R点)
    print("R x = " + 成十六进制(R仿[0]) + chr(10))
    print("R y = " + 成十六进制(R仿[1]) + chr(10))
  }
  返回 比(左[0], 右[0]) == 0 && 比(左[1], 右[1]) == 0
}

// 探针：给一个标量（十六进制），交回「标量乘基点」的仿射 x 与 y；
// 给 --解压 加 32 字节十六进制，交回解出来的点的 x 与 y。
函数 main() -> Int 效果串(process) {
  定 参 = argv()
  若 len(参) < 2 {
    print("用法：hmyr self/curve.hmyr <标量十六进制>" + chr(10))
    print("      hmyr self/curve.hmyr --解压 <32 字节十六进制>" + chr(10))
    返回 2
  }
  若 参[1] == "--哈" {
    定 料 = 解base64十六进制(参[2])
    定 哈 = sha512字节(料)
    变 出 = ""
    变 i = 0
    当 i < len(哈) {
      定 v = to_int(哈[i])
      定 表 = "0123456789abcdef"
      出 = 出 + slice(表, (v - v % 16) / 16, (v - v % 16) / 16 + 1)
      出 = 出 + slice(表, v % 16, v % 16 + 1)
      i = i + 1
    }
    print(出 + chr(10))
    返回 0
  }
  若 参[1] == "--验" {
    若 len(参) < 5 {
      print("要三个十六进制串：公钥、签名（R 与 S 各 32 字节）、消息" + chr(10))
      返回 2
    }
    定 公钥字节 = 解base64十六进制(参[2])
    定 签 = 解base64十六进制(参[3])
    定 消 = 解base64十六进制(参[4])
    定 好 = 验签(公钥字节, 前几(签, 32), 前几(从第(签, 32), 32), 消)
    若 好 {
      print("通过" + chr(10))
    } 否则 {
      print("不通过" + chr(10))
    }
    返回 0
  }
  若 参[1] == "--压缩" {
    // 标量的十六进制 → 公钥的压缩形式（32 字节十六进制）。
    // 判据在 test/curve.test.mjs：--压缩 01 要得基点的那个常量。
    若 len(参) < 3 {
      print("要一个标量的十六进制" + chr(10))
      返回 2
    }
    定 压 = 压缩点(标量乘(基点(), 从十六进制(参[2])))
    变 压出 = ""
    变 压i = 0
    当 压i < len(压) {
      定 v = to_int(压[压i])
      定 表 = "0123456789abcdef"
      压出 = 压出 + slice(表, (v - v % 16) / 16, (v - v % 16) / 16 + 1)
      压出 = 压出 + slice(表, v % 16, v % 16 + 1)
      压i = 压i + 1
    }
    print(压出 + chr(10))
    返回 0
  }
  若 参[1] == "--解压" {
    若 len(参) < 3 {
      print("要一个 32 字节的十六进制串" + chr(10))
      返回 2
    }
    定 字节串 = 解base64十六进制(参[2])
    定 点 = 转仿射(解压(字节串))
    print(成十六进制(点[0]) + chr(10))
    print(成十六进制(点[1]) + chr(10))
    返回 0
  }
  定 点 = 转仿射(标量乘(基点(), 从十六进制(参[1])))
  print(成十六进制(点[0]) + chr(10))
  print(成十六进制(点[1]) + chr(10))
  返回 0
}

// 从第 n 个字节开始取到末尾。
公开 函数 从第(字节串: Int, n: Int) {
  变 出 = ()
  变 i = n
  当 i < len(字节串) {
    出 = 出 + (字节串[i],)
    i = i + 1
  }
  返回 出
}

// 十六进制串 → 字节元组（大端写法，两字符一字节）。
公开 函数 解base64十六进制(s: String) {
  变 出 = ()
  变 i = 0
  当 i + 1 < len(s) {
    出 = 出 + (十六进制值(slice(s, i, i + 1)) * 16 + 十六进制值(slice(s, i + 1, i + 2)),)
    i = i + 2
  }
  返回 出
}

函数 十六进制值(c: String) -> Int {
  定 v = ord(c)
  若 v >= 48 && v <= 57 { 返回 v - 48 }
  若 v >= 97 && v <= 102 { 返回 v - 87 }
  返回 0
}
