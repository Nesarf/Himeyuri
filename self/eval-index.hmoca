// 索引与记录这十个内置：求调用 那一大块分派的第二刀。
//
// 为什么单独立一份（2026-11-05）：与 eval-files.hmoca 同一件事、同一个形状 —— 十条分支
// 各四行（一条效果检查、一条长度检查、一次调用），交回 {有, 结果}，由 求调用 按顺序问。
//
// 它们只依赖 eval-core.hmoca 里的 好 坏 要效果，所以能整组搬走。

引入 "./eval-core.hmoca"

公开 函数 求内置索引(名: String, 值簇: Int, 环境: Int) {
若 名 == "field_get" {
    若 len(值簇) != 2 { 返回 坏("field_get 要两个参数") }
    返回 {有: 真, 结果: 好(field_get(值簇[0], 值簇[1]))}
  }
若 名 == "field_has" {
    若 len(值簇) != 2 { 返回 坏("field_has 要两个参数") }
    返回 {有: 真, 结果: 好(field_has(值簇[0], 值簇[1]))}
  }
若 名 == "field_names" {
    若 len(值簇) != 1 { 返回 坏("field_names 要一个参数") }
    返回 {有: 真, 结果: 好(field_names(值簇[0]))}
  }
若 名 == "index_get" {
    若 len(值簇) != 2 { 返回 坏("index_get 要两个参数") }
    返回 {有: 真, 结果: 好(index_get(值簇[0], 值簇[1]))}
  }
若 名 == "index_has" {
    若 len(值簇) != 2 { 返回 坏("index_has 要两个参数") }
    返回 {有: 真, 结果: 好(index_has(值簇[0], 值簇[1]))}
  }
若 名 == "index_keys" {
    若 len(值簇) != 1 { 返回 坏("index_keys 要一个参数") }
    返回 {有: 真, 结果: 好(index_keys(值簇[0]))}
  }
若 名 == "index_len" {
    若 len(值簇) != 1 { 返回 坏("index_len 要一个参数") }
    返回 {有: 真, 结果: 好(index_len(值簇[0]))}
  }
若 名 == "index_new" {
    若 len(值簇) != 0 { 返回 坏("index_new 不要参数") }
    返回 {有: 真, 结果: 好(index_new())}
  }
若 名 == "index_set" {
    若 len(值簇) != 3 { 返回 坏("index_set 要三个参数") }
    返回 {有: 真, 结果: 好(index_set(值簇[0], 值簇[1], 值簇[2]))}
  }
若 名 == "record_new" {
    若 len(值簇) != 1 { 返回 坏("record_new 要一个参数") }
    返回 {有: 真, 结果: 好(record_new(值簇[0]))}
  }
  返回 {有: 假, 结果: 0}
}
