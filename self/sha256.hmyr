// SHA-256：清单里每一个文件的哈希与整份的 digest 都要它。
//
// 位运算自带在这个文件里，而不是 import：位运算那八个小函数复制一遍
// 比给「两处同名函数」付代价更省事，两处注释互相指一下即可。
//
// 用法：hmyr self/sha256.hmyr <文件>       打印 64 位十六进制

fn 倍(n: Int) -> Int {
  var v = 1
  var i = 0
  while i < n {
    v = v * 2
    i = i + 1
  }
  return v
}

fn 与(a: Int, b: Int) -> Int {
  var 出 = 0
  var 倍量 = 1
  var x = a
  var y = b
  var i = 0
  while i < 32 {
    let 甲 = x % 2
    let 乙 = y % 2
    if 甲 == 1 && 乙 == 1 { 出 = 出 + 倍量 }
    x = (x - 甲) / 2
    y = (y - 乙) / 2
    倍量 = 倍量 * 2
    i = i + 1
  }
  return 出
}

fn 异或(a: Int, b: Int) -> Int {
  var 出 = 0
  var 倍量 = 1
  var x = a
  var y = b
  var i = 0
  while i < 32 {
    let 甲 = x % 2
    let 乙 = y % 2
    if 甲 != 乙 { 出 = 出 + 倍量 }
    x = (x - 甲) / 2
    y = (y - 乙) / 2
    倍量 = 倍量 * 2
    i = i + 1
  }
  return 出
}

fn 非(a: Int) -> Int {
  return 4294967295 - (a % 4294967296)
}

fn 右移(a: Int, n: Int) -> Int {
  return (a - a % 倍(n)) / 倍(n)
}

fn 加32(a: Int, b: Int) -> Int {
  return (a + b) % 4294967296
}

fn 循环右移(a: Int, n: Int) -> Int {
  let 割 = 倍(n)
  let 低 = a % 割
  let 高 = (a - 低) / 割
  return 低 * 倍(32 - n) + 高
}

// 六十四轮常量。
fn 常量们() {
  return (1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
    3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
    3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
    2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
    666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
    2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
    430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
    1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298)
}

fn 初值() {
  return (1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225)
}

// 小写 sigma0：ror7 ^ ror18 ^ shr3
fn 小零(x: Int) -> Int {
  return 异或(异或(循环右移(x, 7), 循环右移(x, 18)), 右移(x, 3))
}

// 小写 sigma1：ror17 ^ ror19 ^ shr10
fn 小一(x: Int) -> Int {
  return 异或(异或(循环右移(x, 17), 循环右移(x, 19)), 右移(x, 10))
}

// 大写 Sigma0：ror2 ^ ror13 ^ ror22
fn 大零(x: Int) -> Int {
  return 异或(异或(循环右移(x, 2), 循环右移(x, 13)), 循环右移(x, 22))
}

// 大写 Sigma1：ror6 ^ ror11 ^ ror25
fn 大一(x: Int) -> Int {
  return 异或(异或(循环右移(x, 6), 循环右移(x, 11)), 循环右移(x, 25))
}

fn 取字(块: Int, i: Int) -> Int {
  return to_int(块[i * 4]) * 16777216 + to_int(块[i * 4 + 1]) * 65536 + to_int(块[i * 4 + 2]) * 256 + to_int(块[i * 4 + 3])
}

// 一个 512 位块压进八个字里，交回新的八个字。
fn 一块(哈希们: Int, 块: Int) {
  let 常 = 常量们()
  var W = ()
  var i = 0
  while i < 16 {
    W = W + (取字(块, i),)
    i = i + 1
  }
  while i < 64 {
    let x = to_int(W[i - 15])
    let y = to_int(W[i - 2])
    W = W + (加32(加32(加32(to_int(W[i - 16]), 小零(x)), to_int(W[i - 7])), 小一(y)),)
    i = i + 1
  }
  var a = to_int(哈希们[0])
  var b = to_int(哈希们[1])
  var c = to_int(哈希们[2])
  var d = to_int(哈希们[3])
  var e = to_int(哈希们[4])
  var f = to_int(哈希们[5])
  var g = to_int(哈希们[6])
  var h = to_int(哈希们[7])
  i = 0
  while i < 64 {
    // Ch(e,f,g) = (e 与 f) 异或 (非 e 与 g)；Maj(a,b,c) = 三对两两相与再异或。
    let Ch = 异或(与(e, f), 与(非(e), g))
    let Maj = 异或(异或(与(a, b), 与(a, c)), 与(b, c))
    let t1 = 加32(加32(加32(h, 大一(e)), Ch), 加32(to_int(常[i]), to_int(W[i])))
    let t2 = 加32(大零(a), Maj)
    h = g
    g = f
    f = e
    e = 加32(d, t1)
    d = c
    c = b
    b = a
    a = 加32(t1, t2)
    i = i + 1
  }
  return (加32(to_int(哈希们[0]), a), 加32(to_int(哈希们[1]), b), 加32(to_int(哈希们[2]), c), 加32(to_int(哈希们[3]), d),
    加32(to_int(哈希们[4]), e), 加32(to_int(哈希们[5]), f), 加32(to_int(哈希们[6]), g), 加32(to_int(哈希们[7]), h))
}

// 填充：0x80、若干 0、最后八字节是大端位长。
fn 填充(字节们: Int) {
  let 原长 = len(字节们)
  var 出 = ()
  var i = 0
  while i < 原长 {
    出 = 出 + (to_int(字节们[i]),)
    i = i + 1
  }
  出 = 出 + (128,)
  while (len(出) + 8) % 64 != 0 {
    出 = 出 + (0,)
  }
  let 位长 = 原长 * 8
  var 倍量 = 倍(56)
  var k = 0
  while k < 8 {
    let b = (位长 - 位长 % 倍量) / 倍量
    出 = 出 + (b % 256,)
    位长 = 位长 - b * 倍量
    倍量 = 倍量 / 256
    k = k + 1
  }
  return 出
}

fn 十六进制(值: Int) -> String {
  let 表 = "0123456789abcdef"
  var 出 = ""
  var 每 = 8
  while 每 > 0 {
    let 割 = 倍(每 * 4 - 4)
    let d = (值 - 值 % 割) / 割
    出 = 出 + 表[d]
    值 = 值 - d * 割
    每 = 每 - 1
  }
  return 出
}

fn sha256(字节们: Int) -> String {
  let 填 = 填充(字节们)
  var 哈希们 = 初值()
  var 起 = 0
  while 起 < len(填) {
    var 块 = ()
    var k = 0
    while k < 64 {
      块 = 块 + (to_int(填[起 + k]),)
      k = k + 1
    }
    哈希们 = 一块(哈希们, 块)
    起 = 起 + 64
  }
  var 出 = ""
  var i = 0
  while i < 8 {
    出 = 出 + 十六进制(to_int(哈希们[i]))
    i = i + 1
  }
  return 出
}

fn main() -> Int effects(file) {
  let 参 = argv()
  if len(参) < 2 {
    print("用法：hmyr self/sha256.hmyr <文件>" + chr(10))
    return 2
  }
  let 字节们 = read_bytes(参[1])
  print(sha256(字节们) + chr(10))
  return 0
}
