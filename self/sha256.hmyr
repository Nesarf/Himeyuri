// SHA-256：清单里每一个文件的哈希与整份的 digest 都要它。
//
// 位运算走内建（位与/位或/位异或/位非/位右移/位加/位循环右移/位循环左移）。
// 早先这一份自带逐位的 32 轮循环版本，对 30 KB 跑了三十分钟没出结果 —— 那是把
// 「语言里没有位运算符」的代价摊在每一次调用上。内建之后，一次位运算就是一次。
//
// 用法：hmyr self/sha256.hmyr <文件>       打印 64 位十六进制

// 2 的 n 次幂：十六进制输出要它按 4 位一段往下取。
fn 倍(n: Int) -> Int {
  var v = 1
  var i = 0
  while i < n {
    v = v * 2
    i = i + 1
  }
  return v
}

// 折半拼接：把几十块并成一条，复制量是「块数乘对数」而不是平方。
fn 拼平(块们: Int, 起: Int, 止: Int) {
  if 止 - 起 <= 1 { return 块们[起] }
  var 左 = 起
  var 右 = 止
  while 右 - 左 > 2 {
    左 = 左 + 1
    右 = 右 - 1
  }
  let 中 = 左 + 1
  return 拼平(块们, 起, 中) + 拼平(块们, 中, 止)
}

// 六十四轮常量。
fn 常量们() {
  return (1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
    3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
    3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
    2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
    666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
    2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
    430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
    1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298)
}

fn 初值() {
  return (1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225)
}

// 小写 sigma0：ror7 异或 ror18 异或 shr3
fn 小零(x: Int) -> Int {
  return 位异或(位异或(位循环右移(x, 7), 位循环右移(x, 18)), 位右移(x, 3))
}

// 小写 sigma1：ror17 异或 ror19 异或 shr10
fn 小一(x: Int) -> Int {
  return 位异或(位异或(位循环右移(x, 17), 位循环右移(x, 19)), 位右移(x, 10))
}

// 大写 Sigma0：ror2 异或 ror13 异或 ror22
fn 大零(x: Int) -> Int {
  return 位异或(位异或(位循环右移(x, 2), 位循环右移(x, 13)), 位循环右移(x, 22))
}

// 大写 Sigma1：ror6 异或 ror11 异或 ror25
fn 大一(x: Int) -> Int {
  return 位异或(位异或(位循环右移(x, 6), 位循环右移(x, 11)), 位循环右移(x, 25))
}

fn 取字(块: Int, i: Int) -> Int {
  return to_int(块[i * 4]) * 16777216 + to_int(块[i * 4 + 1]) * 65536 + to_int(块[i * 4 + 2]) * 256 + to_int(块[i * 4 + 3])
}

// 一个 512 位块压进八个字里，交回新的八个字。
fn 一块(哈希们: Int, 块: Int) {
  let 常 = 常量们()
  // W 用可变数组：64 项，每一轮追加一个 —— 用元组就是每轮重建整条，平方级。
  var W初 = ()
  var i = 0
  while i < 64 {
    W初 = W初 + (0,)
    i = i + 1
  }
  let W = 数组(W初)
  i = 0
  while i < 16 {
    设(W, i, 取字(块, i))
    i = i + 1
  }
  while i < 64 {
    let x = W[i - 15]
    let y = W[i - 2]
    设(W, i, 位加(位加(位加(W[i - 16], 小零(x)), W[i - 7]), 小一(y)))
    i = i + 1
  }
  var a = to_int(哈希们[0])
  var b = to_int(哈希们[1])
  var c = to_int(哈希们[2])
  var d = to_int(哈希们[3])
  var e = to_int(哈希们[4])
  var f = to_int(哈希们[5])
  var g = to_int(哈希们[6])
  var h = to_int(哈希们[7])
  i = 0
  while i < 64 {
    // Ch(e,f,g) = (e 与 f) 异或 (非 e 与 g)；Maj(a,b,c) = 三对两两相与再异或。
    let Ch = 位异或(位与(e, f), 位与(位非(e), g))
    let Maj = 位异或(位异或(位与(a, b), 位与(a, c)), 位与(b, c))
    let t1 = 位加(位加(位加(h, 大一(e)), Ch), 位加(to_int(常[i]), to_int(W[i])))
    let t2 = 位加(大零(a), Maj)
    h = g
    g = f
    f = e
    e = 位加(d, t1)
    d = c
    c = b
    b = a
    a = 位加(t1, t2)
    i = i + 1
  }
  return (位加(to_int(哈希们[0]), a), 位加(to_int(哈希们[1]), b), 位加(to_int(哈希们[2]), c), 位加(to_int(哈希们[3]), d),
    位加(to_int(哈希们[4]), e), 位加(to_int(哈希们[5]), f), 位加(to_int(哈希们[6]), g), 位加(to_int(哈希们[7]), h))
}

// 填充：0x80、若干 0、最后八字节是大端位长。
//
// 这里用块化 + 折平拼接，不是 出 = 出 + (...)：三十 KB 的文件那样拼是平方级，
// 而它正是上一版跑十五分钟没结果的真正原因 —— 不是位运算，是这个循环。
fn 填充(字节们: Int) {
  let 原长 = len(字节们)
  var 块们 = ()
  var 小块 = ()
  var i = 0
  while i < 原长 {
    小块 = 小块 + (to_int(字节们[i]),)
    if len(小块) >= 1024 {
      块们 = 块们 + (小块,)
      小块 = ()
    }
    i = i + 1
  }
  小块 = 小块 + (128,)
  while (len(块们) * 1024 + len(小块) + 8) % 64 != 0 {
    小块 = 小块 + (0,)
  }
  var 位长 = 原长 * 8
  var 倍量 = 倍(56)
  var k = 0
  while k < 8 {
    let b = (位长 - 位长 % 倍量) / 倍量
    小块 = 小块 + (b % 256,)
    位长 = 位长 - b * 倍量
    倍量 = 倍量 / 256
    k = k + 1
  }
  if len(小块) > 0 { 块们 = 块们 + (小块,) }
  if len(块们) == 0 { return () }
  return 拼平(块们, 0, len(块们))
}

fn 十六进制(值: Int) -> String {
  let 表 = "0123456789abcdef"
  var 出 = ""
  var 每 = 8
  while 每 > 0 {
    let 割 = 倍(每 * 4 - 4)
    let d = (值 - 值 % 割) / 割
    出 = 出 + 表[d]
    值 = 值 - d * 割
    每 = 每 - 1
  }
  return 出
}

fn sha256(字节们: Int) -> String {
  let 填 = 填充(字节们)
  var 哈希们 = 初值()
  var 起 = 0
  while 起 < len(填) {
    var 块 = ()
    var k = 0
    while k < 64 {
      块 = 块 + (to_int(填[起 + k]),)
      k = k + 1
    }
    哈希们 = 一块(哈希们, 块)
    起 = 起 + 64
  }
  var 出 = ""
  var i = 0
  while i < 8 {
    出 = 出 + 十六进制(to_int(哈希们[i]))
    i = i + 1
  }
  return 出
}

fn main() -> Int effects(file, process) {
  let 参 = argv()
  if len(参) < 2 {
    print("用法：hmyr self/sha256.hmyr <文件>" + chr(10))
    return 2
  }
  let 字节们 = read_bytes(参[1])
  print(sha256(字节们) + chr(10))
  return 0
}
