引入 "./lex.hmoca"

// 用 Himeyuri 写的第七件：函数声明的签名。
//
// 上面那行是实话：这一件读的是词法切出来的 token，所以它依赖 lex.hmyr。
// （先前漏了它，于是宿主去取 scan 时拿到空值，报错只说「读不到 params」——
//   一条看起来像内部故障、其实是缺依赖的信息。补上依赖，信息才对得上号。）
//
//   [pub] fn 名字 ( 参数… ) [-> 类型] [效果串( 效果… )] [函数体]
//
// 读成：{kind: "fn", pub, name, params, returns, 效果串, hasBody}
//   params  : 元组，每项 {name, type}（拥有 / 借用 这类前缀会被跳过）
//             字段名就叫 type：语言的字段名位置允许关键字，这条正是自举逼出来的。
//
// 一件**故意没做**的事，写在明处：函数体没有被切开。
// 原因是上一层的边界——self/lex.hmyr 把空白与换行一起丢掉了，而换行正是语句的分界。
// 所以这里只记「有没有体」，不装出读懂体的样子。要读体，先得让词法把换行作为 token 留下，
// 那是下一件的前提。
//
// 另一条边界：参数里的默认值会被跳过（记录里不保留），返回类型只保留名字与可空标记。

fn is_word(t: Int, w: String) -> Bool {
  返回 t.kind == "ident" && t.text == w
}

fn is_punct(t: Int, ch: String) -> Bool {
  返回 t.kind == "punct" && t.text == ch
}

// 类型的边界：从 i 开始，交回类型之后的位置。
//
// 括号要跟着配平：元组类型 (String,) 或者 (Int, Int) 在参数表里是一整个类型，
// 不是「一个括号加两个参数」。早先这一层只认一个标识符，于是
// 连接(段们: (String,), 分隔: String) 只解析出一个参数 —— 错误消息是
// 「参数个数不对：连接 要 1 个，给了 2」，看起来像调用写错了。
fn 括号到(tokens: Int, i: Int, 深: Int) -> Int {
  若 i >= len(tokens) { 返回 i }
  若 is_punct(tokens[i], "(") { 返回 括号到(tokens, i + 1, 深 + 1) }
  若 is_punct(tokens[i], ")") {
    若 深 <= 1 { 返回 i + 1 }
    返回 括号到(tokens, i + 1, 深 - 1)
  }
  返回 括号到(tokens, i + 1, 深)
}

fn type_end(tokens: Int, i: Int) -> Int {
  若 i >= len(tokens) { 返回 i }
  若 is_punct(tokens[i], "(") { 返回 括号到(tokens, i, 0) }
  var j = i + 1
  若 j < len(tokens) && is_punct(tokens[j], "?") { j = j + 1 }
  返回 j
}

// 把一段 token 的文字拼起来当类型名。元组类型就拼成它写下的样子。
fn type_text(tokens: Int, 起: Int, 止: Int) -> String {
  var 出 = ""
  var i = 起
  当 i < 止 {
    出 = 出 + tokens[i].text
    i = i + 1
  }
  返回 出
}

// 跳过默认值：从 = 之后一直跳到 , 或 ) 之前。
fn skip_default(tokens: Int, i: Int) -> Int {
  若 i >= len(tokens) { 返回 i }
  若 is_punct(tokens[i], ",") || is_punct(tokens[i], ")") { 返回 i }
  返回 skip_default(tokens, i + 1)
}

// 参数列表：从 ( 之后开始。
fn params(tokens: Int, i: Int, acc: Int) {
  若 i >= len(tokens) { 返回 {list: acc, next: i, closed: false} }
  定 t = tokens[i]
  若 is_punct(t, ")") { 返回 {list: acc, next: i + 1, closed: true} }
  若 is_punct(t, ",") { 返回 params(tokens, i + 1, acc) }
  若 is_word(t, "own") || is_word(t, "borrow") { 返回 params(tokens, i + 1, acc) }

  若 t.kind == "ident" {
    定 name = t.text
    若 i + 1 < len(tokens) && is_punct(tokens[i + 1], ":") {
      定 类止 = type_end(tokens, i + 2)
      定 ty = type_text(tokens, i + 2, 类止)
      var next = 类止
      若 next < len(tokens) && is_punct(tokens[next], "=") {
        next = skip_default(tokens, next + 1)
      }
      返回 params(tokens, next, acc + ({name: name, type: ty},))
    }
    返回 params(tokens, i + 1, acc)
  }
  返回 {list: acc, next: i + 1, closed: false}
}

// 效果列表：效果串( 之后。函数名不能叫 效果串——它是关键字，所以这里叫 effect_list。
fn effect_list(tokens: Int, i: Int, acc: Int) {
  若 i >= len(tokens) { 返回 {list: acc, next: i} }
  定 t = tokens[i]
  若 is_punct(t, ")") { 返回 {list: acc, next: i + 1} }
  若 is_punct(t, ",") { 返回 effect_list(tokens, i + 1, acc) }
  若 t.kind == "ident" { 返回 effect_list(tokens, i + 1, acc + (t.text,)) }
  返回 effect_list(tokens, i + 1, acc)
}

// 主体：签名之后一直读到末尾（体没有被切开，见文件头）。
fn has_body(tokens: Int, i: Int) -> Bool {
  若 i >= len(tokens) { 返回 false }
  若 is_punct(tokens[i], "{") { 返回 true }
  返回 has_body(tokens, i + 1)
}

// 宿主入口：读一份「函数声明」的 token 流。
fn read_signature(tokens: Int) -> Int {
  返回 signature(tokens, 0, false)
}

fn signature_at(tokens: Int, i: Int, is_pub: Bool) {
  若 i >= len(tokens) { 返回 {node: {kind: "误", text: ""}, next: i} }
  定 t = tokens[i]
  若 is_word(t, "pub") { 返回 signature_at(tokens, i + 1, true) }
  若 !is_word(t, "fn") { 返回 {node: {kind: "误", text: t.text}, next: i + 1} }
  若 i + 1 >= len(tokens) { 返回 {node: {kind: "误", text: "fn"}, next: i + 1} }
  定 name = tokens[i + 1].text
  // 声明在源码里的位置：名字那个 token 的码元偏移。要行列时由调用方按原文换算。
  定 起 = tokens[i + 1].at
  若 i + 2 >= len(tokens) || !is_punct(tokens[i + 2], "(") {
    返回 {node: {kind: "误", text: "fn " + name}, next: i + 1}
  }
  定 got = params(tokens, i + 3, ())
  var at = got.next
  // returns 与 eff 都会被改写，所以是 var——定 不可变是这门语言的规则。
  var returns = ""
  若 at < len(tokens) && is_punct(tokens[at], "->") {
    // 返回类型也用同一对帮手：它可能带括号（元组类型），也可能带可空标记。
    定 止 = type_end(tokens, at + 1)
    returns = type_text(tokens, at + 1, 止)
    at = 止
  }
  var eff = ()
  若 at < len(tokens) && is_word(tokens[at], "effects") && at + 1 < len(tokens) && is_punct(tokens[at + 1], "(") {
    定 e = effect_list(tokens, at + 2, ())
    eff = e.list
    at = e.next
  }
  返回 {
    node: {
      kind: "fn",
      at: 起,
      pub: is_pub,
      name: name,
      params: got.list,
      returns: returns,
      效果串: eff,
      hasBody: has_body(tokens, at),
    },
    next: at,
  }
}

// 只要记录的那一版：read_signature 与测试用它。
fn signature(tokens: Int, i: Int, is_pub: Bool) {
  返回 signature_at(tokens, i, is_pub).node
}

// 跳过一个函数体：从签名之后的位置开始，找第一个 { 并配平到它的 }。
// 只在 hasBody 为真时调用 —— 没有体的时候「第一个 {」是下一个函数的，跳过去就少读一个声明。
fn 跳体(tokens: Int, i: Int) -> Int {
  var k = i
  当 k < len(tokens) {
    若 is_punct(tokens[k], "{") {
      var 深 = 0
      当 k < len(tokens) {
        若 is_punct(tokens[k], "{") { 深 = 深 + 1 }
        若 is_punct(tokens[k], "}") {
          深 = 深 - 1
          若 深 == 0 { 返回 k + 1 }
        }
        k = k + 1
      }
      返回 k
    }
    k = k + 1
  }
  返回 k
}

// 整份源码里的所有函数声明，按出现顺序。语言服务器的 documentSymbol 用它。
pub fn all_signatures(tokens: Int) -> Int {
  var 列 = ()
  var i = 0
  当 i < len(tokens) {
    定 是公 = is_word(tokens[i], "pub")
    var 起 = i
    若 是公 { 起 = i + 1 }
    若 起 < len(tokens) && is_word(tokens[起], "fn") {
      定 r = signature_at(tokens, i, 是公)
      若 r.node.kind == "fn" { 列 = 列 + (r.node,) }
      若 r.node.kind == "fn" && r.node.hasBody { i = 跳体(tokens, r.next) } 否则 { i = r.next }
    } 否则 {
      i = i + 1
    }
  }
  返回 列
}

// 这里原有一个演示用的 main。删掉它是因为 self/lsp.hmyr 要 引入 这一份 ——
// 两份 main 合在一起只有一个能活，而活着的是先到的那一个。
// 演示由 test/self-sig.test.mjs 覆盖，它直接调 read_signature。
