// Ed25519 的曲线运算：twisted Edwards 曲线 -x^2 + y^2 = 1 + d x^2 y^2。
//
// 用扩展坐标 (X, Y, Z, T)，其中 x = X/Z、y = Y/Z、T = XY/Z。
// 为什么不用仿射：仿射一次点加要两次求逆（各 0.3 秒），而一次标量乘有 255 次倍点 ——
// 那就是几分钟。扩展坐标里点加与倍点都只有乘与加减，求逆只在最后转回仿射时做一次。
//
// 公式取自「dbl-2008-hwcd」与「add-2008-hwcd-3」这两套（a = -1 的那一支），
// 也就是 RFC 8032 与多数实现用的那两条。
import "./bigint.hmyr"

fn d_常量() {
  return 从十六进制("52036cee2b6ffe738cc740797779e89800700a4d4141d8ab75eb4dca135978a3")
}

// k = 2d，点加公式里的常数。
fn 二d() {
  let d = d_常量()
  return 模加(d, d)
}

fn 基点() {
  let x = 从十六进制("216936d3cd6e53fec0a4e231fdd6dc5c692cc7609525a7b2c9562d608f25d51a")
  let y = 从十六进制("6666666666666666666666666666666666666666666666666666666666666658")
  // Z = 1，所以 T = x*y/Z = x*y。T 不是另算的常数，它是从 x 与 y 推出来的。
  return (x, y, 一(), 模乘(x, y))
}

fn 单位元() {
  return (零组(16), 一(), 一(), 零组(16))
}

fn 抄(a: Int) {
  let 组 = 零组(16)
  var i = 0
  while i < 16 {
    设(组, i, a[i])
    i = i + 1
  }
  return 组
}

fn 规约(a: Int) {
  var 出 = 抄(a)
  while 出[15] >= 32768 {
    设(出, 15, 出[15] - 32768)
    var 进 = 19
    var j = 0
    while 进 > 0 && j < 16 {
      let 和 = 出[j] + 进
      设(出, j, 和 % 65536)
      进 = (和 - 和 % 65536) / 65536
      j = j + 1
    }
  }
  if 比(出, 模数()) >= 0 { 出 = 减(出, 模数()) }
  return 出
}

fn 模加(a: Int, b: Int) {
  let 组 = 零组(16)
  var 进 = 0
  var i = 0
  while i < 16 {
    let 和 = a[i] + b[i] + 进
    设(组, i, 和 % 65536)
    进 = (和 - 和 % 65536) / 65536
    i = i + 1
  }
  return 规约(组)
}

fn 模减(a: Int, b: Int) {
  return 规约(加(加(a, 模数()), 减(零组(16), b)))
}

// 倍点（dbl-2008-hwcd，a = -1）。
fn 倍点(p: Int) {
  let X1 = p[0]
  let Y1 = p[1]
  let Z1 = p[2]
  let A = 模乘(X1, X1)
  let B = 模乘(Y1, Y1)
  let C = 模乘(模加(Z1, Z1), Z1)
  // D = a*A，而 a = -1，所以 D = -A。
  let D = 模减(零组(16), A)
  let E = 模减(模减(模乘(模加(X1, Y1), 模加(X1, Y1)), A), B)
  let G = 模加(D, B)
  let F = 模减(G, C)
  let H = 模减(D, B)
  return (模乘(E, F), 模乘(G, H), 模乘(F, G), 模乘(E, H))
}

// 点加（add-2008-hwcd-3）：常数是 2d。
fn 点加(p1: Int, p2: Int) {
  let X1 = p1[0]
  let Y1 = p1[1]
  let Z1 = p1[2]
  let T1 = p1[3]
  let X2 = p2[0]
  let Y2 = p2[1]
  let Z2 = p2[2]
  let T2 = p2[3]
  let A = 模乘(模减(Y1, X1), 模减(Y2, X2))
  let B = 模乘(模加(Y1, X1), 模加(Y2, X2))
  let C = 模乘(模乘(T1, 二d()), T2)
  let D = 模乘(模乘(Z1, 模加(Z2, Z2)), Z2)
  let E = 模减(B, A)
  let F = 模减(D, C)
  let G = 模加(D, C)
  let H = 模加(B, A)
  return (模乘(E, F), 模乘(G, H), 模乘(F, G), 模乘(E, H))
}

fn 倍点三次(p: Int) {
  return 倍点(倍点(倍点(p)))
}

// 标量乘：从最高位往下，每步倍点，该位是一就再加一次。
fn 标量乘(点: Int, 标: Int) {
  var 出 = 单位元()
  var 位 = 254
  while 位 >= 0 {
    出 = 倍点(出)
    if 取位(标, 位) == 1 {
      出 = 点加(出, 点)
    }
    位 = 位 - 1
  }
  return 出
}

// 扩展坐标 → 仿射：x = X/Z、y = Y/Z。只在这里求一次逆。
fn 转仿射(p: Int) {
  let 逆 = 求逆(p[2])
  return (模乘(p[0], 逆), 模乘(p[1], 逆))
}

// ---- 点解压：32 字节 → 曲线上的一个点 ----
//
// 压缩形式是「y 的小端 32 字节，最高位换成 x 的符号」。解压就是：
//   u = y^2 - 1，v = d y^2 + 1，x = sqrt(u/v)
// 而 p 与 5 同余（模 8），所以开方有一条直路：x = (u/v)^((p+3)/8)，
// 验一下 x^2 * v 是不是 u；不是的话乘上 sqrt(-1) —— 那两种情形正好覆盖全部平方剩余。

// 从 32 字节小端建一个大整数。
fn 从字节们(字节们: Int) {
  let 组 = 零组(16)
  var i = 0
  while i < len(字节们) && i < 32 {
    let 位 = (i - i % 2) / 2
    let 值 = to_int(字节们[i])
    if i % 2 == 0 {
      设(组, 位, 组[位] + 值)
    } else {
      设(组, 位, 组[位] + 值 * 256)
    }
    i = i + 1
  }
  return 组
}

// (p+3)/8 = 2^252 - 2：低 252 位全一，再减一。
fn 指数开方() {
  let 组 = 零组(16)
  var i = 0
  while i < 16 {
    设(组, i, 65535)
    i = i + 1
  }
  设(组, 0, 65534)
  设(组, 15, 4095)
  return 组
}

// (p-1)/4 = 2^253 - 5：2 的这个次幂就是 sqrt(-1)。
fn sqrt负一() effects(process) {
  let 组 = 零组(16)
  var i = 0
  while i < 16 {
    设(组, i, 65535)
    i = i + 1
  }
  设(组, 0, 65531)
  设(组, 15, 8191)
  let 二 = 零组(16)
  设(二, 0, 2)
  return 模幂(二, 组)
}

// 32 字节 → 点（扩展坐标，Z = 1）。符号位不合法的情形这一版不报错，
// 交回的点仍在曲线上 —— 验签那一步会因为方程不成立而拒绝。
fn 解压(字节们: Int) effects(process) {
  let y = 从字节们(字节们)
  let 顶 = 位右移(y[15], 15)
  设(y, 15, 位与(y[15], 32767))
  let y2 = 模乘(y, y)
  let u = 模减(y2, 一())
  let v = 模加(模乘(d_常量(), y2), 一())
  let 比 = 模乘(u, 求逆(v))
  var x = 模幂(比, 指数开方())
  let 验 = 模乘(模乘(x, x), v)
  if 比(验, u) != 0 {
    x = 模乘(x, sqrt负一())
  }
  if 取位(x, 0) != 顶 {
    x = 模减(零组(16), x)
  }
  return (x, y, 一(), 模乘(x, y))
}

// 探针：给一个标量（十六进制），交回「标量乘基点」的仿射 x 与 y；
// 给 --解压 加 32 字节十六进制，交回解出来的点的 x 与 y。
fn main() -> Int effects(process) {
  let 参 = argv()
  if len(参) < 2 {
    print("用法：hmyr self/curve.hmyr <标量十六进制>" + chr(10))
    print("      hmyr self/curve.hmyr --解压 <32 字节十六进制>" + chr(10))
    return 2
  }
  if 参[1] == "--解压" {
    if len(参) < 3 {
      print("要一个 32 字节的十六进制串" + chr(10))
      return 2
    }
    let 字节们 = 解base64十六进制(参[2])
    let 点 = 转仿射(解压(字节们))
    print(成十六进制(点[0]) + chr(10))
    print(成十六进制(点[1]) + chr(10))
    return 0
  }
  let 点 = 转仿射(标量乘(基点(), 从十六进制(参[1])))
  print(成十六进制(点[0]) + chr(10))
  print(成十六进制(点[1]) + chr(10))
  return 0
}

// 十六进制串 → 字节元组（大端写法，两字符一字节）。
fn 解base64十六进制(s: String) {
  var 出 = ()
  var i = 0
  while i + 1 < len(s) {
    出 = 出 + (十六进制值(slice(s, i, i + 1)) * 16 + 十六进制值(slice(s, i + 1, i + 2)),)
    i = i + 2
  }
  return 出
}

fn 十六进制值(c: String) -> Int {
  let v = ord(c)
  if v >= 48 && v <= 57 { return v - 48 }
  if v >= 97 && v <= 102 { return v - 87 }
  return 0
}
