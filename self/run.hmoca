// 自举的最后一步：把四件串起来，让 Himeyuri 自己跑 Himeyuri。
//
//   源码 → lex.scan（token）→ chain.chain（节点）→ eval.求值（值）
//
// 这一件之外没有别的环节：宿主只负责「起它」。也就是说，下面这段程序的每一层
// （怎么切词、怎么搭树、怎么算值）都由 Himeyuri 自己写成，而不是借用别人的语言。
//
// 边界照旧写在明处：
//   ・词法与语法层的错会被原样带上来，不猜、不跳过
//   ・这一版的求值器只认十二种节点里已经实现的部分（记录还不支持）
//   ・调用只认 len 与 str 两个纯函数；打印由这里做，因为这里才该动世界

引入 "./lex.hmoca"
引入 "./chain.hmoca"
引入 "./stmt.hmoca"
引入 "./body.hmoca"
引入 "./eval.hmoca"

// 跑一段源码，交回结果文字。语法层的错不必在这里单独拦：eval 认识 {kind: "误"}
// 那一种节点，会把它原样带上来（实测如此，所以这里少一层分支）。
函数 跑(源码: String) -> String {
  定 tokens = scan(源码)
  定 树 = chain(tokens)
  定 r = 求值(树.node, ())
  若 r.ok == 假 { 返回 "求值错：" + r.text }
  返回 str(r.value)
}

// 跑一段源码并把它写出来。打印放在这里，因为这一层就是那个「调用方」。
函数 跑并打印(源码: String) -> Int 效果串(process) {
  print(跑(源码) + "\n")
  返回 0
}

// 跑一整段程序：scan_lines 保留换行，于是语句边界有着落；
// parse_body 按换行切开、逐条交给 parse_statement；再交给求值器的语句层。
//
// 与上面那条「跑一个表达式」的路并存：表达式用 scan（不保留换行），程序用 scan_lines。
// 两条路的产出形状不同，所以不能混着用——这一点写在明处。
// 源码里有没有声明：行首（可带空白、可夹注释）是 函数 才算。
//
// 只认 函数 是有意的：一段裸语句也可能以 变 或 常量 开头（`变 i = 0` 是普通的局部声明），
// 认了它们就会把「一串语句」误判成「一份声明」—— 症状是「声明里没有 函数」，
// 而那句话会让人去查解析器。有 函数 的文件里照样可以有顶层 常量 与 变，
// 因为判据问的是「这一份是不是声明式程序」，不是「第一个词是什么」。
函数 跳到行尾(s: String, i: Int) -> Int {
  若 i >= len(s) { 返回 i }
  若 s[i] == chr(10) { 返回 i + 1 }
  返回 跳到行尾(s, i + 1)
}

函数 行首是声明从(s: String, i: Int) -> Bool {
  若 i >= len(s) { 返回 假 }
  定 c = s[i]
  若 c == " " || c == "\t" || c == "\n" || c == "\r" { 返回 行首是声明从(s, i + 1) }
  // 注释行要跳过。一份文件以注释开头是常态，而「以注释开头」不等于「不是声明」。
  若 c == "/" && i + 1 < len(s) && s[i + 1] == "/" { 返回 行首是声明从(s, 跳到行尾(s, i)) }
  若 i + 1 < len(s) && s[i] == "f" && s[i + 1] == "n" { 返回 真 }
  返回 假
}

函数 行首是声明(s: String) -> Bool {
  返回 行首是声明从(s, 0)
}

// 跑一整段源码。
//
//  ・有 函数 声明：源码就是完整的程序，parse_body 直接从它里面找体；
//  ・没有声明：当它是一串裸语句，包一层 函数 main 的壳（这是兼容旧用法的路）。
//
// 两条路都交给同一个语句层，所以差别只在「壳由谁提供」。
函数 跑程序文字(源码: String) -> String {
  若 行首是声明(源码) {
    定 tokens = scan_lines(源码)
    // 声明里找：有 main 就跑 main，没有就跑第一个函数。
    // 这样「一个文件里几个函数」也认得，只是还不能互相调用（求值器的调用只认内置）。
    定 全部 = parse_decls(tokens)
    若 len(全部.fns) == 0 { 返回 "错：声明里没有 fn" }
    定 选 = 选函数(全部.fns, "main")
    定 体 = 选[2]   // 声明现在是（名字, 参数名册, 语句批），语句批是第三件
    定 r = 跑程序带常量与参(体, 全部.fns, 全部.consts, (), ())
    若 r.ok == 假 { 返回 "错：" + r.text }
    返回 str(r.value)
  }
  定 有壳 = "fn main() -> Int {\n" + 源码 + "\n}\n"
  定 tokens = scan_lines(有壳)
  定 体 = parse_body(tokens)
  若 体.found == 假 { 返回 "错：找不到函数体" }
  定 r = 跑程序(体.list)
  若 r.ok == 假 { 返回 "错：" + r.text }
  返回 str(r.value)
}

// 只走「切词 + 搭树」这两步，不求值。
//
// 为什么需要它：宿主那边的 loader 也会先做同样两件事，做完才谈得上求值。比「整段程序
// 跑对了」更早的一层，是「这段源码认得下来」。所以这个入口交回的是形状而不是值：
// 认得就 "ok <函数个数>"，认不得就 "错：<为什么>"。
//
// 引入 行先剥掉（去导入）：那不是语法的一部分，而是加载器的事；两边都不该因为
// 「文件里有一行 引入」就把树搭歪。
函数 只解析(源码: String) -> String {
  定 净 = 去导入(源码)
  若 行首是声明(净) {
    定 tokens = scan_lines(净)
    定 全部 = parse_decls(tokens)
    若 len(全部.fns) == 0 { 返回 "错：没有认出任何 fn 声明" }
    返回 "ok " + str(len(全部.fns))
  }
  定 有壳 = "fn main() -> Int {\n" + 净 + "\n}\n"
  定 tokens = scan_lines(有壳)
  定 体 = parse_body(tokens)
  若 体.found == 假 { 返回 "错：找不到函数体" }
  返回 "ok 1"
}

// ---- 只做「加载」：把宿主 loader 的三条承诺在这里也对齐 ----
//
// 宿主 loader 的文件头写着三件事：引入 真的加载本地文件、同一个文件只加载一次、
// 循环引用被拒（HMYR-載-001）。这里一条一条照做，另外补上「引的文件不在就报错」
// （宿主是 HMYR-載-003，不是跳过 —— 跳过是启动器对可选引用的另一件事）。
//
// 顺序取**后序**：先读完它的依赖，再把自己记进来。宿主 visit 里 push 的位置就在
// 递归之后，所以两边的 order 逐项相同 —— 这件事可量，量具是 tools/self-load.mjs。
// 这一条 引入 是不是一个「路径」：宿主那边只有 ./、../、盘符与绝对路径才算文件，
// 其余的（例如 引入 "某个包"）留给包管理器，记一笔 HMYR-載-002 就过去了，不算缺文件。
函数 是路径(s: String) -> Bool {
  若 len(s) >= 2 && slice(s, 0, 2) == "./" { 返回 真 }
  若 len(s) >= 3 && slice(s, 0, 3) == "../" { 返回 真 }
  若 len(s) >= 2 && slice(s, 1, 2) == ":" { 返回 真 }
  若 len(s) >= 1 && slice(s, 0, 1) == "/" { 返回 真 }
  返回 假
}

函数 加载走(目录: String, 相对: String, 栈: Int, 已载: Int) 效果串(file) {
  // 包名也走这条路（2026-11-02）：解析路 认得路径、绝对路径与包名三种写法，
  // 与宿主 loader 的 resolveImport 同一条规矩。原来这里只 拼路径，于是包名
  // 被当成「不是文件」跳过，而适配层只好在 JS 那一侧再补一遍 —— 那就是两份知识。
  //
  // 不成形状的（比如 std/io 里的斜杠）交给包管理器：宿主在那里报 HMYR-載-002 并跳过，
  // 这里也跳过，因为「不是文件」与「缺文件」是两件事。
  若 是路径(相对) == 假 && 是绝对(相对) == 假 && 是包名字(相对) == 假 {
    返回 {已载: 已载, 错: ""}
  }
  定 路 = 解析路(目录, 相对)
  // 环先判：栈 记的是「这一条路径上走过的」，而已载 记的是「已经加载过的」。
  // 两者的顺序要紧 —— 已载 先判会把环当成「已经加载过」，于是 HMYR-載-001 永远报不出来
  // （2026-11-01 实测：调换之后 selfmod 那条环用例才重新通过）。
  若 含路(栈, 路, 0) { 返回 {已载: 已载, 错: "HMYR-載-001 " + 路} }
  若 含路(已载, 路, 0) { 返回 {已载: 已载, 错: ""} }
  若 file_exists(路) == 假 { 返回 {已载: 已载, 错: "HMYR-載-003 " + 路} }
  // 读源码、扫它引了谁，然后递归 —— 这一层只负责「顺序」。
  //
  // 为什么这里不调 只解析（2026-11-01 量出来的）：它只用来报 E0100（这文件语法错），
  // 而语法错宿主那一侧本来就要判（loadUnitSelf 里 lex 与 子集解 都会报，而且更准）。
  // 代价是它把整份源码解析成树：self/eval.hmoca（1309 行、38 KB）一次就要四吉字节 —— 
  // 自举层的解析器对长文件是二次方的，那是一条待修的账（design/FULLSELF.txt 第五节），
  // 而它没有理由坐在「只要顺序」的路径上。
  // 两个列表分工：栈 管环（这一条路径上走过的），已载 管去重（已经完成的）。
  //
  // 传给子层的是「不含自己」的 已载，自己等子层回来才追加 —— 于是顺序是后序：
  // 被 引入 的排在入口之前，与宿主 loader 一样。
  //
  // 为什么要说这一条（2026-11-01 深夜）：原来是 已载 + (路,) 一起传下去，于是
  // 第 154 行那个 含路(已, 路) 永远为真、自己再也没被追加过 —— 顺序变成先序。
  // 症状不吓人但很硬：module 与 subset-load 两套的判据都是「被 引入 的排在入口之前」，
  // 它们拿到的却是 ["main.hmoca","lib.hmoca"]。环靠 栈 拦，不靠 已载，所以这样改
  // 不会把环放回来（那一条由 140 行守着）。
  定 源码 = read_text(路, "utf8")
  定 子 = 加载多(目录部分(路), 找导入们(源码), 0, 栈 + (路,), 已载)
  变 已 = 子.已载
  变 错 = 子.错
  若 错 == "" && 含路(已, 路, 0) == 假 { 已 = 已 + (路,) }
  返回 {已载: 已, 错: 错}
}

函数 加载多(目录: String, 路串: Int, i: Int, 栈: Int, 已载: Int) 效果串(file) {
  若 i >= len(路串) { 返回 {已载: 已载, 错: ""} }
  // 三种形状放行：路径、绝对、包名。其余的（std/io 这种）跳过 —— 报 HMYR-載-003 会把
  // 「包管理器将来的事」当成「缺文件」。
  //
  // 这一道门与 加载走 开头那道要一起改（2026-11-02）：只改后者的话，包名在进
  // 加载走 之前就被这里滤掉了，症状是 order 里没有包 —— 而 pkg-manifest 与
  // owned-check 的那三条判据全在包上，它们一起红，看起来像检查坏了。
  若 是路径(路串[i]) == 假 && 是绝对(路串[i]) == 假 && 是包名字(路串[i]) == 假 {
    返回 加载多(目录, 路串, i + 1, 栈, 已载)
  }
  定 r = 加载走(目录, 路串[i], 栈, 已载)
  若 r.错 != "" { 返回 {已载: r.已载, 错: r.错} }
  返回 加载多(目录, 路串, i + 1, 栈, r.已载)
}

// ---- 声明层：把元组包成节点 ----
//
// 宿主的树有三层：Module → Fn → Block → 语句。这一侧以前只有元组
// （名字, 参数名册, 语句批, 效果名册, 行, 列），于是两边的节点数永远对不上 ——
// 比较只能问「self 的位置宿主有没有」，问不了「节点对不对得上」。
//
// 这两个函数只做包装，不动解析：解析仍是 parse_decls 与 parse_body 干的活。
// 包一层不是为了好看：Module、Fn、Block 是宿主 loader 与 runUnit 认得的那三种东西，
// 有了它们，换掉 src/loader.mjs 才谈得上。
// 宿主的语句层把 若 与 当 包成 ExprStmt（它把 若 当表达式，语句层再包一层）。
// 形状要一致就得跟着包 —— 而这只在包装这一层做，解析与求值两条路一个字都不动。
// 位置的安全读法：语法错的节点本来就可能没有位置（越界时连 token 都没有）。
// 这里缺就填 0，而不是让一次缺字段把整棵树造失败 —— 诊断要的是「尽力说清」，不是「全有或全无」。
函数 行(n: Int) -> Int {
  若 field_has(n, "line") { 返回 n.line }
  返回 0
}

函数 列(n: Int) -> Int {
  若 field_has(n, "column") { 返回 n.column }
  返回 0
}
// 按基读 与 数字值 在 eval.hmyr：求值器那条路也要认 0x1_0，所以它们住在那儿，
// 这一层通过 引入 直接用（这里的 翻表达式 仍在调 数字值）。

// 把表达式树翻成宿主那边认的形状：Literal 补 value 与 raw，Ident 的 text 改叫 name。
//
// 这三件（字面量的值、空 返回、Ident 的字段名）是适配器里最后的翻译。把它们挪进 HMYR，
// 工具那一层就只剩搬运 —— 而「宿主一口吃下去」这句话才算有证据。
函数 翻表达式(n: Int) {
  若 n.kind == "字" {
    若 n.类型 == "int" {
      返回 {kind: "字", 类型: "int", value: 数字值(n.text), raw: n.text, text: n.text, line: 行(n), column: 列(n)}
    }
    返回 {kind: "字", 类型: "string", value: n.text, raw: 假, text: n.text, line: 行(n), column: 列(n)}
  }
  若 n.kind == "名" {
    // 真 与 假 在这一侧是标识符（词法把关键字也归在 ident 里），在宿主那边是字面量。
    // 不转的话，宿主会去找一个叫 假 的名字 —— 报 HMYR-行-005，而那句话听起来像拼写错误。
    若 n.text == "true" { 返回 {kind: "字", 类型: "bool", value: 真, raw: 假, text: n.text, line: 行(n), column: 列(n)} }
    若 n.text == "false" { 返回 {kind: "字", 类型: "bool", value: 假, raw: 假, text: n.text, line: 行(n), column: 列(n)} }
    // 空 在宿主那边是一个字面量（类型 "nil"、值 null），不是名字。
    若 n.text == "nil" { 返回 {kind: "字", 类型: "nil", value: (), raw: 假, text: n.text, line: 行(n), column: 列(n)} }
    返回 {kind: "名", name: n.text, text: n.text, line: 行(n), column: 列(n)}
  }
  若 n.kind == "二元" {
    返回 {kind: "二元", op: n.op, left: 翻表达式(n.left), right: 翻表达式(n.right), line: 行(n), column: 列(n)}
  }
  若 n.kind == "一元" {
    返回 {kind: "一元", op: n.op, operand: 翻表达式(n.operand), line: 行(n), column: 列(n)}
  }
  若 n.kind == "调用" {
    返回 {kind: "调用", callee: 翻表达式(n.callee), args: 翻表达式们(n.args, 0, ()), line: 行(n), column: 列(n)}
  }
  若 n.kind == "字段" {
    返回 {kind: "字段", target: 翻表达式(n.target), name: n.name, line: 行(n), column: 列(n)}
  }
  若 n.kind == "索引" {
    返回 {kind: "索引", target: 翻表达式(n.target), index: 翻表达式(n.index), line: 行(n), column: 列(n)}
  }
  若 n.kind == "组" {
    返回 {kind: "组", items: 翻表达式们(n.items, 0, ()), line: 行(n), column: 列(n)}
  }
  // 记录字面量：字段的值也是表达式，也要翻。漏了这一步不会报错 —— 它只是把没翻过的
  // Ident 原样交给宿主，然后宿主去找一个叫 undefined 的名字。
  若 n.kind == "记录" {
    返回 {kind: "记录", fields: 翻字段批(n.fields, 0, ()), line: 行(n), column: 列(n)}
  }
  返回 n
}

函数 翻字段批(们: Int, i: Int, acc: Int) {
  若 i >= len(们) { 返回 acc }
  定 f = 们[i]
  返回 翻字段批(们, i + 1, acc + ({name: f.name, value: 翻表达式(f.value)},))
}

函数 翻表达式们(们: Int, i: Int, acc: Int) {
  若 i >= len(们) { 返回 acc }
  返回 翻表达式们(们, i + 1, acc + (翻表达式(们[i]),))
}

// 语句里的那几个表达式字段也要翻。空 返回 干脆不带 value —— 宿主读出来是 undefined，
// 与它自己的 null 同效；而这一侧本来就没有 null 这个词。
函数 翻语句(n: Int) {
  若 n.kind == "定" { 返回 {kind: "定", name: n.name, value: 翻表达式(n.value), line: 行(n), column: 列(n)} }
  若 n.kind == "变" { 返回 {kind: "变", name: n.name, value: 翻表达式(n.value), line: 行(n), column: 列(n)} }
  若 n.kind == "赋值" { 返回 {kind: "赋值", name: n.name, value: 翻表达式(n.value), line: 行(n), column: 列(n)} }
  若 n.kind == "返回" {
    若 n.value.kind == "nil" { 返回 {kind: "返回", line: 行(n), column: 列(n)} }
    返回 {kind: "返回", value: 翻表达式(n.value), line: 行(n), column: 列(n)}
  }
  若 n.kind == "表达式语句" { 返回 {kind: "表达式语句", expr: 翻表达式(n.value), line: 行(n), column: 列(n)} }
  返回 n
}

函数 转语句批(语句批: Int, i: Int, acc: Int) {
  若 i >= len(语句批) { 返回 acc }
  定 n = 语句批[i]
  变 出 = 翻语句(n)
  // If 与 While 在这一侧还要换字段名：cond 对 condition，then/otherwise/body 要包成 Block。
  // 解析那一层不动（求值器读的还是 cond 与语句元组），只在包装这一层翻。
  若 n.kind == "若" {
    定 内 = {kind: "若", condition: 翻表达式(n.cond), then: 包块(n.then, n.line), otherwise: 包块(n.otherwise, n.line), line: 行(n), column: 列(n)}
    出 = {kind: "表达式语句", expr: 内, line: 行(n), column: 列(n)}
  }
  若 n.kind == "当" {
    定 内 = {kind: "当", condition: 翻表达式(n.cond), body: 包块(n.body, n.line), line: 行(n), column: 列(n)}
    出 = {kind: "表达式语句", expr: 内, line: 行(n), column: 列(n)}
  }
  返回 转语句批(语句批, i + 1, acc + (出,))
}

函数 包块(语句批: Int, 行: Int) {
  返回 {kind: "块", statements: 转语句批(语句批, 0, ()), line: 行}
}

// 参数名 → {name, passing}。宿主的参数是记录（带 类型 与 passing），而这一侧
// 原来只交 {name} —— 于是「跨模块的借用分析」在自举层那条路上什么都看不见：
// 它判的第一件事就是 params[].passing 是不是 借用（2026-11-02 实测，
// ownedcheck 那套的「跨模块的转移被看见」因此拿到空数组）。
//
// 借用 与 拥有 是两个前缀词，收名 那一层把它们也当名字收进来了 —— 所以这里
// 见到它们就把下一个名字配上去。没有前缀的参数 passing 留空。
函数 转参数们(名册: Int, i: Int, acc: Int) {
  若 i >= len(名册) { 返回 acc }
  定 名 = 名册[i]
  若 名 == "borrow" || 名 == "own" {
    若 i + 1 < len(名册) { 返回 转参数们(名册, i + 2, acc + ({name: 名册[i + 1], passing: 名},)) }
    返回 acc
  }
  返回 转参数们(名册, i + 1, acc + ({name: 名, passing: ()},))
}

函数 包声明(声明批: Int, i: Int, acc: Int) {
  若 i >= len(声明批) { 返回 acc }
  定 d = 声明批[i]
  变 名 = ""
  变 参 = ()
  变 句 = ()
  变 效 = ()
  变 行 = 1
  变 列 = 1
  若 len(d) > 0 { 名 = d[0] }
  若 len(d) > 1 { 参 = d[1] }
  若 len(d) > 2 { 句 = d[2] }
  若 len(d) > 3 { 效 = d[3] }
  若 len(d) > 4 { 行 = d[4] }
  若 len(d) > 5 { 列 = d[5] }
  // 第九件是 "macro" 的时候，第三件放的是表达式而不是语句批 —— 宏的 body 是一个
  // 表达式（src/expand.mjs 的换回按表达式走），所以这里不能包成 Block。
  若 len(d) > 8 && d[8] == "macro" {
    返回 包声明(声明批, i + 1, acc + ({kind: "宏", name: 名, params: 参, body: 句, line: 行, column: 列},))
  }
  变 返 = ()
  若 len(d) > 6 { 返 = d[6] }
  // 第八件是「这个声明是不是 公开」（self/body.hmoca 的 decls_from 现在收它）。
  变 是公开 = 0
  若 len(d) > 7 { 是公开 = d[7] }
  定 体 = 包块(句, 行)
  定 函 = {kind: "函数", name: 名, params: 转参数们(参, 0, ()), returns: 返, 效果串: 效, contracts: (), body: 体, 公开: 是公开, line: 行, column: 列}
  返回 包声明(声明批, i + 1, acc + (函,))
}

// 从 token 流里找出 引入 行，包成 Import 节点。
//
// 为什么从 token 找而不是从文本找：位置要得从 token 来，而 找导入们 只交回路径字符串。
// 宿主那边 Import 的位置记在 引入 这个关键字上，这一侧照同一个规矩。
// alias 与 rev 先留空：这一层的语法还不认它们，等认了再填 —— 空的与「没有」不是一回事，
// 所以量具只比 path 与位置，不比这两项。
// 模块版本：顶上那句 `rev N`。找不到就是 0（宿主那边不写 rev 是 null，
// 而这一侧用一个数表示「不提要求」，桥再决定怎么落）。
函数 模块版本(tokens: Int, i: Int) {
  若 i + 1 >= len(tokens) { 返回 0 }
  定 t = tokens[i]
  // 只看模块顶上那一句：碰到 引入 或声明就该停 —— 记录里的 `rev: 版` 是字段，不是版本。
  若 t.kind == "ident" && (t.text == "import" || t.text == "fn" || t.text == "let" || t.text == "var") { 返回 0 }
  若 t.kind == "ident" && t.text == "rev" {
    若 tokens[i + 1].kind == "int" { 返回 to_int(tokens[i + 1].text) }
    返回 0 - 1
  }
  返回 模块版本(tokens, i + 1)
}

函数 导入节点批(tokens: Int, i: Int, acc: Int) {
  若 i >= len(tokens) { 返回 acc }
  定 t = tokens[i]
  若 t.kind == "ident" && t.text == "import" && i + 1 < len(tokens) && tokens[i + 1].kind == "string" {
    定 s = tokens[i + 1]
    // 引入 "x.hmoca" rev N —— 不写就是 0（这一侧用 0 表示「不提要求」）。
    变 版 = 0
    若 i + 2 < len(tokens) && tokens[i + 2].kind == "ident" && tokens[i + 2].text == "rev" {
      若 i + 3 < len(tokens) && tokens[i + 3].kind == "int" { 版 = to_int(tokens[i + 3].text) } 否则 { 版 = 0 - 1 }
    }
    // 作 别名：`引入 "x" 作 名`。与 rev 可以并存而顺序不固定，所以两个位置都看。
    //
    // 原来这里写死 alias: ""（上面那条注释还写着「这一层的语法还不认它们」）——
    // 于是 Runtime.模块成员 那条路永远查不到别名，「别名点成员调得动」那一条恒红
    // （2026-11-02 实测：桥交出的 别名表 是空的）。空串与「没有」在这里是同一件事，
    // 而调用方只问真不真，所以初值用空串没有歧义。
    变 别 = ""
    若 i + 2 < len(tokens) && tokens[i + 2].kind == "ident" && tokens[i + 2].text == "as" {
      若 i + 3 < len(tokens) && tokens[i + 3].kind == "ident" { 别 = tokens[i + 3].text }
    }
    若 i + 3 < len(tokens) && tokens[i + 3].kind == "ident" && tokens[i + 3].text == "as" {
      若 i + 4 < len(tokens) && tokens[i + 4].kind == "ident" { 别 = tokens[i + 4].text }
    }
    定 节 = {kind: "引入", path: s.text, alias: 别, rev: 版, line: t.line, column: t.column}
    返回 导入节点批(tokens, i + 2, acc + (节,))
  }
  返回 导入节点批(tokens, i + 1, acc)
}

// 一整个文件 → Module。有声明就按声明走；没有就照旧包一层 函数 main 的壳（老用法）。
函数 造模块(源: String) {
  定 净 = 去导入(源)
  // 引入 行被 去导入 剥掉了，所以找它们要用原始源码。
  定 全toks = scan_lines(源)
  定 导入 = 导入节点批(全toks, 0, ())
  // 判断「这是不是一份带声明的程序」看 parse_decls 的结果，不看第一行 —— 文件以注释开头
  // 时会误判（lex.hmyr 就是这样：第一行是注释，于是整份被当成裸语句包进 函数 main 的壳）。
  // 解析用**原始** token 流：去导入 会把行号整体上移，两边就对不上位置了。
  定 全部 = parse_decls(全toks)
  若 len(全部.fns) > 0 {
    返回 {kind: "模块", imports: 导入, decls: 包声明(全部.fns, 0, ()), rev: 模块版本(全toks, 0)}
  }
  定 有壳 = "fn main() -> Int {\n" + 净 + "\n}\n"
  定 体 = parse_body(scan_lines(有壳))
  返回 {kind: "模块", imports: 导入, decls: 包声明((("main", (), 体.list, (), 1, 1),), 0, ()), rev: 0}
}

// 整棵 引入 树：加载（递归、去重、环拒绝、后序）+ 造形状，一步做完。
//
// 两件事本来分在两条链上：加载走 管「谁先被读到」，造模块 管「那一个文件长什么样」。
// 宿主 loader 是把这两件合成一次的，所以这里也合成一次 —— 交回一串 Module，按依赖顺序排。
//
// 入口走相对路径（与 加载走 同一个约定：拼路径 只认相对与 ./）。
函数 造整棵(入口: String) 效果串(file) {
  // 入口也要过 当路径：桥传进来的是 examples/board-spec.hmoca 这种仓库相对路径，
  // 不以 ./ 开头 —— 而 加载走 现在按 引入 说明的三种形状判（路径 / 绝对 / 包名），
  // 含斜杠的裸路径会被当成「不成形状」丢掉，于是整棵树是空的、而 ok 还是真
  // （2026-11-02 实测：桥的 loadUnit 交回 ok=真 而 order=0、modules=0）。
  定 r = 加载走(".", 当路径(入口), (), ())
  若 r.错 != "" { 返回 {ok: 假, 错: r.错, 模块族: (), 路径们: ()} }
  变 模块族 = ()
  变 i = 0
  当 i < len(r.已载) {
    定 源码 = read_text(r.已载[i], "utf8")
    模块族 = 模块族 + (造模块(源码),)
    i = i + 1
  }
  // 路径与模块一起交回去：宿主 loader 的 order 是路径，桥要能照原样说同一个序列。
  返回 {ok: 真, 错: "", 模块族: 模块族, 路径们: r.已载}
}

// 只解析、不求值，交回声明树。
//
// 量「节点位置」时用它：求值会把树丢掉，而位置在树上。函数的形状与 parse_decls 交回的
// 一致 —— 声明是 (名字, 参数名册, 语句批)。
函数 解析程序(源: String) {
  定 净 = 去导入(源)
  若 行首是声明(净) {
    定 全部 = parse_decls(scan_lines(净))
    返回 全部.fns
  }
  定 有壳 = "fn main() -> Int {\n" + 净 + "\n}\n"
  定 体 = parse_body(scan_lines(有壳))
  返回 (体.list,)
}

// 量具与启动器传进来的是「相对当前目录的路径」，可能不写 ./ 开头（self/sign.hmoca 这样）。
// 而 加载走 现在按 引入 说明的三种形状去判（路径 / 绝对 / 包名）—— 于是这里补一个 ./，
// 别让「包名」那条分支抓住一条本来就能读的相对路径（2026-11-02 实测：不补的话
// self-load 那套量出空 order，四棵树一起红）。
函数 当路径(相对: String) -> String {
  若 是路径(相对) { 返回 相对 }
  若 是绝对(相对) { 返回 相对 }
  返回 "./" + 相对
}

// 给一个入口（相对当前目录），交回 "ok <文件数>" 或 "错 <码> <路径>"。
函数 只加载(入口: String) -> String 效果串(file) {
  定 r = 加载走(".", 当路径(入口), (), ())
  若 r.错 != "" { 返回 "错 " + r.错 }
  返回 "ok " + str(len(r.已载))
}

// 加载顺序，一行一个（相对当前目录的写法）。量具靠它逐项比宿主 loader 的 order。
函数 加载序(入口: String) -> String 效果串(file) {
  定 r = 加载走(".", 当路径(入口), (), ())
  若 r.错 != "" { 返回 "错 " + r.错 }
  变 出 = ""
  变 i = 0
  当 i < len(r.已载) {
    出 = 出 + r.已载[i] + chr(10)
    i = i + 1
  }
  返回 出
}

// 按名字挑一个函数；没有就叫第一个（调试单个函数时方便）。
函数 选函数从(们: Int, 名: String, i: Int) {
  若 i >= len(们) { 返回 () }
  若 们[i][0] == 名 { 返回 们[i] }
  返回 选函数从(们, 名, i + 1)
}

函数 选函数(们: Int, 名: String) -> Int {
  定 有 = 选函数从(们, 名, 0)
  若 len(有) == 0 { 返回 们[0] }
  返回 有
}

// 跑几个模块：每一段都扫出它的声明，把函数表合起来，然后跑 main。
//
// 合并的规矩是「后到者覆盖先到者」——与 定 的重定义一致。
// 读文件不在这里：那是启动器（能力内核）的事，于是自举不必背上 file 效果。
// 去掉 引入 行：那些行只用来找路径，解析器不认它们。
//
// 为什么需要它：带 引入 的目标程序在自举层跑时，引入 那一行会被当成语句解析，
// 于是报「不认识的运算符：...」—— 报出来的东西是引号里的路径，
// 看着像是在别处出的错。引号里 只在「这一行是 引入」时才交回路径，
// 所以用它判断既准又省一个函数。
函数 去导入从(行批: Int, i: Int, acc: String) -> String {
  若 i >= len(行批) { 返回 acc }
  定 路 = 引号里(行批[i])
  若 路 == "" { 返回 去导入从(行批, i + 1, acc + 行批[i] + chr(10)) }
  返回 去导入从(行批, i + 1, acc)
}

函数 去导入(源码: String) -> String {
  返回 去导入从(拆行(源码), 0, "")
}

函数 合并从(已收: Int, 源码批: Int, i: Int) -> Int {
  若 i >= len(源码批) { 返回 已收 }
  定 tokens = scan_lines(去导入(源码批[i]))
  定 全部 = parse_decls(tokens)
  返回 合并从(已收 + 全部.fns, 源码批, i + 1)
}

// 常量要单独合并：它们的值要在装环境的时候求值，而函数表里放不下那一步。
// 顺序是 引入 的顺序 —— 依赖在前，所以被依赖的常量先装。
函数 合并常量从(已收: Int, 源码批: Int, i: Int) -> Int {
  若 i >= len(源码批) { 返回 已收 }
  定 tokens = scan_lines(去导入(源码批[i]))
  定 全部 = parse_decls(tokens)
  返回 合并常量从(已收 + 全部.consts, 源码批, i + 1)
}

// ---- 认 引入：从源码里取出它引的那几个路径 ----
//
// 这一段以前在宿主那边（bin/hmyr.mjs 里一个正则）。搬到这里，是因为
// 「一个文件引了谁」是这门语言自己的事——宿主不该比语言更懂 HMYR 的写法。
//
// 只认「一行 引入 "路径"」这一种形式。别的一律当没有：
// 认得窄而说清，比认得宽而猜测好。

// 按换行拆。与 拆行 不同，这里不要末尾那一个空段——
// 找 引入 只看行，末尾空行没有意义。
// 按换行拆。与 拆行 不同，这里不要末尾那一个空段——
// 找 引入 只看行，末尾空行没有意义。
//
// 循环而不是每字符递归：递归深度等于字符数，源码一大就把机器栈吃光
// （同样的写法在 self/pack.hmyr 那里让 C 机器退出码成了 0xC00000FD）。
函数 拆行(文本: String) {
  若 文本 == "" { 返回 () }
  变 i = 0
  变 起 = 0
  变 acc = ()
  当 i < len(文本) {
    若 文本[i] == chr(10) {
      acc = acc + (slice(文本, 起, i),)
      i = i + 1
      起 = i
    } 否则 {
      i = i + 1
    }
  }
  返回 acc + (slice(文本, 起, len(文本)),)
}

// 这一行是不是「引入 "..."」。是就交回引号里的那一段，不是就交回空串。
//
// 两种写法都认（2026-11-02 换关键字之后）。这一层按源码原文判断，比词法那条路慢一拍：
// 词法器归一的是记号，而这里看的是还没切过的行。所以这里要自己认两种拼法。
函数 引号里(行: String) -> String {
  定 去 = 去首(行)
  定 起 = 导入词长(去)
  若 起 < 0 { 返回 "" }
  // 词界与词法那条规矩一样：importx 的前六个字符也是 import，而它不是那件事。
  若 len(去) > 起 && 去[起] != " " && 去[起] != chr(9) && 去[起] != chr(34) { 返回 "" }
  定 开 = 找引号(去, 起)
  若 开 < 0 { 返回 "" }
  定 闭 = 找引号(去, 开 + 1)
  若 闭 < 0 { 返回 "" }
  返回 slice(去, 开 + 1, 闭)
}

// 导入行开头那个关键字占几位；不是导入行就交回 -1。
函数 导入词长(去: String) -> Int {
  若 len(去) >= 6 && slice(去, 0, 6) == "import" { 返回 6 }
  若 len(去) >= 2 && slice(去, 0, 2) == "引入" { 返回 2 }
  返回 -1
}

函数 去首(行: String) -> String {
  若 len(行) == 0 { 返回 行 }
  若 行[0] == " " || 行[0] == chr(9) { 返回 去首(slice(行, 1, len(行))) }
  返回 行
}

函数 找引号(文本: String, 起: Int) -> Int {
  // 这里要改 i，所以是 变 而不是 定——定 声明的东西不可变。
  变 i = 起
  当 i < len(文本) && 文本[i] != chr(34) { i = i + 1 }
  若 i >= len(文本) { 返回 -1 }
  返回 i
}

函数 导入们从(行批: Int, i: Int, acc: Int) -> Int {
  若 i >= len(行批) { 返回 acc }
  定 路 = 引号里(行批[i])
  若 路 == "" { 返回 导入们从(行批, i + 1, acc) }
  返回 导入们从(行批, i + 1, acc + (路,))
}

// 一段源码里引了哪些路径，按出现的顺序。
函数 找导入们(源码: String) -> Int {
  返回 导入们从(拆行(源码), 0, ())
}

函数 跑模块族(源码批: Int, 参册: Int) -> String {
  定 函数族 = 合并从((), 源码批, 0)
  若 len(函数族) == 0 {
    // 一个声明也没有：那它可能是裸语句（老用法）。交回那条路，而不是报「没有 函数」。
    若 len(源码批) == 0 { 返回 "错：没有源码" }
    返回 跑程序文字(源码批[0])
  }
  定 选 = 选函数(函数族, "main")
  // 选[3] 是 main 自己声明的效果 —— 它决定这个程序能碰什么。
  变 主效 = ()
  若 len(选) > 3 { 主效 = 选[3] }
  定 常量册 = 合并常量从((), 源码批, 0)
  定 r = 跑程序带常量与参(选[2], 函数族, 常量册, 参册, 主效)
  若 r.ok == 假 { 返回 "错：" + r.text }
  返回 str(r.value)
}

// ---- 读文件：这一层以前住在宿主的启动器里 ----
//
// bin/hmyr.mjs 曾经自己用 fs 读目标、自己用正则找 引入。那两件事都是
// 「关于 HMYR 的知识」，于是搬到这儿：宿主只管把目录与目标名交过来。
//
// 一条要说清的边界：拼路径认「相对本目录的名字」「./ 开头的名字」与「绝对路径」。
// ../ 还没处理 —— 够现在用，而说清比假装认得宽更好。

函数 拼路径(目录: String, 相对: String) -> String {
  // 绝对路径原样返回。桥与测试会把临时目录里的文件交进来，那些不在仓库下，
  // 而「相对本目录」对它们没有意义 —— 说清这条边界，比让它们安静地读失败好。
  若 len(相对) >= 2 && slice(相对, 1, 2) == ":" { 返回 相对 }
  若 len(相对) >= 1 && slice(相对, 0, 1) == "/" { 返回 相对 }
  若 len(相对) >= 2 && slice(相对, 0, 2) == "./" {
    返回 目录 + "/" + slice(相对, 2, len(相对))
  }
  返回 目录 + "/" + 相对
}

函数 含路(已读: Int, 路: String, i: Int) -> Bool {
  若 i >= len(已读) { 返回 假 }
  若 已读[i] == 路 { 返回 真 }
  返回 含路(已读, 路, i + 1)
}

// 读一棵：先读自己，再挨个读它引的。顺序是先序——与以前启动器那段一模一样，
// 于是「谁先被读到」这件事没有因为搬家而改变。
//
// 环引用不会无限转：已读里有的就跳过。那与宿主那版的 Set 等价。
// 效果要一层一层传：这一件调了 读一棵（要 file），于是它自己也得要。
// 那条规矩不许在调用链中间偷偷断掉——不然「谁动世界」就说不清了。
函数 读多从(目录: String, 路串: Int, i: Int, 已读: Int, 源码批: Int) 效果串(file) {
  若 i >= len(路串) { 返回 {已读: 已读, 源码批: 源码批} }
  定 r = 读一棵(目录, 路串[i], 已读, 源码批)
  返回 读多从(目录, 路串, i + 1, r.已读, r.源码批)
}

// 一个文件路径的目录部分：最后一个分隔符之前的那一段。没有分隔符就是 "."。
// 这个函数存在的理由是一处真的错：早先 读一棵 把子模块的 引入 也按**顶层目录**拼，
// 于是 lib/protocol.hmyr 里那句 引入 "./tuples.hmoca" 被拼成了 conformance/tuples.hmyr，
// 文件不在就按「可选引用」跳过 —— 症状是目标程序运行时报「没有这个函数：子段」。
函数 目录部分(路: String) -> String {
  定 i = 最后一个分隔从(路, 0, 0 - 1)
  若 i < 0 { 返回 "." }
  返回 slice(路, 0, i)
}

// 绝对路径：以 / 开头，或者第二个字符是盘符冒号。它不该再拼一次目录。
函数 是绝对(相对: String) -> Bool {
  若 len(相对) >= 1 && slice(相对, 0, 1) == "/" { 返回 真 }
  若 len(相对) >= 2 && slice(相对, 1, 2) == ":" { 返回 真 }
  返回 假
}

// 一条 引入 说明是不是「路径」：./ ../ 开头的、绝对路径。其余（形如一个名字）是包名。
// 与宿主 loader 的判据同一条。
函数 是路径(相对: String) -> Bool {
  若 len(相对) >= 2 && slice(相对, 0, 2) == "./" { 返回 真 }
  若 len(相对) >= 3 && slice(相对, 0, 3) == "../" { 返回 真 }
  若 是绝对(相对) { 返回 真 }
  返回 假
}

// 像不像一个包名：不以数字、连字符或点开头，且整段不含斜杠。
// 与宿主那条正则同一条意思（名字里允许非 ASCII —— 这门语言的标识符本来就允许）。
// 不成形状的东西（std/io 这种）不是包名，是包管理器将来的事。
函数 是包名字(s: String) -> Bool {
  若 len(s) == 0 { 返回 假 }
  若 is_digit(s[0]) { 返回 假 }
  若 s[0] == "-" || s[0] == "." { 返回 假 }
  变 i = 0
  当 i < len(s) {
    若 s[i] == "/" { 返回 假 }
    i = i + 1
  }
  返回 真
}

// 从某个目录往上找「包根」：最外层的那个含 hmyr.hmkit 的目录。
// 「最外层」是必要的：每个包自己在 hmyr.hmkit 里说明身份（design/PKGMAN.txt），
// 所以「第一个含清单的目录」会是包自己 —— 于是 引入 "乙包" 会被解析成
// 甲包/乙包/index.hmoca。往上走到底、取最后遇到的那个，才是这个工程的外壳。
函数 找包根从(目录: String, 最后: String, 次: Int) -> String 效果串(file) {
  若 次 > 64 { 返回 最后 }
  变 记 = 最后
  若 file_exists(目录 + "/hmyr.hmkit") { 记 = 目录 }
  定 上 = 目录部分(目录)
  若 上 == 目录 { 返回 记 }
  返回 找包根从(上, 记, 次 + 1)
}

// 一个 引入 说明 → 一个路径。
// 包名的规则只有一句：包根下面的一个目录，入口是那个目录里的 index.hmoca。
函数 解析路(目录: String, 相对: String) -> String 效果串(file) {
  若 是绝对(相对) { 返回 相对 }
  若 是路径(相对) { 返回 拼路径(目录, 相对) }
  返回 找包根从(目录, 目录, 0) + "/" + 相对 + "/index.hmoca"
}

函数 读一棵(目录: String, 相对: String, 已读: Int, 源码批: Int) 效果串(file) {
  定 路 = 解析路(目录, 相对)
  若 含路(已读, 路, 0) { 返回 {已读: 已读, 源码批: 源码批} }
  // 不在就跳过：引一个可选文件不该让整个程序死。那与以前启动器的行为一致——
  // 而那件事以前靠宿主那边的 existsSync 做着。
  若 file_exists(路) == 假 { 返回 {已读: 已读 + (路,), 源码批: 源码批} }
  定 源码 = read_text(路, "utf8")
  // 子模块的 引入 相对**它自己**的目录，不是相对顶层目标。
  返回 读多从(目录部分(路), 找导入们(源码), 0, 已读 + (路,), 源码批 + (源码,))
}

// 启动器要的那一件事：给目录与目标名，交回跑出来的那段文字。
// 读不到文件时会以 HMYR-內-011 停下——那是能力契约里那条编号，行为与以前一致。
// 交回 {ok, 文字} 而不是一个字符串，因为这里有两种「不存在」：
//
//   目标文件本身不在      → 程序没法开始，启动器该以 1 退出
//   它 引入 的一个文件不在 → 跳过，照样跑（那是可选引用的常见意思）
//
// 这两件事以前都靠宿主一个 existsSync 判断，于是混在一起。分开说清之后，
// 启动器不必自己再懂一遍「什么算致命」。
// 目标程序看到的 argv：从「脚本名之后」那一位开始。
//
// 自举层自己看到的是 [脚本名, 目标, 其余…]（启动器递过来的是那一份），
// 而目标程序该看到 [目标, 其余…] —— 它问的是自己的参数，不是解释器的。
函数 目标程序参数从(参册: Int, i: Int, 出: Int) -> Int {
  若 i >= len(参册) { 返回 出 }
  返回 目标程序参数从(参册, i + 1, 出 + (参册[i],))
}

函数 目标程序参数(参册: Int, 起: Int, 出: Int) -> Int {
  返回 目标程序参数从(参册, 起, 出)
}

函数 跑文件入口(目录: String, 目标: String, 参册: Int) 效果串(file, process) {
  定 路 = 拼路径(目录, 目标)
  // 先转成绝对路径，再往 读一棵 传。
  //
  // 理由是那一边还会跑一次 解析路，而它只对绝对路径原样返回 —— 相对的 ./a/b 会被
  // 再拼一次目录，变成 ./a/./a/b，读不到，报的是 HMYR-內-011（看上去像文件不见了）。
  // 这道转换不是谨慎，是分工：入口这一层负责「从哪一个绝对文件开始」，
  // 底下那一层只负责「相对它怎么找」。
  变 全 = 路
  若 是绝对(路) == 假 { 全 = 拼路径(cwd(), 路) }
  若 file_exists(全) == 假 {
    返回 {ok: 假, 文字: "HMYR-內-011 cannot read '" + 全 + "': no such file"}
  }
  // 这里传 全（拼好的绝对路径），不是 目标。
  // 理由：解析路 会把「不像路径的名字」当包名，而入口文件的名字常常正是那样
  // （main.hmoca）。传绝对路径就绕过了那一条判断。
  定 读 = 读一棵(目录, 全, (), ())
  若 len(读.源码批) == 0 {
    返回 {ok: 假, 文字: "HMYR-內-011 nothing read from '" + 全 + "'"}
  }
  返回 {ok: 真, 文字: 跑模块族(读.源码批, 参册)}
}

// ---- 命令行入口：第三步的第一半 ----
//
// 这一段以前是宿主的 bin/hmyr.mjs 在做：取 argv、把路径拆成目录与名字、打印、定退出码。
// 四件事里没有一件是「关于宿主的知识」——它们都是「一个语言怎么当程序用」。
//
// 于是现在由 HMYR 自己做完，而宿主只剩「把自举那一层读进来」与「把 argv 递过去」。

// 最后一个路径分隔符的位置。认 / 与反斜杠两种，因为这台机器两种都会见到。
函数 最后一个分隔从(路: String, i: Int, 末: Int) -> Int {
  若 i >= len(路) { 返回 末 }
  定 c = 路[i]
  若 c == "/" || c == chr(92) { 返回 最后一个分隔从(路, i + 1, i) }
  返回 最后一个分隔从(路, i + 1, 末)
}

函数 拆目录(路: String) -> String {
  定 at = 最后一个分隔从(路, 0, -1)
  若 at < 0 { 返回 "." }
  若 at == 0 { 返回 slice(路, 0, 1) }
  返回 slice(路, 0, at)
}

函数 拆名字(路: String) -> String {
  定 at = 最后一个分隔从(路, 0, -1)
  若 at < 0 { 返回 路 }
  返回 slice(路, at + 1, len(路))
}

// 交回退出码：0 表示跑通了，1 表示读不到或跑不动，2 表示参数不对。
// 三个码与以前那个启动器一致——换主体不该悄悄改对外行为。
函数 命令行入口() -> Int 效果串(process, file) {
  定 参册 = argv()
  // 两条通道：答案走 print，用法与失败走 print_err。
  // 分开之后，"把答案重定向出去"就不必担心顺手把用法也塞进那个文件。
  若 len(参册) < 2 {
    print_err("用法：hmyr <file.hmyr>" + chr(10))
    返回 2
  }
  定 目标 = 参册[1]
  定 果 = 跑文件入口(拆目录(目标), 拆名字(目标), 目标程序参数(参册, 1, ()))
  若 果.ok == 假 {
    print_err(果.文字 + chr(10))
    返回 1
  }
  print(果.文字 + chr(10))
  返回 0
}

// ---- 编自己：语法层的那一半 ----
//
// 「一门语言能不能编译它自己」是第三步的核心问题，而它可以拆成一个能验的问题：
// 把 HMYR 的源码交给 HMYR，它算出来的函数名集合，与宿主算出来的对不对得上。
//
// 这一件只做语法那一半（名字），求值那一半由「跑 main」验。
// 两半都对，才说得上「它认得自己」。

函数 函数名从(函数族: Int, i: Int, acc: Int) -> Int {
  若 i >= len(函数族) { 返回 acc }
  返回 函数名从(函数族, i + 1, acc + (函数族[i][0],))
}

// 一段源码声明了哪些函数名，按出现的顺序。
函数 函数名册(源码: String) -> Int {
  定 全部 = parse_decls(scan_lines(源码))
  返回 函数名从(全部.fns, 0, ())
}

// 给适配层用的公开入口（2026-11-01）。
//
// 为什么需要它：加载走 不是 公开，而 src/loader.mjs 的替身要跨模块叫它。
// 交回的是加载顺序（一个文件一行，从目录算起），不是语法树 —— 树由宿主的
// subset-parse 来建，形状才自动一致（design/FULLSELF.txt 第五节）。
// 出错时第一行以「错 」开头，后面是码与路径。
公开 函数 加载顺序公开(目录: String, 相对: String) -> String 效果串(file) {
  定 r = 加载走(目录, 相对, (), ())
  若 r.错 != "" { 返回 "错 " + r.错 + chr(10) }
  返回 拼行从(r.已载, 0, "")
}

函数 拼行从(们: Int, i: Int, acc: String) -> String {
  若 i >= len(们) { 返回 acc }
  返回 拼行从(们, i + 1, acc + 们[i] + chr(10))
}

// 只解析 的公开入口（2026-11-01）。
//
// 为什么需要它：加载走 里最后一步是 只解析，而探针要从别的模块问它一件事 ——
// 「把一段源码认下来」这一步本身会不会撑出几百层调用。它不是 公开，所以要这一行。
公开 函数 只解析公开(源码: String) -> String {
  返回 只解析(源码)
}
函数 main() -> Int 效果串(process) {
  print("1 + 2 * 3 → " + 跑("1 + 2 * 3") + "\n")
  print("(1 + 2) * 3 → " + 跑("(1 + 2) * 3") + "\n")
  print("len(\"abcd\") → " + 跑("len(\"abcd\")") + "\n")
  print("10 % 4 → " + 跑("10 % 4") + "\n")
  // 2026-11-01：加一段「在板子上自己编译并执行」的正面判据。
  //
  // 为什么它比上面四行硬：上面四行跑的是写在这份源码里的表达式，所以板子跑通了
  // 只证明「回声正确」。这一段是一整份程序 —— 有 函数 声明、有 print、有自己的
  // 返回值 —— 而它在这次编译之前并不存在。板子把它编出来、跑起来、交回 42，
  // 那才是「板子上能自己编译源码」（design/BOARD.txt 第二十九节）。
  //
  // 而它只用到子集里有的东西：求值器的调用只认内置（见上面 跑程序文字 的注释），
  // 所以这里不写用户函数调用 —— 那一条限制属于自举层，不属于规范。
  // 它自己会 print 一行 42，那就是判据；返回值不打印，因为裸语句没有 返回，
  // 交回来的是空元组 —— 那一条是 跑程序文字 的语义，不是这次要验的东西。
  print("新程序 →\n")
  跑程序文字("print(str(6 * 7) + chr(10))\n")
  返回 0
}
