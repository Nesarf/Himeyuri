// inflate：deflate 的解码侧。认两种块：stored（BTYPE=00）与固定 Huffman（BTYPE=01）。
//
// 位序是这一件最要紧的地方，两条规则各管一半：
//   Huffman 码   先读到的位是码的最高位 —— 用「左移」读（读msb）
//   额外位       先读到的位是值的最低位 —— 用「右移」读（读lsb）
// 弄反任何一条，解出来的东西都会在第一个匹配处错开 —— 而那种错的症状是
// 「长度对、内容不对」，比崩溃更难查。
//
// 多块：结束码 256 只结束当前块，不是整个流。BFINAL=0 就得接着读下一块的头 ——
// 少了这一层，四十万字节的流会在十一万字节处静悄悄地停，而且返回成功。
//
// 输出块化：每 1024 字节封一块，复制时按逻辑下标取。逐字节往一个元组上拼是平方级，
// 四万三千字节就会把内存顶到上限 —— 这一条是量出来的，不是猜的。
//
// 用法：hmyr self/inflate.hmyr <deflate 流> <输出>

函数 取位(状: Int) {
  var 当前 = 状.当前
  var 已 = 状.已
  var at = 状.位置
  若 已 == 0 {
    若 at >= len(状.字节串) { 返回 {位: 0, 状: 状} }
    当前 = to_int(状.字节串[at])
    at = at + 1
    已 = 8
  }
  定 位 = 当前 % 2
  返回 {位: 位, 状: {字节串: 状.字节串, 位置: at, 当前: (当前 - 位) / 2, 已: 已 - 1}}
}

// 高位先读：第一个位进最高位。
函数 读msb(状: Int, n: Int) {
  var 值 = 0
  var s = 状
  var i = 0
  当 i < n {
    定 g = 取位(s)
    值 = 值 * 2 + g.位
    s = g.状
    i = i + 1
  }
  返回 {值: 值, 状: s}
}

// 低位先读：第一个位进最低位。额外位走这一条。
函数 读lsb(状: Int, n: Int) {
  var 值 = 0
  var 倍 = 1
  var s = 状
  var i = 0
  当 i < n {
    定 g = 取位(s)
    值 = 值 + g.位 * 倍
    倍 = 倍 * 2
    s = g.状
    i = i + 1
  }
  返回 {值: 值, 状: s}
}

// 固定 Huffman 的符号码：7 位不够就再读一位，再不够就第九位。
函数 解符号(状: Int) {
  定 a = 读msb(状, 7)
  若 a.值 <= 23 { 返回 {码: 256 + a.值, 状: a.状} }
  定 b = 读msb(a.状, 1)
  定 v8 = a.值 * 2 + b.值
  若 v8 >= 48 && v8 <= 191 { 返回 {码: v8 - 48, 状: b.状} }
  若 v8 >= 192 && v8 <= 199 { 返回 {码: 280 + (v8 - 192), 状: b.状} }
  定 c = 读msb(b.状, 1)
  定 v9 = v8 * 2 + c.值
  返回 {码: 144 + (v9 - 400), 状: c.状}
}

// 每一项是 (基值, 码, 额外位)。与 self/deflate.hmyr 里的那两张表同一份。
函数 长表() {
  返回 ((3, 257, 0), (4, 258, 0), (5, 259, 0), (6, 260, 0), (7, 261, 0), (8, 262, 0), (9, 263, 0), (10, 264, 0),
    (11, 265, 1), (13, 266, 1), (15, 267, 1), (17, 268, 1), (19, 269, 2), (23, 270, 2), (27, 271, 2), (31, 272, 2),
    (35, 273, 3), (43, 274, 3), (51, 275, 3), (59, 276, 3), (67, 277, 4), (83, 278, 4), (99, 279, 4), (115, 280, 4),
    (131, 281, 5), (163, 282, 5), (195, 283, 5), (227, 284, 5), (258, 285, 0))
}

函数 距表() {
  返回 ((1, 0, 0), (2, 1, 0), (3, 2, 0), (4, 3, 0), (5, 4, 1), (7, 5, 1), (9, 6, 2), (13, 7, 2),
    (17, 8, 3), (25, 9, 3), (33, 10, 4), (49, 11, 4), (65, 12, 5), (97, 13, 5), (129, 14, 6), (193, 15, 6),
    (257, 16, 7), (385, 17, 7), (513, 18, 8), (769, 19, 8), (1025, 20, 9), (1537, 21, 9), (2049, 22, 10), (3073, 23, 10),
    (4097, 24, 11), (6145, 25, 11), (8193, 26, 12), (12289, 27, 12), (16385, 28, 13), (24577, 29, 13))
}

函数 按码查(表: Int, 码: Int) -> Int {
  var i = 0
  当 i < len(表) {
    若 表[i][1] == 码 { 返回 表[i] }
    i = i + 1
  }
  返回 表[0]
}

函数 解距(状: Int) {
  定 a = 读msb(状, 5)
  定 项 = 按码查(距表(), a.值)
  定 余 = 读lsb(a.状, 项[2])
  返回 {值: 项[0] + 余.值, 状: 余.状}
}

// 折半拼接：元组的 + 是复制，逐块拼是平方级。
函数 拼平(块堆: Int, 起: Int, 止: Int) -> Int {
  若 止 - 起 <= 1 { 返回 块堆[起] }
  var 左 = 起
  var 右 = 止
  当 右 - 左 > 2 {
    左 = 左 + 1
    右 = 右 - 1
  }
  定 中 = 左 + 1
  返回 拼平(块堆, 起, 中) + 拼平(块堆, 中, 止)
}

// 按逻辑下标取一个已经输出的字节：先看已封的块，再看当前那一块。
函数 取出(块堆: Int, 出: Int, i: Int) -> Int {
  定 块大 = 1024
  定 块号 = (i - i % 块大) / 块大
  若 块号 < len(块堆) { 返回 to_int(块堆[块号][i % 块大]) }
  返回 to_int(出[i - len(块堆) * 块大])
}

// ---- 动态 Huffman（BTYPE=10）：码表在流里 ----

// 元组不可变，所以「改一项」是重建。码长表最多十九项、符号表最多三百一十八项 —— 够用。
函数 置(元组: Int, 下标: Int, 值: Int) -> Int {
  var 出 = ()
  var i = 0
  当 i < len(元组) {
    若 i == 下标 { 出 = 出 + (值,) } 否则 { 出 = 出 + (to_int(元组[i]),) }
    i = i + 1
  }
  返回 出
}

函数 切片(元组: Int, 起: Int, 止: Int) {
  var 出 = ()
  var i = 起
  当 i < 止 {
    出 = 出 + (to_int(元组[i]),)
    i = i + 1
  }
  返回 出
}

// 每个长度（0-15）上有几个码。
函数 计数(长簇: Int) {
  var 数 = ()
  var i = 0
  当 i <= 15 {
    数 = 数 + (0,)
    i = i + 1
  }
  i = 0
  当 i < len(长簇) {
    定 l = to_int(长簇[i])
    若 l > 0 { 数 = 置(数, l, to_int(数[l]) + 1) }
    i = i + 1
  }
  返回 数
}

// 长度 l 的第一个规范码：首[l+1] = (首[l] + 数[l]) * 2。
函数 首码们(数: Int) {
  var 首 = (0,)
  var 码 = 0
  var 长 = 0
  当 长 < 15 {
    码 = (码 + to_int(数[长])) * 2
    首 = 首 + (码,)
    长 = 长 + 1
  }
  返回 首
}

// 用一张规范码表读一个符号：逐位读，位长了就查「这个长度的第几个」。
函数 解规范(状: Int, 长簇: Int, 数: Int, 首: Int) {
  var 码 = 0
  var 长 = 0
  var s = 状
  当 长 < 15 {
    定 g = 读msb(s, 1)
    码 = 码 * 2 + g.值
    长 = 长 + 1
    s = g.状
    定 本 = to_int(数[长])
    若 本 > 0 {
      定 基 = to_int(首[长])
      若 码 >= 基 && 码 < 基 + 本 {
        var 序 = 码 - 基
        var i = 0
        当 i < len(长簇) {
          若 to_int(长簇[i]) == 长 {
            若 序 == 0 { 返回 {符号: i, 状: s} }
            序 = 序 - 1
          }
          i = i + 1
        }
      }
    }
  }
  返回 {符号: 0, 状: s}
}

// 读三组计数：字面/长度的码数、距离的码数、码长码的码数。
函数 读计数(状: Int) {
  定 a = 读lsb(状, 5)
  定 b = 读lsb(a.状, 5)
  定 c = 读lsb(b.状, 4)
  返回 {字长数: a.值 + 257, 距长数: b.值 + 1, 码长码数: c.值 + 4, 状: c.状}
}

// 读十九个码长码，按 RFC 的固定顺序填进去。
函数 读码长码(状: Int, 个数: Int) {
  定 顺 = (16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15)
  var 长簇 = ()
  var i = 0
  当 i < 19 {
    长簇 = 长簇 + (0,)
    i = i + 1
  }
  var s = 状
  i = 0
  当 i < 个数 {
    定 g = 读lsb(s, 3)
    s = g.状
    长簇 = 置(长簇, to_int(顺[i]), g.值)
    i = i + 1
  }
  返回 {长簇: 长簇, 状: s}
}

// 用码长码表解码 总数 个码长；16/17/18 是重复。
函数 读码长簇(状: Int, 长簇19: Int, 总数: Int) {
  定 数 = 计数(长簇19)
  定 首 = 首码们(数)
  var 长簇 = ()
  var s = 状
  当 len(长簇) < 总数 {
    定 r = 解规范(s, 长簇19, 数, 首)
    s = r.状
    定 符 = r.符号
    若 符 < 16 {
      长簇 = 长簇 + (符,)
    } 否则 若 符 == 16 {
      定 g = 读lsb(s, 2)
      s = g.状
      定 前 = to_int(长簇[len(长簇) - 1])
      var k = 0
      当 k < g.值 + 3 {
        长簇 = 长簇 + (前,)
        k = k + 1
      }
    } 否则 若 符 == 17 {
      定 g = 读lsb(s, 3)
      s = g.状
      var k = 0
      当 k < g.值 + 3 {
        长簇 = 长簇 + (0,)
        k = k + 1
      }
    } 否则 {
      定 g = 读lsb(s, 7)
      s = g.状
      var k = 0
      当 k < g.值 + 11 {
        长簇 = 长簇 + (0,)
        k = k + 1
      }
    }
  }
  返回 {长簇: 长簇, 状: s}
}

// 一个动态块：码表在流里，解完码表再解数据。
函数 解动块(状: Int, 块堆: Int, 出: Int) {
  定 计 = 读计数(状)
  定 码长 = 读码长码(计.状, 计.码长码数)
  定 总 = 计.字长数 + 计.距长数
  定 读 = 读码长簇(码长.状, 码长.长簇, 总)
  定 字长 = 切片(读.长簇, 0, 计.字长数)
  定 距长 = 切片(读.长簇, 计.字长数, 总)
  定 字数 = 计数(字长)
  定 字首 = 首码们(字数)
  定 距数 = 计数(距长)
  定 距首 = 首码们(距数)
  var s = 读.状
  var 块 = 块堆
  var 当前 = 出
  var 完 = 假
  当 !完 {
    定 符 = 解规范(s, 字长, 字数, 字首)
    s = 符.状
    若 符.符号 == 256 {
      完 = 真
    } 否则 若 符.符号 < 256 {
      当前 = 当前 + (符.符号,)
      若 len(当前) >= 1024 {
        块 = 块 + (当前,)
        当前 = ()
      }
    } 否则 {
      定 长项 = 按码查(长表(), 符.符号)
      定 余 = 读lsb(s, 长项[2])
      s = 余.状
      定 长度 = 长项[0] + 余.值
      定 距符 = 解规范(s, 距长, 距数, 距首)
      s = 距符.状
      定 距项 = 按码查(距表(), 距符.符号)
      定 距余 = 读lsb(s, 距项[2])
      s = 距余.状
      定 距值 = 距项[0] + 距余.值
      定 基 = len(块) * 1024 + len(当前) - 距值
      var k = 0
      当 k < 长度 {
        当前 = 当前 + (取出(块, 当前, 基 + k),)
        若 len(当前) >= 1024 {
          块 = 块 + (当前,)
          当前 = ()
        }
        k = k + 1
      }
    }
  }
  返回 {状: s, 块堆: 块, 出: 当前}
}


// 一个 Huffman 块：解到结束码 256 为止。
函数 解一块(状: Int, 块堆: Int, 出: Int) {
  var s = 状
  var 块 = 块堆
  var 当前 = 出
  var 完 = 假
  当 !完 {
    定 符 = 解符号(s)
    s = 符.状
    若 符.码 == 256 {
      完 = 真
    } 否则 若 符.码 < 256 {
      当前 = 当前 + (符.码,)
      若 len(当前) >= 1024 {
        块 = 块 + (当前,)
        当前 = ()
      }
    } 否则 {
      定 长项 = 按码查(长表(), 符.码)
      定 余 = 读lsb(s, 长项[2])
      s = 余.状
      定 长度 = 长项[0] + 余.值
      定 距 = 解距(s)
      s = 距.状
      // 基点在循环外算定：复制时输出在变长，若每轮重算长度，源下标会一路往后漂。
      定 基 = len(块) * 1024 + len(当前) - 距.值
      var k = 0
      当 k < 长度 {
        当前 = 当前 + (取出(块, 当前, 基 + k),)
        若 len(当前) >= 1024 {
          块 = 块 + (当前,)
          当前 = ()
        }
        k = k + 1
      }
    }
  }
  返回 {状: s, 块堆: 块, 出: 当前}
}

// 一个 stored 块：先对齐到字节边界，再读 LEN / NLEN / 数据。
函数 解存块(状: Int, 块堆: Int, 出: Int) {
  var 字节串 = 状.字节串
  var at = 状.位置
  var 块 = 块堆
  var 当前 = 出
  若 at + 4 <= len(字节串) {
    定 长 = to_int(字节串[at]) + to_int(字节串[at + 1]) * 256
    at = at + 4
    var i = 0
    当 i < 长 && at < len(字节串) {
      当前 = 当前 + (to_int(字节串[at]),)
      若 len(当前) >= 1024 {
        块 = 块 + (当前,)
        当前 = ()
      }
      at = at + 1
      i = i + 1
    }
  }
  返回 {状: {字节串: 字节串, 位置: at, 当前: 0, 已: 0}, 块堆: 块, 出: 当前}
}

// 只看码长：读头、读计数、读码长表，打印前几个就停 —— 查码表层的事用它。
函数 打码长(字节串: Int) {
  var 状 = {字节串: 字节串, 位置: 0, 当前: 0, 已: 0}
  定 头 = 读lsb(状, 3)
  状 = 头.状
  定 末 = 头.值 % 2
  定 型 = (头.值 - 末) / 2 % 4
  若 型 != 2 {
    print("不是动态块（BTYPE=" + str(型) + "）" + chr(10))
    返回 0
  }
  定 计 = 读计数(状)
  print("HLIT=" + str(计.字长数) + " HDIST=" + str(计.距长数) + " HCLEN=" + str(计.码长码数) + chr(10))
  定 码长 = 读码长码(计.状, 计.码长码数)
  print("码长码表：" + str(码长.长簇) + chr(10))
  定 读 = 读码长簇(码长.状, 码长.长簇, 计.字长数 + 计.距长数)
  var i = 0
  var 前 = ""
  当 i < len(读.长簇) && i < 40 {
    前 = 前 + str(to_int(读.长簇[i])) + " "
    i = i + 1
  }
  print("前四十个码长：" + 前 + chr(10))
  返回 0
}


// 主循环：一块一块读，BFINAL=1 才停。
函数 解固定(字节串: Int) {
  var 状 = {字节串: 字节串, 位置: 0, 当前: 0, 已: 0}
  var 块堆 = ()
  var 出 = ()
  var 全完 = 假
  当 !全完 {
    定 头 = 读lsb(状, 3)
    状 = 头.状
    定 末 = 头.值 % 2
    定 型 = (头.值 - 末) / 2 % 4
    若 型 == 0 {
      定 r = 解存块(状, 块堆, 出)
      状 = r.状
      块堆 = r.块堆
      出 = r.出
      若 末 == 1 { 全完 = 真 }
    } 否则 若 型 == 1 {
      定 r = 解一块(状, 块堆, 出)
      状 = r.状
      块堆 = r.块堆
      出 = r.出
      若 末 == 1 { 全完 = 真 }
    } 否则 若 型 == 2 {
      定 r = 解动块(状, 块堆, 出)
      状 = r.状
      块堆 = r.块堆
      出 = r.出
      若 末 == 1 { 全完 = 真 }
    } 否则 {
      // BTYPE=11 是保留值。停下，而不是解出一段悄悄错的东西。
      全完 = 真
    }
  }
  若 len(出) > 0 { 块堆 = 块堆 + (出,) }
  若 len(块堆) == 0 { 返回 () }
  返回 拼平(块堆, 0, len(块堆))
}

函数 main() -> Int 效果串(file) {
  定 参 = argv()
  若 len(参) < 3 {
    print("用法：hmyr self/inflate.hmyr <deflate 流> <输出>" + chr(10))
    返回 2
  }
  定 字节串 = read_bytes(参[1])
  var 看码长 = 假
  var i = 0
  当 i < len(参) {
    若 参[i] == "--码长" { 看码长 = 真 }
    i = i + 1
  }
  若 看码长 { 返回 打码长(字节串) }
  定 出 = 解固定(字节串)
  write_bytes(参[2], 出)
  print(str(len(字节串)) + " → " + str(len(出)) + chr(10))
  返回 0
}
