// inflate：deflate 的解码侧。认两种块：stored（BTYPE=00）与固定 Huffman（BTYPE=01）。
//
// 位序是这一件最要紧的地方，两条规则各管一半：
//   Huffman 码   先读到的位是码的最高位 —— 用「左移」读（读msb）
//   额外位       先读到的位是值的最低位 —— 用「右移」读（读lsb）
// 弄反任何一条，解出来的东西都会在第一个匹配处错开 —— 而那种错的症状是
// 「长度对、内容不对」，比崩溃更难查。
//
// 多块：结束码 256 只结束当前块，不是整个流。BFINAL=0 就得接着读下一块的头 ——
// 少了这一层，四十万字节的流会在十一万字节处静悄悄地停，而且返回成功。
//
// 输出块化：每 1024 字节封一块，复制时按逻辑下标取。逐字节往一个元组上拼是平方级，
// 四万三千字节就会把内存顶到上限 —— 这一条是量出来的，不是猜的。
//
// 用法：hmyr self/inflate.hmyr <deflate 流> <输出>

// 读 msb / 读 lsb：位流状态在函数内部摊成四个局部变量。
//
// 原来每读一位都调用一次 取位，而 取位 每一趟造两个记录 —— 一个 {位, 状}，
// 另一个是里面那个四字段的 状 本身。固定 Huffman 解一个字节要读七到九位，
// 于是每字节造十六个记录，而一次读位的真正工作只有「除二取余」两下。
// 2026-11-03 改：循环里只碰局部变量，整个调用结束时才把状态装回一个记录。
//
// 流耗尽时位按 0 算、状态不动 —— 与原来 取位 的边界行为逐字相同：
// 已 到 0 而 at 已经走到尽头，那时 位 留 0，at 与 已 都不再变。

// 高位先读：第一个位进最高位。
函数 读msb(状: Int, n: Int) {
  变 值 = 0
  变 字节串 = 状.字节串
  变 at = 状.位置
  变 当前 = 状.当前
  变 已 = 状.已
  变 i = 0
  当 i < n {
    变 位 = 0
    若 已 == 0 {
      若 at < len(字节串) {
        当前 = to_int(字节串[at])
        at = at + 1
        已 = 8
      }
    }
    若 已 > 0 {
      位 = 当前 % 2
      当前 = (当前 - 位) / 2
      已 = 已 - 1
    }
    值 = 值 * 2 + 位
    i = i + 1
  }
  返回 {值: 值, 状: {字节串: 字节串, 位置: at, 当前: 当前, 已: 已, 表: 状.表}}
}

// 低位先读：一次取 n 位就是缓冲的低 n 位，不需要一位一位走。
//
// 补位保证缓冲里至少有 n 位；流尾不够时高位按零算，与逐位读的旧行为一样
// （旧版读到尽头就给 0 位、不再前进，所以值相同）。已 不许走到负数 ——
// 走到负的会让下一次补位算出荒唐的位移量。
函数 读lsb(状: Int, n: Int) {
  定 b = 补位(状, n)
  定 掩 = 位循环左移(1, n)
  定 低 = b.当前 % 掩
  变 剩 = b.已 - n
  若 剩 < 0 { 剩 = 0 }
  返回 {值: 低, 状: {字节串: b.字节串, 位置: b.位置, 当前: (b.当前 - 低) / 掩, 已: 剩, 表: b.表}}
}

// ---- 固定 Huffman 的查表解码 ----
//
// 原来解一个符号要逐位读七到九次，再按三段分支判断。量出来的账是每符号约五百步，
// 而输出一个字节才五十四步 —— 解码占了全部时间的四分之三。逐位读本身没问题，
// 问题是「一次只读一位」：九位就是九个循环，每个循环十几条指令。
//
// 现在一次取九位：位缓冲 当前 本来就是低位先出，所以「前九位」就是 当前 % 512，
// 一句就够。查表得到 (符号, 位数)，再按位数把那几位移出去。补位一次最多补一个字节，
// 而取九位要看两到三个字节。
//
// 表按「低位先出」建：一个 msb 序的码 C 长度 k，它在缓冲里占低 k 位、且是反过来的，
// 所以填表前要先反转 k 位。

// n 个 (0, 0) 的可变数组。表只建一次，用数组是因为 设 是 O(1) —— 元组拼五百项是平方级。
函数 空簇(n: Int) {
  变 出 = ()
  变 i = 0
  当 i < n {
    出 = 出 + ((0, 0),)
    i = i + 1
  }
  返回 数组(出)
}

// 反转低 n 位。
函数 反转(c: Int, n: Int) {
  变 出 = 0
  变 值 = c
  变 i = 0
  当 i < n {
    定 位 = 值 % 2
    出 = 出 * 2 + 位
    值 = (值 - 位) / 2
    i = i + 1
  }
  返回 出
}

// 固定 Huffman 的九位查找表：表[x] = (符号, 位数)。
// 三段码各有覆盖的九位模式数：七位的每个占四格、八位占两格、九位占一格。
// 填的顺序是九位、八位、七位 —— 让短码最后落地。前缀无关保证互不重叠，
// 这个顺序只是让「万一重叠」时短的那个赢。
函数 造固定表() {
  变 表 = 空簇(512)
  变 i = 0
  当 i < 112 {
    定 r = 反转(400 + i, 9)
    设(表, r, (144 + i, 9))
    i = i + 1
  }
  i = 0
  当 i < 144 {
    定 r = 反转(48 + i, 8)
    设(表, r, (i, 8))
    设(表, r + 256, (i, 8))
    i = i + 1
  }
  i = 0
  当 i < 8 {
    定 r = 反转(192 + i, 8)
    设(表, r, (280 + i, 8))
    设(表, r + 256, (280 + i, 8))
    i = i + 1
  }
  i = 0
  当 i < 24 {
    定 r = 反转(i, 7)
    设(表, r, (256 + i, 7))
    设(表, r + 128, (256 + i, 7))
    设(表, r + 256, (256 + i, 7))
    设(表, r + 384, (256 + i, 7))
    i = i + 1
  }
  定 原距 = 距表()
  变 距反 = ()
  变 j = 0
  当 j < 32 {
    变 下 = 反转(j, 5)
    若 下 >= 30 { 下 = 0 }
    距反 = 距反 + (原距[下],)
    j = j + 1
  }
  返回 {固定: 表, 长项: 长表(), 距项: 原距, 距反: 距反}
}

// 补到至少 需 位（或到流尾）。一次补一个字节，新字节放在已有位的上面。
函数 补位(状: Int, 需: Int) {
  变 字节串 = 状.字节串
  变 at = 状.位置
  变 当前 = 状.当前
  变 已 = 状.已
  当 已 < 需 && at < len(字节串) {
    当前 = 当前 + to_int(字节串[at]) * 位循环左移(1, 已)
    at = at + 1
    已 = 已 + 8
  }
  返回 {字节串: 字节串, 位置: at, 当前: 当前, 已: 已, 表: 状.表}
}

// 固定 Huffman 的符号：补位、取九位、查表、移出那几位。
// 九位表里最短的码是七位，所以补到九位一定够一个符号；流尾不足时高位按零算，
// 全零的九位模式落在结束码 256 上（七位码 0），于是它自己会停。
函数 解符号(状: Int) {
  定 b = 补位(状, 9)
  定 项 = b.表.固定[b.当前 % 512]
  定 长 = to_int(项[1])
  定 掩 = 位循环左移(1, 长)
  返回 {码: to_int(项[0]),
    状: {字节串: b.字节串, 位置: b.位置, 当前: (b.当前 - b.当前 % 掩) / 掩, 已: b.已 - 长, 表: b.表}}
}

// 每一项是 (基值, 码, 额外位)。与 self/deflate.hmyr 里的那两张表同一份。
函数 长表() {
  返回 ((3, 257, 0), (4, 258, 0), (5, 259, 0), (6, 260, 0), (7, 261, 0), (8, 262, 0), (9, 263, 0), (10, 264, 0),
    (11, 265, 1), (13, 266, 1), (15, 267, 1), (17, 268, 1), (19, 269, 2), (23, 270, 2), (27, 271, 2), (31, 272, 2),
    (35, 273, 3), (43, 274, 3), (51, 275, 3), (59, 276, 3), (67, 277, 4), (83, 278, 4), (99, 279, 4), (115, 280, 4),
    (131, 281, 5), (163, 282, 5), (195, 283, 5), (227, 284, 5), (258, 285, 0))
}

函数 距表() {
  返回 ((1, 0, 0), (2, 1, 0), (3, 2, 0), (4, 3, 0), (5, 4, 1), (7, 5, 1), (9, 6, 2), (13, 7, 2),
    (17, 8, 3), (25, 9, 3), (33, 10, 4), (49, 11, 4), (65, 12, 5), (97, 13, 5), (129, 14, 6), (193, 15, 6),
    (257, 16, 7), (385, 17, 7), (513, 18, 8), (769, 19, 8), (1025, 20, 9), (1537, 21, 9), (2049, 22, 10), (3073, 23, 10),
    (4097, 24, 11), (6145, 25, 11), (8193, 26, 12), (12289, 27, 12), (16385, 28, 13), (24577, 29, 13))
}

// 按码查 在这里退休了（2026-11-03）：它的用处是拿码去表里线性找那一项，而两张表的
// 键正好就是下标 —— 长表按 码减 257、距表按 码本身。于是每个回引不必先重建一遍
// 二十九项的元组、再扫一半才找到，直接下标就够。两张表跟着 造固定表 一次建好。

// 距离：五个位一次取出，拿反序表直接查（缓冲里先读到的位在低位，而距离码是高位先写的，
// 所以 距反 是按反转排好的那三十项）。30 与 31 是保留值 —— 原来「查不到就用第一项」
// 那个兜底行为，在建表时就已经折进去了。
函数 解距(状: Int) {
  定 a = 读lsb(状, 5)
  定 项 = 状.表.距反[a.值]
  定 余 = 读lsb(a.状, 项[2])
  返回 {值: 项[0] + 余.值, 状: 余.状}
}

// 折半拼接：元组的 + 是复制，逐块拼是平方级。
函数 拼平(块堆: Int, 起: Int, 止: Int) -> Int {
  若 止 - 起 <= 1 { 返回 块堆[起] }
  变 左 = 起
  变 右 = 止
  当 右 - 左 > 2 {
    左 = 左 + 1
    右 = 右 - 1
  }
  定 中 = 左 + 1
  返回 拼平(块堆, 起, 中) + 拼平(块堆, 中, 止)
}

// 造槽：一个 1024 项的零数组，用来攒当前这一块的输出。
//
// 语言里没有数组字面量（数组只能从元组造出来，见 design/ARRAY.txt），
// 所以先拼一个 1024 项的零元组、再转一次 —— 整份流只造一次，这点代价可以不算。
函数 造槽() {
  变 出 = ()
  变 i = 0
  当 i < 1024 {
    出 = 出 + (0,)
    i = i + 1
  }
  返回 数组(出)
}

// 截：数组的前 n 项 → 元组。每封一块用一次，O(n) —— 而逐字节拼是 O(n^2)。
//
// 为什么输出那一块要用数组：元组的 + 是复制，而 1024 字节的块如果逐字节拼，
// 平均每块要搬 512 个元素的影子（约五十二万次复制）。四百二十块就是两亿多次 ——
// 那正是 inflate 在大流上慢一个量级的原因。数组用 设 直接写，封块时只转一次。
// 2026-11-03 改。
函数 截(数组: Int, n: Int) {
  变 出 = ()
  变 i = 0
  当 i < n {
    出 = 出 + (数组[i],)
    i = i + 1
  }
  返回 出
}

// 按逻辑下标取一个已经输出的字节：先看已封的块，再看当前那一块（数组，按下标读）。
//
// 当前那一块是定长 1024 的数组，所以块内偏移直接算，不必知道「填了几个」——
// 回引的源下标永远小于写下标（距离至少 1），读到的都是已经写出去的位置。
函数 取出(块堆: Int, 槽: Int, i: Int) -> Int {
  定 块大 = 1024
  定 块号 = (i - i % 块大) / 块大
  若 块号 < len(块堆) { 返回 to_int(块堆[块号][i % 块大]) }
  返回 to_int(槽[i - len(块堆) * 块大])
}

// ---- 动态 Huffman（BTYPE=10）：码表在流里 ----

// 元组不可变，所以「改一项」是重建。码长表最多十九项、符号表最多三百一十八项 —— 够用。
函数 置(元组: Int, 下标: Int, 值: Int) -> Int {
  变 出 = ()
  变 i = 0
  当 i < len(元组) {
    若 i == 下标 { 出 = 出 + (值,) } 否则 { 出 = 出 + (to_int(元组[i]),) }
    i = i + 1
  }
  返回 出
}

函数 切片(元组: Int, 起: Int, 止: Int) {
  变 出 = ()
  变 i = 起
  当 i < 止 {
    出 = 出 + (to_int(元组[i]),)
    i = i + 1
  }
  返回 出
}

// 每个长度（0-15）上有几个码。
函数 计数(长簇: Int) {
  变 数 = ()
  变 i = 0
  当 i <= 15 {
    数 = 数 + (0,)
    i = i + 1
  }
  i = 0
  当 i < len(长簇) {
    定 l = to_int(长簇[i])
    若 l > 0 { 数 = 置(数, l, to_int(数[l]) + 1) }
    i = i + 1
  }
  返回 数
}

// 长度 l 的第一个规范码：首[l+1] = (首[l] + 数[l]) * 2。
函数 首码簇(数: Int) {
  变 首 = (0,)
  变 码 = 0
  变 长 = 0
  当 长 < 15 {
    码 = (码 + to_int(数[长])) * 2
    首 = 首 + (码,)
    长 = 长 + 1
  }
  返回 首
}

// 规范码的九位表：表[x] = (符号, 位数)。九位装不下的码（长度 10 到 15）留 (0, 0)。
//
// 码表在流里，所以这张表要按块建，不能像固定块那样建一次用到底。建表按长度从小到大
// 走，每个长度只扫一遍 长簇；总填充量不超过五百一十二项（前缀码的份额之和不大于一）。
函数 造规范表(长簇: Int, 数: Int, 首: Int) {
  变 表 = 空簇(512)
  变 长 = 1
  当 长 <= 9 {
    定 本 = to_int(数[长])
    若 本 > 0 {
      变 序 = 0
      变 i = 0
      当 i < len(长簇) && 序 < 本 {
        若 to_int(长簇[i]) == 长 {
          定 r = 反转(to_int(首[长]) + 序, 长)
          定 倍 = 位循环左移(1, 长)
          变 x = r
          当 x < 512 {
            设(表, x, (i, 长))
            x = x + 倍
          }
          序 = 序 + 1
        }
        i = i + 1
      }
    }
    长 = 长 + 1
  }
  返回 表
}

// 用一张规范码表读一个符号。
//
// 快路：九位表。这与 解符号 在固定块上用的是同一个招式 —— 位缓冲低位先出，
// 前九位就是取余。慢路：九位装不下的长码在表里留空，退回逐位读；补位 已经把
// 那九位留在缓冲里，所以状态不用回退。
//
// 慢路里那一趟「扫 长簇 找第几个同长度的符号」是三百一十八项，而快路完全绕过它 ——
// 这条是量出来的：动态块原来每输出一个字节要七百五十步，是固定块的六点七倍。
函数 解规范(状: Int, 长簇: Int, 数: Int, 首: Int, 表: Int) {
  定 b = 补位(状, 9)
  定 项 = 表[b.当前 % 512]
  定 快长 = to_int(项[1])
  若 快长 > 0 {
    定 掩 = 位循环左移(1, 快长)
    变 剩 = b.已 - 快长
    若 剩 < 0 { 剩 = 0 }
    返回 {符号: to_int(项[0]),
      状: {字节串: b.字节串, 位置: b.位置, 当前: (b.当前 - b.当前 % 掩) / 掩, 已: 剩, 表: b.表}}
  }
  变 码 = 0
  变 长 = 0
  变 s = b
  当 长 < 15 {
    定 g = 读msb(s, 1)
    码 = 码 * 2 + g.值
    长 = 长 + 1
    s = g.状
    定 本 = to_int(数[长])
    若 本 > 0 {
      定 基 = to_int(首[长])
      若 码 >= 基 && 码 < 基 + 本 {
        变 序 = 码 - 基
        变 i = 0
        当 i < len(长簇) {
          若 to_int(长簇[i]) == 长 {
            若 序 == 0 { 返回 {符号: i, 状: s} }
            序 = 序 - 1
          }
          i = i + 1
        }
      }
    }
  }
  返回 {符号: 0, 状: s}
}

// 读三组计数：字面/长度的码数、距离的码数、码长码的码数。
函数 读计数(状: Int) {
  定 a = 读lsb(状, 5)
  定 b = 读lsb(a.状, 5)
  定 c = 读lsb(b.状, 4)
  返回 {字长数: a.值 + 257, 距长数: b.值 + 1, 码长码数: c.值 + 4, 状: c.状}
}

// 读十九个码长码，按 RFC 的固定顺序填进去。
函数 读码长码(状: Int, 个数: Int) {
  定 顺 = (16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15)
  变 长簇 = ()
  变 i = 0
  当 i < 19 {
    长簇 = 长簇 + (0,)
    i = i + 1
  }
  变 s = 状
  i = 0
  当 i < 个数 {
    定 g = 读lsb(s, 3)
    s = g.状
    长簇 = 置(长簇, to_int(顺[i]), g.值)
    i = i + 1
  }
  返回 {长簇: 长簇, 状: s}
}

// 用码长码表解码 总数 个码长；16/17/18 是重复。
函数 读码长簇(状: Int, 长簇19: Int, 总数: Int) {
  定 数 = 计数(长簇19)
  定 首 = 首码簇(数)
  定 表 = 造规范表(长簇19, 数, 首)
  变 长簇 = ()
  变 s = 状
  当 len(长簇) < 总数 {
    定 r = 解规范(s, 长簇19, 数, 首, 表)
    s = r.状
    定 符 = r.符号
    若 符 < 16 {
      长簇 = 长簇 + (符,)
    } 否则 若 符 == 16 {
      定 g = 读lsb(s, 2)
      s = g.状
      定 前 = to_int(长簇[len(长簇) - 1])
      变 k = 0
      当 k < g.值 + 3 {
        长簇 = 长簇 + (前,)
        k = k + 1
      }
    } 否则 若 符 == 17 {
      定 g = 读lsb(s, 3)
      s = g.状
      变 k = 0
      当 k < g.值 + 3 {
        长簇 = 长簇 + (0,)
        k = k + 1
      }
    } 否则 {
      定 g = 读lsb(s, 7)
      s = g.状
      变 k = 0
      当 k < g.值 + 11 {
        长簇 = 长簇 + (0,)
        k = k + 1
      }
    }
  }
  返回 {长簇: 长簇, 状: s}
}

// 一个动态块：码表在流里，解完码表再解数据。
//
// 槽 与 填 是「当前这一块」的两个半边：槽 是定长 1024 的数组（设 是 O(1)，原地改
// 同一份），填 是已经写了几个。封块时 截 一次转成元组，然后 填 归零。
// 填 走参数而不是记录：记录不可变，每写一个字节就重建一次记录，等于把这个平方项
// 从元组搬到了记录上。
函数 解动块(状: Int, 块堆: Int, 槽: Int, 填: Int) {
  定 计 = 读计数(状)
  定 码长 = 读码长码(计.状, 计.码长码数)
  定 总 = 计.字长数 + 计.距长数
  定 读 = 读码长簇(码长.状, 码长.长簇, 总)
  定 字长 = 切片(读.长簇, 0, 计.字长数)
  定 距长 = 切片(读.长簇, 计.字长数, 总)
  定 字数 = 计数(字长)
  定 字首 = 首码簇(字数)
  定 距数 = 计数(距长)
  定 距首 = 首码簇(距数)
  定 字表 = 造规范表(字长, 字数, 字首)
  定 距表 = 造规范表(距长, 距数, 距首)
  变 s = 读.状
  变 块 = 块堆
  变 数 = 填
  变 完 = 假
  当 !完 {
    定 符 = 解规范(s, 字长, 字数, 字首, 字表)
    s = 符.状
    若 符.符号 == 256 {
      完 = 真
    } 否则 若 符.符号 < 256 {
      设(槽, 数, 符.符号)
      数 = 数 + 1
      若 数 >= 1024 {
        块 = 块 + (截(槽, 1024),)
        数 = 0
      }
    } 否则 {
      变 下 = 符.符号 - 257
      若 下 > 28 { 下 = 0 }
      定 长项 = s.表.长项[下]
      定 余 = 读lsb(s, 长项[2])
      s = 余.状
      定 长度 = 长项[0] + 余.值
      定 距符 = 解规范(s, 距长, 距数, 距首, 距表)
      s = 距符.状
      变 距下 = 距符.符号
      若 距下 >= 30 { 距下 = 0 }
      定 距项 = s.表.距项[距下]
      定 距余 = 读lsb(s, 距项[2])
      s = 距余.状
      定 距值 = 距项[0] + 距余.值
      定 基 = len(块) * 1024 + 数 - 距值
      变 k = 0
      当 k < 长度 {
        设(槽, 数, 取出(块, 槽, 基 + k))
        数 = 数 + 1
        若 数 >= 1024 {
          块 = 块 + (截(槽, 1024),)
          数 = 0
        }
        k = k + 1
      }
    }
  }
  返回 {状: s, 块堆: 块, 填: 数}
}


// 一个 Huffman 块：解到结束码 256 为止。
函数 解一块(状: Int, 块堆: Int, 槽: Int, 填: Int) {
  变 s = 状
  变 块 = 块堆
  变 数 = 填
  变 完 = 假
  当 !完 {
    定 符 = 解符号(s)
    s = 符.状
    若 符.码 == 256 {
      完 = 真
    } 否则 若 符.码 < 256 {
      设(槽, 数, 符.码)
      数 = 数 + 1
      若 数 >= 1024 {
        块 = 块 + (截(槽, 1024),)
        数 = 0
      }
    } 否则 {
      变 下 = 符.码 - 257
      若 下 > 28 { 下 = 0 }
      定 长项 = s.表.长项[下]
      定 余 = 读lsb(s, 长项[2])
      s = 余.状
      定 长度 = 长项[0] + 余.值
      定 距 = 解距(s)
      s = 距.状
      // 基点在循环外算定：复制时输出在变长，若每轮重算长度，源下标会一路往后漂。
      定 基 = len(块) * 1024 + 数 - 距.值
      变 k = 0
      当 k < 长度 {
        设(槽, 数, 取出(块, 槽, 基 + k))
        数 = 数 + 1
        若 数 >= 1024 {
          块 = 块 + (截(槽, 1024),)
          数 = 0
        }
        k = k + 1
      }
    }
  }
  返回 {状: s, 块堆: 块, 填: 数}
}

// 一个 stored 块：先对齐到字节边界，再读 LEN / NLEN / 数据。
函数 解存块(状: Int, 块堆: Int, 槽: Int, 填: Int) {
  变 字节串 = 状.字节串
  变 at = 状.位置
  变 块 = 块堆
  变 数 = 填
  若 at + 4 <= len(字节串) {
    定 长 = to_int(字节串[at]) + to_int(字节串[at + 1]) * 256
    at = at + 4
    变 i = 0
    当 i < 长 && at < len(字节串) {
      设(槽, 数, to_int(字节串[at]))
      数 = 数 + 1
      若 数 >= 1024 {
        块 = 块 + (截(槽, 1024),)
        数 = 0
      }
      at = at + 1
      i = i + 1
    }
  }
  返回 {状: {字节串: 字节串, 位置: at, 当前: 0, 已: 0, 表: 状.表}, 块堆: 块, 填: 数}
}

// 只看码长：读头、读计数、读码长表，打印前几个就停 —— 查码表层的事用它。
函数 打码长(字节串: Int) {
  变 状 = {字节串: 字节串, 位置: 0, 当前: 0, 已: 0, 表: ()}
  定 头 = 读lsb(状, 3)
  状 = 头.状
  定 末 = 头.值 % 2
  定 型 = (头.值 - 末) / 2 % 4
  若 型 != 2 {
    print("不是动态块（BTYPE=" + str(型) + "）" + chr(10))
    返回 0
  }
  定 计 = 读计数(状)
  print("HLIT=" + str(计.字长数) + " HDIST=" + str(计.距长数) + " HCLEN=" + str(计.码长码数) + chr(10))
  定 码长 = 读码长码(计.状, 计.码长码数)
  print("码长码表：" + str(码长.长簇) + chr(10))
  定 读 = 读码长簇(码长.状, 码长.长簇, 计.字长数 + 计.距长数)
  变 i = 0
  变 前 = ""
  当 i < len(读.长簇) && i < 40 {
    前 = 前 + str(to_int(读.长簇[i])) + " "
    i = i + 1
  }
  print("前四十个码长：" + 前 + chr(10))
  返回 0
}


// 主循环：一块一块读，BFINAL=1 才停。
//
// 槽 造一次就用到底：数组是原地改的，三个分支交回来的都是同一份，
// 只有 填 要跟着接（它才是那个会变的数）。
函数 解固定(字节串: Int) {
  变 状 = {字节串: 字节串, 位置: 0, 当前: 0, 已: 0, 表: 造固定表()}
  变 块堆 = ()
  变 槽 = 造槽()
  变 填 = 0
  变 全完 = 假
  当 !全完 {
    定 头 = 读lsb(状, 3)
    状 = 头.状
    定 末 = 头.值 % 2
    定 型 = (头.值 - 末) / 2 % 4
    若 型 == 0 {
      定 r = 解存块(状, 块堆, 槽, 填)
      状 = r.状
      块堆 = r.块堆
      填 = r.填
      若 末 == 1 { 全完 = 真 }
    } 否则 若 型 == 1 {
      定 r = 解一块(状, 块堆, 槽, 填)
      状 = r.状
      块堆 = r.块堆
      填 = r.填
      若 末 == 1 { 全完 = 真 }
    } 否则 若 型 == 2 {
      定 r = 解动块(状, 块堆, 槽, 填)
      状 = r.状
      块堆 = r.块堆
      填 = r.填
      若 末 == 1 { 全完 = 真 }
    } 否则 {
      // BTYPE=11 是保留值。停下，而不是解出一段悄悄错的东西。
      全完 = 真
    }
  }
  若 填 > 0 { 块堆 = 块堆 + (截(槽, 填),) }
  若 len(块堆) == 0 { 返回 () }
  返回 拼平(块堆, 0, len(块堆))
}

函数 main() -> Int 效果串(file) {
  定 参 = argv()
  若 len(参) < 3 {
    print("用法：hmyr self/inflate.hmyr <deflate 流> <输出>" + chr(10))
    返回 2
  }
  定 字节串 = read_bytes(参[1])
  变 看码长 = 假
  变 i = 0
  当 i < len(参) {
    若 参[i] == "--码长" { 看码长 = 真 }
    i = i + 1
  }
  若 看码长 { 返回 打码长(字节串) }
  定 出 = 解固定(字节串)
  write_bytes(参[2], 出)
  print(str(len(字节串)) + " → " + str(len(出)) + chr(10))
  返回 0
}
