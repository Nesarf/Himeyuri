引入 "./f64.hmoca"

// 用 HMYR 写的字节码机器：第一层是装载。
//
// 为什么要有这一份：vm/hmyr.c 那 6660 行是四台机器里唯一没有自举版本的一层，
// 而 self/ 里连对应的实现都没有。要它自举，第一件事不是指令循环，是「把一份
// .hmoks 读进来」—— 而那条路原先在 HMYR 里断着：文件里的数字常量是八个字节的位模式，
// 而没有任何一层把它变回数（f64_bytes 只做反方向）。self/f64.hmoca 补的就是那一头。
//
// 这一版只做装载：读头部、函数表、指令表、全局表。执行还不在里面 —— 而那是刻意的，
// 「读得进来」与「跑得起来」是两个可以分开验的台阶，前一个没站稳就写后一个，
// 出问题时说不清是读错了还是跑错了。
//
// 文件的格式全在 src/code-file.mjs 那 211 行里，这里按它照抄，包括两处容易写错的：
//   · 空元组编成 0x00（不是 0x04 加长度零）—— 这门语言里「没有值」与空元组是同一个东西；
//   · 操作码 34 条按名字排序编号，加指令只许追加在末尾，旧号不动。
//
// 一个形状上的选择：游标用一个可变数组（字节, at），而不是让每个读函数都返回下一个
// 位置。理由是这一层读起来像「一路往下扫」，把 at 装在记录里逐层传会让每个函数
// 多一个参数、每个调用点多一次拆包 —— 而数组的 设 是原地改（design/ARRAY.txt）。
// 副作用是它不纯：同一个状态对象在整个装载过程中被改。这在单线程装载里是优点。

// 游标：一个两元的可变数组 —— 第 0 项是字节串，第 1 项是读到哪里了。
公开 函数 开卷(字节: Int) {
  返回 数组((字节, 0))
}

// 当前读到哪。
函数 在哪(卷: Int) -> Int {
  返回 to_int(卷[1])
}

// 还剩多少字节。
函数 剩多少(卷: Int) -> Int {
  返回 len(卷[0]) - 在哪(卷)
}

// 读一个字节，游标前进一。
//
// 这一层是装载里被调得最多的一件事（九万字节就是九万次），所以两处都按「少一层」
// 写：游标直接从数组里取，不再经 在哪 那一个函数；字节串也先落到一个名字上。
// 自举解释器里每多一层调用就是几百步，而这里省下的那一层要乘九万次。
公开 函数 取一(卷: Int) -> Int {
  定 b = 卷[0]
  定 at = to_int(卷[1])
  若 at >= len(b) {
    返回 0
  }
  设(卷, 1, at + 1)
  返回 to_int(b[at])
}

// 读一个小端 u16。语言里的数是双精度，16 位放得下，不必借大整数。
//
// 与 取一 同一个理由内联：它被调的次数与字节数同量级，而每层调用都不便宜。
公开 函数 取二(卷: Int) -> Int {
  定 b = 卷[0]
  定 at = to_int(卷[1])
  若 at + 2 > len(b) {
    设(卷, 1, len(b))
    返回 0
  }
  设(卷, 1, at + 2)
  返回 to_int(b[at]) + to_int(b[at + 1]) * 256
}

// 读一个小端 u32。32 位仍然在安全整数里（2 的 53 次方以内）。
公开 函数 取四(卷: Int) -> Int {
  定 b = 卷[0]
  定 at = to_int(卷[1])
  若 at + 4 > len(b) {
    设(卷, 1, len(b))
    返回 0
  }
  设(卷, 1, at + 4)
  返回 to_int(b[at]) + to_int(b[at + 1]) * 256 + to_int(b[at + 2]) * 65536 + to_int(b[at + 3]) * 16777216
}

// 读一个串：u16 长度 + 每字符 u16（UTF-16 码元）。
公开 函数 取串(卷: Int) {
  定 长 = 取二(卷)
  变 出 = ""
  变 i = 0
  当 i < 长 {
    出 = 出 + chr(取二(卷))
    i = i + 1
  }
  返回 出
}

// 读八个字节，走由位 变成一个数。
公开 函数 取双(卷: Int) {
  变 八 = ()
  变 i = 0
  当 i < 8 {
    八 = 八 + (取一(卷),)
    i = i + 1
  }
  返回 由位(八)
}

// 读一个值。tag 一字节，后面按 tag 走。
//
// 元组与记录在语言里各有自己的表示（元组就是元组，记录就是 {字段: 值}），
// 所以这里直接造出来。空元组那一支要单独写：它编成 0x00，与「没有值」同一个字节。
公开 函数 取值(卷: Int) {
  定 t = 取一(卷)
  若 t == 0 {
    返回 ()
  }
  若 t == 1 {
    返回 取双(卷)
  }
  若 t == 2 {
    返回 取串(卷)
  }
  若 t == 3 {
    返回 取一(卷) == 1
  }
  若 t == 4 {
    定 n = 取二(卷)
    变 项们 = ()
    变 i = 0
    当 i < n {
      项们 = 项们 + (取值(卷),)
      i = i + 1
    }
    返回 项们
  }
  // t == 5：记录。字段名与值交替，攒成 (名, 值) 对的元组再交给 record_new ——
  // 那个内置要的正是这个形状（见 src/vm-builtins.mjs），一次造完比逐个加字段省事。
  定 数 = 取二(卷)
  变 项们 = ()
  变 k = 0
  当 k < 数 {
    定 名 = 取串(卷)
    定 值 = 取值(卷)
    项们 = 项们 + ((名, 值),)
    k = k + 1
  }
  返回 record_new(项们)
}

// 立即数的形状。34 条指令，按操作码的下标排 —— 与 src/code-file.mjs 的立即数形状
// 那张表同一个顺序，改一处就要改另一处。
//
//   0 无  1 u16  2 u32  3 串  4 存（u16 + u8）  5 记录（名字表）  6 调用（串 + u16）  7 值
函数 形状(号: Int) -> Int {
  定 表 = (0, 1, 0, 6, 6, 7, 0, 0, 3, 0, 3, 0, 0, 2, 2, 2, 2, 2, 0, 1, 0, 0, 0, 0, 0, 0, 0, 5, 0, 4, 0, 1, 6, 3)
  若 号 < 0 || 号 >= 34 {
    返回 0
  }
  返回 to_int(表[号])
}

// 操作码的名字。读得出名字才好报错 —— 「第 12 号」那种话查不动。
函数 操作名(号: Int) -> String {
  定 表 = ("加", "赋值", "布尔", "调内置", "调函数", "常量", "除", "等", "字段", "大等",
    "全域取", "大", "索引", "跳", "假跳", "假跳留", "真跳", "真跳留", "小等",
    "取", "小", "余", "乘", "不等", "负", "非", "弃", "记录", "返回", "存",
    "减", "组", "调方法", "全域存")
  若 号 < 0 || 号 >= 34 {
    返回 "?"
  }
  返回 表[号]
}

// 读一条指令：操作码一字节，然后按形状读立即数。
//
// 交回 {op, 形, a, b}。形 留着，因为执行那一层要按它分派；而 a 与 b 的用法
// 按形而定 —— 这与 src/vm.mjs 里那个 switch 读的是同一份东西。
公开 函数 取命令(卷: Int) {
  定 号 = 取一(卷)
  定 形 = 形状(号)
  若 形 == 0 {
    返回 {op: 操作名(号), 号: 号, 形: 0, a: 0, b: 0}
  }
  若 形 == 1 || 形 == 2 {
    若 形 == 1 {
      返回 {op: 操作名(号), 号: 号, 形: 形, a: 取二(卷), b: 0}
    }
    返回 {op: 操作名(号), 号: 号, 形: 形, a: 取四(卷), b: 0}
  }
  若 形 == 3 {
    返回 {op: 操作名(号), 号: 号, 形: 3, a: 取串(卷), b: 0}
  }
  若 形 == 4 {
    定 槽 = 取二(卷)
    定 可 = 取一(卷)
    返回 {op: 操作名(号), 号: 号, 形: 4, a: 槽, b: 可}
  }
  若 形 == 5 {
    定 n = 取二(卷)
    变 名册 = ()
    变 i = 0
    当 i < n {
      名册 = 名册 + (取串(卷),)
      i = i + 1
    }
    返回 {op: 操作名(号), 号: 号, 形: 5, a: 名册, b: 0}
  }
  若 形 == 6 {
    定 名 = 取串(卷)
    定 个 = 取二(卷)
    返回 {op: 操作名(号), 号: 号, 形: 6, a: 名, b: 个}
  }
  返回 {op: 操作名(号), 号: 号, 形: 7, a: 取值(卷), b: 0}
}

// 读一个函数：名字、参数量、槽数、效果表、指令表。
公开 函数 取函数(卷: Int) {
  定 名 = 取串(卷)
  定 参数量 = 取二(卷)
  定 槽数 = 取二(卷)
  定 效果数 = 取二(卷)
  变 效果们 = ()
  变 i = 0
  当 i < 效果数 {
    效果们 = 效果们 + (取串(卷),)
    i = i + 1
  }
  定 指令数 = 取四(卷)
  变 码列 = ()
  变 k = 0
  当 k < 指令数 {
    码列 = 码列 + (取命令(卷),)
    k = k + 1
  }
  返回 {名: 名, 参数量: 参数量, 槽数: 槽数, 效果: 效果们, 码: 码列}
}

// 一份 .hmoks 的字节 → 一个程序。交回 {函数族, 全局们, ok, 说}。
//
// 头部四个魔数加一个版本，少一个都说明这不是这门语言的文件，或者不是这一版。
// 那份字节是 read_bytes 读来的元组。
公开 函数 装载(字节: Int) {
  定 卷 = 开卷(字节)
  定 m0 = 取一(卷)
  定 m1 = 取一(卷)
  定 m2 = 取一(卷)
  定 m3 = 取一(卷)
  定 m4 = 取一(卷)
  若 !(m0 == 72 && m1 == 77 && m2 == 89 && m3 == 82 && m4 == 66) {
    返回 {ok: 假, 说: "这不是 .hmoks 文件", 函数族: (), 全局们: ()}
  }
  定 版 = 取二(卷)
  若 版 != 1 {
    返回 {ok: 假, 说: "这份文件的版本是 " + str(版) + "，这一份读法只认 1", 函数族: (), 全局们: ()}
  }
  定 函数数 = 取二(卷)
  变 函数族 = ()
  变 i = 0
  当 i < 函数数 {
    函数族 = 函数族 + (取函数(卷),)
    i = i + 1
  }
  定 全局数 = 取二(卷)
  变 全局们 = ()
  变 k = 0
  当 k < 全局数 {
    全局们 = 全局们 + (取串(卷),)
    k = k + 1
  }
  返回 {ok: 真, 说: "", 函数族: 函数族, 全局们: 全局们}
}

// ---- 执行 ----
//
// 与 JVM 那种栈机同一个形状：一条指令弹几个、压几个，pc 自己走。
// 蓝本是 src/vm.mjs 那个 240 行的 switch，这里按它一条一条照抄 —— 顺序也照抄，
// 于是两边对同一份字节码读的是同一件东西。
//
// 这一版只做「不调函数也能跑完」的那一批：常量、取、存、赋值、弃、算术与比较、
// 跳转、返回。调函数要帧与效果，那是下一批；到了那一条就明说「还做不到」，
// 不假装跑通了。
//
// 栈与槽都用可变数组（design/ARRAY.txt）：栈顶那一下是 O(1)，而元组拼接是复制。
// 一个 1024 格的栈对自举层与 run.hmoca 都够 —— 真正的 HMYR 程序一层帧里同时压着
// 的操作数不多，而多的是帧数，不是格数。

// n 个空位（语言里的「没有值」就是空元组）。
函数 空值们(n: Int) {
  变 出 = ()
  变 i = 0
  当 i < n {
    出 = 出 + ((),)
    i = i + 1
  }
  返回 数组(出)
}

// 真值：不是假、不是空、不是零、不是空串。与 src/vm.mjs 里那个 真 同一个判断，
// 而「零」那一条在这里写成 num 比较 —— 语言里数只有一种。
公开 函数 真值(v: Int) -> Bool {
  若 v == 假 {
    返回 假
  }
  若 v == () {
    返回 假
  }
  若 v == "" {
    返回 假
  }
  若 v == 0 {
    返回 假
  }
  返回 真
}

// 造一个帧。槽是可变数组，参数填最前面几个，其余留空。
//
// 可写那一位（存 指令的 b）这一版不记：赋值到定 名上的检查是判据那一层的事，
// 而先把「算得对」跑通。到那一批时再把它加进槽的形状里 —— 现在加，会让每一条
// 取/存 都多一次拆包。
公开 函数 造帧(函: Int, 实参: Int) {
  变 槽 = 空值们(函.槽数)
  变 i = 0
  当 i < len(实参) && i < 函.槽数 {
    设(槽, i, 实参[i])
    i = i + 1
  }
  返回 {槽: 槽, 名: 函.名}
}

// ---- 圈：一份程序的全局表 ----
//
// 名字来自文件里那张全局表（顶层 var 与 const 的名字），值是一个可变数组 ——
// 与栈同一个理由：按位置改是 O(1)，而元组拼接是复制。
//
// 按名字查是线性的。这一条不必优化：全局表是十几个名字，而查它的是顶层那一段与
// 少数几个 全域取，不是热循环。真要快，改法是把「名字→第几个」的表在建圈时算好，
// 那时再说。
//
// 参 是这一份程序的 argv —— 客人自己看到的命令行。它不能直接借宿主那个 argv()：
// 那是「跑 VM 的进程」的命令行，而客人的程序问的是「我自己的」。两者混起来，
// 第一个症状是 VM 把自己当成要跑的目标，读一份字节码当源码解析。所以参随圈走，
// 装在这一层，内置的 只负责把它交出去。
公开 函数 造圈(程序: Int, 参: Int) {
  返回 {程序: 程序, 名们: 程序.全局们, 值们: 空值们(len(程序.全局们)), 参: 参}
}

公开 函数 圈里看(圈: Int, 名: String) {
  变 i = 0
  当 i < len(圈.名们) {
    若 圈.名们[i] == 名 {
      返回 圈.值们[i]
    }
    i = i + 1
  }
  返回 ()
}

公开 函数 圈里写(圈: Int, 名: String, 值: Int) {
  变 i = 0
  当 i < len(圈.名们) {
    若 圈.名们[i] == 名 {
      设(圈.值们, i, 值)
    }
    i = i + 1
  }
  返回 0
}

// 跑一个内置。名字来自字节码，所以这里是一串比较 —— 与 self/eval.hmoca 里
// 那张表同一个形状。
//
// 只收这一版用得上的几个：装载与执行都不靠它们，而「跑一份真实的程序」靠。
// 不认识的明说，不猜 —— 猜错的那个会更难查。
//
// 名录是按「从 命令行入口 往外第几跳用到它」排出来的，不是随手挑的。
// 2026-11-04 量过（tools/builtin-demand.mjs 就是为这件事留下的）：
// 整份 runtime/run.hmoks 从入口可达 180 个函数、最深 16 跳，一共要 80 个内置。
// 按跳分是这样：第 0 跳 5 个（argv chr len print print_err），第 1 跳 3 个，
// 第 2 跳 2 个，第 3 跳 2 个，第 5 跳 6 个，第 6 跳 62 个 —— 而那 62 个才是
// 命令行、线程、打包、终端那一整套。
//
// 这里认 22 个：第 0 到第 5 跳全在，第 6 跳只认了 is_letter 与 is_mark
// （词法认字要先过它们）。这 22 个正好够把 examples/hello.hmoca 从源码跑到 5 ——
// 判据是 test/vm-boot.test.mjs。还缺的 58 个不在那条路上：它们在写文件、跑外部
// 程序、线程与终端那几条路上，补与不补，hello 都照样跑得通。
//
// 借的是什么：这一层跑在 HMYR 自己上面，所以 print、str、chr 这些就是语言自己的
// 内置。这里没有「再实现一遍」，只有「按名字挑一个」。
//
// 圈 要传进来，因为只有它知道客人自己的 argv（见 造圈）。
公开 函数 内置的(名: String, 实参: Int, 圈: Int) {
  若 名 == "print" {
    变 串 = ""
    变 i = 0
    当 i < len(实参) {
      串 = 串 + str(实参[i])
      i = i + 1
    }
    print(串)
    返回 {ok: 真, 值: (), 说: ""}
  }
  若 名 == "str" {
    返回 {ok: 真, 值: str(实参[0]), 说: ""}
  }
  若 名 == "chr" {
    返回 {ok: 真, 值: chr(实参[0]), 说: ""}
  }
  若 名 == "ord" {
    返回 {ok: 真, 值: ord(实参[0]), 说: ""}
  }
  若 名 == "len" {
    返回 {ok: 真, 值: len(实参[0]), 说: ""}
  }
  若 名 == "to_int" {
    返回 {ok: 真, 值: to_int(实参[0]), 说: ""}
  }
  若 名 == "floor" {
    返回 {ok: 真, 值: floor(实参[0]), 说: ""}
  }
  // 第五跳：词法那一段认字用 is_letter / is_mark，读串前先 nfc；
  // 而符号表与「按名字取」这两件事靠 index_* 与 field_*。
  //
  // 这四个 二参 的名字是「容器 + 键」，键是串 —— 与语言里那一条同形。
  // 传错时宿主自己报，这里不替它判：替它判会把一件明确的错变成两个地方各说一句。
  若 名 == "nfc" {
    返回 {ok: 真, 值: nfc(实参[0]), 说: ""}
  }
  若 名 == "is_letter" {
    返回 {ok: 真, 值: is_letter(实参[0]), 说: ""}
  }
  若 名 == "is_mark" {
    返回 {ok: 真, 值: is_mark(实参[0]), 说: ""}
  }
  若 名 == "field_has" {
    返回 {ok: 真, 值: field_has(实参[0], 实参[1]), 说: ""}
  }
  若 名 == "field_get" {
    返回 {ok: 真, 值: field_get(实参[0], 实参[1]), 说: ""}
  }
  若 名 == "index_has" {
    返回 {ok: 真, 值: index_has(实参[0], 实参[1]), 说: ""}
  }
  若 名 == "index_get" {
    返回 {ok: 真, 值: index_get(实参[0], 实参[1]), 说: ""}
  }
  // ---- 第六跳那一层：宿主的内脏 ----
  //
  // 这一批在 examples/hello.hmoca 那条路上一个都用不到 —— 它只走到第七跳就到底。
  // 它们落在「跑一份真的会写东西、会读目录、会算位」的程序」那几条路上，
  // 而那些路今天没有判据，所以下面每一条都只是转手：参数个数与顺序照宿主那一条
  // 原样传，不在这一层改形状。这一层不是内置的实现者，它只是把客人的请求递过去。
  //
  // 为什么不在这里查参数个数：宿主自己会报「wants N arguments」，那句话就在
  // 那一条内置的门口，比这里造的一句更准；在这里判一遍，判错时报的是这一层的错，
  // 指着一个没有问题的客人。
  //
  // 记账与打包：自举层的符号表、包格式、校验和都靠这几个。
  若 名 == "record_new" {
    返回 {ok: 真, 值: record_new(实参[0]), 说: ""}
  }
  若 名 == "field_names" {
    返回 {ok: 真, 值: field_names(实参[0]), 说: ""}
  }
  若 名 == "index_len" {
    返回 {ok: 真, 值: index_len(实参[0]), 说: ""}
  }
  若 名 == "index_keys" {
    返回 {ok: 真, 值: index_keys(实参[0]), 说: ""}
  }
  若 名 == "pack_value" {
    返回 {ok: 真, 值: pack_value(实参[0]), 说: ""}
  }
  若 名 == "校验和" {
    返回 {ok: 真, 值: 校验和(实参[0]), 说: ""}
  }
  若 名 == "f64_bytes" {
    返回 {ok: 真, 值: f64_bytes(实参[0]), 说: ""}
  }
  若 名 == "bytes_to_text" {
    返回 {ok: 真, 值: bytes_to_text(实参[0]), 说: ""}
  }
  // 文件：读那几条与写那两条分开放，因为「读不动」是正常情形而「写不动」是故障。
  若 名 == "read_bytes" {
    返回 {ok: 真, 值: read_bytes(实参[0]), 说: ""}
  }
  若 名 == "write_bytes" {
    返回 {ok: 真, 值: write_bytes(实参[0], 实参[1]), 说: ""}
  }
  若 名 == "write_text" {
    返回 {ok: 真, 值: write_text(实参[0], 实参[1]), 说: ""}
  }
  若 名 == "read_dir" {
    返回 {ok: 真, 值: read_dir(实参[0]), 说: ""}
  }
  若 名 == "is_dir" {
    返回 {ok: 真, 值: is_dir(实参[0]), 说: ""}
  }
  // read_line(路径, 起)：第二个是字节偏移，不是行号 —— 名字容易读错，所以写明。
  若 名 == "read_line" {
    返回 {ok: 真, 值: read_line(实参[0], 实参[1]), 说: ""}
  }
  若 名 == "read_lines" {
    返回 {ok: 真, 值: read_lines(实参[0]), 说: ""}
  }
  若 名 == "read_stdin_bytes" {
    返回 {ok: 真, 值: read_stdin_bytes(实参[0]), 说: ""}
  }
  若 名 == "read_stdin_line" {
    返回 {ok: 真, 值: read_stdin_line(), 说: ""}
  }
  // 路径与目录：这四个都是「问宿主我在哪」，转手之后客人拿到的就是宿主的位置。
  // 这一层没有自己的根目录概念；要给客人一个别的根，那是一件设计活，不是转手。
  若 名 == "home_dir" {
    返回 {ok: 真, 值: home_dir(), 说: ""}
  }
  若 名 == "temp_path" {
    返回 {ok: 真, 值: temp_path(实参[0]), 说: ""}
  }
  若 名 == "repo_path" {
    返回 {ok: 真, 值: repo_path(实参[0]), 说: ""}
  }
  若 名 == "python_path" {
    返回 {ok: 真, 值: python_path(), 说: ""}
  }
  若 名 == "chdir" {
    返回 {ok: 真, 值: chdir(实参[0]), 说: ""}
  }
  // 数与串。
  若 名 == "abs" {
    返回 {ok: 真, 值: abs(实参[0]), 说: ""}
  }
  若 名 == "int" {
    返回 {ok: 真, 值: int(实参[0]), 说: ""}
  }
  若 名 == "to_upper" {
    返回 {ok: 真, 值: to_upper(实参[0]), 说: ""}
  }
  若 名 == "to_lower" {
    返回 {ok: 真, 值: to_lower(实参[0]), 说: ""}
  }
  若 名 == "split" {
    返回 {ok: 真, 值: split(实参[0], 实参[1]), 说: ""}
  }
  // 时间：自举层拿它做「别等太久」与「这一跑花了多久」。
  若 名 == "now_ms" {
    返回 {ok: 真, 值: now_ms(), 说: ""}
  }
  若 名 == "sleep_ms" {
    返回 {ok: 真, 值: sleep_ms(实参[0]), 说: ""}
  }
  // locale 与终端代码页：四个都是进程级的设置，转手就是真改 —— 客人与宿主
  // 共用同一个进程，这是「VM 跑在语言自己上面」的代价，写在这里免得下次当惊喜。
  若 名 == "locale_current" {
    返回 {ok: 真, 值: locale_current(), 说: ""}
  }
  若 名 == "locale_env" {
    返回 {ok: 真, 值: locale_env(), 说: ""}
  }
  若 名 == "locale_set" {
    返回 {ok: 真, 值: locale_set(实参[0]), 说: ""}
  }
  若 名 == "console_codepage" {
    返回 {ok: 真, 值: console_codepage(), 说: ""}
  }
  // run_program(命令, 参数元组, 超时毫秒, 编码)：四个都可省，而 HMYR 没有
  // 「把元组摊开当实参」的写法，所以这里按个数分四支照原样递 —— 不是判断，
  // 是转发一个可选参数列表的唯一写法。
  若 名 == "run_program" {
    若 len(实参) == 1 { 返回 {ok: 真, 值: run_program(实参[0]), 说: ""} }
    若 len(实参) == 2 { 返回 {ok: 真, 值: run_program(实参[0], 实参[1]), 说: ""} }
    若 len(实参) == 3 { 返回 {ok: 真, 值: run_program(实参[0], 实参[1], 实参[2]), 说: ""} }
    返回 {ok: 真, 值: run_program(实参[0], 实参[1], 实参[2], 实参[3]), 说: ""}
  }
  // 位运算八条：编号、哈希、打包都要它们。名字是汉字，与操作码表里那几条同名，
  // 所以这一串看起来像语法，其实是内置名。
  若 名 == "位与" {
    返回 {ok: 真, 值: 位与(实参[0], 实参[1]), 说: ""}
  }
  若 名 == "位或" {
    返回 {ok: 真, 值: 位或(实参[0], 实参[1]), 说: ""}
  }
  若 名 == "位异或" {
    返回 {ok: 真, 值: 位异或(实参[0], 实参[1]), 说: ""}
  }
  若 名 == "位非" {
    返回 {ok: 真, 值: 位非(实参[0]), 说: ""}
  }
  若 名 == "位右移" {
    返回 {ok: 真, 值: 位右移(实参[0], 实参[1]), 说: ""}
  }
  若 名 == "位加" {
    返回 {ok: 真, 值: 位加(实参[0], 实参[1]), 说: ""}
  }
  若 名 == "位循环右移" {
    返回 {ok: 真, 值: 位循环右移(实参[0], 实参[1]), 说: ""}
  }
  若 名 == "位循环左移" {
    返回 {ok: 真, 值: 位循环左移(实参[0], 实参[1]), 说: ""}
  }
  // 可变性那两条：数组 把元组变成可变的那一份，设 就地写它。
  // 这两条是这一批里唯一带引用语义的：客人拿到的是一个可变容器的同一份，
  // 所以 设 之后再读，读到的是新值 —— 与宿主那边完全一样，因为转手转的正是那个值。
  若 名 == "数组" {
    返回 {ok: 真, 值: 数组(实参[0]), 说: ""}
  }
  若 名 == "设" {
    返回 {ok: 真, 值: 设(实参[0], 实参[1], 实参[2]), 说: ""}
  }
  // 第二跳：命令行自己的三件。argv 交回客人那一份，不是宿主的。
  若 名 == "argv" {
    返回 {ok: 真, 值: 圈.参, 说: ""}
  }
  若 名 == "cwd" {
    返回 {ok: 真, 值: cwd(), 说: ""}
  }
  若 名 == "file_exists" {
    返回 {ok: 真, 值: file_exists(实参[0]), 说: ""}
  }
  // 第三跳：读源码。读不动的那个错误由宿主报，这里不吞。
  若 名 == "read_text" {
    返回 {ok: 真, 值: read_text(实参[0]), 说: ""}
  }
  // 第四跳：词法那一段用索引攒符号表。索引是值，所以 index_set 交回的那个
  // 才是要继续用的那个 —— 客人自己知道这一条，这里只管转手。
  若 名 == "index_new" {
    返回 {ok: 真, 值: index_new(), 说: ""}
  }
  若 名 == "index_set" {
    返回 {ok: 真, 值: index_set(实参[0], 实参[1], 实参[2]), 说: ""}
  }
  // slice(s, 从, 到)：三参，与语言里那一条同一个形状（不是 slice(s, 从)）。
  若 名 == "slice" {
    返回 {ok: 真, 值: slice(实参[0], 实参[1], 实参[2]), 说: ""}
  }
  // print_err 与 print 一样的收法，只是走另一条流。
  若 名 == "print_err" {
    变 串 = ""
    变 i = 0
    当 i < len(实参) {
      串 = 串 + str(实参[i])
      i = i + 1
    }
    print_err(串)
    返回 {ok: 真, 值: (), 说: ""}
  }
  返回 {ok: 假, 值: (), 说: "还不认这个内置：" + 名}
}

// 跑一个函数。交回 {ok, 值, 说}。
//
// 没有效果检查、没有深度上限、没有持有格 —— 那三件都属于「跑得对之后」，
// 而它们各自要的数据这一版还没建。写在这里，因为缺的东西要能被看见。
//
// 栈 128 这个数不是拍的。原来写 1024，而每一次 guest 函数调用都要分配一个
// 这么多槽的数组 —— 一份几十行的源码跑下来是几十万次调用，分配量以 GB 计，
// 回收器于是几乎一直在扫，每一步都跟着变慢。2026-11-04 量的（同一个程序、
// 同一份字节码，只改这一个数）：
//
//     1024：examples/hello.hmoca 24 秒；conformance/vm-hands.hmoca 300 秒没跑完
//     128 ：同一份 hello 2 秒；同一份 vm-hands 21 秒，答案与 src/vm.mjs 相同
//
// 128 的依据：自举层那一侧的表达式嵌套深度没有超过几十的，而越界的症状是
// 「栈满了」这条明说的错，不是静默算错 —— 所以宁小勿大。真要更大的栈，
// 该改的是「按需增长」，不是再把这个数调回去。
公开 函数 执行(码: Int, 帧: Int, 圈: Int) {
  定 栈 = 空值们(128)
  变 顶 = 0
  变 pc = 0
  当 真 {
    若 pc >= len(码) {
      返回 {ok: 假, 值: (), 说: "指令走完了却没有返回"}
    }
    定 命 = 码[pc]
    定 号 = 命.号
    // 常量：压立即数。
    若 号 == 5 {
      若 顶 >= len(栈) { 返回 {ok: 假, 值: (), 说: "栈满了"} }
      设(栈, 顶, 命.a)
      顶 = 顶 + 1
      pc = pc + 1
    } 否则 若 号 == 19 {
      // 取：把第 a 个槽压上。
      若 顶 >= len(栈) { 返回 {ok: 假, 值: (), 说: "栈满了"} }
      设(栈, 顶, 帧.槽[命.a])
      顶 = 顶 + 1
      pc = pc + 1
    } 否则 若 号 == 29 || 号 == 1 {
      // 存 与 赋值：弹一个写进第 a 个槽。可写那一位这一版不查（见 造帧 的说明）。
      顶 = 顶 - 1
      设(帧.槽, 命.a, 栈[顶])
      pc = pc + 1
    } 否则 若 号 == 26 {
      // 弃：弹掉。空栈时什么都不做 —— 这一条不是宽容，是照抄另外两台的底：
      // C 那台的 pop() 在栈底返回空值（vm/hmyr.c 的 pop），JS 那台是 栈.pop()，
      // 空数组弹出来的正是 undefined。两边都不报错。
      //
      // 而编译器确实会发出一个空的 弃：`若 甲 { 路径 = f() }` 这种没有值的语句，
      // 编出来的样子是「真分支 … 赋值 … 跳 过 常量 null … 弃」。假分支走到 弃 时
      // 栈上有那个 null，真分支是跳过去的，落到同一条 弃 上时栈是空的。
      // 三台机器都认这个形状，所以这里也得认 —— 第一版在这里直接把 顶 减到 -1，
      // 下一条 取 写栈时报的是「index outside the array」，指向一条完全无辜的指令
      // （2026-11-04 撞的，前后查了一整轮）。
      若 顶 > 0 {
        顶 = 顶 - 1
      }
      pc = pc + 1
    } 否则 若 号 == 24 {
      // 负。
      顶 = 顶 - 1
      设(栈, 顶, 0 - 栈[顶])
      顶 = 顶 + 1
      pc = pc + 1
    } 否则 若 号 == 25 {
      // 非。
      顶 = 顶 - 1
      设(栈, 顶, !真值(栈[顶]))
      顶 = 顶 + 1
      pc = pc + 1
    } 否则 若 号 == 0 || 号 == 6 || 号 == 21 || 号 == 22 || 号 == 30 {
      // 加、除、余、乘、减。弹两个、压一个。
      顶 = 顶 - 1
      定 乙 = 栈[顶]
      定 甲 = 栈[顶 - 1]
      变 结果 = 甲 + 乙
      若 号 == 30 { 结果 = 甲 - 乙 }
      若 号 == 22 { 结果 = 甲 * 乙 }
      若 号 == 21 { 结果 = 甲 % 乙 }
      若 号 == 6 {
        若 乙 == 0 {
          返回 {ok: 假, 值: (), 说: "除以零"}
        }
        结果 = 甲 / 乙
      }
      设(栈, 顶 - 1, 结果)
      pc = pc + 1
    } 否则 若 号 == 7 || 号 == 23 || 号 == 20 || 号 == 18 || 号 == 11 || 号 == 9 {
      // 等、不等、小、小等、大、大等。这一版只做数与串的直接比较 —— 记录与元组的
      // 深比较、非数那种「不可比」，都留给「比较」那一批（src/vm.mjs 里 相等 与 比
      // 各二十来行，而且那一条语义是三个执行器共用的）。
      顶 = 顶 - 1
      定 右 = 栈[顶]
      定 左 = 栈[顶 - 1]
      变 答 = 左 == 右
      若 号 == 23 { 答 = 左 != 右 }
      若 号 == 20 { 答 = 左 < 右 }
      若 号 == 18 { 答 = 左 <= 右 }
      若 号 == 11 { 答 = 左 > 右 }
      若 号 == 9 { 答 = 左 >= 右 }
      设(栈, 顶 - 1, 答)
      pc = pc + 1
    } 否则 若 号 == 13 {
      // 跳：pc 直接改成立即数给出的位置。
      pc = 命.a
    } 否则 若 号 == 14 {
      // 假跳：假就跳，真就往下走。
      顶 = 顶 - 1
      若 !真值(栈[顶]) {
        pc = 命.a
      } 否则 {
        pc = pc + 1
      }
    } 否则 若 号 == 16 {
      // 真跳。
      顶 = 顶 - 1
      若 真值(栈[顶]) {
        pc = 命.a
      } 否则 {
        pc = pc + 1
      }
    } 否则 若 号 == 2 {
      // 布尔：把一个值收成布尔。语义与 src/vm.mjs 的 真 那条相同。
      顶 = 顶 - 1
      设(栈, 顶, 真值(栈[顶]))
      顶 = 顶 + 1
      pc = pc + 1
    } 否则 若 号 == 31 {
      // 组：从栈上取 a 个，造一个元组。
      定 个数 = 命.a
      变 项们 = ()
      变 k = 0
      当 k < 个数 {
        项们 = 项们 + (栈[顶 - 个数 + k],)
        k = k + 1
      }
      顶 = 顶 - 个数
      设(栈, 顶, 项们)
      顶 = 顶 + 1
      pc = pc + 1
    } 否则 若 号 == 27 {
      // 记录：名字表是立即数，值在栈上同样多个（顺序与名字一对一）。
      定 名册 = 命.a
      定 数 = len(名册)
      变 对们 = ()
      变 j = 0
      当 j < 数 {
        对们 = 对们 + ((名册[j], 栈[顶 - 数 + j]),)
        j = j + 1
      }
      顶 = 顶 - 数
      设(栈, 顶, record_new(对们))
      顶 = 顶 + 1
      pc = pc + 1
    } 否则 若 号 == 8 {
      // 字段：弹掉记录、把那个字段的值留在原处 —— 弹一个压一个，所以 顶 一个都不动。
      // 第一版把它减了一，于是 返回 那一步弹到了 -1，报出来的却是「索引越界」。
      设(栈, 顶 - 1, field_get(栈[顶 - 1], 命.a))
      pc = pc + 1
    } 否则 若 号 == 12 {
      // 索引：弹下标、弹容器，把 容器[下标] 留在原处。
      //
      // 这一条比它在 JS 那边的样子短得多，因为语言自己的 [] 已经做完了那三件事：
      // 它对串与元组都工作，下标先取下整（design/SCALARS.txt 那条规矩），越界有自己的
      // 错误码。JS 那一侧要分别处理「宿主串」与「类元组」，是因为它就是那个底；
      // 而这里写的是这门语言自己，底已经在下面一层了。
      顶 = 顶 - 1
      定 下标 = 栈[顶]
      定 容器 = 栈[顶 - 1]
      设(栈, 顶 - 1, 容器[下标])
      pc = pc + 1
    } 否则 若 号 == 15 {
      // 假跳留：栈顶是假就跳，真就弹掉往下走。
      // 跳走时不弹 —— 栈上留着的那一个就是整个短路表达式的值（下一个 布尔 把它收成布尔）。
      若 !真值(栈[顶 - 1]) {
        pc = 命.a
      } 否则 {
        顶 = 顶 - 1
        pc = pc + 1
      }
    } 否则 若 号 == 17 {
      // 真跳留：同一条，方向相反。
      若 真值(栈[顶 - 1]) {
        pc = 命.a
      } 否则 {
        顶 = 顶 - 1
        pc = pc + 1
      }
    } 否则 若 号 == 10 {
      // 全域取：按名字从圈里读。圈 是这一份程序的全局表 —— 顶层 var 与 const 的住处。
      设(栈, 顶, 圈里看(圈, 命.a))
      顶 = 顶 + 1
      pc = pc + 1
    } 否则 若 号 == 33 {
      // 全域存：弹一个写进圈。
      顶 = 顶 - 1
      圈里写(圈, 命.a, 栈[顶])
      pc = pc + 1
    } 否则 若 号 == 4 {
      // 调函数：立即数是名字与实参个数。
      //
      // 实参在栈上按顺序压着（最左的先压），所以从 顶 - n 开始取就是对的 ——
      // 倒过来取会让每个二元函数都算错，而那种错在单参函数上完全看不出来。
      定 名 = 命.a
      定 几 = 命.b
      变 实参 = ()
      变 m = 0
      当 m < 几 {
        实参 = 实参 + (栈[顶 - 几 + m],)
        m = m + 1
      }
      顶 = 顶 - 几
      定 找 = 找函数(圈.程序, 名)
      若 !找.有 {
        返回 {ok: 假, 值: (), 说: "没有这个函数：" + 名}
      }
      定 果 = 执行(找.函.码, 造帧(找.函, 实参), 圈)
      若 !果.ok {
        返回 果
      }
      设(栈, 顶, 果.值)
      顶 = 顶 + 1
      pc = pc + 1
    } 否则 若 号 == 3 {
      // 调内置：立即数是名字与实参个数，实参与 调函数 同一个顺序。
      定 内名 = 命.a
      定 内几 = 命.b
      变 内参 = ()
      变 q = 0
      当 q < 内几 {
        内参 = 内参 + (栈[顶 - 内几 + q],)
        q = q + 1
      }
      顶 = 顶 - 内几
      定 内果 = 内置的(内名, 内参, 圈)
      若 !内果.ok {
        返回 内果
      }
      设(栈, 顶, 内果.值)
      顶 = 顶 + 1
      pc = pc + 1
    } 否则 若 号 == 32 {
      // 调方法：对一个值调方法。自举那一层从不产生这一条指令（见 design/FILETYPE.txt
      // 那一层对方法的处理），所以这里如实报「还做不到」而不是造一个半成品。
      返回 {ok: 假, 值: (), 说: "这一条指令还做不到：" + 命.op}
    } 否则 若 号 == 28 {
      // 返回：结束这一帧。
      顶 = 顶 - 1
      返回 {ok: 真, 值: 栈[顶], 说: ""}
    } 否则 {
      返回 {ok: 假, 值: (), 说: "这一条指令还做不到：" + 命.op}
    }
  }
}

// 按名字找函数。交回 {有, 函} —— 不交回「记录或空元组」，因为调用方要拿它去
// 判断有没有，而 len() 对记录会报 HMYR-行-008（第一版就是这么错的）。
公开 函数 找函数(程序: Int, 名: String) {
  变 i = 0
  当 i < len(程序.函数族) {
    若 程序.函数族[i].名 == 名 {
      返回 {有: 真, 函: 程序.函数族[i]}
    }
    i = i + 1
  }
  返回 {有: 假, 函: ()}
}

// 跑一个程序的 main：造圈、先跑顶层段、再跑 main。
//
// 交回 {ok, 值, 说}。效果检查与深度上限这一版都没有 —— 那些在调用链上，而这里是最
// 内的一层：给它一份装载好的程序与它自己的 argv，它跑 main 并交回那个值。
//
// 参 就是客人看到的 argv。命令行入口 那类程序是靠 argv() 拿目标的，所以这一条
// 传错，程序会去读一份不该读的文件 —— 而那一种错报出来是「读不动这个文件」，
// 与真正的缺文件一模一样。所以它显式在身上，不从宿主那儿偷。
//
// 顶层段要单独跑，因为顶层 var 与 const 的初值是在那一小段指令里算出来的，
// 而 main 可能读它们（全域取）。段名是 __hmyr_top__ —— 与 src/bytecode.mjs 里那个
// 常量同一个字面量，改一处就要改另一处。
公开 函数 跑主函数(程序: Int, 参: Int) {
  返回 跑入口(程序, 参, "main")
}

// 同一个跑法，入口名字自己给。自举那一层那个叫 命令行入口，不叫 main ——
// 要试「这份 VM 能不能跑起自举层」，就得能点名调它。除此之外与 跑主函数 一样，
// 连顶层段那一步也一样：两个入口都要那个圈 —— 顶层那个圈正是 const 的初值所在。
公开 函数 跑入口(程序: Int, 参: Int, 入口名: String) {
  返回 跑入口带参(程序, 参, 入口名, ())
}

// 再往下一格：入口的实参也自己给。这一格是给探针用的 —— 「那一层跑不动」有两类，
// 是整个自举层跑不动，还是某一个函数跑不动；要分开它们，就得能点名一个更小的函数
// 并塞给它一份实参。参数是值、不是名字，所以这里不查个数：给少了由客人那边的
// 取 报出来，那一条报得比这里准。
公开 函数 跑入口带参(程序: Int, 参: Int, 入口名: String, 实参: Int) {
  定 圈 = 造圈(程序, 参)
  定 顶段 = 找函数(程序, "__hmyr_top__")
  若 顶段.有 {
    定 序 = 执行(顶段.函.码, 造帧(顶段.函, ()), 圈)
    若 !序.ok {
      返回 序
    }
  }
  定 主 = 找函数(程序, 入口名)
  若 !主.有 {
    返回 {ok: 假, 值: (), 说: "没有 " + 入口名 + " 这个函数"}
  }
  返回 执行(主.函.码, 造帧(主.函, 实参), 圈)
}

