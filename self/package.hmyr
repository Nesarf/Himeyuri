// 打一个包：把几个目录下的文件收进一个 ZIP。
//
// 这一版只做「收集 + 打包」，不做签名、不做发布流程；成员一律 stored（不压缩），
// 因为压缩那一路要每个文件跑一遍 LZ77，而这一版的目的是先把「遍历目录 → 逐成员写头
// → 中央目录 → 尾记录」这条线走通。压缩留给下一版，deflate 的两个方向本来就在。
//
// 成员名用正斜杠（正规名 负责这一处）；每个成员各自算 CRC32；
// 偏移是「在它之前所有块的长度之和」—— 中央目录靠它找回每个成员。
//
// 实测：design/ 的 28 个文件（269128 字节）打成 272262 字节的包，
// Expand-Archive 解得开、28 个一个不少、抽查 ARRAY.txt 的 SHA-256 与原件相同。
//
// 压缩（--压，方法 8）：只对小文件开，阈值 8192 字节，写在 zip.hmyr 的 成员 里。
// 实测 examples/ 的 7 个文件：不压 4298 字节，压了 3411 字节，0.8 秒。
// 但整份 design（269 KB）会撞 C 那台二十亿步的上限 —— 固定压 的常数太大。
// 所以这个开关在，发布流程里暂时不开它。
//
// 边界：整棵仓库的收集也一样会撞限，因为 runtime/ucd/ 里躺着几 MB 的语料。
// 第二参数「只收哪一个目录」就是为验结构留的。
import "./zip.hmyr"
import "./manifest.hmyr"

fn 收一件(路们: Int, 目录: String, 名们: Int) {
  var 出 = 路们
  var i = 0
  while i < len(名们) {
    出 = 出 + (目录 + "/" + 名们[i],)
    i = i + 1
  }
  return 出
}

// 名字要带自己的前缀：合并程序是「先到者赢」，而 manifest.hmyr 里也有一个 主。
// 撞名不会报错 —— 只会安静地跑成另一个工具。这一条与 zip.hmyr 文件头那句同源。
fn 打包(包路: String, 只收: String, 要压: Bool) effects(file, process) {
  // 要收的目录。默认这一层；给了第三个参数就只收那一个 —— 后者用来验结构。
  //
  // runtime/ 与 conformance/ 不在表里：它们装着 UCD 语料（几 MB 的单个文件），
  // 而这份语言把「一串字节」表示成每个字节一个值 —— 5 MB 就是 500 万个值，
  // 读进来先撞内存上限（实测：带 runtime 的那一版分配了 7609 MB 就停了）。
  // 那是表示层面的限制，不是打包逻辑的问题；语料由 tools/ucd*.mjs 从 Unicode 源生成。
  var 目录们 = ("src", "self", "bin", "tools", "test", "design", "examples", "assets")
  if 只收 != "" { 目录们 = (只收,) }
  var 路们 = ()
  var d = 0
  while d < len(目录们) {
    if is_dir(目录们[d]) {
      路们 = 收一件(路们, 目录们[d], 走文件(目录们[d]))
    }
    d = d + 1
  }
  if len(路们) == 0 {
    print("  没有可收的文件" + chr(10))
    return 1
  }

  var 块们 = ()
  var 心们 = ()
  var 偏移 = 0
  var 总原始 = 0
  var k = 0
  while k < len(路们) {
    let 一 = 成员(路们[k], 正规名(路们[k]), 要压, 偏移)
    块们 = 块们 + (一.块,)
    心们 = 心们 + (一.中心,)
    偏移 = 偏移 + len(一.块)
    总原始 = 总原始 + 一.原始
    k = k + 1
  }
  let 体 = 拼平(块们, 0, len(块们))
  let 录 = 拼平(心们, 0, len(心们))
  let 收尾 = 尾(len(块们), len(录), 偏移)
  write_bytes(包路, (体, 录, 收尾))
  print("  收了 " + str(len(块们)) + " 个文件，原样 " + str(总原始) + " 字节 → " + str(len(体) + len(录) + len(收尾)) + " 字节的包" + chr(10))
  return 0
}

fn main() -> Int effects(file, process) {
  let 参 = argv()
  if len(参) < 2 {
    print("用法：hmyr self/package.hmyr <包.zip>" + chr(10))
    return 2
  }
  var 要压 = false
  var i = 0
  while i < len(参) {
    if 参[i] == "--压" { 要压 = true }
    i = i + 1
  }
  if len(参) > 2 && 参[2] != "--压" { return 打包(参[1], 参[2], 要压) }
  return 打包(参[1], "", 要压)
}
