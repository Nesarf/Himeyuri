// 用 Himeyuri 写的第二个前端部件：词法扫描。
//
// 与 self/scan.hmyr 一样，它只依赖语言里已有的东西。深度按上一件学到的形状安排：
// 外层「每读一个 token 一层递归」，而读一个词、读一个数字、读一个字符串各自是**独立的一次递归**——
// 两者不嵌套在同一层里，所以深度是 token 数与 token 长度的较大者，不是乘积。
//
// 两条当前的边界，写在明处而不是留给别人发现：
//   ・关键字不单独成类，一律算标识符；对拍时 JS 版的 keyword 也按标识符看待。
//   ・字符串保留原文，不解转义；对拍字符串时只比种类，不比内容（解转义是下一件活）。
//   ・块注释不嵌套（JS 版嵌套）；进制字面量按十六进制字符集读取；小数与整数同归 int 一类。
//
// 这个文件当时是自足的：那会儿模块系统还没有，starts_with 一类的工具在这里
// 重写了一遍（scan.hmoca 里至今还留着一份同样的）。模块系统现在有了 ——
// run.hmoca 就是靠 引入 把五份串起来的 —— 所以这一段只剩历史价值。
// 合并那两份工具不急，但它已经不是「必须自足」，而是一份可以收的重复。

fn letters() -> String {
  返回 "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
}

fn digits() -> String {
  返回 "0123456789"
}

// ch 是否出现在 set 里。深度等于 set 的长度。
fn in_set(ch: String, set: String, i: Int) -> Bool {
  若 i >= len(set) { 返回 false }
  若 ch == set[i] { 返回 true }
  返回 in_set(ch, set, i + 1)
}

fn is_alpha(c: String) -> Bool {
  // 字母的判定交给宿主：它已经有 Unicode 的属性表，而语言自己带一份副本只会与它渐渐分叉。
  // 这一步是「用母语写这门语言」的前提——中文、日文、谚文的名字在词法里得先算一个标识符。
  返回 is_letter(c)
}

// pub 是给 run.hmoca 用的：是包名字 要判「首字符不是数字」，而那是字符分类这件事
// 该留在词法这一层（2026-11-02）。
pub fn is_digit(c: String) -> Bool {
  返回 in_set(c, digits(), 0)
}

fn is_ident_start(c: String) -> Bool {
  // 字母由宿主判定，下划线是标识符自己的字符（\p{L} 并不包含它）。
  返回 is_letter(c) || c == "_"
}

fn is_ident_char(c: String) -> Bool {
  // 组合记号也属于标识符：café 的两种写法都是同一个名字的候选。
  // 归一不再「是下一步」—— tokenize 在产出标识符时已经调 nfc 了（2026-11-01 改）。
  返回 is_letter(c) || is_mark(c) || is_digit(c) || c == "_"
}

fn is_space(c: String) -> Bool {
  返回 c == " " || c == "\t" || c == "\r"
}

// 跳过空白、换行与行注释，返回下一个有意义字符的位置。
fn skip_ws(s: String, i: Int) -> Int {
  若 i >= len(s) { 返回 i }
  // 换行不再算空白：它是语句的边界，要不要留下由 tokenize 决定。
  若 is_space(s[i]) { 返回 skip_ws(s, i + 1) }
  若 s[i] == "/" && i + 1 < len(s) && s[i + 1] == "/" { 返回 skip_ws(s, skip_to_eol(s, i)) }
  若 s[i] == "/" && i + 1 < len(s) && s[i + 1] == "*" { 返回 skip_ws(s, skip_block(s, i + 2)) }
  返回 i
}

fn skip_to_eol(s: String, i: Int) -> Int {
  若 i >= len(s) { 返回 i }
  若 s[i] == "\n" { 返回 i }
  返回 skip_to_eol(s, i + 1)
}

// 跳过块注释，停在收尾的 */ 之后。不处理嵌套，这条边界写在文件头。
fn skip_block(s: String, i: Int) -> Int {
  若 i + 1 >= len(s) { 返回 len(s) }
  若 s[i] == "*" && s[i + 1] == "/" { 返回 i + 2 }
  返回 skip_block(s, i + 1)
}

// 取一段直接用语言的内置 slice，这一层不再自己定义（2026-11-01 删）。
//
// 为什么要删：原来这里有 pub fn slice(s, from, to)，实现是「s[from] 再递归取剩下」——
// 取长度 L 的一段要复制 L 的平方那么多个字符。宿主那一侧因为「内置优先」，
// 这个定义从来没被调到过（src/eval.mjs 第 52 行写着这条规矩），于是它只活在 C 机器上：
// 加载 self/eval.hmoca（1309 行、38 KB）时十六秒内吃完四个吉字节，而同一份源码在宿主上
// 毫无异样。删除之后两台机器都落到同一个内置，边界行为也因此一致（起点截到零、
// 终点截到末尾、终点小于起点交回空）—— design/BOARD.txt 第三十四节那条裂缝正是
// 「手写版越界交回空、内置版截断」造成的。

fn starts_with(s: String, from: Int, p: String, k: Int) -> Bool {
  若 k >= len(p) { 返回 true }
  若 from + k >= len(s) { 返回 false }
  若 s[from + k] != p[k] { 返回 false }
  返回 starts_with(s, from, p, k + 1)
}

// 读一个标识符。返回 {next, text}。
fn read_ident(s: String, i: Int, acc: String) -> {next: Int, text: String} {
  若 i >= len(s) { 返回 {next: i, text: acc} }
  若 is_ident_char(s[i]) { 返回 read_ident(s, i + 1, acc + s[i]) }
  返回 {next: i, text: acc}
}

fn is_hex_char(c: String) -> Bool {
  返回 is_digit(c) || in_set(c, "abcdefABCDEF", 0)
}

// 汉字关键字归一成英文那一套 —— 与 src/lexer.mjs 的 关键字别名 是同一张表。
//
// 为什么放在这里：这一层把关键字一律当 ident（文件头第三行写着那条边界），
// 而上面按文本判关键字（stmt 的 is_word、body 的 t.text ==）。归一放在产出
// token 的这一步，那些地方一行都不用改，也就不必让每一处都写两遍。
// 一次只收四个词，与 JS 那两张表同步：返回 若 定 当 在全部 .hmoca 里作为
// 独立标识符出现零次，所以不会与既有名字撞。
fn 关键字归一(词: String) -> String {
  若 词 == "返回" { 返回 "return" }
  若 词 == "若" { 返回 "if" }
  若 词 == "定" { 返回 "let" }
  若 词 == "当" { 返回 "while" }
  若 词 == "效果串" { 返回 "effects" }
  若 词 == "引入" { 返回 "import" }
  若 词 == "否则" { 返回 "else" }
  若 词 == "常量" { 返回 "const" }
  若 词 == "借用" { 返回 "borrow" }
  若 词 == "拥有" { 返回 "own" }
  若 词 == "作" { 返回 "as" }
  若 词 == "托管" { 返回 "managed" }
  若 词 == "要求" { 返回 "requires" }
  若 词 == "保证" { 返回 "ensures" }
  若 词 == "不变式" { 返回 "invariant" }
  返回 词
}

// 进制字面量：0x / 0b / 0o 之后一律按十六进制字符集读下去。
fn read_based(s: String, i: Int, acc: String) -> {next: Int, text: String} {
  若 i >= len(s) { 返回 {next: i, text: acc} }
  // 下划线是分隔符，但它属于字面量的一部分（0x1_0 的原文要完整留着），
  // 否则词法先把它截断，后面再聪明也补不回来。
  若 is_hex_char(s[i]) || s[i] == "_" { 返回 read_based(s, i + 1, acc + s[i]) }
  返回 {next: i, text: acc}
}

// 读一个数字（整数与小数都用同一段字面量，带下划线分隔也算）。
//
// 指数也算进字面量：e 或 E，后面可带一个符号，再跟数字。不认它的话
// 1e3 会被读成「1」加一个标识符 e3 —— 那是个安静的错误：后面某一层会算出一个
// 看起来像个数的东西。这一条与宿主 lexer.mjs 的规矩一致。
fn read_number(s: String, i: Int, acc: String) -> {next: Int, text: String} {
  若 i >= len(s) { 返回 {next: i, text: acc} }
  若 is_digit(s[i]) || s[i] == "_" { 返回 read_number(s, i + 1, acc + s[i]) }
  // 小数点后面紧跟数字时，它属于这个字面量；否则句点是标点
  若 s[i] == "." && i + 1 < len(s) && is_digit(s[i + 1]) { 返回 read_number(s, i + 1, acc + ".") }
  若 s[i] == "e" || s[i] == "E" {
    若 i + 1 < len(s) && is_digit(s[i + 1]) { 返回 read_number(s, i + 1, acc + "e") }
    若 i + 2 < len(s) && (s[i + 1] == "+" || s[i + 1] == "-") && is_digit(s[i + 2]) {
      返回 read_number(s, i + 2, acc + "e" + s[i + 1])
    }
  }
  返回 {next: i, text: acc}
}

// 读一个字符串，停在收尾的引号上。
//
// 转义要在这里解：早先这一版把内容原样留着，于是目标程序里写 "\t" 拿到的是
// 反斜杠加 t 两个字符 —— 而标准库的空白判断正是靠那一个字符，
// 症状是「修剪不认制表符」，看起来像库里写错了。
// 认五个：n、t、r、反斜杠、引号；别的一律原样留两个字符，不猜。
fn read_string(s: String, i: Int, acc: String) {
  若 i >= len(s) { 返回 {next: i, text: acc, closed: false} }
  若 s[i] == "\"" { 返回 {next: i + 1, text: acc, closed: true} }
  若 s[i] == "\n" { 返回 {next: i, text: acc, closed: false} }
  若 s[i] == "\\" { 返回 read_escape(s, i, acc) }
  返回 read_string(s, i + 1, acc + s[i])
}

fn read_escape(s: String, i: Int, acc: String) -> {next: Int, text: String} {
  若 i + 1 >= len(s) { 返回 {next: i + 1, text: acc + "\\"} }
  定 c = s[i + 1]
  若 c == "n" { 返回 read_string(s, i + 2, acc + "\n") }
  若 c == "t" { 返回 read_string(s, i + 2, acc + "\t") }
  若 c == "r" { 返回 read_string(s, i + 2, acc + "\r") }
  若 c == "\\" { 返回 read_string(s, i + 2, acc + "\\") }
  若 c == "\"" { 返回 read_string(s, i + 2, acc + "\"") }
  返回 read_string(s, i + 2, acc + "\\" + c)
}

// 读一个标点：先看两字符的组合，再看单字符。
fn read_punct(s: String, i: Int) -> {next: Int, text: String} {
  定 two = "-> => == != <= >= && ||"
  定 k = 0
  返回 read_punct_two(s, i, two, k)
}

fn read_punct_two(s: String, i: Int, two: String, k: Int) -> {next: Int, text: String} {
  若 k + 1 >= len(two) { 返回 {next: i + 1, text: s[i] + ""} }
  定 candidate = two[k] + two[k + 1]
  若 two[k] == " " { 返回 read_punct_two(s, i, two, k + 1) }
  若 starts_with(s, i, candidate, 0) { 返回 {next: i + 2, text: candidate} }
  返回 read_punct_two(s, i, two, k + 2)
}

// 主循环：读一个 token，再递归读剩下的。层数等于 token 数。
// 跳过空白、注释，以及（只在不保留换行时）换行本身。
// 这一点很要紧：若让 tokenize 逐个消费换行，每一行都会多占一层递归，
// 一百行的片段就会顶到调用深度上限——同一条边界测试正是这样被撞出来的。
fn skip_trivia(s: String, i: Int, keep_lines: Bool) -> Int {
  若 i >= len(s) { 返回 i }
  若 is_space(s[i]) { 返回 skip_trivia(s, i + 1, keep_lines) }
  若 s[i] == "\n" && !keep_lines { 返回 skip_trivia(s, i + 1, keep_lines) }
  若 s[i] == "/" && i + 1 < len(s) && s[i + 1] == "/" { 返回 skip_trivia(s, skip_to_eol(s, i), keep_lines) }
  若 s[i] == "/" && i + 1 < len(s) && s[i + 1] == "*" { 返回 skip_trivia(s, skip_block(s, i + 2), keep_lines) }
  返回 i
}

// 分块累积（2026-11-02）：token 与「带位置的 token」原来都是一路 acc + (t,)，而元组的
// 加号每次都复制整个元组 —— 一万三千个 token 就是八千五百万个槽，C 机器上要四吉字节
// （量出来的：self/eval.hmoca 的只解析 撞内存上限）。这里改成两层：段内最多 128 个，
// 段满就整段挪进「段们」，最后二分合并 —— 累积成本从 n 的平方降到 n 乘块数，
// 合并成本是 n log 段数。
//
// 128 写成字面量而不是 常量 名字：模块级的 常量 在字节码那条路上不在作用域里，
// 报的是 HMYR-行-005 没有这个名字（2026-11-02 量出来的，bytecode 那套一红九项）。
fn 攒(们: Int, 段: Int, t: Int) {
  定 新 = 段 + (t,)
  若 len(新) >= 128 { 返回 {们: 们 + (新,), 段: ()} }
  返回 {们: 们, 段: 新}
}

// 取一个范围（元组没有切片语法，所以自己走一遍；只在合并时用，量很小）。
fn 取范围(们: Int, i: Int, 末: Int, acc: Int) {
  若 i >= 末 { 返回 acc }
  返回 取范围(们, i + 1, 末, acc + (们[i],))
}

// 二分合并：两半各自合并好再相加，于是每一次元素只被复制 log 段数 次。
//
// 取一半要用 floor 而不是 to_int：to_int 对 1.5 会抛 HMYR-內-008（它是「字符串转整数」，
// 不是取整），而段数是奇数时 3 除 2 正好是 1.5 —— 症状是一串「not an integer literal:
// '1.5' '4.5' '43.5'」，看起来像数字字面量出了问题，其实是在这里（2026-11-02 实测）。
fn 合并们(段们: Int) {
  若 len(段们) == 0 { 返回 () }
  若 len(段们) == 1 { 返回 段们[0] }
  定 半 = floor(len(段们) / 2)
  定 左 = 合并们(取范围(段们, 0, 半, ()))
  定 右 = 合并们(取范围(段们, 半, len(段们), ()))
  返回 左 + 右
}

// 把「段们」与「还没满的最后一段」收成一个元组。
fn 收段(尾: Int) {
  var 段们 = 尾.们
  若 len(尾.段) > 0 { 段们 = 段们 + (尾.段,) }
  返回 合并们(段们)
}

fn tokenize(s: String, at: Int, 们: Int, 段: Int, keep_lines: Bool) {
  定 i = skip_trivia(s, at, keep_lines)
  若 i >= len(s) { 返回 {们: 们, 段: 段} }
  若 s[i] == "\n" {
    // 到这里只能是「保留换行」，不保留的情形已在上面被吃掉
    定 下 = 攒(们, 段, {kind: "newline", text: "\n", at: i})
    返回 tokenize(s, i + 1, 下.们, 下.段, keep_lines)
  }

  // r"..." 是一个字符串，不是「标识符 r 加一个字符串」
  若 (s[i] == "r" || s[i] == "R") && i + 1 < len(s) && s[i + 1] == "\"" {
    定 raw = read_string(s, i + 2, "")
    定 下 = 攒(们, 段, {kind: "string", text: raw.text, at: i})
    返回 tokenize(s, raw.next, 下.们, 下.段, keep_lines)
  }
  若 is_ident_start(s[i]) {
    定 got = read_ident(s, i, "")
    定 下 = 攒(们, 段, {kind: "ident", text: 关键字归一(nfc(got.text)), at: i})
    返回 tokenize(s, got.next, 下.们, 下.段, keep_lines)
  }
  若 is_digit(s[i]) {
    若 s[i] == "0" && i + 1 < len(s) && (s[i + 1] == "x" || s[i + 1] == "X" || s[i + 1] == "b" || s[i + 1] == "B" || s[i + 1] == "o" || s[i + 1] == "O") {
      定 based = read_based(s, i + 2, slice(s, i, i + 2))
      定 下 = 攒(们, 段, {kind: "int", text: based.text, at: i})
      返回 tokenize(s, based.next, 下.们, 下.段, keep_lines)
    }
    定 got = read_number(s, i, "")
    定 下 = 攒(们, 段, {kind: "int", text: got.text, at: i})
    返回 tokenize(s, got.next, 下.们, 下.段, keep_lines)
  }
  若 s[i] == "\"" {
    定 got = read_string(s, i + 1, "")
    定 下 = 攒(们, 段, {kind: "string", text: got.text, at: i})
    返回 tokenize(s, got.next, 下.们, 下.段, keep_lines)
  }
  定 got = read_punct(s, i)
  定 下 = 攒(们, 段, {kind: "punct", text: got.text, at: i})
  返回 tokenize(s, got.next, 下.们, 下.段, keep_lines)
}

// 给每个 token 补上行列。token 本来就带着字符偏移（at），所以这一遍只做一次线性扫描：
// 从上一个 token 的位置走到这一个的位置，遇到换行就翻页。
//
// 为什么要位置：诊断要能说「第 3 行第 7 列」，而宿主的解析器（subset-parse）交出的每个
// 节点都带 line 与 column。self 这一侧以前只有 at，等于只能给字符偏移 —— 那对读的人
// 没有意义。位置从词法这一层带上，后面的节点才有东西可抄。
fn 补位置(tokens: Int, 源码: String) {
  var 们 = ()
  var 段 = ()
  var 行 = 1
  var 列 = 1
  var 看过 = 0
  var i = 0
  当 i < len(tokens) {
    定 t = tokens[i]
    定 at = to_int(t.at)
    var 走 = 看过
    当 走 < at && 走 < len(源码) {
      若 源码[走] == chr(10) {
        行 = 行 + 1
        列 = 1
      } 否则 {
        列 = 列 + 1
      }
      走 = 走 + 1
    }
    看过 = 走
    // 这一趟同样是一万三千次，也分块攒 —— 原来这里是 出 = 出 + (...)，第二个平方在它身上。
    定 攒好 = 攒(们, 段, {kind: t.kind, text: t.text, at: at, line: 行, column: 列})
    们 = 攒好.们
    段 = 攒好.段
    i = i + 1
  }
  若 len(段) > 0 { 们 = 们 + (段,) }
  返回 合并们(们)
}

pub fn scan(text: String) {
  返回 补位置(收段(tokenize(text, 0, (), (), false)), text)
}

// 保留换行的入口：语句边界由此而来。旧入口保持原样，六处既有对拍不受影响。
pub fn scan_lines(text: String) {
  返回 补位置(收段(tokenize(text, 0, (), (), true)), text)
}

fn main() -> Int {
  定 demo = "let x = 1 + 2\n// 注释\nfn f(a: Int) -> Int { return a }"
  返回 len(scan(demo))
}
