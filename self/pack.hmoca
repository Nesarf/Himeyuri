// HMYR 自己把程序打成 .hmyrb。
//
// 为什么要有这一份：src/code-file.mjs 的「写」那一半，是编译器搬进 HMYR 之后
// 最后一块还借在 JS 那边的东西。这一份按格式一格格写字节，落文件由 write_bytes 负责。
//
// 格式照 src/code-file.mjs：
//   "HMYRB" + 版本 u16（现在是 1）
//   u16 函数数，每个函数：名字串、参数量 u16、槽数 u16、效果数 u16、效果串们、
//     指令数 u16、指令们（op u16 + 按形状的立即数）
//   u16 全局名数，每个全局名一个串
// 串 = u16 长度 + 每个 UTF-16 码元一个 u16（小端）。
//
// 两条边界写在这里，因为它们是这一份的存在理由：
//   一、值怎么编码不由这一份决定 —— 那是 pack_value 的事。语言里没有 typeof，
//      也没有 try，所以在语言内部判不出「这个值是数还是串还是记录」。
//      试过用 == () 与 len() 去猜，猜不准，而猜不准的编码器比没有更危险。
//   二、双精度的位同理，交给 f64_bytes。
引入 "./compile.hmoca"
引入 "./paths.hmoca"

// ---- 字节累加：语言里没有可变引用，所以每一步交回新的元组 ----
//
// 而「每一步都复制一次已累积的全部内容」是平方级的：几万字节就撑不住（第十四轮撞到的那次
// out of memory 就是它）。所以按块收：攒够 512 个字节就封成一块，块堆再拼成一个元组。
// 块的数量只有总量的五百一十二分之一，于是复制量从平方掉到接近线性。
//
// 交给 write_bytes 的是「块堆的元组」（二维），由世界那一侧一次拍平写出 ——
// 拍平在那边是一次线性扫描，不在这边一次次复制。
公开 函数 块长() -> Int {
  返回 512
}

函数 空值() {
  返回 {块: (), 小: ()}
}

函数 放(状态: Int, x: Int) {
  定 小 = 状态.小 + (x,)
  若 len(小) >= 块长() { 返回 {块: 状态.块 + (小,), 小: ()} }
  返回 {块: 状态.块, 小: 小}
}

// 收尾：还在手上的那些字节也封成一块，交回块堆。
函数 收尾(状态: Int) -> Int {
  若 len(状态.小) == 0 { 返回 状态.块 }
  返回 状态.块 + (状态.小,)
}

函数 放u16(状态: Int, v: Int) -> Int {
  定 低 = v % 256
  定 高 = (v - 低) / 256
  返回 放(放(状态, 低), ((高 % 256) + 256) % 256)
}

函数 放u32(状态: Int, v: Int) -> Int {
  定 低 = v % 65536
  定 高 = (v - 低) / 65536
  返回 放u16(放u16(状态, 低), ((高 % 65536) + 65536) % 65536)
}

函数 放串(状态: Int, s: String) -> Int {
  变 收 = 放u16(状态, len(s))
  变 i = 0
  当 i < len(s) {
    收 = 放u16(收, ord(s[i]))
    i = i + 1
  }
  返回 收
}

函数 放字节串(状态: Int, 们: Int) -> Int {
  变 收 = 状态
  变 i = 0
  当 i < len(们) {
    收 = 放(收, to_int(们[i]))
    i = i + 1
  }
  返回 收
}

函数 放值(状态: Int, v: Int) -> Int {
  返回 放字节串(状态, pack_value(v))
}

// ---- 指令 ----
函数 操作码(op: String) -> Int {
  若 op == "加" { 返回 0 }
  若 op == "赋值" { 返回 1 }
  若 op == "布尔" { 返回 2 }
  若 op == "调内置" { 返回 3 }
  若 op == "调函数" { 返回 4 }
  若 op == "常量" { 返回 5 }
  若 op == "除" { 返回 6 }
  若 op == "等" { 返回 7 }
  若 op == "字段" { 返回 8 }
  若 op == "大等" { 返回 9 }
  若 op == "全域取" { 返回 10 }
  若 op == "大" { 返回 11 }
  若 op == "索引" { 返回 12 }
  若 op == "跳" { 返回 13 }
  若 op == "假跳" { 返回 14 }
  若 op == "假跳留" { 返回 15 }
  若 op == "真跳" { 返回 16 }
  若 op == "真跳留" { 返回 17 }
  若 op == "小等" { 返回 18 }
  若 op == "取" { 返回 19 }
  若 op == "小" { 返回 20 }
  若 op == "余" { 返回 21 }
  若 op == "乘" { 返回 22 }
  若 op == "不等" { 返回 23 }
  若 op == "负" { 返回 24 }
  若 op == "非" { 返回 25 }
  若 op == "弃" { 返回 26 }
  若 op == "记录" { 返回 27 }
  若 op == "返回" { 返回 28 }
  若 op == "存" { 返回 29 }
  若 op == "减" { 返回 30 }
  若 op == "组" { 返回 31 }
  // 新号追加在末尾，旧号不动 —— 见 src/code-file.mjs 那一行说明。
  若 op == "调方法" { 返回 32 }
  若 op == "全域存" { 返回 33 }
  返回 0 - 1
}

// 一条指令。立即数的形状看 opcode —— 与 src/code-file.mjs 的 立即数形状 一致。
//
// 两个字节宽度容易记错，写在这里：opcode 是 u8，而「指令数」是 u32。
// 记错时的症状是「不认的操作码」—— 因为后面的字节被整体错位读了。
函数 放指令(状态: Int, 码: Int) -> Int {
  变 收 = 放(状态, 操作码(码.op))
  若 码.op == "常量" { 返回 放值(收, 码.a) }
  若 码.op == "取" { 返回 放u16(收, 码.a) }
  若 码.op == "存" {
    若 码.b { 返回 放(放u16(收, 码.a), 1) }
    返回 放(放u16(收, 码.a), 0)
  }
  若 码.op == "赋值" { 返回 放u16(收, 码.a) }
  // GLOBAL 的立即数是一个名字串（别的都按编号），而跳转目标是 u32 ——
  // 与 src/code-file.mjs 的 立即数形状 一致。宽度记错的样子是「整段错位」。
  若 码.op == "全域取" { 返回 放串(收, 码.a) }
  若 码.op == "跳" { 返回 放u32(收, 码.a) }
  若 码.op == "假跳" { 返回 放u32(收, 码.a) }
  若 码.op == "真跳" { 返回 放u32(收, 码.a) }
  若 码.op == "假跳留" { 返回 放u32(收, 码.a) }
  若 码.op == "真跳留" { 返回 放u32(收, 码.a) }
  // 调用：名字串在前，实参数在后 —— 顺序与 src/code-file.mjs 的写者一致。
  // 反过来的症状不是「读不出来」，而是读出来一个两码元的名字，然后整段错位。
  若 码.op == "调函数" { 返回 放u16(放串(收, 码.a), 码.b) }
  若 码.op == "调内置" { 返回 放u16(放串(收, 码.a), 码.b) }
  // 方法调用与那两个同一个形状：名字串在前，实参数在后。
  若 码.op == "调方法" { 返回 放u16(放串(收, 码.a), 码.b) }
  // 顶层常量的登记：立即数是一个名字，与 GLOBAL 同形状。
  若 码.op == "全域存" { 返回 放串(收, 码.a) }
  若 码.op == "字段" { 返回 放串(收, 码.a) }
  若 码.op == "组" { 返回 放u16(收, 码.a) }
  若 码.op == "记录" {
    变 收2 = 放u16(收, len(码.a))
    变 i = 0
    当 i < len(码.a) {
      收2 = 放串(收2, 码.a[i])
      i = i + 1
    }
    返回 收2
  }
  返回 收
}

函数 放函数(状态: Int, 函: Int) -> Int {
  变 收 = 放串(状态, 函.名)
  收 = 放u16(收, 函.参数量)
  收 = 放u16(收, 函.槽数)
  收 = 放u16(收, len(函.效果))
  变 i = 0
  当 i < len(函.效果) {
    收 = 放串(收, 函.效果[i])
    i = i + 1
  }
  收 = 放u32(收, len(函.码))
  变 j = 0
  当 j < len(函.码) {
    收 = 放指令(收, 函.码[j])
    j = j + 1
  }
  返回 收
}

// 打包：函数表 → 字节元组。
函数 打包(函数族: Int) -> Int {
  变 收 = 放(空值(), 72)
  收 = 放(收, 77)
  收 = 放(收, 89)
  收 = 放(收, 82)
  收 = 放(收, 66)
  收 = 放u16(收, 1)
  收 = 放u16(收, len(函数族))
  变 i = 0
  当 i < len(函数族) {
    收 = 放函数(收, 函数族[i])
    i = i + 1
  }
  收 = 放u16(收, 0)
  返回 收尾(收)
}

// ---- 去 引入 ----
//
// 拼接多份源码时，每份里的 引入 行要先拿掉：那几行是「文件之间的接线」，
// 而拼起来之后接线已经由顺序表达过了。留着它们，编译器会把它们当成不认识的语句。
// 这一套与 self/run.hmyr 的 去导入 同形（那里也是逐行看、只认行首的 引入 与词界）。
函数 去首(行: String) -> String {
  若 len(行) == 0 { 返回 行 }
  若 行[0] == " " || 行[0] == chr(9) { 返回 去首(slice(行, 1, len(行))) }
  返回 行
}

函数 找引号(文本: String, 起: Int) -> Int {
  若 起 >= len(文本) { 返回 0 - 1 }
  若 文本[起] == chr(34) { 返回 起 }
  返回 找引号(文本, 起 + 1)
}

函数 是导入行(行: String) -> Bool {
  定 去 = 去首(行)
  定 起 = 导入起(去)
  若 起 < 0 { 返回 假 }
  若 len(去) > 起 && 去[起] != " " && 去[起] != chr(9) && 去[起] != chr(34) { 返回 假 }
  若 找引号(去, 起) < 0 { 返回 假 }
  返回 真
}

// 导入行开头那个关键字占几位；不是导入行就交回 -1。
//
// 两种写法都认，理由与 self/run.hmoca 的 引号里 同一条：这一层看的是源码原文，
// 而词法器归一的是记号。两处要成对修 —— 只修一处等于没修，而坏在这里的症状是
// 「没有这个函数」：库没被接进来，看上去像调用写错了。
函数 导入起(去: String) -> Int {
  若 len(去) >= 6 && slice(去, 0, 6) == "import" { 返回 6 }
  若 len(去) >= 2 && slice(去, 0, 2) == "引入" { 返回 2 }
  返回 -1
}

// 按换行拆成行批。写成循环，而不是「每个字符递归一层」：
// 那种写法的递归深度就是字符数 —— 一份五百多行的源码一万六千层，
// 而这台机器的每一层调用都占一层 C 栈，64 MB 直接见底（实测退出码 0xC00000FD）。

函数 去导入从(行批: Int, i: Int, acc: String) -> String {
  若 i >= len(行批) { 返回 acc }
  若 是导入行(行批[i]) { 返回 去导入从(行批, i + 1, acc) }
  返回 去导入从(行批, i + 1, acc + 行批[i] + chr(10))
}

函数 去导入(源码: String) -> String {
  返回 去导入从(拆行(源码), 0, "")
}

// ---- 走 引入 树 ----
//
// 这一节以前只住在 self/run.hmoca 的「读文件」那一段，而打包这一侧没有它。
// 少它的代价是一处真的错：C 机器的 cli_main 交给种子的是两份参数（输出路径、目标），
// 而种子只用 去导入 剥掉 引入 行就编 —— 于是目标引来的函数一个都不在函数表里。
// 2026-11-02 实测：hmyr.exe self/curve.hmoca 8 编出三十四个块，然后立刻停在
// HMYR-行-005 there is no such function 上。
//
// 这个错可以用一句话说清：去导入 剪掉的是接线，而它只负责「剪」这一半；
// 「把线接上」的另一半以前由启动器（JS）做着，而 C 那条路没有启动器。
//
// 顺序是后序：依赖在前，最后才是入口。理由与 self/run.hmoca 的 加载走 同一条 ——
// 函数表按源码批的顺序接，而重名先到者赢，于是入口的同名实现盖住依赖的。
// self/run.hmoca 的 读一棵 仍然是先序（那边只给工具量顺序用），这一侧不能照抄：
// 两条路顺序不一致，同一个程序会编出与跑出不同的结果。
//
// 路径：认 ./ 与 ../ 开头的、绝对路径、以及「相对本目录的名字」。
// 最后一种要先补 ./（当路径），否则 解析路 会把它当成包名去拼 index.hmoca。

// 这一行是不是「引入 "..."」。是就交回引号里的那一段，不是就交回空串。
//
// 两种写法都认，理由与 是导入行 同一条：这一层看的是源码原文，而词法器归一的是记号。
函数 引号里(行: String) -> String {
  定 去 = 去首(行)
  定 起 = 导入起(去)
  若 起 < 0 { 返回 "" }
  若 len(去) > 起 && 去[起] != " " && 去[起] != chr(9) && 去[起] != chr(34) { 返回 "" }
  定 开 = 找引号(去, 起)
  若 开 < 0 { 返回 "" }
  定 闭 = 找引号(去, 开 + 1)
  若 闭 < 0 { 返回 "" }
  返回 slice(去, 开 + 1, 闭)
}

函数 导入批从(行批: Int, i: Int, acc: Int) -> Int {
  若 i >= len(行批) { 返回 acc }
  定 路 = 引号里(行批[i])
  若 路 == "" { 返回 导入批从(行批, i + 1, acc) }
  返回 导入批从(行批, i + 1, acc + (路,))
}

// 一段源码里引了哪些路径，按出现的顺序。
函数 找导入批(源码: String) -> Int {
  返回 导入批从(拆行(源码), 0, ())
}

// 命令行给进来的是「相对当前目录的路径」，可能不写 ./ 开头（self/sign.hmoca 这样）。
// 而 解析路 按 引入 说明的三种形状去判（路径 / 绝对 / 包名）—— 于是这里补一个 ./，
// 别让「包名」那条分支抓住一条本来就能读的相对路径。
// 这条规矩与 self/run.hmoca 的 当路径 是同一条：那里不补的话，self-load 量出空 order。
函数 当路径(相对: String) -> String {
  若 是路径(相对) { 返回 相对 }
  若 是绝对(相对) { 返回 相对 }
  返回 "./" + 相对
}

// 绝对路径原样交回；./ 开头的与相对名字按目录拼。

函数 含路(已读: Int, 路: String, i: Int) -> Bool {
  若 i >= len(已读) { 返回 假 }
  若 已读[i] == 路 { 返回 真 }
  返回 含路(已读, 路, i + 1)
}

// 最后一个路径分隔符的位置。认 / 与反斜杠两种，因为这台机器两种都会见到。

// 一个文件路径的目录部分：最后一个分隔符之前的那一段。没有分隔符就是 "."。
//
// 这一件存在的理由是一处真的错：子模块的 引入 相对**它自己**的目录，不是相对顶层目标。
// 按顶层目录拼的话，lib/protocol.hmoca 里那句 引入 "./tuples.hmoca" 会被拼到别的目录里，
// 而那份文件恰好不在，于是按「可选引用」跳过 —— 症状是跑起来报「没有这个函数」，
// 看上去像调用写错了地方。

// 绝对路径：以 / 开头，或者第二个字符是盘符冒号。它不该再拼一次目录。
函数 是绝对(相对: String) -> Bool {
  若 len(相对) >= 1 && slice(相对, 0, 1) == "/" { 返回 真 }
  若 len(相对) >= 2 && slice(相对, 1, 2) == ":" { 返回 真 }
  返回 假
}

// 一条 引入 说明是不是「路径」：./ ../ 开头的、绝对路径。其余（形如一个名字）是包名。
函数 是路径(相对: String) -> Bool {
  若 len(相对) >= 2 && slice(相对, 0, 2) == "./" { 返回 真 }
  若 len(相对) >= 3 && slice(相对, 0, 3) == "../" { 返回 真 }
  若 是绝对(相对) { 返回 真 }
  返回 假
}

// 像不像一个包名：不以数字、连字符或点开头，且整段不含斜杠。
// 不成形状的东西（std/io 这种）不是包名，是包管理器将来的事。

// 从某个目录往上找「包根」：最外层的那个含 hmyr.hmkit 的目录。
// 「最外层」是必要的：每个包自己在 hmyr.hmkit 里说明身份，
// 所以「第一个含清单的目录」会是包自己 —— 于是 引入 "乙包" 会被解析成 甲包/乙包/index.hmoca。
// 往上走到底、取最后遇到的那个，才是这个工程的外壳。

// 一个 引入 说明 → 一个路径。
// 包名的规则只有一句：包根下面的一个目录，入口是那个目录里的 index.hmoca。
函数 解析路(目录: String, 相对: String) -> String 效果串(file) {
  若 是绝对(相对) { 返回 相对 }
  若 是路径(相对) { 返回 拼路径(目录, 相对) }
  返回 找包根从(目录, 目录, 0) + "/" + 相对 + "/index.hmoca"
}

// 交回 {已读, 源码批}，所以**不**声明返回类型 —— 声明 Int 会被返回类型检查照出来
// （hmyrpack 就是这么照的：第 414 行「声明返回 Int，交回的是 {已读: ?, 源码批: ?}」）。
// self/run.hmoca 里同名的两件也不声明，照抄的时候别自作主张补上。
函数 读多从(目录: String, 路串: Int, i: Int, 已读: Int, 源码批: Int) 效果串(file) {
  若 i >= len(路串) { 返回 {已读: 已读, 源码批: 源码批, 错: ""} }
  定 r = 读一棵(目录, 路串[i], 已读, 源码批)
  若 r.错 != "" { 返回 {已读: r.已读, 源码批: r.源码批, 错: r.错} }
  返回 读多从(目录, 路串, i + 1, r.已读, r.源码批)
}

// 读一棵：先把它引的都读完，最后才把自己放进去 —— 后序。
//
// 与 self/run.hmoca 那一份有一处要紧的不同：那一份把 已读 + (路,) 与
// 源码批 + (源码,) 一起传下去，于是自己排在依赖前面（先序）。
// 这一侧不能那样：源码批的顺序就是函数表的顺序，而重名先到者赢。
// 传空源码批给子层、回来之后自己追加，顺序才是「依赖在前、入口在后」。
函数 读一棵(目录: String, 相对: String, 已读: Int, 源码批: Int) 效果串(file) {
  定 路 = 解析路(目录, 相对)
  若 含路(已读, 路, 0) { 返回 {已读: 已读, 源码批: 源码批, 错: ""} }
  // 与 self/run.hmoca 同一件事：缺一份 import 要报出来，不跳过。
  若 file_exists(路) == 假 {
    返回 {已读: 已读 + (路,), 源码批: 源码批, 错: "HMYR-載-003 " + 路}
  }
  定 源码 = read_text(路, "utf8")
  // 子模块的 引入 相对**它自己**的目录，不是相对顶层目标。
  //
  // 这里是「接着传进来的批继续收」，所以第五个参数是 源码批 本身。
  // 写完第一版时这里传的是空元组，于是每进一个子模块就把兄弟收好的都丢掉 ——
  // 症状很难认：curve 引 bigint 与 sha512，bigint 被 sha512 那一趟覆盖掉，
  // 打包出来的函数表少了整整一份，跑起来报「没有这个函数：从十六进制」，
  // 而那个名字明明在字节里（调用点的名字池里有它）。
  // 判据是数出来的：JS 那条路 79 个函数，这一条路 56 个，差 23 正是 bigint。
  定 子 = 读多从(目录部分(路), 找导入批(源码), 0, 已读 + (路,), 源码批)
  若 子.错 != "" {
    返回 {已读: 子.已读, 源码批: 子.源码批, 错: 子.错}
  }
  返回 {已读: 子.已读, 源码批: 子.源码批 + (源码,), 错: ""}
}

// 入口：把给的源文件一份一份编，函数表按给的顺序接起来，打包，写出去。
函数 main() -> Int 效果串(process, file) {
  // 分批编，而不是把六份拼成一条链一次编完。
  //
  // 为什么：编译器的指令累积写成「码 + (一条,)」，每发一条就复制一次已经发出的全部，
  // 是平方级。六份拼起来是五千多条指令，而 C 那台分配了不回收 —— 2026 实测那一次
  // 跑到九千零八兆，整机差点被拖垮。一份一份编，每份几百条，平方项小四十倍。
  //
  // 函数表按 argv 顺序接，于是「重名先到者赢」与拼起来再编时完全一致；
  // 全局名那一栏本来就是零（见 打包），所以分批也不动它。
  变 函数族 = ()
  若 len(argv()) > 2 {
    // 先把引入树走一遍（2026-11-02）。以前这里只编 argv 里给的那几份，
    // 而 去导入 把 引入 行剥掉就算完 —— 于是目标引来的函数一个都不在函数表里。
    变 源码批 = ()
    变 已读 = ()
    变 i = 2
    当 i < len(argv()) {
      若 file_exists(argv()[i]) == 假 {
        print("没有这个文件：" + argv()[i])
        返回 1
      }
      定 树 = 读一棵(".", 当路径(argv()[i]), 已读, 源码批)
      已读 = 树.已读
      源码批 = 树.源码批
      i = i + 1
    }
    // 再一份一份编。分批是因为指令累积是平方级（见上面那段注释）；
    // 顺序是因为重名先到者赢 —— 源码批是后序，依赖在前，入口最后。
    变 j = 0
    当 j < len(源码批) {
      定 r = 编源码(去导入(源码批[j]), 1)
      若 r.ok == 假 {
        print("编译失败（第 " + str(j) + " 份）：" + r.错)
        返回 1
      }
      函数族 = 函数族 + r.函数族
      j = j + 1
    }
  } 否则 {
    定 r0 = 编源码("fn main() -> Int {" + chr(10) + "  return 7" + chr(10) + "}" + chr(10), 1)
    若 r0.ok == 假 {
      print("编译失败：" + r0.错)
      返回 1
    }
    函数族 = r0.函数族
  }
  定 字节 = 打包(函数族)
  若 len(argv()) < 2 {
    // 数的是块，不是字节 —— 按块累积之后 len() 给的是块数。
    // 这句以前写着「个字节」，于是启动器里看到的「1 个字节」像是在说
    // 「编出来只有一个字节」，而实际那份字节码有两百多字节。消息说错话，
    // 比没有消息更费时间：查错的人会照它去怀疑错的地方。
    print(str(len(字节)) + " 个块")
    返回 0
  }
  write_bytes(argv()[1], 字节)
  print(str(len(字节)) + " 个块 → " + argv()[1])
  返回 0
}
