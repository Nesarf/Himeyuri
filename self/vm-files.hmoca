// VM 那台机器的文件类内置：read_bytes、write_bytes、write_text、read_dir、is_dir、
// read_text、file_exists。内置的 那一大块分派的第一刀。
//
// 为什么单独立一份（2026-11-05）：与 self/eval* 那七刀同一件事 —— 每条分支三行、
// 不调任何自定义函数，所以整组能搬走而不带依赖。
//
// 交回 {认, 值}：认 是「这名内置归我管」，值是原本那条 {ok, 值, 说} 记录。
// 内置的 只按顺序问每一组，谁先认领谁处理。

公开 函数 求内置文件(名: String, 实参: Int, 圈: Int) {
若 名 == "read_bytes" {
    返回 {认: 真, 值: {ok: 真, 值: read_bytes(实参[0]), 说: ""}}
  }
若 名 == "write_bytes" {
    返回 {认: 真, 值: {ok: 真, 值: write_bytes(实参[0], 实参[1]), 说: ""}}
  }
若 名 == "write_text" {
    返回 {认: 真, 值: {ok: 真, 值: write_text(实参[0], 实参[1]), 说: ""}}
  }
若 名 == "read_dir" {
    返回 {认: 真, 值: {ok: 真, 值: read_dir(实参[0]), 说: ""}}
  }
若 名 == "is_dir" {
    返回 {认: 真, 值: {ok: 真, 值: is_dir(实参[0]), 说: ""}}
  }
若 名 == "read_text" {
    返回 {认: 真, 值: {ok: 真, 值: read_text(实参[0]), 说: ""}}
  }
若 名 == "file_exists" {
    返回 {认: 真, 值: {ok: 真, 值: file_exists(实参[0]), 说: ""}}
  }
  返回 {认: 假, 值: 0}
}
