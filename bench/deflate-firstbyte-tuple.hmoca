// deflate：stored 块与固定 Huffman 两支。
//
// 两支的分工写在名字上：
//   压      stored 块（BTYPE=00）。不压，压缩率 1.0 加五字节头；但它是合法的 deflate，
//           任何标准工具都读得懂。它是「格式对不对」的那一支。
//   固定压  固定 Huffman（BTYPE=01）加 LZ77。这一支才真的压。
//   解      只认 stored 块。固定 Huffman 的流现在由 zlib 解 —— 自举侧的解码器是下一步，
//           而这一步能许的承诺是「压出来的东西标准工具读得懂」。
//
// 一个 stored 块（按字节对齐）：
//   字节 0     BFINAL 在 bit0，BTYPE=00 在 bit1-2
//   字节 1-2   LEN，小端
//   字节 3-4   NLEN，LEN 的反码，小端
//   字节 5..   原始数据
//
// 固定 Huffman 的头三位：BFINAL=1、BTYPE=01，按 LSB 先写，值是 3。
//
// 用法：hmyr self/deflate.hmyr <输入> <输出> [--固定] [--解]

// 折半拼接：元组的 + 是复制，逐块拼是平方级 —— 与 self/compile.hmyr 的 拼两半 同一个形状。
函数 拼平(块堆: Int, 起: Int, 止: Int) -> Int {
  若 止 - 起 <= 1 { 返回 块堆[起] }
  变 左 = 起
  变 右 = 止
  当 右 - 左 > 2 {
    左 = 左 + 1
    右 = 右 - 1
  }
  定 中 = 左 + 1
  返回 拼平(块堆, 起, 中) + 拼平(块堆, 中, 止)
}

函数 字节值(n: Int) -> Int {
  变 v = n % 256
  若 v < 0 { v = v + 256 }
  返回 v
}

函数 剩(总: Int, 起: Int) -> Int {
  定 剩 = 总 - 起
  若 剩 < 0 { 返回 0 }
  返回 剩
}

// ---- stored 块 ----

函数 压(字节串: Int) {
  定 总 = len(字节串)
  变 块堆 = ()
  变 小块 = ()
  变 起 = 0
  变 首 = 真
  当 起 < 总 || 首 {
    变 块 = 剩(总, 起)
    若 块 > 65535 { 块 = 65535 }
    变 是末 = 假
    若 起 + 块 >= 总 { 是末 = 真 }
    变 头 = 0
    若 是末 { 头 = 1 }
    定 反 = 65535 - 块
    小块 = 小块 + (头, 字节值(块), 字节值((块 - 块 % 256) / 256), 字节值(反), 字节值((反 - 反 % 256) / 256))
    变 i = 0
    当 i < 块 {
      小块 = 小块 + (字节值(to_int(字节串[起 + i])),)
      若 len(小块) >= 1024 {
        块堆 = 块堆 + (小块,)
        小块 = ()
      }
      i = i + 1
    }
    起 = 起 + 块
    首 = 假
  }
  若 len(小块) > 0 { 块堆 = 块堆 + (小块,) }
  返回 拼平(块堆, 0, len(块堆))
}

// 解：只认 BTYPE=00，一路读到 BFINAL=1 为止。
函数 解(字节串: Int) {
  定 总 = len(字节串)
  变 块堆 = ()
  变 小块 = ()
  变 at = 0
  变 完 = 假
  当 !完 && at + 5 <= 总 {
    定 头 = to_int(字节串[at])
    at = at + 1
    定 末 = 头 % 2
    定 型 = (头 - 末) / 2 % 4
    若 型 != 0 {
      完 = 真
    } 否则 {
      定 长 = to_int(字节串[at]) + to_int(字节串[at + 1]) * 256
      at = at + 4
      变 i = 0
      当 i < 长 && at < 总 {
        小块 = 小块 + (to_int(字节串[at]),)
        若 len(小块) >= 1024 {
          块堆 = 块堆 + (小块,)
          小块 = ()
        }
        at = at + 1
        i = i + 1
      }
      若 末 == 1 { 完 = 真 }
    }
  }
  若 len(小块) > 0 { 块堆 = 块堆 + (小块,) }
  若 len(块堆) == 0 { 返回 () }
  返回 拼平(块堆, 0, len(块堆))
}

// ---- 位流：deflate 的位是按 LSB 先写进字节的 ----

函数 倍(n: Int) -> Int {
  变 v = 1
  变 i = 0
  当 i < n {
    v = v * 2
    i = i + 1
  }
  返回 v
}

// Huffman 码本身是高位先写，而位流是低位先写 —— 所以先把这个码的位序翻过来。
函数 反转位(码: Int, 位数: Int) -> Int {
  变 出 = 0
  变 值 = 码
  变 i = 0
  当 i < 位数 {
    定 位 = 值 % 2
    出 = 出 * 2 + 位
    值 = (值 - 位) / 2
    i = i + 1
  }
  返回 出
}

函数 放位(状: Int, 值: Int, 位数: Int) {
  变 字节串 = 状.字节串
  变 当前 = 状.当前
  变 已 = 状.已
  变 v = 值
  变 i = 0
  当 i < 位数 {
    定 位 = v % 2
    当前 = 当前 + 位 * 倍(已)
    已 = 已 + 1
    若 已 >= 8 {
      字节串 = 字节串 + (当前,)
      当前 = 0
      已 = 0
    }
    v = (v - 位) / 2
    i = i + 1
  }
  返回 {字节串: 字节串, 当前: 当前, 已: 已}
}

函数 刷(状: Int) {
  变 字节串 = 状.字节串
  若 状.已 > 0 { 字节串 = 字节串 + (状.当前,) }
  返回 {字节串: 字节串, 已: 0, 当前: 0}
}

// ---- 固定 Huffman 的码表（RFC 1951） ----

// 固定 Huffman 的符号码覆盖 0-287：字面量、结束码 256 与长度码 257-285 都在这一张表里，
// 但分段不同 —— 把长度码当字面量编，解出来的东西会在第一个匹配处就错。
//   0-143   八位   0x30 + 符号
//   144-255 九位   0x190 + (符号 - 144)
//   256-279 七位   符号 - 256
//   280-287 八位   0xC0 + (符号 - 280)
函数 符号码(s: Int) -> Int {
  若 s <= 143 { 返回 48 + s }
  若 s <= 255 { 返回 400 + (s - 144) }
  若 s <= 279 { 返回 s - 256 }
  返回 192 + (s - 280)
}

函数 符号位数(s: Int) -> Int {
  若 s <= 143 { 返回 8 }
  若 s <= 255 { 返回 9 }
  若 s <= 279 { 返回 7 }
  返回 8
}

// 每一项是 (基值, 码, 额外位)。
函数 长表() {
  返回 ((3, 257, 0), (4, 258, 0), (5, 259, 0), (6, 260, 0), (7, 261, 0), (8, 262, 0), (9, 263, 0), (10, 264, 0),
    (11, 265, 1), (13, 266, 1), (15, 267, 1), (17, 268, 1), (19, 269, 2), (23, 270, 2), (27, 271, 2), (31, 272, 2),
    (35, 273, 3), (43, 274, 3), (51, 275, 3), (59, 276, 3), (67, 277, 4), (83, 278, 4), (99, 279, 4), (115, 280, 4),
    (131, 281, 5), (163, 282, 5), (195, 283, 5), (227, 284, 5), (258, 285, 0))
}

函数 距表() {
  返回 ((1, 0, 0), (2, 1, 0), (3, 2, 0), (4, 3, 0), (5, 4, 1), (7, 5, 1), (9, 6, 2), (13, 7, 2),
    (17, 8, 3), (25, 9, 3), (33, 10, 4), (49, 11, 4), (65, 12, 5), (97, 13, 5), (129, 14, 6), (193, 15, 6),
    (257, 16, 7), (385, 17, 7), (513, 18, 8), (769, 19, 8), (1025, 20, 9), (1537, 21, 9), (2049, 22, 10), (3073, 23, 10),
    (4097, 24, 11), (6145, 25, 11), (8193, 26, 12), (12289, 27, 12), (16385, 28, 13), (24577, 29, 13))
}

// 查表：从后往前扫，第一个「基值 <= 值」的就是它。
函数 查表(表: Int, 值: Int) -> Int {
  变 i = len(表) - 1
  当 i >= 0 {
    若 表[i][0] <= 值 { 返回 表[i] }
    i = i - 1
  }
  返回 表[0]
}

// 在窗口里找最长匹配。窗口取 4096：自举那一层的执行是逐条的，32K 窗口在四十三千字节上
// 会把这一件拖成分钟级；4096 是「够压一点、又不至于太慢」的那一档，写在明处。
// 对照用：首字节分桶，与 self/deflate.hmyr 只差 哈希 与 链们 两处，其余逐字相同。
//
// 桶用可变数组，这是加 数组/设 的唯一理由：桶的更新要 O(1)。
// 早先按首字节分桶、桶用元组时，改一次桶就是重建整个元组 —— 四万三千字节压了七十二秒，
// 而同样的算法在宿主那边只要零点零三秒。
函数 哈希(字节串: Int, i: Int) -> Int {
  // 首字节桶（元组版）
  返回 to_int(字节串[i]) % 256
}

函数 链们(字节串: Int) {
  定 总 = len(字节串)
  变 头初 = ()
  变 i = 0
  当 i < 256 {
    头初 = 头初 + (0 - 1,)
    i = i + 1
  }
  // 桶是元组：每改一次都要重建整个元组，这就是九倍差距的来源。
  变 头 = 头初
  变 块堆 = ()
  变 小块 = ()
  i = 0
  当 i < 总 {
    小块 = 小块 + (0 - 1,)
    若 len(小块) >= 1024 {
      块堆 = 块堆 + (小块,)
      小块 = ()
    }
    i = i + 1
  }
  若 len(小块) > 0 { 块堆 = 块堆 + (小块,) }
  变 链初 = ()
  若 len(块堆) > 0 { 链初 = 拼平(块堆, 0, len(块堆)) }
  定 链列 = 数组(链初)
  i = 0
  当 i < 总 {
    定 桶 = 哈希(字节串, i)
    设(链列, i, to_int(头[桶]))
    头 = 置(头, 桶, i)
    i = i + 1
  }
  返回 链列
}

函数 找匹配(字节串: Int, 链: Int, i: Int) {
  定 总 = len(字节串)
  变 最 = 0
  变 距 = 0
  定 限 = i - 4096
  变 j = to_int(链[i])
  当 j >= 0 && j >= 限 {
    变 长 = 0
    当 长 < 258 && i + 长 < 总 && j + 长 < 总 && 字节串[i + 长] == 字节串[j + 长] {
      长 = 长 + 1
    }
    若 长 > 最 {
      最 = 长
      距 = i - j
      若 最 == 258 { 返回 {长: 最, 距: 距} }
    }
    j = to_int(链[j])
  }
  返回 {长: 最, 距: 距}
}

// ---- 动态 Huffman 的编码侧 ----

函数 置(元组: Int, 下标: Int, 值: Int) {
  变 出 = ()
  变 i = 0
  当 i < len(元组) {
    若 i == 下标 { 出 = 出 + (值,) } 否则 { 出 = 出 + (to_int(元组[i]),) }
    i = i + 1
  }
  返回 出
}

// 先切 token：字面量或（长度, 距离）。统计与编码都要这一份。
函数 切块(字节串: Int) {
  定 链 = 链们(字节串)
  变 列 = ()
  变 i = 0
  当 i < len(字节串) {
    定 匹 = 找匹配(字节串, 链, i)
    变 长 = 匹.长
    // 懒惰匹配：下一个位置的匹配更长时，当前这一位只写字面量。
    若 长 >= 3 && i + 1 < len(字节串) {
      定 下 = 找匹配(字节串, 链, i + 1)
      若 下.长 > 长 { 长 = 0 }
    }
    若 长 >= 3 {
      列 = 列 + ({类: 1, 长: 长, 距: 匹.距},)
      i = i + 长
    } 否则 {
      列 = 列 + ({类: 0, 值: to_int(字节串[i])},)
      i = i + 1
    }
  }
  返回 列
}

// 只写字面量：不做匹配。它与 ref-encoder.mjs 用同一份输入时会得到同一棵树，
// 于是两份流可以逐位对照 —— 对着看才能分清「树不同」和「序列化错」。
函数 切字面(字节串: Int) {
  变 列 = ()
  变 i = 0
  当 i < len(字节串) {
    列 = 列 + ({类: 0, 值: to_int(字节串[i])},)
    i = i + 1
  }
  返回 列
}

函数 统计(列: Int) {  变 字频 = ()
  变 i = 0
  当 i < 286 {
    字频 = 字频 + (0,)
    i = i + 1
  }
  变 距频 = ()
  i = 0
  当 i < 30 {
    距频 = 距频 + (0,)
    i = i + 1
  }
  i = 0
  当 i < len(列) {
    定 t = 列[i]
    若 t.类 == 0 {
      字频 = 置(字频, t.值, to_int(字频[t.值]) + 1)
    } 否则 {
      定 长码 = 查表(长表(), t.长)
      字频 = 置(字频, 长码[1], to_int(字频[长码[1]]) + 1)
      定 距码 = 查表(距表(), t.距)
      距频 = 置(距频, 距码[1], to_int(距频[距码[1]]) + 1)
    }
    i = i + 1
  }
  // 结束码 256 至少要出现一次，否则它没有码。
  字频 = 置(字频, 256, to_int(字频[256]) + 1)
  // 距离表至少要有一个码：没有匹配时它是空的，而空表是非法码集。
  若 to_int(距频[0]) == 0 { 距频 = 置(距频, 0, 1) }
  返回 {字频: 字频, 距频: 距频}
}

// 建 Huffman 树再取码长：每次合并权重最小的两个，最后从每个叶子沿父链数层数。
函数 码长簇(频们: Int) {
  变 权 = ()
  变 父 = ()
  变 活 = ()
  变 i = 0
  当 i < len(频们) {
    权 = 权 + (to_int(频们[i]),)
    父 = 父 + (0 - 1,)
    // 频 0 的符号不进树：进了会把树拉深，码长多算一位，Kraft 和就凑不满。
    若 to_int(频们[i]) > 0 { 活 = 活 + (i,) }
    i = i + 1
  }
  当 len(活) > 1 {
    变 甲 = 0 - 1
    变 乙 = 0 - 1
    变 甲权 = 0 - 1
    变 乙权 = 0 - 1
    变 k = 0
    当 k < len(活) {
      定 号 = to_int(活[k])
      定 w = to_int(权[号])
      若 甲权 < 0 || w < 甲权 {
        乙 = 甲
        乙权 = 甲权
        甲 = 号
        甲权 = w
      } 否则 若 乙权 < 0 || w < 乙权 {
        乙 = 号
        乙权 = w
      }
      k = k + 1
    }
    定 新 = len(权)
    权 = 权 + (甲权 + 乙权,)
    父 = 父 + (0 - 1,)
    父 = 置(父, 甲, 新)
    父 = 置(父, 乙, 新)
    变 新活 = ()
    k = 0
    当 k < len(活) {
      定 号 = to_int(活[k])
      若 号 != 甲 && 号 != 乙 { 新活 = 新活 + (号,) }
      k = k + 1
    }
    活 = 新活 + (新,)
  }
  变 长簇 = ()
  i = 0
  当 i < len(频们) {
    变 深 = 0
    若 to_int(频们[i]) > 0 {
      变 号 = i
      当 to_int(父[号]) >= 0 {
        深 = 深 + 1
        号 = to_int(父[号])
      }
    }
    长簇 = 长簇 + (深,)
    i = i + 1
  }
  返回 长簇
}

// 每长度的第一个规范码：首[长+1] = (首[长] + 数[长]) * 2。
函数 首码们(长簇: Int) {
  变 数 = ()
  变 i = 0
  当 i <= 15 {
    数 = 数 + (0,)
    i = i + 1
  }
  i = 0
  当 i < len(长簇) {
    定 l = to_int(长簇[i])
    若 l > 0 && l <= 15 { 数 = 置(数, l, to_int(数[l]) + 1) }
    i = i + 1
  }
  变 首 = (0,)
  变 码 = 0
  变 长 = 0
  当 长 < 15 {
    码 = (码 + to_int(数[长])) * 2
    首 = 首 + (码,)
    长 = 长 + 1
  }
  返回 {数: 数, 首: 首}
}

// 一个符号的规范码：首[长] 加上它在本长度里的序号。
函数 规范码(长簇: Int, 信息: Int, 符号: Int) -> Int {
  定 长 = to_int(长簇[符号])
  若 长 == 0 { 返回 0 }
  变 序 = 0
  变 i = 0
  当 i < 符号 {
    若 to_int(长簇[i]) == 长 { 序 = 序 + 1 }
    i = i + 1
  }
  返回 to_int(信息.首[长]) + 序
}

函数 写符号(状: Int, 长簇: Int, 信息: Int, 符号: Int) {
  定 长 = to_int(长簇[符号])
  若 长 == 0 { 返回 状 }
  定 码 = 规范码(长簇, 信息, 符号)
  返回 放位(状, 反转位(码, 长), 长)
}

// 把 316 个码长写成「码长码表」那一层，并且用 16/17/18 压缩连续相同。
// 规则（RFC 1951 §3.2.7）：
//   16  重复前一个码长 3-6 次，后跟 2 位（次数减三）
//   17  重复 0 共 3-10 次，后跟 3 位（次数减三）
//   18  重复 0 共 11-138 次，后跟 7 位（次数减十一）
函数 码长符号(全长: Int) {
  变 列 = ()
  变 i = 0
  当 i < len(全长) {
    定 v = to_int(全长[i])
    变 次 = 1
    当 i + 次 < len(全长) && to_int(全长[i + 次]) == v { 次 = 次 + 1 }
    若 v == 0 {
      变 余 = 次
      当 余 >= 11 {
        变 用 = 余
        若 用 > 138 { 用 = 138 }
        列 = 列 + ({符: 18, 位: 7, 值: 用 - 11},)
        余 = 余 - 用
      }
      当 余 >= 3 {
        变 用2 = 余
        若 用2 > 10 { 用2 = 10 }
        列 = 列 + ({符: 17, 位: 3, 值: 用2 - 3},)
        余 = 余 - 用2
      }
      当 余 > 0 {
        列 = 列 + ({符: 0, 位: 0, 值: 0},)
        余 = 余 - 1
      }
    } 否则 {
      列 = 列 + ({符: v, 位: 0, 值: 0},)
      变 剩 = 次 - 1
      当 剩 >= 3 {
        变 用3 = 剩
        若 用3 > 6 { 用3 = 6 }
        列 = 列 + ({符: 16, 位: 2, 值: 用3 - 3},)
        剩 = 剩 - 用3
      }
      当 剩 > 0 {
        列 = 列 + ({符: v, 位: 0, 值: 0},)
        剩 = 剩 - 1
      }
    }
    i = i + 次
  }
  返回 列
}

函数 写码长层(状: Int, 字长: Int, 距长: Int) {
  变 全长 = ()
  变 i = 0
  当 i < len(字长) {
    全长 = 全长 + (to_int(字长[i]),)
    i = i + 1
  }
  i = 0
  当 i < len(距长) {
    全长 = 全长 + (to_int(距长[i]),)
    i = i + 1
  }
  定 列 = 码长符号(全长)
  // 十九个符号（0-15 加 16/17/18）各自的频率
  变 频 = ()
  i = 0
  当 i < 19 {
    频 = 频 + (0,)
    i = i + 1
  }
  i = 0
  当 i < len(列) {
    定 符 = to_int(列[i].符)
    频 = 置(频, 符, to_int(频[符]) + 1)
    i = i + 1
  }
  变 长码长 = 码长簇(频)
  定 信息 = 首码们(长码长)
  变 s = 放位(状, 15, 4)
  定 顺 = (16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15)
  i = 0
  当 i < 19 {
    s = 放位(s, to_int(长码长[to_int(顺[i])]), 3)
    i = i + 1
  }
  i = 0
  当 i < len(列) {
    定 项 = 列[i]
    s = 写符号(s, 长码长, 信息, to_int(项.符))
    若 to_int(项.位) > 0 { s = 放位(s, to_int(项.值), to_int(项.位)) }
    i = i + 1
  }
  返回 {状: s, 全长: 全长}
}


// 动态 Huffman：BTYPE=10。
函数 动态压(字节串: Int, 字面: Int) {
  变 列 = 切块(字节串)
  若 字面 { 列 = 切字面(字节串) }
  定 频 = 统计(列)
  定 字长 = 码长簇(频.字频)
  定 距长 = 码长簇(频.距频)
  定 字信 = 首码们(字长)
  定 距信 = 首码们(距长)
  // 头三位：BFINAL=1、BTYPE=10 —— 按 LSB 先写，值是 5。
  变 状 = 放位({字节串: (), 当前: 0, 已: 0}, 5, 3)
  状 = 放位(状, len(字长) - 257, 5)
  状 = 放位(状, len(距长) - 1, 5)
  定 层 = 写码长层(状, 字长, 距长)
  变 s = 层.状
  变 出串 = ()
  变 小块 = ()
  变 i = 0
  当 i < len(列) {
    定 t = 列[i]
    若 t.类 == 0 {
      s = 写符号(s, 字长, 字信, t.值)
    } 否则 {
      定 长码 = 查表(长表(), t.长)
      s = 写符号(s, 字长, 字信, 长码[1])
      若 长码[2] > 0 { s = 放位(s, t.长 - 长码[0], 长码[2]) }
      定 距码 = 查表(距表(), t.距)
      s = 写符号(s, 距长, 距信, 距码[1])
      若 距码[2] > 0 { s = 放位(s, t.距 - 距码[0], 距码[2]) }
    }
    小块 = s.字节串
    若 len(小块) >= 1024 {
      出串 = 出串 + (小块,)
      s = {字节串: (), 当前: s.当前, 已: s.已}
    }
    i = i + 1
  }
  s = 写符号(s, 字长, 字信, 256)
  s = 刷(s)
  定 尾 = s.字节串
  若 len(尾) > 0 { 出串 = 出串 + (尾,) }
  若 len(出串) == 0 { 返回 () }
  返回 拼平(出串, 0, len(出串))
}


// 固定 Huffman：有匹配就放 length + distance，没有就放字面量。末尾放结束码 256。
函数 固定压(字节串: Int) {
  定 总 = len(字节串)
  定 链 = 链们(字节串)
  变 状 = {字节串: (), 当前: 0, 已: 0}
  变 块堆 = ()
  变 起 = 0
  变 完 = 假
  当 !完 {
    // 每 65535 字节一块：块头的 BFINAL 只在最后一块置位。
    变 止 = 起 + 65535
    若 止 >= 总 {
      止 = 总
      完 = 真
    }
    变 头 = 2
    若 完 { 头 = 3 }
    状 = 放位(状, 头, 3)
    变 i = 起
    当 i < 止 {
      定 匹 = 找匹配(字节串, 链, i)
      变 长 = 匹.长
      // 匹配不能越过块尾：长度先夹一下。
      若 i + 长 > 止 { 长 = 止 - i }
      若 长 >= 3 {
        定 长项 = 查表(长表(), 长)
        定 长码 = 长项[1]
        状 = 放位(状, 反转位(符号码(长码), 符号位数(长码)), 符号位数(长码))
        若 长项[2] > 0 { 状 = 放位(状, 长 - 长项[0], 长项[2]) }
        定 距项 = 查表(距表(), 匹.距)
        状 = 放位(状, 反转位(距项[1], 5), 5)
        若 距项[2] > 0 { 状 = 放位(状, 匹.距 - 距项[0], 距项[2]) }
        i = i + 长
      } 否则 {
        定 b = 字节值(to_int(字节串[i]))
        状 = 放位(状, 反转位(符号码(b), 符号位数(b)), 符号位数(b))
        i = i + 1
      }
      定 小块 = 状.字节串
      若 len(小块) >= 1024 {
        块堆 = 块堆 + (小块,)
        状 = {字节串: (), 当前: 状.当前, 已: 状.已}
      }
    }
    // 这一块的结束码 256
    状 = 放位(状, 0, 7)
    若 len(状.字节串) > 0 { 块堆 = 块堆 + (状.字节串,) }
    状 = {字节串: (), 当前: 状.当前, 已: 状.已}
    起 = 止
  }
  状 = 刷(状)
  定 尾 = 状.字节串
  若 len(尾) > 0 { 块堆 = 块堆 + (尾,) }
  若 len(块堆) == 0 { 返回 () }
  返回 拼平(块堆, 0, len(块堆))
}

函数 main() -> Int 效果串(file) {
  定 参 = argv()
  若 len(参) < 3 {
    print("用法：hmyr self/deflate.hmyr <输入> <输出> [--固定] [--解]" + chr(10))
    返回 2
  }
  变 固定 = 假
  变 动态 = 假
  变 字面 = 假
  变 解模式 = 假
  变 i = 0
  当 i < len(参) {
    若 参[i] == "--固定" { 固定 = 真 }
    若 参[i] == "--动态" { 动态 = 真 }
    若 参[i] == "--字面" {
      动态 = 真
      字面 = 真
    }
    若 参[i] == "--解" { 解模式 = 真 }
    i = i + 1
  }
  定 字节串 = read_bytes(参[1])
  变 出 = 压(字节串)
  若 固定 { 出 = 固定压(字节串) }
  若 动态 { 出 = 动态压(字节串, 字面) }
  若 解模式 { 出 = 解(字节串) }
  write_bytes(参[2], 出)
  print(str(len(字节串)) + " → " + str(len(出)) + chr(10))
  返回 0
}
