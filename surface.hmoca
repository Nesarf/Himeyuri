// 表面：一个可绘制的东西。
//
// 主窗口是一张大表面，每个子窗口是一张自己的表面。这一层只做纯数据：
// 表面有名字、宽高、位置，以及一张字符画布——与 term 那套画布同一个表示。
//
// 于是「主窗口里多开子窗口」在还没有真窗口之前就能先跑起来：
// 合成规则与将来真窗口要走的规则完全一样，只是画布是字符而不是像素。
//
// 依赖写清楚：画布、换行、贴行都来自 term.hmyr。

引入 "./term.hmoca"
引入 "./task.hmoca"

函数 新表面(名: String, 行: Int, 列: Int) -> Int {
  返回 {name: 名, rows: 行, cols: 列, x: 0, y: 0, owner: -1, 布: 空画布(行, 列)}
}

// 放它在主表面上的位置。位置是表面自己的属性，所以改位置要重建一个记录——
// 这门语言的 定 不可变，而这样正好避免了「两个地方各记一份坐标」。
函数 放(表面: Int, x: Int, y: Int) -> Int {
  返回 {name: 表面.name, rows: 表面.rows, cols: 表面.cols, x: x, y: y, owner: 表面.owner, 布: 表面.布}
}

// 把它挂到一个任务下。owner 为 -1 表示它不属于任何任务（主表面就是这样）。
函数 归主(表面: Int, owner: Int) -> Int {
  返回 {name: 表面.name, rows: 表面.rows, cols: 表面.cols, x: 表面.x, y: 表面.y, owner: owner, 布: 表面.布}
}

// 在表面里写一行字，从指定列开始。越界交给贴行处理：它按起点消费片段。
函数 写(表面: Int, 行号: Int, 列号: Int, 文字: String) -> Int {
  若 行号 < 0 || 行号 >= 表面.rows { 返回 表面 }
  返回 {name: 表面.name, rows: 表面.rows, cols: 表面.cols, x: 表面.x, y: 表面.y, owner: 表面.owner,
          布: 换行(表面.布, 行号, 贴行(表面.布[行号], 文字, 列号))}
}

// 把一张子表面的每一行贴到主布上；越界的行直接跳过。
// 后贴的盖住先贴的——与场景栈同一个次序，于是「字幕叠在背景上」那套经验照用。
函数 贴从(布: Int, 子: Int, i: Int) -> Int {
  若 i >= len(子.布) { 返回 布 }
  定 目标行 = 子.y + i
  若 目标行 < 0 || 目标行 >= len(布) { 返回 贴从(布, 子, i + 1) }
  返回 贴从(换行(布, 目标行, 贴行(布[目标行], 子.布[i], 子.x)), 子, i + 1)
}

函数 合成(布: Int, 子批: Int, i: Int) -> Int {
  若 i >= len(子批) { 返回 布 }
  返回 合成(贴从(布, 子批[i], 0), 子批, i + 1)
}

// 在场：owner 为 -1（主表面）或那个 owner 还在任务树里。
//
// 这是「关掉子窗口，画面就没了」的全部实现——不是把表面删掉，而是合成时过滤掉。
// 与任务树那边「取消是子树查询，不是删数据」同一个立场。
函数 在场从(表: Int, 树: Int, i: Int, acc: Int) -> Int {
  若 i >= len(表) { 返回 acc }
  定 一 = 表[i]
  若 一.owner < 0 { 返回 在场从(表, 树, i + 1, acc + (一,)) }
  若 有id(树, 一.owner) { 返回 在场从(表, 树, i + 1, acc + (一,)) }
  返回 在场从(表, 树, i + 1, acc)
}

函数 在场(表: Int, 树: Int) -> Int {
  返回 在场从(表, 树, 0, ())
}

// 合成的另一条入口：只贴在场的那些。真窗口将来照抄这一条就够了。
函数 合成在场(布: Int, 表: Int, 树: Int) -> Int {
  返回 合成(布, 在场(表, 树), 0)
}

// 合成一整帧：清屏、归位、逐行写出。与 term 的 画一帧 同一件事，
// 只是这里的布可能由好几张表面叠成。
函数 画表面(布: Int) -> String {
  返回 清屏() + 归位() + 画行(布, 0)
}

// ---- 呈现后端 ----
//
// 程序只认「布」与「呈现」，而「呈现到哪里」由后端决定。
// 现在只有一个后端：字符终端。将来多一个真窗口，程序不用改一行。
函数 后端名() -> String {
  返回 "term"
}

函数 呈现(后端: String, 布: Int) -> String {
  若 后端 == "term" { 返回 画表面(布) }
  返回 "错：没有这个后端：" + 后端
}

// 脚本路径与颜色那条桥一样：写在一个地方，调用处不必知道绝对路径。
函数 脚本路径() -> String {
  返回 repo_path("deps/surface/win.ps1")
}

// POSIX 那一份：同一件事、同一份回执，只做 -NoShow 那条路（见那个文件头）。
函数 脚本路径py() -> String {
  返回 repo_path("deps/surface/win.py")
}

// 两台各一份脚本，而这一层不判断平台：先试 powershell、失败再试 python3。
// 在 Windows 上第一个就成；在 Linux 上 powershell 根本起不来（ENOENT）。
// 与 parallel.hmoca 那一条回退是同一个写法，理由也一样 —— 行为本身就是判据，
// 不必再引一个「我在哪台机器上」的内置（language 那一侧今天没有 platform()）。
//
// 交回 {ok, text}：ok 只在真拿到退出码 0 时为真，text 是「退出码 N · 回执」。
// 调用处三个（呈现进程、呈现图像、会话）形状一致，所以只写这一份。
函数 试两路(参: Int) -> Int 效果串(process) {
  定 甲 = run_program("powershell", ("-NoProfile", "-STA", "-File", 脚本路径()) + 参, 20000, "utf8")
  若 甲.code == 0 { 返回 {ok: 真, text: "退出码 " + str(甲.code) + " · " + 甲.stdout} }
  定 乙 = run_program("python3", (脚本路径py(),) + 参, 20000, "utf8")
  返回 {ok: 乙.code == 0, text: "退出码 " + str(乙.code) + " · " + 乙.stdout + 乙.stderr}
}

// 呈现到某个后端，并且会真的动世界（native 要起一个进程）。
// 与上面的 呈现 分开：那一个是纯的，只交出字符串；这一个要 process 效果。
函数 呈现进程(后端: String, 布: Int, 文字: String) -> Int 效果串(process) {
  若 后端 == "term" { 返回 {ok: 真, text: 呈现("term", 布)} }
  若 后端 == "native" {
    返回 试两路(("-Width", "640", "-Height", "400", "-Text", 文字, "-NoShow"))
  }
  返回 {ok: 假, text: "没有这个后端：" + 后端}
}

// 呈现一张图像（像素布导出的 PNG）。与 呈现进程 分开一个入口，
// 因为它们的参数不同：一个是「一段文字」，一个是「一个文件」。
函数 呈现图像(后端: String, 图像路径: String) -> Int 效果串(process) {
  若 后端 == "native" {
    返回 试两路(("-Image", 图像路径, "-NoShow"))
  }
  返回 {ok: 假, text: "这个后端还不呈现图像：" + 后端}
}

// 一段会话：开窗、跑一段消息循环、收事件、换帧、关窗、把回执交回来。
//
// 与 呈现进程 分开，因为它们是两件事：那一条是「放一张静态的帧就关」，
// 这一条是「陪它待一会儿」—— 中间那段时间里窗口是活的，键与点击进得去，
// 帧也会换。回执仍然是一行 JSON，多了 events 与 frames 两张表。
//
// 毫秒 小于等于 0 时不弹窗，只验管道与回执 —— 那是套件走的路，也是
// 「这条会话的形状对不对」与「它会不会真弹」分开的原因。
//
// 事件 是注入的事件串（"key:A;mouse:10,20"），空串表示没有。它只为自动化存在：
// 真窗口自己收到的键与点击会与它进同一张表，所以真人用时这一栏空着就行。
公开 函数 会话(后端: String, 布: Int, 文字: String, 毫秒: Int, 帧间隔: Int, 事件: String) -> Int 效果串(process) {
  若 后端 == "native" {
    定 参 = ("-Width", "640", "-Height", "400", "-Text", 文字,
      "-EventMs", str(毫秒), "-Frames", str(帧间隔), "-Events", 事件)
    若 毫秒 <= 0 { 返回 试两路(参 + ("-NoShow",)) }
    返回 试两路(参)
  }
  返回 {ok: 假, text: "这个后端还不开会话：" + 后端}
}

函数 main() -> Int 效果串(process) {
  定 主 = 空画布(6, 24)
  定 a = 写(放(新表面("A", 2, 10), 1, 1), 0, 0, "子窗口 A")
  定 b = 写(放(新表面("B", 2, 10), 12, 3), 0, 0, "子窗口 B")
  定 成 = 合成(主, (a, b), 0)
  print("合成之后（主 6 行 24 列，两张子表面各 2 行 10 列）：\n")
  print(成[1] + "\n" + 成[3] + "\n")
  返回 0
}
