// 自举比例：仓库里有多少行是 HMYR 自己写的，多少行是别的语言写的。
//
// 这一份是 tools/self-ratio.mjs 的 HMYR 版，口径与它相同（不含 test/，不含 data/
// 与 deps/ 里的语料）—— 两台机器跑同一件事、给同一个答案，那是第二段一直在做的
// 那种对照。这一版只报行数（文件数下轮再补：元组返回在这一层的类型推断还没过）。
//
// 这个数字只在一个方向上诚实。净增 HMYR 代码能让它涨；把对照实现删掉也能让它涨 ——
// 而后者会拆掉「两台机器同一个答案」那句话。所以这一份只报数，不给结论。
//
// 用法：hmyr tools/self-ratio.hmoca
fn 尾是(名: String, 后缀: String) -> Bool {
  // 后缀不带点（hmoca / mjs / c），看名字最后一段是不是它。
  let 段 = split(名, ".")
  if len(段) < 2 { return false }
  return 段[len(段) - 1] == 后缀
}

// 数一份内容的行数：末尾那个换行不算多出一行（与 wc -l 同一个口径）。
fn 数行(内容: String) -> Int {
  let 段 = split(内容, chr(10))
  if len(段) > 0 {
    if 段[len(段) - 1] == "" { return len(段) - 1 }
  }
  return len(段)
}

// 一个目录下所有匹配后缀的文件一共多少行。深度上限 24：防环。
fn 数(相对: String, 后缀: String, 次: Int) -> Int effects(file) {
  if 次 > 24 { return 0 }
  if is_dir(相对) == false { return 0 }
  let 名们 = read_dir(相对)
  var 行 = 0
  var i = 0
  while i < len(名们) {
    let 全 = 相对 + "/" + 名们[i]
    if is_dir(全) {
      行 = 行 + 数(全, 后缀, 次 + 1)
    } else {
      if 尾是(名们[i], 后缀) {
        行 = 行 + 数行(read_text(全, "utf8"))
      }
    }
    i = i + 1
  }
  return 行
}

fn 一行(名: String, 行: Int, 语: String) -> String {
  return "  " + 名 + "  " + str(行) + " 行  " + 语 + chr(10)
}

fn main() -> Int effects(file, process) {
  let 自举 = 数("self", "hmoca", 0)
  let 宿主侧 = 数("self", "mjs", 0)
  let 执行器 = 数("src", "mjs", 0)
  let 工具 = 数("tools", "mjs", 0)
  let 机器 = 数("vm", "c", 0)
  let 总行 = 自举 + 宿主侧 + 执行器 + 工具 + 机器
  print("自举比例（不含 test/，不含 data/ 与 deps/ 里的语料）" + chr(10) + chr(10))
  print(一行("自举", 自举, "HMYR"))
  print(一行("自举的宿主侧", 宿主侧, "JS"))
  print(一行("宿主执行器", 执行器, "JS"))
  print(一行("工具", 工具, "JS"))
  print(一行("C 机器", 机器, "C"))
  print(chr(10))
  print("  合计 " + str(总行) + " 行，其中 HMYR 写的 " + str(自举) + " 行" + chr(10))
  return 0
}
