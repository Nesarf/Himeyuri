// design/ 的份数与行数 —— 那个「39 份、7573 行」的前提，用它核一遍。
//
// 为什么值得单独一件：objective 里写着「design/*.txt 是 39 份 7573 行的文档，而几十 MB
// 的 ucd/unihan 是数据表、不在其中」，而那个数字是写的时候估的。HMYR 自己数一遍，
// 顺手也给「HMYR 能独立算完的小工具」添一份 —— 它不依赖宿主那一侧的解析与装载。
//
// 2026-11-02 实测：design/ 下 39 份、11016 行、平均 282 行一份。份数对得上前提，
// 行数比 7573 多了 3443 —— 那一段自己的工作把它写长了。对照用 PowerShell 直接数
// 也得到 39 份 11016 行；而 Measure-Object -Line 给 7990，那个只数非空行。
//
// 同一天稍晚再数已经是 11106 行 —— 因为这一段的文档还在写。所以这个数只有一种读法：
// 它说的是「你跑它的那一刻」，而不是一个该被写死在别处的常数。
//
// 两个数分两次走：元组返回值在这一层的类型推断还没过（tools/self-ratio.hmoca 那一次
// 就是撞在这里），所以份数与行数各有一个函数，各自走一遍树。多一次遍历，换类型这一层
// 的干净。
//
// 用法：hmyr tools/doc-stats.hmoca [目录]
fn 尾是(名: String, 后缀: String) -> Bool {
  定 段 = split(名, ".")
  若 len(段) < 2 { 返回 false }
  返回 段[len(段) - 1] == 后缀
}

fn 数行(内容: String) -> Int {
  定 段 = split(内容, chr(10))
  若 len(段) > 0 {
    若 段[len(段) - 1] == "" { 返回 len(段) - 1 }
  }
  返回 len(段)
}

fn 数份(相对: String, 后缀: String, 次: Int) -> Int effects(file) {
  若 次 > 24 { 返回 0 }
  若 is_dir(相对) == false { 返回 0 }
  定 名册 = read_dir(相对)
  var 份 = 0
  var i = 0
  当 i < len(名册) {
    定 全 = 相对 + "/" + 名册[i]
    若 is_dir(全) {
      份 = 份 + 数份(全, 后缀, 次 + 1)
    } else {
      若 尾是(名册[i], 后缀) { 份 = 份 + 1 }
    }
    i = i + 1
  }
  返回 份
}

fn 数行总(相对: String, 后缀: String, 次: Int) -> Int effects(file) {
  若 次 > 24 { 返回 0 }
  若 is_dir(相对) == false { 返回 0 }
  定 名册 = read_dir(相对)
  var 行 = 0
  var i = 0
  当 i < len(名册) {
    定 全 = 相对 + "/" + 名册[i]
    若 is_dir(全) {
      行 = 行 + 数行总(全, 后缀, 次 + 1)
    } else {
      若 尾是(名册[i], 后缀) { 行 = 行 + 数行(read_text(全, "utf8")) }
    }
    i = i + 1
  }
  返回 行
}

fn main() -> Int effects(file, process) {
  定 参们 = argv()
  var 起 = "design"
  若 len(参们) > 1 { 起 = 参们[1] }
  定 份 = 数份(起, "txt", 0)
  定 行 = 数行总(起, "txt", 0)
  print(起 + "/ 下的 .txt：" + str(份) + " 份，" + str(行) + " 行" + chr(10))
  若 份 > 0 {
    print("平均 " + str(floor(行 / 份)) + " 行一份" + chr(10))
  }
  返回 0
}
