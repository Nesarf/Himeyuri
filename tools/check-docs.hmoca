// 文档里不该藏着渲染记号。
//
// 这一份原来是 tools/check-docs.mjs，2026-11-02 用 HMYR 重写。判据不是「看起来差不多」，
// 而是「同一棵树上跑出同一张清单」—— 旧的那份打印份数、每一份的通过与否、以及命中的记号名。
//
// 没有正则，所以八种记号都是手写扫描。这件事本身说明了这条规矩：文档是普通文本，
// 读得懂它的东西不该依赖某一个渲染器。
//
// 数据目录（data/）跳过：那里是 Unicode 的原始数据，行首的井号与竖线表格是数据自己的
// 写法，不是我们写下的文档。
//
// 跑全仓要调步数上限（2026-11-02 实测）：默认步数在一半就报 HMYR-R0102（跑得太久），
// 因为每一份文档都要逐字符扫一遍。HMYR_STEPS 给到四亿之后，11 秒给出 43 份：
//
//   HMYR_STEPS=400000000 hmyr tools/check-docs.hmoca
//
// 而 43 这个数要与 tools/check-docs.mjs 对得上 —— 两份的跳过规则是同一套
// （node_modules、.git、build、data、swap、ucd、conformance，以及所有点开头的目录）。
// 差过一次：JS 版曾经数到 61，多出来的是 ucd/ 与 conformance/ 下的数据表。
//
//   node bin/hmyr.mjs tools/check-docs.hmoca

fn 是文档(名: String) -> Bool {
  定 n = len(名)
  若 n >= 4 && slice(名, n - 4, n) == ".txt" { 返回 true }
  若 n >= 4 && slice(名, n - 4, n) == ".rst" { 返回 true }
  若 n >= 5 && slice(名, n - 5, n) == ".adoc" { 返回 true }
  返回 false
}

fn 要跳过(名: String) -> Bool {
  若 名 == "node_modules" { 返回 true }
  若 名 == ".git" { 返回 true }
  若 名 == "build" { 返回 true }
  若 名 == "data" { 返回 true }
  若 名 == "swap" { 返回 true }
  // 点开头的一律跳过：2026-11-02 实测，这一份从 . 起走的时候进了 .tmp-crc-* 与
  // .tmp-readdir-*（测试留下的临时目录），深度在那里面耗掉一半，于是 design/ 只
  // 查到两份就停了 —— 19 份对 JS 版的 61 份，差的就是这些。测试的临时目录不是文档。
  若 len(名) > 0 && slice(名, 0, 1) == "." { 返回 true }
  // ucd 是码点表（runtime/ucd/codepoints.txt 有 42 MB），conformance 下是 Unihan 与
  // NFC 的对照表（29 MB 与 17 MB）—— 都是数据，不是我们写下的文档。
  //
  // 旧那一份只跳了 data/，于是这些也被扫进去了；它用正则，快得看不出代价。
  // 这一份是手写扫描，一跑就撞步限（HMYR-R0102）—— 于是这条「跳什么」第一次
  // 变成了必须说清的事，而不是一个碰巧够用的省略。
  若 名 == "ucd" { 返回 true }
  若 名 == "conformance" { 返回 true }
  返回 false
}

fn 有片(文: String, 片: String) -> Bool {
  定 片长 = len(片)
  若 片长 == 0 { 返回 true }
  var i = 0
  当 i + 片长 <= len(文) {
    若 slice(文, i, i + 片长) == 片 { 返回 true }
    i = i + 1
  }
  返回 false
}

fn 行首是(行: String, 头: String) -> Bool {
  若 len(行) < len(头) { 返回 false }
  返回 slice(行, 0, len(头)) == 头
}

fn 含(们: Int, 值: String) -> Bool {
  var i = 0
  当 i < len(们) {
    若 们[i] == 值 { 返回 true }
    i = i + 1
  }
  返回 false
}

// 行首那一列的记号。都不命中就交回空串。
fn 行记号(行: String) -> String {
  若 行首是(行, "```") { 返回 "fenced code block" }
  若 行首是(行, "# ") { 返回 "hash heading" }
  若 行首是(行, "## ") { 返回 "hash heading" }
  若 行首是(行, "### ") { 返回 "hash heading" }
  若 行首是(行, "> ") { 返回 "blockquote" }
  若 行首是(行, "- [ ]") { 返回 "task checkbox" }
  若 行首是(行, "- [x]") { 返回 "task checkbox" }
  若 行首是(行, "- [X]") { 返回 "task checkbox" }
  若 行首是(行, "* [ ]") { 返回 "task checkbox" }
  若 行首是(行, "* [x]") { 返回 "task checkbox" }
  若 行首是(行, "* [X]") { 返回 "task checkbox" }
  若 行首是(行, "|") && len(行) >= 2 && slice(行, len(行) - 1, len(行)) == "|" { 返回 "table row" }
  返回 ""
}

// 整份文本里命中的行首记号（去重，按出现顺序）。
fn 行记号们(文: String) -> Int {
  var 出 = ()
  var 起 = 0
  var i = 0
  当 i <= len(文) {
    定 到尾 = i == len(文)
    若 到尾 || 文[i] == chr(10) {
      定 记 = 行记号(slice(文, 起, i))
      若 记 != "" && 含(出, 记) == false { 出 = 出 + (记,) }
      起 = i + 1
    }
    i = i + 1
  }
  返回 出
}

// 不在行首的那三种。逐行找，因为逐字符找整份（几十 KB 一份）是平方的。
fn 行内记号们(文: String) -> Int {
  var 出 = ()
  var 起 = 0
  var i = 0
  当 i <= len(文) {
    定 到尾 = i == len(文)
    若 到尾 || 文[i] == chr(10) {
      定 行 = slice(文, 起, i)
      若 含(出, "bold marker") == false && 有片(行, "**") { 出 = 出 + ("bold marker",) }
      若 含(出, "backtick code span") == false && 有片(行, "`") { 出 = 出 + ("backtick code span",) }
      若 含(出, "inline link") == false && 有片(行, "](") && 有片(行, "[") { 出 = 出 + ("inline link",) }
      起 = i + 1
    }
    i = i + 1
  }
  返回 出
}

fn 拼(们: Int) -> String {
  var 出 = ""
  var i = 0
  当 i < len(们) {
    若 i > 0 { 出 = 出 + ", " }
    出 = 出 + 们[i]
    i = i + 1
  }
  返回 出
}

fn 走(路径: String, 出: Int, 次: Int) -> Int 效果串(file) {
  若 次 > 24 { 返回 出 }
  定 名册 = read_dir(路径)
  var 收 = 出
  var i = 0
  当 i < len(名册) {
    定 名 = 名册[i]
    若 要跳过(名) == false {
      定 全 = 路径 + "/" + 名
      若 is_dir(全) {
        收 = 走(全, 收, 次 + 1)
      } 否则 {
        若 是文档(名) { 收 = 收 + (全,) }
      }
    }
    i = i + 1
  }
  返回 收
}

fn main() -> Int 效果串(file, process) {
  // 没有参数时走全仓；给了参数就只走那一个目录（先拿 design/ 试性能）。
  定 参们 = argv()
  var 起 = "."
  若 len(参们) > 1 { 起 = 参们[1] }
  定 文们 = 走(起, (), 0)
  var 坏 = 0
  var i = 0
  当 i < len(文们) {
    定 路 = 文们[i]
    定 文 = read_text(路, "utf8")
    定 记们 = 行记号们(文) + 行内记号们(文)
    定 相对 = slice(路, 2, len(路))
    若 len(记们) == 0 {
      print("  [通过] " + 相对 + chr(10))
    } 否则 {
      坏 = 坏 + 1
      print("  [不通过] " + 相对 + "  " + 拼(记们) + chr(10))
    }
    i = i + 1
  }
  print(chr(10) + str(len(文们)) + " document(s) checked, " + str(坏) + " with rendering syntax" + chr(10))
  若 坏 == 0 { 返回 0 }
  返回 1
}
