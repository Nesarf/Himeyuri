// Himeyuri 的终端模块：帧是数据，不是字节。
//
// 这一层只做两件事：
//   ・向内拿终端的能力（尺寸、清屏、光标定位、颜色）——宿主给的是**字符串**，不是写出去的字节；
//   ・向外把一帧画成**一段字符串**，由调用者决定写给谁。
//
// 于是「画到真终端」与「画进一个字符串缓冲」是同一条路，动画也因此能被套件断言。
// 参考物是 plaaosert 的 credits_public（Frums - Credits EX 的终端动画）：场景栈与按节拍推进
// 那个思路学自它，而它直接写 stdout，所以它的动画没法被自动验——这一点我们不改。

fn 清屏() -> String {
  return term_clear()
}

fn 归位() -> String {
  return term_escape(1, 1)
}

fn 定位(行: Int, 列: Int) -> String {
  return term_escape(行, 列)
}

// 256 色的前景与背景；背景给 -1 表示不设，前景给 -1 表示重置。
fn 上色(前景: Int, 背景: Int) -> String {
  return term_color(前景, 背景)
}

fn 收色() -> String {
  return term_color(-1, -1)
}

fn 藏光标() -> String {
  return term_hide()
}

fn 显光标() -> String {
  return term_show()
}

fn 尺寸行() -> Int {
  let s = term_size()
  return s[0]
}

fn 尺寸列() -> Int {
  let s = term_size()
  return s[1]
}

// 一行空白。递归深度等于列数，所以太宽的终端会先撞上调用深度上限——这是刻意的：
// 与其悄悄画出一行短东西，不如报出「太宽」。
fn 空格行(列数: Int) -> String {
  if 列数 <= 0 { return "" }
  return " " + 空格行(列数 - 1)
}

fn 空画布(行数: Int, 列数: Int) -> Int {
  if 行数 <= 0 { return () }
  return (空格行(列数),) + 空画布(行数 - 1, 列数)
}

// 一帧 = 清屏 + 归位 + 逐行写出来。行与行之间用换行，而不是用光标逐行定位——
// 后者在窄终端上会被自动折行打乱，这一点与参考实现的做法一致。
fn 画行(画布: Int, i: Int) -> String {
  if i >= len(画布) { return "" }
  return 画布[i] + "\n" + 画行(画布, i + 1)
}

fn 画一帧(画布: Int) -> String {
  return 清屏() + 归位() + 画行(画布, 0)
}

// ---- 小工具：字符串打点、按行号换行 ----
//
// 都写成递归，深度分别等于列数与行数。这对常见终端（80 列、24 行）是安全的，
// 而更宽的终端会先撞上调用深度上限——那是刻意的：与其悄悄画歪，不如报出「太宽」。

fn 打个点从(行: String, 目标: Int, 记号: String, 当前: Int) -> String {
  if 当前 >= len(行) { return "" }
  if 当前 == 目标 { return 记号 + 打个点从(行, 目标, 记号, 当前 + 1) }
  return 行[当前] + 打个点从(行, 目标, 记号, 当前 + 1)
}

fn 打个点(行: String, 位置: Int, 记号: String) -> String {
  return 打个点从(行, 位置, 记号, 0)
}

fn 换行从(布: Int, 目标: Int, 新行: String, 当前: Int) -> Int {
  if 当前 >= len(布) { return () }
  if 当前 == 目标 { return (新行,) + 换行从(布, 目标, 新行, 当前 + 1) }
  return (布[当前],) + 换行从(布, 目标, 新行, 当前 + 1)
}

fn 换行(布: Int, 行号: Int, 新行: String) -> Int {
  return 换行从(布, 行号, 新行, 0)
}

// ---- 场景与场景栈 ----
//
// 场景用**名字**表示，不用函数值——这门语言还没有一等函数，所以分派写在明处。
// 等函数值进语言之后，这里可以收窄成一张表；那时也不必着急。
// 每个场景收下整张画布，交回一张新的：于是它们可以依次叠上去，后画的盖住先画的。

// 「波浪」：一条横贯画面的波浪，形状随列变化、整体随帧号移动。
// 三行分别表示波谷、中线、波峰，每列按 (列 + 帧号) 对三取余落到其中一行。
fn 场景波浪从(布: Int, 帧号: Int, 列: Int) -> Int {
  if len(布) < 3 { return 布 }
  if 列 >= len(布[0]) { return 布 }
  let 高 = (列 + 帧号) % 3
  return 场景波浪从(换行(布, 高, 打个点(布[高], 列, "~")), 帧号, 列 + 1)
}

fn 场景波浪(布: Int, 帧号: Int) -> Int {
  return 场景波浪从(布, 帧号, 0)
}

// 「雨」：一串竖直下落的记号。每一滴落在自己的列上，落到最下面一行就绕回最上面。
// 用 (帧号 + 偏移) 对行数取余，于是既会下落、又各有快慢。
fn 场景雨从(布: Int, 帧号: Int, 滴: Int, 滴数: Int) -> Int {
  if 滴 >= 滴数 { return 布 }
  if len(布) == 0 { return 布 }
  let 行数 = len(布)
  if len(布[0]) == 0 { return 布 }
  let 落点 = (帧号 + 滴 * 3) % 行数
  let 列 = (滴 * 5) % len(布[0])
  return 场景雨从(换行(布, 落点, 打个点(布[落点], 列, "|")), 帧号, 滴 + 1, 滴数)
}

fn 场景雨(布: Int, 帧号: Int) -> Int {
  return 场景雨从(布, 帧号, 0, 4)
}

// 「字幕」：一行文字从右边进来、往左走出画面，然后再从右边进来。
// 起点会变成负数，而贴行本来就按「从起点开始消费片段」处理，所以负起点不必特判。
fn 场景字幕(布: Int, 帧号: Int, 文字: String) -> Int {
  if len(布) == 0 { return 布 }
  let 宽 = len(布[0])
  if 宽 == 0 { return 布 }
  let 行号 = len(布) - 1
  let 起点 = 宽 - (帧号 % (宽 + len(文字) + 1))
  return 换行(布, 行号, 贴行(布[行号], 文字, 起点))
}

fn 场景叠一层(布: Int, 名字: String, 帧号: Int) -> Int {
  if 名字 == "点" { return 场景点(布, 帧号) }
  if 名字 == "横线" { return 场景横线(布, 帧号) }
  if 名字 == "波浪" { return 场景波浪(布, 帧号) }
  if 名字 == "雨" { return 场景雨(布, 帧号) }
  if 名字 == "字幕" { return 场景字幕(布, 帧号, "HIMEYURI") }
  return 布
}

// 「点」：第一行上有一个按帧号移动的记号，走到头就绕回来。
fn 场景点(布: Int, 帧号: Int) -> Int {
  if len(布) == 0 { return 布 }
  let 宽 = len(布[0])
  if 宽 <= 0 { return 布 }
  return 换行(布, 0, 打个点(布[0], 帧号 % 宽, "*"))
}

// 「横线」：第二行上有一段以帧号为中心、来回移动的横线。
fn 场景横线(布: Int, 帧号: Int) -> Int {
  if len(布) < 2 { return 布 }
  let 宽 = len(布[1])
  if 宽 <= 0 { return 布 }
  let 位置 = 帧号 % 宽
  return 换行(布, 1, 打个点(布[1], 位置, "-"))
}

// 把一个场景栈叠到同一张画布上。栈里靠后的盖住靠前的——这就是「字幕叠在背景上」的做法。
fn 叠从(布: Int, 栈: Int, 帧号: Int, i: Int) -> Int {
  if i >= len(栈) { return 布 }
  return 叠从(场景叠一层(布, 栈[i], 帧号), 栈, 帧号, i + 1)
}

fn 叠(布: Int, 栈: Int, 帧号: Int) -> Int {
  return 叠从(布, 栈, 帧号, 0)
}

// 帧循环：画一帧、写出去、睡一会儿，直到帧数用完。
// 递归深度等于帧数，所以长动画要分段跑——这一点写在明处，而不是到撞上限才发现。
fn 跑从(布: Int, 栈: Int, 帧号: Int, 帧数: Int, 每帧毫秒: Int) -> String {
  if 帧号 >= 帧数 { return "" }
  let 本帧 = 画一帧(叠(布, 栈, 帧号))
  sleep_ms(每帧毫秒)
  return 本帧 + 跑从(布, 栈, 帧号 + 1, 帧数, 每帧毫秒)
}

fn 跑(栈: Int, 帧数: Int, 每帧毫秒: Int) -> String {
  let 布 = 空画布(2, 16)
  return 跑从(布, 栈, 0, 帧数, 每帧毫秒)
}

// ---- 节拍 ----
//
// 按 beat 推进，而不是按帧率推进。这条设计学自 plaaosert 的 credits_public，理由也照抄：
// 画面与节拍对齐，不因机器快慢而漂移。这里用「一拍一幕」的简化形式——
// 当前拍决定画哪一幕，于是不必增删场景栈，只要从表里取当前那一项。

fn 每拍毫秒(bpm: Int) -> Int {
  if bpm <= 0 { return 1000 }
  return floor(60000 / bpm)
}

fn 当前拍(经过毫秒: Int, bpm: Int) -> Int {
  return floor(经过毫秒 / 每拍毫秒(bpm))
}

// 表是 ((拍号, 场景名), …)，按拍号从小到大排。
// 返回最后一个「拍号 <= 当前拍」的那一项——也就是**此刻应当画的那一幕**。
fn 拍上的场景从(表: Int, 拍: Int, i: Int, 当前: String) -> String {
  if i >= len(表) { return 当前 }
  let 项 = 表[i]
  if 项[0] <= 拍 { return 拍上的场景从(表, 拍, i + 1, 项[1]) }
  return 当前
}

fn 拍上的场景(表: Int, 拍: Int) -> String {
  return 拍上的场景从(表, 拍, 0, "")
}

fn 跑节拍从(布: Int, 表: Int, bpm: Int, 帧号: Int, 帧数: Int, 每帧毫秒: Int) -> String {
  if 帧号 >= 帧数 { return "" }
  let 经过 = 帧号 * 每帧毫秒
  let 名 = 拍上的场景(表, 当前拍(经过, bpm))
  let 本帧 = 画一帧(叠(布, (名,) , 帧号))
  sleep_ms(每帧毫秒)
  return 本帧 + 跑节拍从(布, 表, bpm, 帧号 + 1, 帧数, 每帧毫秒)
}

fn 跑节拍(表: Int, bpm: Int, 帧数: Int, 每帧毫秒: Int) -> String {
  let 布 = 空画布(2, 16)
  return 跑节拍从(布, 表, bpm, 0, 帧数, 每帧毫秒)
}

// ---- 大字：把字形贴到画布上 ----
//
// 字形本身（每个字符长什么样）在 glyphs.hmyr 里，是数据；这里只有怎么贴的逻辑。
// 这个分工学自参考实现里那份 string_defs.py：换字体不用碰绘图代码。

// 把 . 换成空格：定义用点号是为了在编辑器里看得见形状，而画到终端上该是空白。
fn 换点从(行: String, i: Int) -> String {
  if i >= len(行) { return "" }
  if 行[i] == "." { return " " + 换点从(行, i + 1) }
  return 行[i] + 换点从(行, i + 1)
}

fn 换点(行: String) -> String {
  return 换点从(行, 0)
}

// 把片段贴到某一行上，从「起点」这一列开始。深度等于行长。
fn 贴行从(行: String, 片段: String, 起点: Int, 当前: Int, 片段位: Int) -> String {
  if 当前 >= len(行) { return "" }
  if 当前 < 起点 { return 行[当前] + 贴行从(行, 片段, 起点, 当前 + 1, 片段位) }
  if 片段位 >= len(片段) { return 行[当前] + 贴行从(行, 片段, 起点, 当前 + 1, 片段位) }
  return 片段[片段位] + 贴行从(行, 片段, 起点, 当前 + 1, 片段位 + 1)
}

fn 贴行(行: String, 片段: String, 起点: Int) -> String {
  return 贴行从(行, 片段, 起点, 0, 0)
}

// 一串字符的第 n 行：逐个字符取出它的第 n 行再接到一起。
// 找不到的字符（例如字母）就跳过去，空出一格——不猜，也不拿别的字顶上。
fn 字形行从(文字: String, 第几行: Int, i: Int) -> String {
  if i >= len(文字) { return "" }
  let 一个 = 找字形(文字[i])
  if len(一个) == 0 { return "  " + 字形行从(文字, 第几行, i + 1) }
  return 一个[第几行] + " " + 字形行从(文字, 第几行, i + 1)
}

fn 字形行(文字: String, 第几行: Int) -> String {
  return 字形行从(文字, 第几行, 0)
}

// 把一串字符画成大字：从「行起点、列起点」开始，逐行贴下去。
fn 画大字行(布: Int, 行起点: Int, 列起点: Int, 文字: String, 第几行: Int) -> Int {
  if 第几行 >= 字形高() { return 布 }
  let 行号 = 行起点 + 第几行
  if 行号 >= len(布) { return 布 }
  let 片段 = 换点(字形行(文字, 第几行))
  return 画大字行(换行(布, 行号, 贴行(布[行号], 片段, 列起点)), 行起点, 列起点, 文字, 第几行 + 1)
}

fn 画大字(布: Int, 行起点: Int, 列起点: Int, 文字: String) -> Int {
  return 画大字行(布, 行起点, 列起点, 文字, 0)
}

// ---- 键输入 ----
//
// 形状与输出对称：真实输入与自动验收走**同一个队列**。于是「按键就停」这类事能被断言，
// 而不必真的按键——不可验的输入等于没有测试。接不上真终端时，开始收键() 返回假，不装。

fn 有键() -> Bool { return key_available() }
fn 取键() -> String { return key_read() }
fn 推键(键: String) -> Int { return key_push(键) }
fn 开始收键() -> Bool { return key_start() }

// 跑到有键为止（或跑满上限）。返回实际跑了几帧——这就是「按 q 退出」的形状。
fn 跑到按键从(布: Int, 栈: Int, bpm: Int, 帧号: Int, 最多帧: Int, 每帧毫秒: Int) -> Int effects(process) {
  if 帧号 >= 最多帧 { return 帧号 }
  if 有键() { return 帧号 }
  let 经过 = 帧号 * 每帧毫秒
  let 名 = 拍上的场景(栈, 当前拍(经过, bpm))
  print(画一帧(叠(布, (名,), 帧号)))
  sleep_ms(每帧毫秒)
  return 跑到按键从(布, 栈, bpm, 帧号 + 1, 最多帧, 每帧毫秒)
}

fn 跑到按键(栈: Int, bpm: Int, 每帧毫秒: Int, 最多帧: Int) -> Int effects(process) {
  return 跑到按键从(空画布(2, 16), 栈, bpm, 0, 最多帧, 每帧毫秒)
}

// ---- 一个演示 ----
//
// 用上了全部件：画布 · 场景栈（点与横线）· 大字（标题）· 节拍（一拍一幅字样）· 按键退出。
// 标题就是「拍上的场景」返回的那个名字——那张表本来是场景表，这里借它当字样表，
// 所以同一个机制两处受用，而不必再造一份。

fn demo从(布: Int, 表: Int, 帧号: Int, 帧数: Int) -> Int effects(process) {
  if 帧号 >= 帧数 { return 帧号 }
  if 有键() { return 帧号 }
  let 拍 = 当前拍(帧号 * 50, 1200)
  let 标题 = 拍上的场景(表, 拍)
  let 画面 = 叠(布, ("点", "横线"), 帧号)
  print(画一帧(画大字(画面, 2, 1, 标题)))
  sleep_ms(50)
  return demo从(布, 表, 帧号 + 1, 帧数)
}

fn demo(表: Int, 帧数: Int) -> Int effects(process) {
  return demo从(空画布(9, 26), 表, 0, 帧数)
}

fn main() -> Int {
  let 布 = 空画布(2, 4)
  print(画一帧(布))
  return 0
}
