import "./shell.hmoca"

// 输入法的预编辑：一个「字」还没定下来之前，它不该进缓冲区。
//
// 为什么单独一层：组合中的文字会被输入法反复改写——打 nihao 会变成
// n → ni → 「你」→「你好」。若把这些中间态写进缓冲区，用户按左键、按退格、
// 按 Home 的时候就会碰到它们，而那些键本该只作用于已经定下来的文字。
//
// 所以这一层多一个字段：状态是 (缓冲, 位, 预编辑)。
// 预编辑是空串表示「没有在组合」——那也是绝大多数时候。

fn 空编辑() -> Int {
  return ("", 0, "")
}

fn 由状态(编辑: Int) -> Int {
  return (编辑[0], 编辑[1])
}

fn 预编辑(编辑: Int) -> String {
  return 编辑[2]
}

fn 组合中(编辑: Int) -> Bool {
  return 编辑[2] != ""
}

// 开始组合：预编辑写上第一段。缓冲区一位也不动。
fn 开始(编辑: Int, 文字: String) -> Int {
  return (编辑[0], 编辑[1], 文字)
}

// 改写组合：输入法换了主意，就把预编辑整个换掉。
fn 改写(编辑: Int, 文字: String) -> Int {
  return (编辑[0], 编辑[1], 文字)
}

// 组合中按退格：删的是预编辑里的一个字，而不是缓冲区里的。
// 这是那条规矩的另一面——预编辑期间，编辑键只作用于预编辑。
fn 退格预编辑从(文字: String, 位: Int) -> Int {
  if 位 <= 0 { return 0 }
  if is_mark(文字[位 - 1]) { return 退格预编辑从(文字, 位 - 1) }
  return 位 - 1
}

fn 退格预编辑(编辑: Int) -> Int {
  if 编辑[2] == "" { return 编辑 }
  let 末 = 退格预编辑从(编辑[2], len(编辑[2]))
  return (编辑[0], 编辑[1], slice(编辑[2], 0, 末))
}

// 取消组合：预编辑清空，缓冲区原样。Esc 键走这一条。
fn 取消(编辑: Int) -> Int {
  return (编辑[0], 编辑[1], "")
}

// 定下组合：把预编辑插到光标处，然后清空。
// 这是唯一一处「组合中的文字进了缓冲区」——而它进去的时候已经定下来了。
fn 定下(编辑: Int) -> Int {
  if 编辑[2] == "" { return 编辑 }
  let 新 = 插入(由状态(编辑), 编辑[2])
  return (新[0], 新[1], "")
}

// 画屏时用的文本：已定下来的部分，加上正在组合的那一段。
// 光标在屏幕上落在「缓冲区那些字之后、预编辑之前」——那是输入法的惯例。
fn 显示文本(编辑: Int) -> String {
  return 编辑[0] + 编辑[2]
}

fn 光标列(编辑: Int) -> Int {
  return 显示列(编辑[0], 编辑[1])
}

fn main() -> Int {
  var e = 空编辑()
  e = 开始(e, "ni")
  print("组合中：" + 显示文本(e) + " · 位 " + str(e[1]) + "\n")
  e = 定下(e)
  print("定下之后：" + 显示文本(e) + " · 位 " + str(e[1]) + "\n")
  return 0
}
