import "./term.hmyr"

// shell 的行编辑与历史。
//
// 这一层只做纯函数：状态进、新状态出。于是每一次按键的效果都能被套件断言，
// 而不必真的敲键盘——与 term 那条线同一个立场（输入可注入，输出可断言）。
//
// 状态是一个二元元组：(缓冲, 光标位置)。光标是「插入点」，0 表示在第一个字符之前。
// 历史是一个二元元组：(条目, 当前索引)，索引 -1 表示「不在历史里」，也就是正在编辑新的一行。

fn 空状态() -> Int {
  return ("", 0)
}



// 在光标处插入一个片段（通常是一个字符），光标右移同宽。
fn 插入(状态: Int, 片段文字: String) -> Int {
  let 缓冲 = 状态[0]
  let 位 = 状态[1]
  return (slice(缓冲, 0, 位) + 片段文字 + slice(缓冲, 位, len(缓冲)), 位 + len(片段文字))
}

// 显示宽度：一个码位在终端里占几列。
//
// 零宽：组合符号。它们粘在前一个字上，不占列。
// 二宽：全角标点、假名、CJK 表意文字、谚文音节，以及几个兼容区段。
// 一宽：其余。
//
// 为什么要它：行编辑里「光标在第几列」与「缓冲里第几个码位」不是一回事。
// 全角字占两列、组合符号占零列，于是两者会越走越远。这一层把那个差算出来——
// 不是为了让光标画得好看，而是因为「换行在哪里断」「删一个字要删几个码位」
// 这两件事都得先知道宽度。
fn 宽吗(码: Int) -> Bool {
  if 码 >= 4352 && 码 <= 4441 { return true }
  if 码 >= 11904 && 码 <= 42191 { return true }
  if 码 >= 44032 && 码 <= 55203 { return true }
  if 码 >= 63744 && 码 <= 64255 { return true }
  if 码 >= 65072 && 码 <= 65103 { return true }
  if 码 >= 65281 && 码 <= 65376 { return true }
  if 码 >= 65504 && 码 <= 65510 { return true }
  if 码 >= 131072 && 码 <= 195103 { return true }
  return false
}

fn 字宽(字符: String) -> Int {
  if len(字符) == 0 { return 0 }
  if is_mark(字符[0]) { return 0 }
  if 宽吗(ord(字符[0])) { return 2 }
  return 1
}

fn 显示宽从(文本: String, i: Int, acc: Int) -> Int {
  if i >= len(文本) { return acc }
  return 显示宽从(文本, i + 1, acc + 字宽(文本[i]))
}

// 一段文本在终端里占几列。
fn 显示宽(文本: String) -> Int {
  return 显示宽从(文本, 0, 0)
}

fn 显示列从(文本: String, i: Int, 位: Int, acc: Int) -> Int {
  if i >= 位 { return acc }
  return 显示列从(文本, i + 1, 位, acc + 字宽(文本[i]))
}

// 缓冲里第 位 个码位，落在第几列（从零数）。这就是光标该去的地方。
fn 显示列(文本: String, 位: Int) -> Int {
  return 显示列从(文本, 0, 位, 0)
}

// 从 位 往前剥掉一个「字」：一个基字，加上粘在它上面的组合符号。
//
// 为什么不是「减一」：组合字符（例如 e 加一个重音符）在码位上是两个，而在屏幕上是字一。
// 只删一个码位会留下一个孤零零的重音符，它粘到前面那个字上，屏幕就变了样。
fn 剥字(缓冲: String, 位: Int) -> Int {
  if 位 <= 0 { return 0 }
  if is_mark(缓冲[位 - 1]) { return 剥字(缓冲, 位 - 1) }
  return 位 - 1
}

// 左一格与右一格：按「字」走，不按码位走。
//
// 为什么：一个基字加若干组合符号在屏幕上是字一，而它们是两三个码位。
// 按码位移动会让光标停在组合符号中间——那时用户看到的是「按了左键却没动」，
// 因为组合符号没法单独显示。
fn 左一字(文本: String, 位: Int) -> Int {
  if 位 <= 0 { return 0 }
  return 剥字(文本, 位)
}

fn 右一字(文本: String, 位: Int) -> Int {
  if 位 >= len(文本) { return len(文本) }
  return 删到位(文本, 位 + 1, len(文本))
}

// 退格：删掉光标左边那一个「字」，光标左移。光标在最前就什么都不做。
fn 退格(状态: Int) -> Int {
  let 缓冲 = 状态[0]
  let 位 = 状态[1]
  if 位 <= 0 { return 状态 }
  let 新位 = 剥字(缓冲, 位)
  return (slice(缓冲, 0, 新位) + slice(缓冲, 位, len(缓冲)), 新位)
}

// 删除：删掉光标处那一个「字」的全部码位（Del 键），光标不动。
// 与退格对称：向前看，把基字与它后面粘着的组合符号一起去掉。
fn 删到位(缓冲: String, 位: Int, 末: Int) -> Int {
  if 位 >= 末 { return 末 }
  if 位 == 0 { return 删到位(缓冲, 位 + 1, 末) }
  if is_mark(缓冲[位]) { return 删到位(缓冲, 位 + 1, 末) }
  return 位
}

fn 删除(状态: Int) -> Int {
  let 缓冲 = 状态[0]
  let 位 = 状态[1]
  if 位 >= len(缓冲) { return 状态 }
  let 末 = 删到位(缓冲, 位 + 1, len(缓冲))
  return (slice(缓冲, 0, 位) + slice(缓冲, 末, len(缓冲)), 位)
}

// 光标移动：越界就停在边界上，不报错也不绕回——绕回是另一回事，得先说清。
fn 左移(状态: Int) -> Int {
  if 状态[1] <= 0 { return 状态 }
  return (状态[0], 左一字(状态[0], 状态[1]))
}

fn 右移(状态: Int) -> Int {
  if 状态[1] >= len(状态[0]) { return 状态 }
  return (状态[0], 右一字(状态[0], 状态[1]))
}

fn 到首(状态: Int) -> Int {
  return (状态[0], 0)
}

fn 到尾(状态: Int) -> Int {
  return (状态[0], len(状态[0]))
}

fn 缓冲(状态: Int) -> String {
  return 状态[0]
}

fn 光标(状态: Int) -> Int {
  return 状态[1]
}

// ---- 历史 ----
//
// 与最近一条相同就不重复记——这是「按了两次回车只留一条」的规矩，
// 而它写在明处，不是靠调用方自觉。

fn 空历史() -> Int {
  return ((), -1)
}

fn 记住(历史: Int, 行: String) -> Int {
  let 条目 = 历史[0]
  if 行 == "" { return (条目, -1) }
  if len(条目) > 0 && 条目[len(条目) - 1] == 行 { return (条目, -1) }
  return (条目 + (行,), -1)
}

fn 上翻(历史: Int) -> Int {
  let 条目 = 历史[0]
  let 位 = 历史[1]
  if len(条目) == 0 { return 历史 }
  if 位 == -1 { return (条目, len(条目) - 1) }
  if 位 == 0 { return 历史 }
  return (条目, 位 - 1)
}

fn 下翻(历史: Int) -> Int {
  let 条目 = 历史[0]
  let 位 = 历史[1]
  if 位 == -1 { return 历史 }
  if 位 + 1 >= len(条目) { return (条目, -1) }
  return (条目, 位 + 1)
}

// 历史当前那一行；不在历史里就是空行（那是正在编辑的新一行）。
fn 历史行(历史: Int) -> String {
  let 条目 = 历史[0]
  let 位 = 历史[1]
  if 位 == -1 { return "" }
  return 条目[位]
}

fn 历史条数(历史: Int) -> Int {
  return len(历史[0])
}

// ---- 渲染 ----
//
// 一行提示的渲染：清屏、归位、写提示符与缓冲，然后把光标放到它该在的那一格。
// 列是「提示符长度 + 缓冲里的光标位置 + 1」，因为光标定位从 1 起算。

fn 渲染提示行(提示符: String, 状态: Int) -> String {
  return 清屏() + 归位() + 提示符 + 状态[0] + 定位(1, len(提示符) + 状态[1] + 1)
}

// 把一行读到的按键逐个作用到状态上。返回 (状态, 是否按了回车)。
// 这只处理「可打印字符与四个编辑键」，其余键交给调用方决定——不认识就不猜。
fn 喂键(状态: Int, 键: String) -> Int {
  // raw 模式下回车送来的是 \r（十三），退格是 127 或 8，而不是名字。
  // 而这两个字符在 Himeyuri 源码里写不出来（字符串只认 \\ 与 \"），所以用 chr。
  if 键 == "ENTER" || 键 == chr(13) || 键 == chr(10) { return (状态, true) }
  if 键 == "BACKSPACE" || 键 == chr(127) || 键 == chr(8) { return (退格(状态), false) }
  if 键 == "DEL" { return (删除(状态), false) }
  if 键 == "LEFT" { return (左移(状态), false) }
  if 键 == "RIGHT" { return (右移(状态), false) }
  if 键 == "HOME" { return (到首(状态), false) }
  if 键 == "END" { return (到尾(状态), false) }
  if 键 == "UP" || 键 == "DOWN" { return (状态, false) }
  return (插入(状态, 键), false)
}

fn main() -> Int {
  let 状态 = 插入(插入(空状态(), "a"), "b")
  print("缓冲 " + 缓冲(状态) + " 光标 " + str(光标(状态)) + "\n")
  return 0
}
