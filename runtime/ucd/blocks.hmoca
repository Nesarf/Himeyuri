// 这张表是从 data/ucd/Blocks.txt 生成的：码点 → 块名。
// 生成器是 tools/ucd.mjs，验收在 test/ucd.test.mjs。手改这里会被下一次生成覆盖。
// 边界写十进制：自举那一层的 to_int 只认十进制，十六进制会让它在那边读不进来。
fn 块名(码点: Int) -> String {
  if 码点 >= 0 {  // 0x0..0x7F
    if 码点 <= 127 {
      return "Basic Latin"
    }
  }
  if 码点 >= 128 {  // 0x80..0xFF
    if 码点 <= 255 {
      return "Latin-1 Supplement"
    }
  }
  if 码点 >= 256 {  // 0x100..0x17F
    if 码点 <= 383 {
      return "Latin Extended-A"
    }
  }
  if 码点 >= 384 {  // 0x180..0x24F
    if 码点 <= 591 {
      return "Latin Extended-B"
    }
  }
  if 码点 >= 592 {  // 0x250..0x2AF
