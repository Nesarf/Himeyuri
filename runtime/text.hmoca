// 小库：文本。只用四个内置——len、slice、ord、chr。
//
// 为什么强调「只用这四个」：这一层的目的不是方便，而是**可移植**。
// 换宿主时要实现的就是那十四个内置（见 design/RUNTIME.txt），
// 而这一层若只用到其中四个，那么不管宿主的文件、进程、终端做得多烂，
// 文本这一块都不会受影响。
//
// 所以这个文件里的每一个函数都该能用「长度、切片、码位、字符」四个词说清。
// 若哪天需要第五个，那是把「最小的内置集」往上抬，而不是偷偷用地上的别的东西。

函数 字符(文本: String, 位: Int) -> String {
  若 位 < 0 || 位 >= len(文本) { 返回 "" }
  返回 文本[位]
}

// 两个字符串是否相同。写成函数，是为了让小库里的东西都显式——
// 而比较本身是语言的事，不是库的事。
函数 同(甲: String, 乙: String) -> Bool {
  返回 甲 == 乙
}

// 从 起 取 数 个字符。超出就取到末尾。
函数 取(文本: String, 起: Int, 数: Int) -> String {
  若 起 < 0 || 起 >= len(文本) || 数 <= 0 { 返回 "" }
  定 末 = 起 + 数
  若 末 > len(文本) { 返回 slice(文本, 起, len(文本)) }
  返回 slice(文本, 起, 末)
}

// 从 起 到末尾。
函数 之后(文本: String, 起: Int) -> String {
  返回 取(文本, 起, len(文本) - 起)
}

函数 之前(文本: String, 数: Int) -> String {
  返回 取(文本, 0, 数)
}

// 是不是空白：空格、制表符、换行、回车。
函数 空白(字: String) -> Bool {
  若 字 == "" { 返回 假 }
  定 码 = ord(字)
  若 码 == 32 { 返回 真 }
  若 码 == 9 { 返回 真 }
  若 码 == 10 { 返回 真 }
  若 码 == 13 { 返回 真 }
  返回 假
}

函数 去首空从(文本: String, 位: Int) -> Int {
  若 位 >= len(文本) { 返回 位 }
  若 空白(文本[位]) { 返回 去首空从(文本, 位 + 1) }
  返回 位
}

函数 去尾空从(文本: String, 末: Int) -> Int {
  若 末 <= 0 { 返回 0 }
  若 空白(文本[末 - 1]) { 返回 去尾空从(文本, 末 - 1) }
  返回 末
}

函数 去首空(文本: String) -> String {
  返回 之后(文本, 去首空从(文本, 0))
}

函数 去尾空(文本: String) -> String {
  返回 之前(文本, 去尾空从(文本, len(文本)))
}

// 首尾都去。顺序无关，但它是最常用的那一个。
函数 去空白(文本: String) -> String {
  返回 去尾空(去首空(文本))
}

// 拆行：按换行切。末尾的空段留着——因为「文件以换行结尾」与「末尾有空行」
// 在文本层是两件事，而让调用方自己决定要不要丢掉最后那一个。
函数 拆行从(文本: String, i: Int, 起: Int, acc: Int) -> Int {
  若 i >= len(文本) { 返回 acc + (slice(文本, 起, len(文本)),) }
  若 文本[i] == chr(10) {
    返回 拆行从(文本, i + 1, i + 1, acc + (slice(文本, 起, i),))
  }
  返回 拆行从(文本, i + 1, 起, acc)
}

函数 拆行(文本: String) -> Int {
  若 文本 == "" { 返回 ("",) }
  返回 拆行从(文本, 0, 0, ())
}

// 拼行：每行之后加一个换行。与拆行是（近似）的逆——
// 差在「末尾那一个空段」，而那是约定，不是漏洞。
函数 拼行从(行批: Int, i: Int, acc: String) -> String {
  若 i >= len(行批) { 返回 acc }
  返回 拼行从(行批, i + 1, acc + 行批[i] + chr(10))
}

函数 拼行(行批: Int) -> String {
  返回 拼行从(行批, 0, "")
}

// 子串出现的位置；没有就交回 -1。朴素匹配——这一层不追求算法，追求说得清。
函数 找从(文本: String, 要: String, 位: Int) -> Int {
  若 len(要) == 0 { 返回 0 }
  若 位 + len(要) > len(文本) { 返回 -1 }
  若 slice(文本, 位, 位 + len(要)) == 要 { 返回 位 }
  返回 找从(文本, 要, 位 + 1)
}

函数 找(文本: String, 要: String) -> Int {
  返回 找从(文本, 要, 0)
}

函数 含(文本: String, 要: String) -> Bool {
  返回 找(文本, 要) >= 0
}

函数 前缀(文本: String, 头: String) -> Bool {
  若 len(头) > len(文本) { 返回 假 }
  返回 slice(文本, 0, len(头)) == 头
}

函数 后缀(文本: String, 尾: String) -> Bool {
  若 len(尾) > len(文本) { 返回 假 }
  返回 slice(文本, len(文本) - len(尾), len(文本)) == 尾
}

函数 main() -> Int {
  print("这一层只有函数，没有独立的入口可跑。\n")
  返回 0
}
