// 并行：把「同时起几件事」交给一个本来就支持并行的进程。
//
// 为什么不在语言里做：求值器是同步的，而同步等异步的完成事件会把事件循环堵死
// （见 design/CONCURRENCY.txt 的补记，那里记着实测）。
// 所以并行发生在一个子进程里——借能力，不复制实现。
//
// 三步都动世界：写列表（file）、调脚本（process）、读回结果（file）。
// 而交回来的是一段 JSON，交给 json.hmyr 去读——于是判定仍在语言里做。

fn 列表路径() -> String {
  返回 temp_path("parallel-in.txt")
}

fn 结果路径() -> String {
  返回 temp_path("parallel-out.json")
}

fn 并行脚本() -> String {
  返回 repo_path("deps/surface/parallel.ps1")
}

fn 拼列表从(命令们: Int, i: Int, acc: String) -> String {
  若 i >= len(命令们) { 返回 acc }
  返回 拼列表从(命令们, i + 1, acc + 命令们[i] + "\n")
}

fn 拼列表(命令们: Int) -> String {
  返回 拼列表从(命令们, 0, "")
}

// 真的同时跑。交回 {ok, text}：text 是那段 JSON，由调用方交给 json.hmyr 解析。
//
// 超时是**每条**的上限（脚本里逐条 Wait-Job），不是总时长——因为并行时「总时长」
// 取决于最长的那一条，把它写死反而会误杀。
fn 并行跑(命令们: Int, 超时秒: Int) -> Int 效果串(process, file) {
  write_text(列表路径(), 拼列表(命令们), "utf8")
  定 r = run_program("powershell", ("-NoProfile", "-STA", "-File", 并行脚本(),
    "-List", 列表路径(), "-Out", 结果路径(), "-TimeoutSec", str(超时秒)), 120000, "utf8")
  若 r.code != 0 { 返回 {ok: false, text: r.stderr} }
  返回 {ok: true, text: read_text(结果路径(), "utf8"), 报: r.stdout}
}

fn main() -> Int 效果串(process, file) {
  定 r = 并行跑(("cmd /c \"echo one\"", "cmd /c \"echo two\""), 20)
  print("ok " + str(r.ok) + " · " + str(len(r.text)) + " 字节\n")
  返回 0
}
