引入 "../lib/rational.hmoca"

// 有理数的示范：分数形式的精确算术。
//
// 为什么这份例子存在（2026-11-05）：lib/ 十一库里，rational 一直没被例子用过。
// 这一份是第七份。
//
// 它回答的是 0.1 + 0.2 那个老问题：用双精度算出来不是 0.3，用有理数算出来是 3/10。
//
// 它自己判：每一步都对才打「全对」，否则打印是哪一处并返回 1。

函数 核(名: String, 得: String, 期: String) -> Int {
  若 得 != 期 {
    print("不对：" + 名 + " 得 " + 得 + " 期 " + 期 + chr(10))
    返回 1
  }
  返回 0
}

函数 main() -> Int 效果串(process) {
  变 错 = 0

  // 一、从两个数造一个分数。注意 分子 与 分母 交回的是**大整数**（lib/bigint 那种
  // 24 位字组成的小端序列），不是普通整数 —— 所以 str() 会打出一串数组。
  // 要比大小就比 成串，那是给它准备的读法。
  定 半 = 从两数(1, 2)
  错 = 错 + 核("二分之一", 成串(半), "1/2")

  // 二、约分：造的时候就该是最简形式。
  定 化简 = 从两数(6, 8)
  错 = 错 + 核("六分之八约成", 成串(化简), "3/4")

  // 三、0.1 + 0.2 那个问题：有理数里它是精确的。
  定 十分之一 = 从两数(1, 10)
  定 十分之二 = 从两数(2, 10)
  定 和 = 加有理(十分之一, 十分之二)
  错 = 错 + 核("十分之一加十分之二", 成串(和), "3/10")

  // 四、减与乘。减法只测正结果那一边 —— 负结果的减法是这一份例子撞见的一个
  // 真缺陷（2026-11-05）：减有理(1/10, 2/10) 在自举层这条路上不终止，而
  // 减有理(3/10, 1/10) 正常。细节记在 design/OPEN.txt 那一条里。
  定 差 = 减有理(从两数(3, 10), 十分之一)
  错 = 错 + 核("十分之三减十分之一是五分之一", 成串(差), "1/5")
  定 积 = 乘有理(从两数(2, 3), 从两数(3, 4))
  错 = 错 + 核("三分之二乘四分之三", 成串(积), "1/2")

  // 五、比较与相等：两条都不该走浮点。
  错 = 错 + 核("二分之一小于三分之二（交回 -1）", str(比有理(半, 从两数(2, 3))), "-1")
  错 = 错 + 核("二分之一等于四分之二", str(等有理(半, 从两数(2, 4))), "true")
  错 = 错 + 核("二分之一等于四分之三", str(等有理(半, 从两数(3, 4))), "false")

  若 错 == 0 {
    print("全对：有理数，八项" + chr(10))
  }
  返回 错
}
