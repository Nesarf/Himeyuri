引入 "../lib/interval.hmoca"

// 区间的示范：一段有端点的范围，与它上面那几种运算。
//
// 为什么这份例子存在（2026-11-05）：lib/ 十一库里，interval 一直没有被例子用过。
// 这一份是第六份。
//
// 区间在这门语言里是一个记录（下界、上界），而「含不含」与「宽度」是它的两条基本问题。
//
// 它自己判：每一步都对才打「全对」，否则打印是哪一处并返回 1。

函数 核(名: String, 得: String, 期: String) -> Int {
  若 得 != 期 {
    print("不对：" + 名 + " 得 " + 得 + " 期 " + 期 + chr(10))
    返回 1
  }
  返回 0
}

函数 main() -> Int 效果串(process) {
  变 错 = 0

  // 一、造一个区间：它的形状就是一个记录 {下, 上}，所以直接写出来。
  // 加端 不是「造区间」—— 那是 TwoSum：它交回「a + b 的精确值所在的那一段」。
  定 a = {下: 0, 上: 10}
  错 = 错 + 核("下界", str(下界(a)), "0")
  错 = 错 + 核("上界", str(上界(a)), "10")
  错 = 错 + 核("宽度", str(宽度(a)), "10")

  // 二、含不含：两端都算在里面（闭区间），外面那一点不算。
  错 = 错 + 核("含下界", str(含(a, 0)), "true")
  错 = 错 + 核("含上界", str(含(a, 10)), "true")
  错 = 错 + 核("含中间", str(含(a, 5)), "true")
  错 = 错 + 核("含外面", str(含(a, 11)), "false")

  // 三、加减：两段区间按端点算。
  定 b = {下: 5, 上: 20}
  定 交的 = 加区间(a, b)
  错 = 错 + 核("两段之和的下界", str(下界(交的)), "5")
  错 = 错 + 核("两段之和的上界", str(上界(交的)), "30")
  定 差的 = 减区间(b, a)
  错 = 错 + 核("差的下界", str(下界(差的)), "-5")
  错 = 错 + 核("差的上界", str(上界(差的)), "20")

  // 四、加端：两个数相加的精确值落在哪一段。精确的时候端点不动。
  // 它交回的字段叫 {低, 高}（不是 {下, 上}）—— 与区间是两种记录，别混。
  定 精 = 加端(1, 2)
  错 = 错 + 核("1+2 的低端", str(精.低), "3")
  错 = 错 + 核("1+2 的高端", str(精.高), "3")

  // 六、成串：给打印用的那一份。
  错 = 错 + 核("成串", 成串(a), "[0, 10]")

  若 错 == 0 {
    print("全对：区间，十六项" + chr(10))
  }
  返回 错
}
