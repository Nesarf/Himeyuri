引入 "../lib/tables.hmoca"

// 表（字典）的示范：一张表在自己手里是什么样。
//
// 为什么这份例子存在（2026-11-05）：lib/ 十一库里，只有 strings 与 tuples 被
// examples/lib-tour.hmoca 用过。这一份是第二份，用 tables。
//
// 表是一个「名 → 值」的东西，而这一门语言没有内建的字典 —— 所以它由 lib/tables
// 用元组对搭出来。这一份把最常用的七件过一遍：置入、取或、删、有几件、键串、
// 合并、是空表。
//
// 它自己判：每一步都对才打「全对」，否则打印是哪一处并返回 1。

函数 真一(b: Bool) -> String {
  若 b { 返回 "1" } 否则 { 返回 "0" }
}

函数 核(名: String, 得: String, 期: String) -> Int {
  若 得 != 期 {
    print("不对：" + 名 + " 得 " + 得 + " 期 " + 期 + chr(10))
    返回 1
  }
  返回 0
}

函数 main() -> Int 效果串(process) {
  变 错 = 0

  // 一、空表就是空的。
  变 t = 空表()
  错 = 错 + 核("空表是空的", 真一(是空表(t)), "1")
  错 = 错 + 核("空表有几件", str(有几件(t)), "0")

  // 二、置入与取或：取不到就给缺省值 —— 这一条是表最有用的性质。
  t = 置入(t, "甲", 10)
  t = 置入(t, "乙", 20)
  t = 置入(t, "丙", 30)
  错 = 错 + 核("三件之后有几件", str(有几件(t)), "3")
  错 = 错 + 核("取甲", str(取或(t, "甲", 0)), "10")
  错 = 错 + 核("取丁给缺省", str(取或(t, "丁", -1)), "-1")

  // 三、置入同一个名字是覆盖，不是多出一件。
  t = 置入(t, "甲", 99)
  错 = 错 + 核("覆盖之后还是三件", str(有几件(t)), "3")
  错 = 错 + 核("覆盖之后取甲", str(取或(t, "甲", 0)), "99")

  // 四、删：删掉之后取不到，件数也少一件。
  t = 删(t, "乙")
  错 = 错 + 核("删掉之后有几件", str(有几件(t)), "2")
  错 = 错 + 核("删掉之后取乙", str(取或(t, "乙", -7)), "-7")

  // 五、键串：交回的是一串名字（元组，不是拼好的字符串）—— 所以逐项比。
  定 名串 = 键串(t)
  错 = 错 + 核("键串有两项", str(len(名串)), "2")
  错 = 错 + 核("键串里有甲", str(元里有(名串, "甲")), "1")
  错 = 错 + 核("键串里有丙", str(元里有(名串, "丙")), "1")
  错 = 错 + 核("键串里没有乙", str(元里有(名串, "乙")), "0")

  // 六、合并：后一张盖前一张。这里用「盖」这个词是因为 置入 的语义就是覆盖。
  变 a = 空表()
  a = 置入(a, "x", 1)
  变 b = 空表()
  b = 置入(b, "x", 2)
  b = 置入(b, "y", 3)
  定 m = 合并(a, b)
  错 = 错 + 核("合并之后两件", str(有几件(m)), "2")
  错 = 错 + 核("合并不盖掉 x", str(取或(m, "x", 0)), "2")
  错 = 错 + 核("合并带上 y", str(取或(m, "y", 0)), "3")

  // 七、清空是「删到空」这个形状：用 删 一个个删。
  a = 删(a, "x")
  错 = 错 + 核("删空之后是空表", 真一(是空表(a)), "1")

  若 错 == 0 {
    print("全对：表，十八项" + chr(10))
  }
  返回 错
}

// 元组里有没有这个字符串：这一条不借别的库，让这份例子只依赖一个。
函数 元里有(项串: (String,), 子: String) -> Int {
  变 i = 0
  当 i < len(项串) {
    若 项串[i] == 子 { 返回 1 }
    i = i + 1
  }
  返回 0
}
