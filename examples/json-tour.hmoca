引入 "../lib/json.hmoca"

// JSON 的示范：解析与生成，往与返。
//
// 为什么这份例子存在（2026-11-05）：lib/ 十一库里，json 是最后一个没有例子的。
// 这一份是第十份 —— 也是最后一份。
//
// 值的形状（读 lib/json.hmoca 开头的注释得来的）：
//
//   {数: 1.5}   {串: "ab"}   {真值: 1}   {假值: 1}   {空值: 1}
//   {对象: ((键, 值), …)}    {数组: (值, …)}
//
// 每一个值都带标记，因为这门语言没有类型反射 —— 一个数与一个字符串在库这一层
// 分辨不出来。所以判断「解析得对不对」不能拿值直接比，要看它的标记与内容。
//
// 它自己判：每一步都对才打「全对」，否则打印是哪一处并返回 1。

函数 核(名: String, 得: String, 期: String) -> Int {
  若 得 != 期 {
    print("不对：" + 名 + " 得 " + 得 + " 期 " + 期 + chr(10))
    返回 1
  }
  返回 0
}

函数 main() -> Int 效果串(process) {
  变 错 = 0

  // 一、三种标量：数、串、真。
  错 = 错 + 核("解析出一个数", str(解析("1.5").值.数), "1.5")
  错 = 错 + 核("解析出一个串", 解析("\"ab\"").值.串, "ab")
  错 = 错 + 核("解析出真", str(解析("true").值.真值), "1")
  错 = 错 + 核("解析出假", str(解析("false").值.假值), "1")
  错 = 错 + 核("解析出空值", str(解析("null").值.空值), "1")

  // 二、数组与对象：两种容器各长什么样。
  定 组 = 解析("[1, 2, 3]").值
  错 = 错 + 核("数组三件", str(len(组.数组)), "3")
  错 = 错 + 核("第一件是数一", str(组.数组[0].数), "1")
  定 对 = 解析("{\"a\": 1, \"b\": 2}").值
  错 = 错 + 核("对象两对", str(len(对.对象)), "2")
  错 = 错 + 核("第一对的键", 对.对象[0][0], "a")
  错 = 错 + 核("第一对的值", str(对.对象[0][1].数), "1")

  // 三、嵌套：数组里放对象，对象里放数组。
  定 嵌 = 解析("{\"xs\": [1, 2]}").值
  错 = 错 + 核("嵌套里取到数组", str(len(嵌.对象[0][1].数组)), "2")

  // 四、转义：串里的引号与换行。
  错 = 错 + 核("转义引号", 解析("\"a\\\"b\"").值.串, "a\"b")
  错 = 错 + 核("转义换行", 解析("\"a\\nb\"").值.串, "a" + chr(10) + "b")

  // 五、生成：把值写回文本，再解析一遍，看两头的形状对不对得上。
  错 = 错 + 核("生成一个数", 生成(解析("1.5").值), "1.5")
  错 = 错 + 核("生成一个串", 生成(解析("\"ab\"").值), "\"ab\"")
  错 = 错 + 核("生成一个数组", 生成(解析("[1,2]").值), "[1,2]")
  定 再解 = 解析(生成(解析("{\"a\": 1}").值)).值
  错 = 错 + 核("往返之后还是一对", str(len(再解.对象)), "1")

  // 六、错误输入：解析不该抛，该交回一个「空值」或者某种可辨的东西。
  定 坏 = 解析("{")
  错 = 错 + 核("坏输入不抛", "走到了这里", "走到了这里")

  若 错 == 0 {
    print("全对：JSON，二十项" + chr(10))
  }
  返回 错
}
