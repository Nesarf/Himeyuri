// 板子上的第一份真程序：循环、元组、字符串拼接，全在语言自己这一侧。
//
// 它存在的理由是一个判据：同一份源码，桌面上 stdout 的字节，与这块板子串口上
// 的字节，必须逐字节相同（design/BOARD.txt 第十五节）。
//
// 所以这里只写不依赖文件系统与托管区的东西 —— 板子上没有 GC（gc_分配 在
// __arm__ 下是一个返回 NULL 的桩），而托管区里的东西要靠它回收。
// 元组是不可变值、字符串是分配出来的，两者在板上都能用：它们只分配，不回收，
// 而这一份程序的总量远小于板子剩下的那些。
fn main() -> Int effects(process) {
  var 和 = 0
  var i = 1
  while i <= 10 {
    和 = 和 + i
    i = i + 1
  }
  print("和=" + str(和) + chr(10))

  let 元 = (3, 5, 7)
  print("首项=" + str(元[0]) + " 三项之和=" + str(元[0] + 元[1] + 元[2]) + chr(10))

  let 名 = "ヒメユリ"
  print("名=" + 名 + " 长=" + str(len(名)) + chr(10))

  var k = 0
  var 串 = ""
  while k < 5 {
    串 = 串 + chr(65 + k)
    k = k + 1
  }
  print("串=" + 串 + chr(10))
  return 0
}
