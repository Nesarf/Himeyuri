// 板子上的规范判据：只碰 SPEC 规定的东西。
//
// 为什么这一份单独存在（2026-11-01）：板子那条线要回答的是「规范在板上成立吗」，
// 而不是「能力全集在板上成立吗」。所以这里一个宿主能力都不碰 ——
// 不读文件、不开终端、不起线程、不用索引表、不碰 arena 与 owned。
// print 是唯一的外部动作，而它属于能力契约的第一组（输出），也是最基础的那一组。
//
// 覆盖的是 SPEC 里能一眼核对的那几条：算术、比较与布尔、控制流、递归、
// 元组、记录、字符串。判据是「桌面上打出来的字节与板子串口上的字节逐字节相同」。
fn 阶(n: Int) -> Int {
  if n <= 1 {
    return 1
  }
  return n * 阶(n - 1)
}

fn 斐(n: Int) -> Int {
  if n < 2 {
    return n
  }
  return 斐(n - 1) + 斐(n - 2)
}

fn 大者(a: Int, b: Int) -> Int {
  if a > b {
    return a
  }
  return b
}

fn main() -> Int effects(process) {
  // 一、算术：乘加、整除与余数
  print("算术 " + str(7 % 3) + " " + str(2 * 3 + 1) + " " + str(100 / 7) + chr(10))

  // 二、比较与布尔
  print("比较 " + str(1 < 2) + " " + str(2 <= 2) + " " + str(3 != 3) + " " + str(1 > 2) + chr(10))

  // 三、控制流
  var 和 = 0
  var i = 1
  while i <= 100 {
    和 = 和 + i
    i = i + 1
  }
  print("循环 " + str(和) + chr(10))

  // 四、递归与按名字调用
  print("阶乘 " + str(阶(6)) + " 斐波那契 " + str(斐(10)) + " 大者 " + str(大者(3, 9)) + chr(10))

  // 五、元组
  let t = (10, 20, 30)
  print("元组 " + str(t[0] + t[1] + t[2]) + " 长 " + str(len(t)) + chr(10))

  // 六、记录
  let r = {宽: 3, 高: 4}
  print("记录 " + str(r.宽 * r.高) + chr(10))

  // 七、字符串：长度按码元算，拼接不丢东西
  print("字符串 " + str(len("ヒメユリ")) + " " + ("a" + "b" + "c") + chr(10))
  return 0
}
