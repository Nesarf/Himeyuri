引入 "../lib/time.hmoca"

// 时间的示范：闰年、月长、日数与日期互转、把毫秒写成 ISO 串。
//
// 为什么这份例子存在（2026-11-05）：lib/ 十一库里，只有 strings 与 tuples 被
// examples/lib-tour.hmoca 用过。这一份是第三份，用 time。
//
// 这一门语言的时间只有一个口径：UTC。没有本地时区、没有夏令时 —— 那不是省事，
// 是一种判断：一个跨平台的库如果自带时区表，它每年都要跟着改；而 UTC 不用。
//
// 它自己判：每一步都对才打「全对」，否则打印是哪一处并返回 1。

函数 核(名: String, 得: String, 期: String) -> Int {
  若 得 != 期 {
    print("不对：" + 名 + " 得 " + 得 + " 期 " + 期 + chr(10))
    返回 1
  }
  返回 0
}

函数 main() -> Int 效果串(process) {
  变 错 = 0

  // 一、闰年：四年一闰、百年不闰、四百年再闰。
  错 = 错 + 核("2024 是闰年", str(时_闰(2024)), "true")
  错 = 错 + 核("2023 不是", str(时_闰(2023)), "false")
  错 = 错 + 核("1900 不是（百年不闰）", str(时_闰(1900)), "false")
  错 = 错 + 核("2000 是（四百年再闰）", str(时_闰(2000)), "true")

  // 二、月长：二月随闰年变，其余固定。
  错 = 错 + 核("2024 年二月", str(时_月长(2024, 2)), "29")
  错 = 错 + 核("2023 年二月", str(时_月长(2023, 2)), "28")
  错 = 错 + 核("四月", str(时_月长(2026, 4)), "30")
  错 = 错 + 核("十二月", str(时_月长(2026, 12)), "31")

  // 三、日数与日期互转：这才是这个库真正有用的地方 —— 算差几天不用自己数月。
  //
  // 一件事要说清：时_日数到日 交回的是**记录** {年, 月, 日}，不是三元组 ——
  // 所以对它用 len() 或下标都会报「len() wants a string or a tuple」。
  // 这不是库的毛病，是读它的方式要跟着形状走。
  错 = 错 + 核("1970-01-01 是第 0 天", str(时_日到日数(1970, 1, 1)), "0")
  错 = 错 + 核("1970-01-02 是第 1 天", str(时_日到日数(1970, 1, 2)), "1")
  错 = 错 + 核("1970-03-01 是第 59 天", str(时_日到日数(1970, 3, 1)), "59")
  定 那日 = 时_日数到日(59)
  错 = 错 + 核("反向：第 59 天是三月", str(那日.月), "3")
  错 = 错 + 核("反向：第 59 天是一号", str(那日.日), "1")

  // 四、成文：毫秒写成 ISO 串。零就是纪元开始那一刻。
  错 = 错 + 核("零是 1970-01-01", 时_成文(0), "1970-01-01T00:00:00.000Z")
  错 = 错 + 核("一天之后", 时_成文(86400000), "1970-01-02T00:00:00.000Z")
  错 = 错 + 核("一秒之后", 时_成文(1000), "1970-01-01T00:00:01.000Z")

  // 五、补零：成文那一层自己会补，但报表里常常要手补。
  错 = 错 + 核("补到三位", 时_补零(7, 3), "007")
  错 = 错 + 核("已经够长就不动", 时_补零(1234, 3), "1234")

  若 错 == 0 {
    print("全对：时间，十三项" + chr(10))
  }
  返回 错
}
