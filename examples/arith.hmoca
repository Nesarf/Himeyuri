fn 加(a: Int, b: Int) -> Int {
  return a + b
}

fn 阶(n: Int) -> Int {
  if n <= 1 {
    return 1
  }
  return n * 阶(n - 1)
}

fn main() -> Int {
  print(str(加(20, 22)))
  print(" ")
  print(str(阶(5)))
  print(" ")
  let t = (1, 2, 3)
  print(str(len(t)))
  print(" ")
  let r = {a: 7, b: "琥珀"}
  print(str(r.a))
  print(r.b)
  return 0
}
