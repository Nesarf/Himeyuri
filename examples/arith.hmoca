fn 加(a: Int, b: Int) -> Int {
  返回 a + b
}

fn 阶(n: Int) -> Int {
  若 n <= 1 {
    返回 1
  }
  返回 n * 阶(n - 1)
}

fn main() -> Int {
  print(str(加(20, 22)))
  print(" ")
  print(str(阶(5)))
  print(" ")
  定 t = (1, 2, 3)
  print(str(len(t)))
  print(" ")
  定 r = {a: 7, b: "琥珀"}
  print(str(r.a))
  print(r.b)
  返回 0
}
