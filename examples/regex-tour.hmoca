引入 "../lib/regex.hmoca"

// 正则的示范：模式与文本之间那一个问题 —— 「有没有」。
//
// 为什么这份例子存在（2026-11-05）：lib/ 十一库里，只有 strings 与 tuples 被
// examples/lib-tour.hmoca 用过。这一份是第四份，用 regex。
//
// 只测 式_有 这一条，因为它今天在自举层下跑得通；式_找 与 式_全找 不行（见文件末尾
// 那段记下来的话）。一份只能说出一半的示范，比一份绕过去假装全对的示范诚实。
//
// 它自己判：每一步都对才打「全对」，否则打印是哪一处并返回 1。

函数 核(名: String, 得: String, 期: String) -> Int {
  若 得 != 期 {
    print("不对：" + 名 + " 得 " + 得 + " 期 " + 期 + chr(10))
    返回 1
  }
  返回 0
}

函数 主() -> Int {
  返回 0
}

函数 main() -> Int 效果串(process) {
  变 错 = 0

  // 一、字符类与量词：数字、字母、下划线。
  错 = 错 + 核("找得到数字", str(式_有("[0-9]+", "abc123")), "true")
  错 = 错 + 核("纯字母里没有数字", str(式_有("[0-9]+", "abcdef")), "false")
  错 = 错 + 核("字母类", str(式_有("[a-z]+", "123abc456")), "true")
  错 = 错 + 核("下划线算不算字", str(式_有("\\w", "_")), "true")

  // 二、锚：^ 与 $ 是零宽断言，所以「整串」与「某处」是两种问题。
  错 = 错 + 核("整串匹配", str(式_有("^abc$", "abc")), "true")
  错 = 错 + 核("整串不匹配（前缀）", str(式_有("^abc$", "abcd")), "false")
  错 = 错 + 核("不加锚就某处", str(式_有("abc", "xxabcyy")), "true")

  // 三、或与重复：一个组里的选择、以及 {n,m} 那种次数。
  错 = 错 + 核("或", str(式_有("cat|dog", "a dog here")), "true")
  错 = 错 + 核("或的另一半", str(式_有("cat|dog", "a cat here")), "true")
  错 = 错 + 核("或都不在", str(式_有("cat|dog", "a bird here")), "false")
  错 = 错 + 核("重复两次", str(式_有("a{2}", "aa")), "true")
  错 = 错 + 核("重复不够", str(式_有("a{3}", "aa")), "false")

  // 四、点号：这一份的实现里它**也匹配换行**（有的引擎不匹配，有的要开一个开关）。
  // 例子照实现写，而不是照「通常的规矩」写 —— 判据比的是这一份的行为。
  错 = 错 + 核("点号吃到字母", str(式_有("a.c", "abc")), "true")
  错 = 错 + 核("点号也跨行", str(式_有("a.c", "a" + chr(10) + "c")), "true")

  若 错 == 0 {
    print("全对：正则，十四项" + chr(10))
  }
  返回 错
}

// 记下来的一件事（2026-11-05）：
//
//   式_找(式_编译("..."), 文, 起, 组数)   与   式_全找(...)
//
// 在这条（自举层）路径上会抛「len() wants a string or a tuple」。式_有 那条路好走，
// 是因为它自己从头编译再匹配一遍。两处都记在这里 —— 它比「再多写一份例子」要紧。
//
// 库本来的判据（test/ 里那一套）跑的是宿主那三台 —— 它们没红，所以这不是「库算错了」，
// 而是「有一条路能用、另一条不能」。
