// 短路：`&&` 的右边在有前提不成立时该不该被求值。
//
// 为什么（2026-11-01）：越界现场指到 lex.hmoca 的注释检查那一行 ——
//   if s[i] == "/" && i + 1 < len(s) && s[i + 1] == "/" { ... }
// 对长度为 1 的串、i=0 时，第二个条件为假，右边的 s[i + 1] 本该被短路掉。
// 若这一台的 && 不短路，s[1] 就会落在界外 —— 那正好是读数里那个「下标 1、长度 1」。
fn main() -> Int effects(process) {
  let s = "a"
  if 1 > 2 && s[9] == "x" {
    print("右边被求值了" + chr(10))
  }
  print("完" + chr(10))
  return 0
}
