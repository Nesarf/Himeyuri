引入 "../lib/maps.hmoca"

// 表与集的示范：`maps` 这一份与 `tables` 是两套独立的东西 ——
// tables 用记录搭字典，maps 用「名字 → 值」的对偶列表搭表与集。
//
// 为什么这份例子存在（2026-11-05）：lib/ 十一库里，maps 一直没被例子用过。
// 这一份是第八份。
//
// 它自己判：每一步都对才打「全对」，否则打印是哪一处并返回 1。

函数 核(名: String, 得: String, 期: String) -> Int {
  若 得 != 期 {
    print("不对：" + 名 + " 得 " + 得 + " 期 " + 期 + chr(10))
    返回 1
  }
  返回 0
}

函数 main() -> Int 效果串(process) {
  变 错 = 0

  // 一、表：空表、放、问、取。表取 交回的是 {有, 值} 记录 —— 要 值 那一个字段。
  变 t = 表新()
  错 = 错 + 核("空表没有东西", str(表数(t)), "0")
  错 = 错 + 核("空表问一个键", str(表有(t, "甲")), "false")
  t = 表放(t, "甲", 10)
  t = 表放(t, "乙", 20)
  错 = 错 + 核("放了两件", str(表数(t)), "2")
  错 = 错 + 核("问甲", str(表有(t, "甲")), "true")
  错 = 错 + 核("取甲", str(表取(t, "甲").值), "10")

  // 二、覆盖与删除：同一个键放两次不该变成两件。
  t = 表放(t, "甲", 99)
  错 = 错 + 核("覆盖之后还是两件", str(表数(t)), "2")
  错 = 错 + 核("覆盖之后取甲", str(表取(t, "甲").值), "99")
  t = 表删(t, "甲")
  错 = 错 + 核("删掉之后一件", str(表数(t)), "1")
  错 = 错 + 核("删掉之后问甲", str(表有(t, "甲")), "false")

  // 三、拷贝：拷出来的那一份改了不影响原来那一份 —— 值语义。
  定 原 = 表放(表新(), "x", 1)
  变 拷 = 表拷(原)
  拷 = 表放(拷, "y", 2)
  错 = 错 + 核("原表还是一件", str(表数(原)), "1")
  错 = 错 + 核("拷出来的两件", str(表数(拷)), "2")

  // 四、集：加、问、去。
  变 s = 集新()
  s = 集加(s, "苹果")
  s = 集加(s, "香蕉")
  s = 集加(s, "苹果")
  错 = 错 + 核("重复加不会多", str(集数(s)), "2")
  错 = 错 + 核("集里有苹果", str(集有(s, "苹果")), "true")
  错 = 错 + 核("集里没有梨", str(集有(s, "梨")), "false")
  s = 集去(s, "苹果")
  错 = 错 + 核("去掉之后一件", str(集数(s)), "1")

  // 五、并、交、差：三件集合运算一起测，才看得出谁算错。
  定 a = 集加(集加(集新(), "p"), "q")
  定 b = 集加(集加(集新(), "q"), "r")
  错 = 错 + 核("并之后是三件", str(集数(集并(a, b))), "3")
  错 = 错 + 核("交之后是一件", str(集数(集交(a, b))), "1")
  错 = 错 + 核("差之后是一件", str(集数(集差(a, b))), "1")

  若 错 == 0 {
    print("全对：表与集，十八项" + chr(10))
  }
  返回 错
}
