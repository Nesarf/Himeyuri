// Himeyuri 的终端动画示例。
//
// 跑法（在 D:\himeyuri 下）：
//   node examples/run-demo.mjs
//
// 它用上了这些件：画布 · 场景栈（点与横线）· 大字（标题）· 节拍（一拍一幅字样）· 按键退出。
// 表里的每一对是「拍号，标题字样」；到了那一拍，标题就换成它。
// 按键（真终端里 raw 模式可用时）会让它提前收手；否则跑满帧数。

fn main() -> Int effects(process) {
  let 表 = ((0, "42"), (2, "2026"), (4, "42"))
  return demo(表, 6)
}
