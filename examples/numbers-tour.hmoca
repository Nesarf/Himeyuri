引入 "../lib/numbers.hmoca"

// 数的示范：整除、取整、公约数、幂与阶乘那些「常常要写、每次都写错」的小事。
//
// 为什么这份例子存在（2026-11-05）：lib/ 十一库里，numbers 一直没有被任何例子用过。
// 这一份是第五份，用 numbers。
//
// 它自己判：每一步都对才打「全对」，否则打印是哪一处并返回 1。

函数 核(名: String, 得: String, 期: String) -> Int {
  若 得 != 期 {
    print("不对：" + 名 + " 得 " + 得 + " 期 " + 期 + chr(10))
    返回 1
  }
  返回 0
}

函数 main() -> Int 效果串(process) {
  变 错 = 0

  // 一、绝对值与符号：负数那一边最容易被忘掉。
  错 = 错 + 核("绝对值（负）", str(绝对值(-7)), "7")
  错 = 错 + 核("绝对值（正）", str(绝对值(7)), "7")
  错 = 错 + 核("零的绝对值", str(绝对值(0)), "0")
  错 = 错 + 核("负的符号", str(符号(-3)), "-1")
  错 = 错 + 核("零的符号", str(符号(0)), "0")

  // 二、两个极值：这一对在「夹住」里用得上。
  错 = 错 + 核("最小值", str(最小值(3, 9)), "3")
  错 = 错 + 核("最大值", str(最大值(3, 9)), "9")
  错 = 错 + 核("夹在中间", str(夹住(15, 0, 10)), "10")
  错 = 错 + 核("夹在下界", str(夹住(-3, 0, 10)), "0")

  // 三、奇偶与整除。整除 交回的是**商**（向下取整），不是布尔值 ——
  // 名字容易让人以为是「除得尽吗」，读一次实现就知道不是。
  错 = 错 + 核("六是偶数", str(是偶数(6)), "true")
  错 = 错 + 核("七不是偶数", str(是偶数(7)), "false")
  错 = 错 + 核("十二除以四的商", str(整除(12, 4)), "3")
  错 = 错 + 核("十除以四的商", str(整除(10, 4)), "2")

  // 四、幂与阶乘：边界那几条（零次幂、零的阶乘）比正数更值得测。
  错 = 错 + 核("二的十次", str(幂(2, 10)), "1024")
  错 = 错 + 核("零次幂", str(幂(9, 0)), "1")
  错 = 错 + 核("零的阶乘", str(阶乘(0)), "1")
  错 = 错 + 核("五的阶乘", str(阶乘(5)), "120")

  // 五、公约数与公倍数：GCD 与 LCM 互为对照，两个一起测才看得出错在哪。
  错 = 错 + 核("十二与十八的公约数", str(最大公约数(12, 18)), "6")
  错 = 错 + 核("互质", str(最大公约数(9, 28)), "1")
  错 = 错 + 核("四与六的公倍数", str(最小公倍数(4, 6)), "12")

  // 六、平方根与百分比：两条都走浮点，所以判据用「接近」而不是「相等」——
  // 这里退一步用整数化的期望，是因为例子要比的是「算得对」，不是精度。
  错 = 错 + 核("十六的平方根", str(平方根(16)), "4")
  错 = 错 + 核("六十四的平方根", str(平方根(64)), "8")
  错 = 错 + 核("五十是两百的百分之几", str(百分比(50, 200)), "25")

  若 错 == 0 {
    print("全对：数，二十二项" + chr(10))
  }
  返回 错
}
