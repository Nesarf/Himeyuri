引入 "../lib/strings.hmoca"
引入 "../lib/tuples.hmoca"

// 标准库的示范：用 lib/strings 与 lib/tuples 处理一小段文本与一组数。
//
// 为什么这份例子存在（2026-11-05）：lib/ 下十一个库一直有判据，但**没有任何一份
// 例子用它们** —— 那些判据证明库算得对，而这一份证明库用得起来。两者不是一回事：
// 一个库可以每一格都对，而写它的人从来不想拿它处理真的东西。
//
// 它自己判：每一步都对就打「全对」，有一处不对就打印是哪一处并返回 1 ——
// 于是 examples 那一条判据（每份都要退出码 0）就同时验了「库好用」。

函数 核(名: String, 得: String, 期: String) -> Int {
  若 得 != 期 {
    print("不对：" + 名 + " 得 " + 得 + " 期 " + 期 + chr(10))
    返回 1
  }
  返回 0
}

函数 main() -> Int 效果串(process) {
  变 错 = 0

  // 一、切分：把一条清单切成段。空段保留 —— 那与 JS 的 split 同一条规矩。
  定 清单 = "阿一:12|乙:7|丙:30|丁:5|"
  定 段们 = 切分(清单, "|")
  错 = 错 + 核("切分之后几段", str(len(段们)), "5")
  错 = 错 + 核("第一段", 段们[0], "阿一:12")

  // 二、修剪与查找：两端的空格、名字在不在。
  错 = 错 + 核("修剪两端", 修剪("  乙  "), "乙")
  错 = 错 + 核("找得到「丙」", str(串_查找(清单, "丙")), "10")

  // 三、替换与连接：把分隔符换成逗号，再接回一行。
  错 = 错 + 核("替换分隔符", 替换(清单, "|", ","), "阿一:12,乙:7,丙:30,丁:5,")
  定 名们 = ("阿一", "乙", "丙")
  错 = 错 + 核("连回一行", 连接(名们, "、"), "阿一、乙、丙")

  // 四、大小写与填充：这两条在报表里最常用。
  错 = 错 + 核("大写", 大写("abc"), "ABC")
  错 = 错 + 核("左填", 左填("7", 3, "0"), "007")

  // 五、元组：排序、反转、求和、极值。
  定 数们 = (3, 1, 4, 1, 5, 9, 2, 6)
  定 排 = 排序(数们)
  错 = 错 + 核("排序", str(排[0]) + str(排[7]), "19")
  错 = 错 + 核("反转", str(元_反转(数们)[0]), "6")
  错 = 错 + 核("求和", str(和(数们)), "31")
  错 = 错 + 核("最大", str(最大(数们)), "9")
  错 = 错 + 核("最小", str(最小(数们)), "1")

  // 六、元组里找不找得到某个值。
  定 串们 = ("甲", "乙", "丙")
  若 串含(串们, "乙") { 错 = 错 + 0 } 否则 { 错 = 错 + 1 }
  若 串含(串们, "丁") { 错 = 错 + 1 } 否则 { 错 = 错 + 0 }

  若 错 == 0 {
    print("全对：两个库，十六项" + chr(10))
  }
  返回 错
}
