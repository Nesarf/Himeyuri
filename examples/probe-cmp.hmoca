// 比较：最小的一件事，而它决定所有边界检查还站不站得住。
//
// 为什么（2026-11-01）：越界现场是 标.value[1] 而 len 是 1，也就是说某个
// 「走 < len(源码)」或「i < len(s)」在越界时被判成了真。若这一台机器上
// 1 < 1 为真，那所有边界检查都会失效 —— 那才是根因，而不是词法器。
fn main() -> Int effects(process) {
  print("1<1=" + str(1 < 1) + chr(10))
  print("1<2=" + str(1 < 2) + chr(10))
  print("0<1=" + str(0 < 1) + chr(10))
  print("1<=1=" + str(1 <= 1) + chr(10))
  print("2<=1=" + str(2 <= 1) + chr(10))
  return 0
}
