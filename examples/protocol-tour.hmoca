引入 "../lib/protocol.hmoca"

// 帧的示范：先报长度、再报类型、然后是载荷 —— 二进制的那一种。
//
// 为什么这份例子存在（2026-11-05）：lib/ 十一库里，protocol 是最后一个没被例子
// 用过的。这一份是第九份 —— 也是这一批的最后一份。
//
// 形状（读 lib/protocol.hmoca 得来的，不是猜的）：
//
//   编帧(帧型: Int, 载荷: (Int,))   四个字节的长度 + 一个字节的帧型 + 载荷
//   解帧(字节: (Int,))              交回 {ok, 长度, 帧型, 载荷}
//   完整(字节: (Int,))              自称的长度与实际给的字节数对不对得上
//
// 注意它的长度算的是「类型一个字节 + 载荷」，不是整套五个字节 —— 这一条是从
// 实现里读出来的（n = len(载荷) + 1），而 完整 那一边用的是 len(字节) - 4 == n。
//
// 它自己判：每一步都对才打「全对」，否则打印是哪一处并返回 1。

函数 核(名: String, 得: String, 期: String) -> Int {
  若 得 != 期 {
    print("不对：" + 名 + " 得 " + 得 + " 期 " + 期 + chr(10))
    返回 1
  }
  返回 0
}

函数 main() -> Int 效果串(process) {
  变 错 = 0

  // 一、编一帧：三字节载荷 + 一字节类型 = 八个字节。
  定 帧 = 编帧(7, (65, 66, 67))
  错 = 错 + 核("帧长八字节", str(len(帧)), "8")
  错 = 错 + 核("这一帧是完整的", str(完整(帧)), "true")

  // 二、解回去：帧型与载荷都该回到原来的样子。
  定 解 = 解帧(帧)
  错 = 错 + 核("解得开", str(解.ok), "true")
  错 = 错 + 核("声称的长度", str(解.长度), "4")
  错 = 错 + 核("帧型", str(解.帧型), "7")
  错 = 错 + 核("载荷三项", str(len(解.载荷)), "3")
  错 = 错 + 核("第一个载荷字节", str(解.载荷[0]), "65")
  错 = 错 + 核("第三个载荷字节", str(解.载荷[2]), "67")

  // 三、不完整：少给一个字节，「完整」就该说不完整。
  定 缺一 = (帧[0], 帧[1], 帧[2], 帧[3], 帧[4], 帧[5], 帧[6])
  错 = 错 + 核("少一字节就不完整", str(完整(缺一)), "false")

  // 四、两个帧拼起来：完整 问的是「这一整块字节恰好是一帧吗」，不是「前面这一帧
  // 完了没有」—— 它比 len(字节) - 4 与自称的长度。所以两帧拼起来它说不完整。
  // 要按帧切流，得先读前四个字节算出长度，再自己切。
  定 两帧 = 帧 + 编帧(9, (10,))
  错 = 错 + 核("两帧拼起来不算一帧", str(完整(两帧)), "false")

  若 错 == 0 {
    print("全对：帧，十一项" + chr(10))
  }
  返回 错
}
