// 优先级：&& 与比较谁先算。
//
// 为什么（2026-11-01）：probe-and 里 1 > 2 左边是假（probe-gt 已确认），
// 而 && 的实现左边为假就返回 false —— 那么 s[9] 根本不该被求值。它被求值了，
// 所以怀疑解析：1 > 2 && s[9] == "x" 也许被读成了 1 > (2 && s[9] == "x")。
fn main() -> Int effects(process) {
  print("带括号=" + str((1 > 2) && (3 > 4)) + chr(10))
  print("不带括号=" + str(1 > 2 && 3 > 4) + chr(10))
  print("或带括号=" + str((1 < 2) || (3 < 4)) + chr(10))
  print("或不带括号=" + str(1 < 2 || 3 < 4) + chr(10))
  return 0
}
