// 板子上的那条规矩：一个区，用完关掉，别在循环里建。
//
// 为什么这份示例长成这样：Nucleo-F411RE 那块板子不编 GC —— vm/hmyr.c 里
// gc_分配 在 __arm__ 下是一个返回 NULL 的桩（design/BOARD.txt 第九节）。
// 于是板子上的分配从不回收。
//
// 而语言里「一次释放全部」的那个东西是 arena。它在桌面上可以在循环里一轮建一个、
// 轮末关掉，因为关掉的块会被回收器收走；在板子上不行 —— 关掉只是把它标成关，
// 那块内存还在。所以循环里建 N 个区，就是 N 份量，N 大了就耗尽。
// 装载器早有一条警告说这件事（HMYR-W0310），而这一份的第一版正是它的反例：
// 50 轮每轮一个区，在板子上跑到一半 hm_malloc 失败，exit 落进死循环。
//
// 于是板子上的形状是这一条，而它同时也是桌面上的形状：
//
//   循环外面一个区 —— 里面想分多少块就分多少块 —— 全部用完再一次关掉。
//
// 一次关掉释放的是整区，所以分区次数不改变占用，只改变「一次拿多少」。
//
// 三台机器跑它输出逐行相同：默认路径、--compile、C 那台；那块板子是第四台。
// 判据在 test/zone-self.test.mjs 第九节。
fn main() -> Int effects(process) {
  let 区 = arena()

  var 块数 = 0
  var 总长 = 0
  var 最宽 = 0
  var i = 0
  while i < 20 {
    let 块 = 区.alloc(i % 11 + 1)
    块数 = 块数 + 1
    总长 = 总长 + 块.size
    if 块.size > 最宽 { 最宽 = 块.size }
    i = i + 1
  }

  let 报告 = 区.alloc(8)
  区.freeze(报告)
  报告.存(0, 块数)

  print("块数=" + str(块数) + chr(10))
  print("总长=" + str(总长) + chr(10))
  print("最宽=" + str(最宽) + chr(10))
  print("关之前 held=" + str(区.held()) + chr(10))
  区.close()
  print("关之后 报告.live=" + str(报告.live) + " zone=" + 报告.zone + chr(10))
  return 0
}