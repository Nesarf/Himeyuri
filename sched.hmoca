// 调度器：轮流让每个任务推进一步。
//
// 它不「跑」任务。这门语言没有续延，也没有函数值，所以调度器不调用谁——
// 它只回答两件事：下一个该轮到谁；某个任务跑完一步之后，怎么记。
// 于是「交错推进」完全由调用方按轮转顺序做，而调度器本身是纯数据、可逐轮断言。
//
// 这与 design/THREADS.txt 那个「一步函数 + 调度一遍」的形状是同一件事：
// 一步之内跑多长由那个任务自己决定，一步结束就轮到下一个。

函数 空轮() -> Int {
  返回 {tasks: (), 下一个位: 0, 轮数: 0}
}

函数 加(轮: Int, 名: String) -> Int {
  返回 {tasks: 轮.tasks + ({name: 名, state: (), done: 假, failed: 假, steps: 0},),
          下一个位: 轮.下一个位, 轮数: 轮.轮数}
}

函数 任务数(轮: Int) -> Int {
  返回 len(轮.tasks)
}

// 从「下一个位」开始往后找第一个还没完成的；都完了就交回 -1。
// 深度等于任务数——所以一个轮里的任务不该成千上万，这一点写在明处。
函数 找下一个从(轮: Int, i: Int) -> Int {
  若 i >= len(轮.tasks) { 返回 -1 }
  定 位 = (轮.下一个位 + i) % len(轮.tasks)
  若 轮.tasks[位].done == 假 { 返回 位 }
  返回 找下一个从(轮, i + 1)
}

函数 下一个(轮: Int) -> Int {
  若 len(轮.tasks) == 0 { 返回 -1 }
  返回 找下一个从(轮, 0)
}

函数 名字(轮: Int, 位: Int) -> String {
  若 位 < 0 || 位 >= len(轮.tasks) { 返回 "" }
  返回 轮.tasks[位].name
}

函数 状态(轮: Int, 位: Int) -> Int {
  若 位 < 0 || 位 >= len(轮.tasks) { 返回 () }
  返回 轮.tasks[位].state
}

函数 完成了(轮: Int, 位: Int) -> Bool {
  若 位 < 0 || 位 >= len(轮.tasks) { 返回 真 }
  返回 轮.tasks[位].done
}

函数 步数(轮: Int, 位: Int) -> Int {
  若 位 < 0 || 位 >= len(轮.tasks) { 返回 -1 }
  返回 轮.tasks[位].steps
}

函数 失败了吗(轮: Int, 位: Int) -> Bool {
  若 位 < 0 || 位 >= len(轮.tasks) { 返回 假 }
  返回 轮.tasks[位].failed
}

函数 剩余(轮: Int) -> Int {
  变 数 = 0
  变 i = 0
  当 i < len(轮.tasks) {
    若 轮.tasks[i].done == 假 { 数 = 数 + 1 }
    i = i + 1
  }
  返回 数
}

// 换掉第 位 个任务。深度等于任务数。
函数 换位从(轮: Int, 位: Int, 新: Int, i: Int, acc: Int) -> Int {
  若 i >= len(轮.tasks) { 返回 acc }
  若 i == 位 { 返回 换位从(轮, 位, 新, i + 1, acc + (新,)) }
  返回 换位从(轮, 位, 新, i + 1, acc + (轮.tasks[i],))
}

// 记一步：状态换掉、步数加一、完成与失败照实记。
// 而「下一个位」推到它后面——轮转就是这样来的。
函数 记(轮: Int, 位: Int, 新状态: Int, 完成: Bool, 失败: Bool) -> Int {
  若 位 < 0 || 位 >= len(轮.tasks) { 返回 轮 }
  定 旧 = 轮.tasks[位]
  定 新 = {name: 旧.name, state: 新状态, done: 完成, failed: 失败, steps: 旧.steps + 1}
  返回 {tasks: 换位从(轮, 位, 新, 0, ()), 下一个位: (位 + 1) % len(轮.tasks), 轮数: 轮.轮数 + 1}
}

// 取消一个任务：它不再被轮到。而它的子任务由任务树那边负责（task.hmyr 的 取消），
// 这一层不重复实现那条规矩——两处各管一件事。
函数 取消(轮: Int, 位: Int) -> Int {
  返回 记(轮, 位, 状态(轮, 位), 真, 假)
}

函数 main() -> Int {
  变 轮 = 空轮()
  轮 = 加(轮, "甲")
  轮 = 加(轮, "乙")
  print("两个任务，第一个该轮到：" + 名字(轮, 下一个(轮)) + "\n")
  返回 0
}
