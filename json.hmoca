// 用 Himeyuri 写的 JSON 解析器：值那一层。
//
// 为什么这件事该在语言里做：颜色桥的报告是 JSON，此前要判断「源图带不带 ICC」「损失多大」
// 都得请宿主代劳——而那是「用别人的语言判定自己产物」的形态。把解析器写进语言之后，
// 同一份报告可以在 Himeyuri 里被读、被判断、被拒绝。
//
// 表示约定（JSON 与 Himeyuri 的类型不对应，所以要说清楚）：
//   ・JSON 字符串 → Himeyuri 字符串
//   ・JSON 整数   → Himeyuri 整数
//   ・JSON 布尔   → Himeyuri 布尔
//   ・JSON null   → 空元组（这门语言没有 null）
//   ・JSON 数组   → 元组
//   ・JSON 对象   → 元组的元组，每项是 (键, 值)
//      不用记录，因为记录的字段名必须是标识符，而 JSON 的键是任意字符串。
//
// 每个值都包一层 {kind: ..., value: ...}，kind 是 "s" / "n" / "b" / "null" / "a" / "o"，
// 调用方据此分派——于是「这是什么类型」不靠猜。
//
// 边界（写在明处，不装作支持）：
//   ・字符串只认两个转义：\\ 与 \"，其余原样保留
//   ・数字只认整数（报告里的数都是整数或小数的字符串形式）
//   ・深度等于嵌套层数加字符串长度，所以极深的文档会先撞上调用深度上限

fn 跳过空白(s: String, i: Int) -> Int {
  if i >= len(s) { return i }
  let c = s[i]
  if c == " " || c == "\n" || c == "\r" || c == "\t" { return 跳过空白(s, i + 1) }
  return i
}

fn 是数字字符(c: String) -> Bool {
  return c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9"
}

// 字符串：从开引号之后开始读，认出 \\ 与 \" 两个转义。
fn 读字符串从(s: String, i: Int, acc: String) {
  if i >= len(s) { return ({kind: "err", text: "字符串没有闭合"}, i) }
  let c = s[i]
  if c == "\"" { 返回 ({kind: "s", value: acc}, i + 1) }
  若 c == "\\" {
    若 i + 1 >= len(s) { 返回 ({kind: "err", text: "转义不完整"}, i) }
    返回 读字符串从(s, i + 2, acc + s[i + 1])
  }
  返回 读字符串从(s, i + 1, acc + c)
}

函数 读字符串(s: String, i: Int) {
  返回 读字符串从(s, i, "")
}

// 数字：整数，可带负号。
// 数字：整数或小数。小数点只认一个，读到别的字符就收工。
// 整数给 "n"（值是整数），带小数点的给 "f"（值保留原文，免得把 0.969 悄悄读成 0）。
函数 读数字从(s: String, i: Int, acc: String, 有点: Bool) {
  若 i >= len(s) { 返回 (收数字(acc), i) }
  定 c = s[i]
  若 是数字字符(c) { 返回 读数字从(s, i + 1, acc + c, 有点) }
  若 c == "." && 有点 == 假 { 返回 读数字从(s, i + 1, acc + ".", 真) }
  返回 (收数字(acc), i)
}

函数 收数字(原文: String) {
  若 含点(原文) { 返回 {kind: "f", value: 原文} }
  返回 {kind: "n", value: to_int(原文)}
}

函数 含点从(s: String, i: Int) -> Bool {
  若 i >= len(s) { 返回 假 }
  若 s[i] == "." { 返回 真 }
  返回 含点从(s, i + 1)
}

函数 含点(s: String) -> Bool {
  返回 含点从(s, 0)
}




// 字面量：真 / 假 / null
函数 读字面量(s: String, i: Int, 字: String, 值: Int) {
  若 i + len(字) > len(s) { 返回 ({kind: "err", text: "字面量不完整：" + 字}, i) }
  定 片 = slice(s, i, i + len(字))
  若 片 != 字 { 返回 ({kind: "err", text: "不认识的词：" + 片}, i) }
  返回 (值, i + len(字))
}



函数 读值(s: String, i: Int) {
  定 j = 跳过空白(s, i)
  若 j >= len(s) { 返回 ({kind: "err", text: "没有值"}, j) }
  定 c = s[j]
  若 c == "\"" { 返回 读字符串(s, j + 1) }
  若 c == "{" { 返回 读对象(s, j + 1, ()) }
  若 c == "[" { 返回 读数组(s, j + 1, ()) }
  若 c == "t" { 返回 读字面量(s, j, "true", ({kind: "b", value: 真})) }
  若 c == "f" { 返回 读字面量(s, j, "false", ({kind: "b", value: 假})) }
  若 c == "n" { 返回 读字面量(s, j, "null", {kind: "null"}) }
  // 负号要单独吃：读数字从只认数字字符，遇到负号会立刻收工，于是 -7 会变成 0。
  若 c == "-" {
    定 后半 = 读数字从(s, j + 1, "", 假)
    若 后半[0].kind == "f" { 返回 ({kind: "f", value: "-" + 后半[0].value}, 后半[1]) }
    返回 ({kind: "n", value: 0 - 后半[0].value}, 后半[1])
  }
  若 是数字字符(c) { 返回 读数字从(s, j, "", 假) }
  返回 ({kind: "err", text: "不认识的字符：" + c}, j + 1)
}

// 数组：[值, 值, ...]——遇到 ] 收工。
函数 读数组从(s: String, i: Int, acc: Int) {
  定 j = 跳过空白(s, i)
  若 j >= len(s) { 返回 ({kind: "err", text: "数组没有闭合"}, j) }
  若 s[j] == "]" { 返回 ({kind: "a", value: acc}, j + 1) }
  若 s[j] == "," { 返回 读数组从(s, j + 1, acc) }
  定 一个 = 读值(s, j)
  若 一个[0].kind == "err" { 返回 一个 }
  返回 读数组从(s, 一个[1], acc + (一个[0],))
}

函数 读数组(s: String, i: Int, acc: Int) {
  返回 读数组从(s, i, acc)
}

// 对象：{"键": 值, ...}——键读成字符串值，再塞进 (键, 值) 的对里。
函数 读对象从(s: String, i: Int, acc: Int) {
  定 j = 跳过空白(s, i)
  若 j >= len(s) { 返回 ({kind: "err", text: "对象没有闭合"}, j) }
  若 s[j] == "}" { 返回 ({kind: "o", value: acc}, j + 1) }
  若 s[j] == "," { 返回 读对象从(s, j + 1, acc) }
  若 s[j] != "\"" { 返回 ({kind: "err", text: "键必须是字符串"}, j) }
  定 键 = 读字符串(s, j + 1)
  若 键[0].kind == "err" { 返回 键 }
  定 k = 跳过空白(s, 键[1])
  若 k >= len(s) || s[k] != ":" { 返回 ({kind: "err", text: "键后面应当是冒号"}, k) }
  定 值 = 读值(s, k + 1)
  若 值[0].kind == "err" { 返回 值 }
  返回 读对象从(s, 值[1], acc + ((键[0].value, 值[0]),))
}

函数 读对象(s: String, i: Int, acc: Int) {
  返回 读对象从(s, i, acc)
}

// 入口：读一段 JSON，交回 (值, 结束位置)。值带着 kind，所以调用方不必猜它是什么。
pub 函数 解析(s: String) {
  返回 读值(s, 0)
}

// 从对象里取一个字段。不是对象、或没有这个键，都返回 err——
// 调用方据此拒绝，而不是拿默认值顶上。
函数 字段从(对表: Int, 键: String, i: Int) {
  若 i >= len(对表) { 返回 {kind: "err", text: "没有字段：" + 键} }
  若 对表[i][0] == 键 { 返回 对表[i][1] }
  返回 字段从(对表, 键, i + 1)
}

函数 字段(对象: Int, 键: String) {
  若 对象.kind != "o" { 返回 {kind: "err", text: "不是对象，取不到字段 " + 键} }
  返回 字段从(对象.value, 键, 0)
}


// ---- 生成：两种形式 ----
//
// 紧凑形式对齐 JSON.stringify(x)，缩进形式对齐 JSON.stringify(x, null, 2)。
// 后者不是「好看」——清单的 digest 是对那一串字节算的，差一个空格就对不上。

函数 转义文(s: String) -> String {
  var 出 = ""
  var i = 0
  当 i < len(s) {
    定 c = s[i]
    若 c == "\"" { 出 = 出 + "\\\"" }
    否则 若 c == "\\" { 出 = 出 + "\\\\" }
    否则 若 c == chr(10) { 出 = 出 + "\\n" }
    否则 若 c == chr(13) { 出 = 出 + "\\r" }
    否则 若 c == chr(9) { 出 = 出 + "\\t" }
    否则 { 出 = 出 + c }
    i = i + 1
  }
  返回 出
}

函数 引号(s: String) -> String {
  返回 "\"" + 转义文(s) + "\""
}

函数 缩进空(n: Int) -> String {
  var 出 = ""
  var i = 0
  当 i < n {
    出 = 出 + "  "
    i = i + 1
  }
  返回 出
}

函数 生成紧凑(值: Int) -> String {
  若 值.kind == "n" { 返回 str(值.value) }
  若 值.kind == "f" { 返回 值.value }
  若 值.kind == "s" { 返回 引号(值.value) }
  若 值.kind == "b" {
    若 值.value { 返回 "true" }
    返回 "false"
  }
  若 值.kind == "null" { 返回 "null" }
  若 值.kind == "a" {
    var 出 = "["
    var i = 0
    当 i < len(值.value) {
      若 i > 0 { 出 = 出 + "," }
      出 = 出 + 生成紧凑(值.value[i])
      i = i + 1
    }
    返回 出 + "]"
  }
  若 值.kind == "o" {
    var 出 = "{"
    var i = 0
    当 i < len(值.value) {
      若 i > 0 { 出 = 出 + "," }
      出 = 出 + 引号(值.value[i][0]) + ":" + 生成紧凑(值.value[i][1])
      i = i + 1
    }
    返回 出 + "}"
  }
  返回 "null"
}

// 缩进形式：空容器写成 [] / {}，非空才换行。
函数 生成缩进(值: Int, 层: Int) -> String {
  若 值.kind == "n" { 返回 str(值.value) }
  若 值.kind == "f" { 返回 值.value }
  若 值.kind == "s" { 返回 引号(值.value) }
  若 值.kind == "b" {
    若 值.value { 返回 "true" }
    返回 "false"
  }
  若 值.kind == "null" { 返回 "null" }
  若 值.kind == "a" {
    若 len(值.value) == 0 { 返回 "[]" }
    定 内 = 缩进空(层 + 1)
    var 出 = "[" + chr(10)
    var i = 0
    当 i < len(值.value) {
      出 = 出 + 内 + 生成缩进(值.value[i], 层 + 1)
      若 i + 1 < len(值.value) { 出 = 出 + "," }
      出 = 出 + chr(10)
      i = i + 1
    }
    返回 出 + 缩进空(层) + "]"
  }
  若 值.kind == "o" {
    若 len(值.value) == 0 { 返回 "{}" }
    定 内 = 缩进空(层 + 1)
    var 出 = "{" + chr(10)
    var i = 0
    当 i < len(值.value) {
      出 = 出 + 内 + 引号(值.value[i][0]) + ": " + 生成缩进(值.value[i][1], 层 + 1)
      若 i + 1 < len(值.value) { 出 = 出 + "," }
      出 = 出 + chr(10)
      i = i + 1
    }
    返回 出 + 缩进空(层) + "}"
  }
  返回 "null"
}

pub 函数 生成(值: Int) -> String {
  返回 生成紧凑(值)
}

函数 生成二(值: Int) -> String {
  返回 生成缩进(值, 0)
}

// ---- 串与字节 ----
//
// sha256 收字节元组，而生成器给字符串。这一步把前者造出来：按 UTF-8 编码。
// 边界写在明处：只覆盖基本多文种平面（码点小于 65536）——代理对要另外合并，
// 而 JSON 清单里的字符都在这一层。
//
// 写法上有一处必须避开：往元组上一个一个追加是平方级（这个仓库里同一句教训已经出现过四次）。
// 这里每 1024 字节封一块，最后用两半合并折平。

pub 函数 拼平(块堆: Int, 起: Int, 止: Int) {
  若 止 - 起 <= 1 { 返回 块堆[起] }
  var 左 = 起
  var 右 = 止
  当 右 - 左 > 2 {
    左 = 左 + 1
    右 = 右 - 1
  }
  定 中 = 左 + 1
  返回 拼平(块堆, 起, 中) + 拼平(块堆, 中, 止)
}

pub 函数 从文本(s: String) {
  var 块堆 = ()
  var 块 = ()
  var i = 0
  当 i < len(s) {
    定 cp = ord(s[i])
    若 cp < 128 {
      块 = 块 + (cp,)
    } 否则 若 cp < 2048 {
      块 = 块 + (192 + (cp - cp % 64) / 64, 128 + cp % 64)
    } 否则 {
      定 高 = (cp - cp % 4096) / 4096
      定 中 = ((cp - cp % 64) / 64) % 64
      定 低 = cp % 64
      块 = 块 + (224 + 高, 128 + 中, 128 + 低)
    }
    若 len(块) >= 1024 {
      块堆 = 块堆 + (块,)
      块 = ()
    }
    i = i + 1
  }
  若 len(块) > 0 { 块堆 = 块堆 + (块,) }
  若 len(块堆) == 0 { 返回 () }
  返回 拼平(块堆, 0, len(块堆))
}

函数 main() -> Int {
  定 一个 = 解析("{\"a\": 1, \"b\": [true, false]}")[0]
  print("kind " + 一个.kind + " 字段 " + str(len(一个.value)) + "\n")
  返回 0
}
