// 正则库：模式串 → 一棵小树 → 在文本里找。第二次重写（2026-11-04）：加了捕获组与懒惰量词。
//
// 支持的语法（就这些，别的不认，认不出就交回 有: 假）：
//
//   字面量        普通字符
//   .             任意一个字符（换行也算）
//   [abc] [a-z]   字符类，^ 打头是否定
//   *  +  ?       量词，贪婪
//   *? +? ??      同一批量词，懒惰（先吞最少）
//   (...)         捕获组，从 1 开始编号；嵌套时外层得号，内层接着往下
//   (?:...)       非捕获组：只分组，不占号
//   |             选择
//   ^  $          锚点，分别对文本头与文本尾
//   \d \w \s      数字 / 单词字符 / 空白
//   \. \\ 等      转义一个字面量字符
//
// 不支持：{n,m}、前后瞻、反向引用、命名组、旗标。与 JS 的 RegExp 对答案时只用上面
// 这些，别的形状两边本来就不该一致。
//
// 为什么用回溯而不是 NFA：JS 的 RegExp 是回溯的，而这一份要与它逐位对答案。
// 一个 Thompson 的线性引擎在这门语言里更优雅，但它给出的匹配位置与回溯引擎不同 ——
// 那就不再是「同一个意思」了。
//
// 节点用五元组，五样都写满，缺的填 0 或空元组：
//
//   下标 0  种：0 字, 1 任意, 2 类, 3 序, 4 或, 5 复, 6 组, 7 锚
//   下标 1  主：字的码点 / 类的项 / 序的子们 / 或的左 / 复的子 / 组的子 / 锚的型
//   下标 2  次：或的右 / 复的少 / 类的反 / 组的号
//   下标 3  三：复的多
//   下标 4  四：复的贪（1 贪婪，0 懒惰）
//
// 为什么不各用一个记录：记录的字段是固定的，不同种用不同字段就会读到不存在的字段，
// 而那报的是 HMYR-內-016。五元组让每个节点同形，代价是可读性。

函数 式_字(码: Int) { 返回 (0, 码, 0, 0, 0) }
函数 式_任意() { 返回 (1, 0, 0, 0, 0) }
函数 式_锚(型: Int) { 返回 (7, 型, 0, 0, 0) }

// ---- 解析 ----
//
// 组号往下传：解或 交回 {节, 位, 号}，号 是「下一个可用的组号」。
// 这个号必须一路穿过去，不能用一层全局变量 —— 嵌套的 (...)(...) 要靠它按括号顺序编号，
// 而 组 节点的号一旦错位，捕获结果就全错，症状却是「匹配位置都对」。

函数 式_取字(式: String, 位: Int) -> String {
  若 位 >= len(式) {
    返回 ""
  }
  返回 slice(式, 位, 位 + 1)
}

函数 码在(式: String, 位: Int) -> Int {
  若 位 >= len(式) {
    返回 0 - 1
  }
  返回 ord(slice(式, 位, 位 + 1))
}

函数 解类项(式: String, 位: Int) {
  定 始码 = 码在(式, 位)
  若 始码 == 92 {
    定 下码 = 码在(式, 位 + 1)
    若 下码 == 100 { 返回 {项们: ((48, 57),), 位: 位 + 2} }
    若 下码 == 119 { 返回 {项们: ((48, 57), (65, 90), (95, 95), (97, 122)), 位: 位 + 2} }
    若 下码 == 115 { 返回 {项们: ((9, 13), (32, 32)), 位: 位 + 2} }
    返回 {项们: ((下码, 下码),), 位: 位 + 2}
  }
  若 码在(式, 位 + 1) == 45 && 位 + 2 < len(式) && 码在(式, 位 + 2) != 93 {
    返回 {项们: ((始码, 码在(式, 位 + 2)),), 位: 位 + 3}
  }
  返回 {项们: ((始码, 始码),), 位: 位 + 1}
}

函数 解类(式: String, 位: Int) {
  变 i = 位
  变 反 = 假
  若 码在(式, i) == 94 {
    反 = 真
    i = i + 1
  }
  变 项们 = ()
  变 收尾 = 假
  变 终 = i
  当 i < len(式) {
    若 码在(式, i) == 93 && !收尾 {
      终 = i
      收尾 = 真
      i = len(式) + 1
    } 否则 {
      定 一 = 解类项(式, i)
      项们 = 项们 + 一.项们
      i = 一.位
    }
  }
  若 !收尾 {
    返回 {有: 假, 节: 0, 位: 位, 号: 0}
  }
  返回 {有: 真, 节: (2, 项们, 反, 0, 0), 位: 终 + 1, 号: 0}
}

// 一个单元。号 穿进去、交回来。
函数 解元(式: String, 位: Int, 号: Int) {
  定 码 = 码在(式, 位)
  若 码 == 0 - 1 {
    返回 {有: 假, 节: 0, 位: 位, 号: 号}
  }
  若 码 == 46 {
    返回 {有: 真, 节: 式_任意(), 位: 位 + 1, 号: 号}
  }
  若 码 == 40 {
    // (  后面可能跟着 ?: / ?= / ?! / ?<= / ?<! —— 四种零宽断言与一种非捕获组。
    // 都不占组号，因为它们不捕获；只有裸的 ( 才占号。
    变 非捕 = 假
    变 种 = 6
    变 正 = 1
    变 起 = 位 + 1
    若 码在(式, 起) == 63 {
      定 型 = 码在(式, 起 + 1)
      若 型 == 58 {
        非捕 = 真
        起 = 起 + 2
      }
      若 型 == 61 {
        种 = 8
        正 = 1
        起 = 起 + 2
      }
      若 型 == 33 {
        种 = 8
        正 = 0
        起 = 起 + 2
      }
      若 型 == 60 {
        定 四 = 码在(式, 起 + 2)
        若 四 == 61 {
          种 = 9
          正 = 1
          起 = 起 + 3
        }
        若 四 == 33 {
          种 = 9
          正 = 0
          起 = 起 + 3
        }
        若 四 != 61 && 四 != 33 {
          // (?<名字> 是命名组，这一份不做 —— 交回 有: 假，而不是猜。
          返回 {有: 假, 节: 0, 位: 位, 号: 号}
        }
      }
      若 型 != 58 && 型 != 61 && 型 != 33 && 型 != 60 {
        // (? 后面跟了别的东西：JS 里那多半是错的，这里也拒绝，不猜。
        返回 {有: 假, 节: 0, 位: 位, 号: 号}
      }
    }
    定 我号 = 号
    变 下号 = 号
    若 !非捕 && 种 == 6 {
      下号 = 号 + 1
    }
    定 内 = 解或(式, 起, 下号)
    若 !内.有 {
      返回 {有: 假, 节: 0, 位: 位, 号: 号}
    }
    若 码在(式, 内.位) != 41 {
      返回 {有: 假, 节: 0, 位: 位, 号: 号}
    }
    若 种 == 8 || 种 == 9 {
      // 零宽断言：主是子节点，次是正负。断言里的组也照样占号（JS 如此），
      // 所以 下号 照传 —— 只是节点自己不捕获。
      返回 {有: 真, 节: (种, 内.节, 正, 0, 0), 位: 内.位 + 1, 号: 内.号}
    }
    变 组号 = 0 - 1
    若 !非捕 {
      组号 = 我号
    }
    返回 {有: 真, 节: (6, 内.节, 组号, 0, 0), 位: 内.位 + 1, 号: 内.号}
  }
  若 码 == 91 {
    定 类 = 解类(式, 位 + 1)
    若 !类.有 {
      返回 {有: 假, 节: 0, 位: 位, 号: 号}
    }
    返回 {有: 真, 节: 类.节, 位: 类.位, 号: 号}
  }
  若 码 == 94 {
    返回 {有: 真, 节: 式_锚(0), 位: 位 + 1, 号: 号}
  }
  若 码 == 36 {
    返回 {有: 真, 节: 式_锚(1), 位: 位 + 1, 号: 号}
  }
  若 码 == 92 {
    定 下码 = 码在(式, 位 + 1)
    若 下码 == 100 {
      返回 {有: 真, 节: (2, ((48, 57),), 假, 0, 0), 位: 位 + 2, 号: 号}
    }
    若 下码 == 119 {
      返回 {有: 真, 节: (2, ((48, 57), (65, 90), (95, 95), (97, 122)), 假, 0, 0), 位: 位 + 2, 号: 号}
    }
    若 下码 == 115 {
      返回 {有: 真, 节: (2, ((9, 13), (32, 32)), 假, 0, 0), 位: 位 + 2, 号: 号}
    }
    若 下码 == 0 - 1 {
      返回 {有: 假, 节: 0, 位: 位, 号: 号}
    }
    返回 {有: 真, 节: 式_字(下码), 位: 位 + 2, 号: 号}
  }
  返回 {有: 真, 节: 式_字(码), 位: 位 + 1, 号: 号}
}

// 读一串十进制数字。交回 {数, 位}；一个数字都没有时 数 是 -1。
//
// 自己算，不用 to_int：to_int 要一整串都是数字（HMYR-內-008），而这里要的是
// 「读到没数字为止」—— a{2,3}b 里它得在 3 之后停下。
//
// 第一版用「i 跳到 len 之外」来结束循环，于是交回的位是 len+1 —— 调用方拿去读 '}'
// 当然读不到，整条 {n,m} 被当成字面量，症状是 a{2} 对 aaa 报「无匹配」。
// 这一门语言没有 break，所以结束靠一个标志，而标志必须写在交回的位之前。
函数 读数(式: String, 位: Int) {
  变 i = 位
  变 值 = 0
  变 有 = 假
  变 停 = 假
  当 i < len(式) && 停 == 假 {
    定 码 = 码在(式, i)
    若 码 < 48 || 码 > 57 {
      停 = 真
    } 否则 {
      值 = 值 * 10 + (码 - 48)
      有 = 真
      i = i + 1
    }
  }
  若 !有 {
    返回 {数: 0 - 1, 位: 位}
  }
  返回 {数: 值, 位: i}
}

// 单元加可选量词。量词后面再跟一个 ? 就是懒惰。
//
// 认四种：* + ? 与 {n} {n,} {n,m}。那个 { 只在「单元之后」才当量词 ——
// 别的位子上它是字面量（JS 也这样），所以读不成就把单元原样交回，
// 让 { 成为下一个单元的第一个字符。
函数 解量(式: String, 位: Int, 号: Int) {
  定 一 = 解元(式, 位, 号)
  若 !一.有 {
    返回 一
  }
  定 下码 = 码在(式, 一.位)
  变 少 = 0 - 1
  变 多 = 0 - 1
  变 量尾 = 一.位 + 1
  若 下码 == 42 {
    少 = 0
    多 = 1000000
  }
  若 下码 == 43 {
    少 = 1
    多 = 1000000
  }
  若 下码 == 63 {
    少 = 0
    多 = 1
  }
  若 下码 == 123 {
    定 甲 = 读数(式, 一.位 + 1)
    若 甲.数 < 0 {
      返回 一
    }
    少 = 甲.数
    多 = 甲.数
    变 后 = 甲.位
    若 码在(式, 后) == 44 {
      定 乙 = 读数(式, 后 + 1)
      若 乙.数 < 0 {
        多 = 1000000
      } 否则 {
        多 = 乙.数
        后 = 乙.位
      }
      若 乙.数 < 0 {
        后 = 后 + 1
      }
    }
    若 码在(式, 后) != 125 {
      返回 一
    }
    量尾 = 后 + 1
  }
  若 少 < 0 {
    返回 一
  }
  变 贪 = 1
  变 下位 = 量尾
  若 码在(式, 下位) == 63 {
    贪 = 0
    下位 = 下位 + 1
  }
  返回 {有: 真, 节: (5, 一.节, 少, 多, 贪), 位: 下位, 号: 一.号}
}

函数 解序(式: String, 位: Int, 号: Int) {
  变 i = 位
  变 子们 = ()
  变 下号 = 号
  当 真 {
    若 i >= len(式) {
      返回 {有: 真, 节: (3, 子们, 0, 0, 0), 位: i, 号: 下号}
    }
    定 码 = 码在(式, i)
    若 码 == 124 || 码 == 41 {
      返回 {有: 真, 节: (3, 子们, 0, 0, 0), 位: i, 号: 下号}
    }
    定 一 = 解量(式, i, 下号)
    若 !一.有 {
      返回 一
    }
    子们 = 子们 + (一.节,)
    下号 = 一.号
    i = 一.位
  }
  返回 {有: 真, 节: (3, 子们, 0, 0, 0), 位: i, 号: 下号}
}

函数 解或(式: String, 位: Int, 号: Int) {
  定 首 = 解序(式, 位, 号)
  若 !首.有 {
    返回 首
  }
  变 节 = 首.节
  变 i = 首.位
  变 下号 = 首.号
  当 i < len(式) && 码在(式, i) == 124 {
    定 右 = 解序(式, i + 1, 下号)
    若 !右.有 {
      返回 右
    }
    节 = (4, 节, 右.节, 0, 0)
    i = 右.位
    下号 = 右.号
  }
  返回 {有: 真, 节: 节, 位: i, 号: 下号}
}

// 交回 {有, 树, 组数, 说}。
函数 式_编译(式: String) {
  定 一 = 解或(式, 0, 0)
  若 !一.有 {
    返回 {有: 假, 树: 0, 组数: 0, 说: "这一条模式读不完"}
  }
  若 一.位 < len(式) {
    返回 {有: 假, 树: 0, 组数: 0, 说: "这一条模式多出来一段：" + slice(式, 一.位, len(式))}
  }
  返回 {有: 真, 树: 一.节, 组数: 一.号, 说: ""}
}

// ---- 匹配 ----
//
// 匹 交回元组，每个元素是 (止位, 组们) —— 组们 是「这一条分支走到这里时，各组捕获到了
// 什么」。组们 是长度 组数*2 的元组，每组的起止各一格，未参与是 -1。
//
// 为什么组们要跟每个候选走：回溯时「组捕获到哪儿」正是会变的那部分状态。
// 若把它放在一处共享的槽里，退回一步时还得知道退到哪一版 —— 那比多传一个元组更难写对。

函数 初组们(组数: Int) {
  变 出 = ()
  变 i = 0
  当 i < 组数 * 2 {
    出 = 出 + (0 - 1,)
    i = i + 1
  }
  返回 出
}

// 往组们 里写一组的起止，交回新的一份（元组不可变，改就是重建）。
函数 设组(组们: Int, 号: Int, 起: Int, 止: Int) {
  变 出 = ()
  变 i = 0
  当 i < len(组们) {
    若 i == 号 * 2 {
      出 = 出 + (起,)
    } 否则 {
      若 i == 号 * 2 + 1 {
        出 = 出 + (止,)
      } 否则 {
        出 = 出 + (组们[i],)
      }
    }
    i = i + 1
   }
  返回 出
}

函数 类中(项们: Int, 码: Int) -> Bool {
  变 i = 0
  当 i < len(项们) {
    若 码 >= 项们[i][0] && 码 <= 项们[i][1] {
      返回 真
    }
    i = i + 1
  }
  返回 假
}

// 交回 ((止位, 组们), ...)
函数 匹(节: Int, 文: String, 位: Int, 组们: Int) {
  定 种 = 节[0]
  若 种 == 0 {
    若 位 < len(文) && 码在(文, 位) == 节[1] {
      返回 ((位 + 1, 组们),)
    }
    返回 ()
  }
  若 种 == 1 {
    若 位 < len(文) {
      返回 ((位 + 1, 组们),)
    }
    返回 ()
  }
  若 种 == 2 {
    若 位 < len(文) {
      定 中 = 类中(节[1], 码在(文, 位))
      若 (中 && 节[2] == 假) || (中 == 假 && 节[2] != 假) {
        返回 ((位 + 1, 组们),)
      }
    }
    返回 ()
  }
  若 种 == 7 {
    若 节[1] == 0 {
      若 位 == 0 {
        返回 ((位, 组们),)
      }
      返回 ()
    }
    若 位 == len(文) {
      返回 ((位, 组们),)
    }
    返回 ()
  }
  若 种 == 6 {
    定 内 = 匹(节[1], 文, 位, 组们)
    若 节[2] < 0 {
      返回 内
    }
    变 出 = ()
    变 i = 0
    当 i < len(内) {
      出 = 出 + ((内[i][0], 设组(内[i][1], 节[2], 位, 内[i][0])),)
      i = i + 1
    }
    返回 出
  }
  若 种 == 4 {
    返回 匹(节[1], 文, 位, 组们) + 匹(节[2], 文, 位, 组们)
  }
  若 种 == 3 {
    返回 序从(节[1], 文, ((位, 组们),), 0)
  }
  若 种 == 8 {
    // 前瞻：子模式在当前位置能匹配就算成功，位置一格都不动。
    定 内 = 匹(节[1], 文, 位, 组们)
    变 成 = len(内) > 0
    若 节[2] == 0 {
      成 = 成 == 假
    }
    若 成 {
      返回 ((位, 组们),)
    }
    返回 ()
  }
  若 种 == 9 {
    // 后顾：JS 的后顾是「往左看」，而这一份的匹配是「从某位往后」——
    // 于是枚举起点 j（0 到位），看子模式能不能正好止于 位。
    // 可变长度的后顾靠这一步就成立了，不必写一个逆向匹配器。
    变 存 = 假
    变 j = 位
    当 j >= 0 {
      定 内 = 匹(节[1], 文, j, 组们)
      变 k = 0
      当 k < len(内) {
        若 内[k][0] == 位 {
          存 = 真
        }
        k = k + 1
      }
      j = j - 1
    }
    若 (存 && 节[2] != 0) || (存 == 假 && 节[2] == 0) {
      返回 ((位, 组们),)
    }
    返回 ()
  }
  若 种 == 5 {
    返回 复从(节[1], 文, 位, 组们, 节[2], 节[3], 节[4], 0)
  }
  返回 ()
}

函数 序从(子们: Int, 文: String, 起们: Int, k: Int) {
  若 k >= len(子们) {
    返回 起们
  }
  变 出 = ()
  变 i = 0
  当 i < len(起们) {
    定 下 = 匹(子们[k], 文, 起们[i][0], 起们[i][1])
    出 = 出 + 下
    i = i + 1
  }
  若 len(出) == 0 {
    返回 ()
  }
  返回 序从(子们, 文, 出, k + 1)
}

// 重复。贪：先往深里吞再退；懒：先退再往深里吞 —— 两条只是顺序不同。
//
// 那个「下一个位置必须大于当前位置」的检查：子节点若能匹配空串（比如 (a*) 里的 a*），
// 无限递归会让这一层永远走不完。代价是「能空匹配的重复最多吞一次」，
// 而 JS 在那种模式上给出的也是同样的位置 —— 所以它是个取舍，不是漏洞。
函数 复从(子: Int, 文: String, 位: Int, 组们: Int, 少: Int, 多: Int, 贪: Int, 已: Int) {
  变 出 = ()
  若 贪 != 0 {
    若 已 < 多 {
      定 下 = 匹(子, 文, 位, 组们)
      变 i = 0
      当 i < len(下) {
        若 下[i][0] > 位 {
          出 = 出 + 复从(子, 文, 下[i][0], 下[i][1], 少, 多, 贪, 已 + 1)
        }
        i = i + 1
      }
    }
    若 已 >= 少 {
      出 = 出 + ((位, 组们),)
    }
    返回 出
  }
  若 已 >= 少 {
    出 = 出 + ((位, 组们),)
  }
  若 已 < 多 {
    定 下 = 匹(子, 文, 位, 组们)
    变 i = 0
    当 i < len(下) {
      若 下[i][0] > 位 {
        出 = 出 + 复从(子, 文, 下[i][0], 下[i][1], 少, 多, 贪, 已 + 1)
      }
      i = i + 1
    }
  }
  返回 出
}

// 从 起 往后找第一个匹配。交回 {有, 起, 止, 组们}。
函数 式_找(树: Int, 文: String, 起: Int, 组数: Int) {
  定 初 = 初组们(组数)
  变 i = 起
  当 i <= len(文) {
    定 止们 = 匹(树, 文, i, 初)
    若 len(止们) > 0 {
      返回 {有: 真, 起: i, 止: 止们[0][0], 组们: 止们[0][1]}
    }
    i = i + 1
  }
  返回 {有: 假, 起: 0, 止: 0, 组们: 初}
}

函数 式_全找(树: Int, 文: String, 组数: Int) {
  变 出 = ()
  变 i = 0
  当 i <= len(文) {
    定 一 = 式_找(树, 文, i, 组数)
    若 !一.有 {
      返回 出
    }
    出 = 出 + ((一.起, 一.止),)
    若 一.止 > 一.起 {
      i = 一.止
    } 否则 {
      i = 一.起 + 1
    }
  }
  返回 出
}

// 一次便当：编译 + 找。匹配失败或模式读不完都交回 有: 假。
函数 式_有(式: String, 文: String) -> Bool {
  定 编 = 式_编译(式)
  若 !编.有 {
    返回 假
  }
  返回 式_找(编.树, 文, 0, 编.组数).有
}
