// 正则库：模式串 → 一棵小树 → 在文本里找。
//
// 支持的语法（就这些，别的不认，认不出就交回 有: 假）：
//
//   字面量        普通字符
//   .             任意一个字符（换行也算 —— 与 JS 的 s 旗标同一个意思）
//   [abc] [a-z]   字符类，^ 打头是否定
//   *  +  ?       量词，贪婪
//   (...)         分组（只分组，不捕获）
//   |             选择
//   ^  $          锚点，分别对文本头与文本尾
//   \d \w \s      数字 / 单词字符 / 空白
//   \. \\ 等      转义一个字面量字符
//
// 不支持：懒惰量词、{n,m}、前后瞻、反向引用、命名组、旗标。这也是判据的边界 ——
// 与 JS 的 RegExp 对答案时只用上面这些，别的形状两边本来就不该一致。
//
// 为什么用回溯而不是 NFA：JS 的 RegExp 是回溯的，而这一份要与它逐位对答案。
// 一个 Thompson 的线性引擎在这门语言里更优雅，但它给出的匹配位置与回溯引擎不同 ——
// 那就不再是「同一个意思」了。
//
// 节点用一个四元组表示，四样都写满，缺的填 0 或空元组：
//
//   下标 0  种：0 字, 1 任意, 2 类, 3 序, 4 或, 5 复, 6 组, 7 锚
//   下标 1  主：字的码点 / 类的项 / 序的子们 / 或的左 / 复的子 / 组的子 / 锚的型
//   下标 2  次：或的右 / 复的少 / 类的反
//   下标 3  三：复的多
//
// 为什么不各用一个记录：记录的字段是固定的，不同种用不同字段就会读到不存在的字段，
// 而那报的是 HMYR-內-016。四元组让每个节点同形，代价是可读性 —— 所以下面每个解元
// 都写清它填的是哪三样。

函数 式_字(码: Int) -> Int { 返回 (0, 码, 0, 0) }
函数 式_任意() -> Int { 返回 (1, 0, 0, 0) }
函数 式_锚(型: Int) -> Int { 返回 (7, 型, 0, 0) }

// ---- 解析 ----

// 取一个字符；越界交回空串。
函数 取字(式: String, 位: Int) -> String {
  若 位 >= len(式) {
    返回 ""
  }
  返回 slice(式, 位, 位 + 1)
}

// 一个字符 → 码点。-1 表示越界。
函数 码在(式: String, 位: Int) -> Int {
  若 位 >= len(式) {
    返回 0 - 1
  }
  返回 ord(slice(式, 位, 位 + 1))
}

// 字符类里的一个单元：一个字面字符，或 反斜杠 d/w/s，或反斜杠转义。
// 交回 {项们, 位}，项们 是 ((起, 止), ...) 的元组。
函数 解类项(式: String, 位: Int) {
  定 始码 = 码在(式, 位)
  若 始码 == 92 {
    定 下码 = 码在(式, 位 + 1)
    若 下码 == 100 { 返回 {项们: ((48, 57),), 位: 位 + 2} }
    若 下码 == 119 { 返回 {项们: ((48, 57), (65, 90), (95, 95), (97, 122)), 位: 位 + 2} }
    若 下码 == 115 { 返回 {项们: ((9, 13), (32, 32)), 位: 位 + 2} }
    返回 {项们: ((下码, 下码),), 位: 位 + 2}
  }
  // 范围：[a-z]
  若 码在(式, 位 + 1) == 45 && 位 + 2 < len(式) && 码在(式, 位 + 2) != 93 {
    返回 {项们: ((始码, 码在(式, 位 + 2)),), 位: 位 + 3}
  }
  返回 {项们: ((始码, 始码),), 位: 位 + 1}
}

// [ ... ]，位 指向 '[' 之后。
函数 解类(式: String, 位: Int) {
  变 i = 位
  变 反 = 假
  若 码在(式, i) == 94 {
    反 = 真
    i = i + 1
  }
  变 项们 = ()
  变 收尾 = 假
  变 终 = i
  当 i < len(式) {
    若 码在(式, i) == 93 && !收尾 {
      终 = i
      收尾 = 真
      i = len(式) + 1
    } 否则 {
      定 一 = 解类项(式, i)
      项们 = 项们 + 一.项们
      i = 一.位
    }
  }
  若 !收尾 {
    返回 {有: 假, 节: 0, 位: 位}
  }
  返回 {有: 真, 节: (2, 项们, 反, 0), 位: 终 + 1}
}

// 一个单元：字面、.、类、组、(^ $)
函数 解元(式: String, 位: Int) {
  定 码 = 码在(式, 位)
  若 码 == 0 - 1 {
    返回 {有: 假, 节: 0, 位: 位}
  }
  若 码 == 46 {
    返回 {有: 真, 节: 式_任意(), 位: 位 + 1}
  }
  若 码 == 40 {
    定 内 = 解或(式, 位 + 1)
    若 !内.有 {
      返回 {有: 假, 节: 0, 位: 位}
    }
    若 码在(式, 内.位) != 41 {
      返回 {有: 假, 节: 0, 位: 位}
    }
    返回 {有: 真, 节: (6, 内.节, 0, 0), 位: 内.位 + 1}
  }
  若 码 == 91 {
    返回 解类(式, 位 + 1)
  }
  若 码 == 94 {
    返回 {有: 真, 节: 式_锚(0), 位: 位 + 1}
  }
  若 码 == 36 {
    返回 {有: 真, 节: 式_锚(1), 位: 位 + 1}
  }
  若 码 == 92 {
    定 下码 = 码在(式, 位 + 1)
    若 下码 == 100 {
      返回 {有: 真, 节: (2, ((48, 57),), 假, 0), 位: 位 + 2}
    }
    若 下码 == 119 {
      返回 {有: 真, 节: (2, ((48, 57), (65, 90), (95, 95), (97, 122)), 假, 0), 位: 位 + 2}
    }
    若 下码 == 115 {
      返回 {有: 真, 节: (2, ((9, 13), (32, 32)), 假, 0), 位: 位 + 2}
    }
    若 下码 == 0 - 1 {
      返回 {有: 假, 节: 0, 位: 位}
    }
    返回 {有: 真, 节: 式_字(下码), 位: 位 + 2}
  }
  返回 {有: 真, 节: 式_字(码), 位: 位 + 1}
}

// 单元加可选的量词。
函数 解量(式: String, 位: Int) {
  定 一 = 解元(式, 位)
  若 !一.有 {
    返回 一
  }
  定 下码 = 码在(式, 一.位)
  若 下码 == 42 {
    返回 {有: 真, 节: (5, 一.节, 0, 1000000), 位: 一.位 + 1}
  }
  若 下码 == 43 {
    返回 {有: 真, 节: (5, 一.节, 1, 1000000), 位: 一.位 + 1}
  }
  若 下码 == 63 {
    返回 {有: 真, 节: (5, 一.节, 0, 1), 位: 一.位 + 1}
  }
  返回 一
}

// 一串单元 → 序节点（只有一个子时不套序壳）。
函数 解序(式: String, 位: Int) {
  变 i = 位
  变 子们 = ()
  当 真 {
    若 i >= len(式) {
      返回 {有: 真, 节: (3, 子们, 0, 0), 位: i}
    }
    定 码 = 码在(式, i)
    若 码 == 124 || 码 == 41 {
      返回 {有: 真, 节: (3, 子们, 0, 0), 位: i}
    }
    定 一 = 解量(式, i)
    若 !一.有 {
      返回 一
    }
    子们 = 子们 + (一.节,)
    i = 一.位
  }
  返回 {有: 真, 节: (3, 子们, 0, 0), 位: i}
}

// 序们用 | 连起来，左结合。
函数 解或(式: String, 位: Int) {
  定 首 = 解序(式, 位)
  若 !首.有 {
    返回 首
  }
  变 节 = 首.节
  变 i = 首.位
  当 i < len(式) && 码在(式, i) == 124 {
    定 右 = 解序(式, i + 1)
    若 !右.有 {
      返回 右
    }
    节 = (4, 节, 右.节, 0)
    i = 右.位
  }
  返回 {有: 真, 节: 节, 位: i}
}

函数 式_编译(式: String) {
  定 一 = 解或(式, 0)
  若 !一.有 {
    返回 {有: 假, 树: 0, 说: "这一条模式读不完"}
  }
  若 一.位 < len(式) {
    返回 {有: 假, 树: 0, 说: "这一条模式多出来一段：" + slice(式, 一.位, len(式))}
  }
  返回 {有: 真, 树: 一.节, 说: ""}
}

// ---- 匹配 ----
//
// 每个 匹 交回「可能停在哪几个位置」的元组，按贪婪优先排序。序列与重复都靠这张表
// 展开 —— 这就是回溯：把「还可以从哪儿继续」写成数据，而不是写成控制流。
//
// 为什么不用「第一个答案 + 失败即返回」那种写法：那条路要在每个节点里手写回退，
// 而回退的状态（重复吞了几个、组从哪儿起）会散落在每一层。列表版本把状态变成返回值，
// 代价是可能算多几条分支。

函数 类中(项们: Int, 码: Int) -> Bool {
  变 i = 0
  当 i < len(项们) {
    若 码 >= 项们[i][0] && 码 <= 项们[i][1] {
      返回 真
    }
    i = i + 1
  }
  返回 假
}

函数 匹(节: Int, 文: String, 位: Int) -> (Int,) {
  定 种 = 节[0]
  若 种 == 0 {
    若 位 < len(文) && 码在(文, 位) == 节[1] {
      返回 (位 + 1,)
    }
    返回 ()
  }
  若 种 == 1 {
    若 位 < len(文) {
      返回 (位 + 1,)
    }
    返回 ()
  }
  若 种 == 2 {
    若 位 < len(文) {
      定 中 = 类中(节[1], 码在(文, 位))
      若 (中 && 节[2] == 假) || (中 == 假 && 节[2] != 假) {
        返回 (位 + 1,)
      }
    }
    返回 ()
  }
  若 种 == 7 {
    若 节[1] == 0 {
      若 位 == 0 {
        返回 (位,)
      }
      返回 ()
    }
    若 位 == len(文) {
      返回 (位,)
    }
    返回 ()
  }
  若 种 == 6 {
    返回 匹(节[1], 文, 位)
  }
  若 种 == 4 {
    返回 匹(节[1], 文, 位) + 匹(节[2], 文, 位)
  }
  若 种 == 3 {
    返回 序从(节[1], 文, (位,), 0)
  }
  若 种 == 5 {
    返回 复从(节[1], 文, 位, 节[2], 节[3], 0)
  }
  返回 ()
}

// 序列：起点们 是当前各分支的起点，逐个节点往下展。
// 空序列交回起点本身（匹配零个字符仍然成功）。
函数 序从(子们: Int, 文: String, 起们: Int, k: Int) -> (Int,) {
  若 k >= len(子们) {
    返回 起们
  }
  变 出 = ()
  变 i = 0
  当 i < len(起们) {
    出 = 出 + 匹(子们[k], 文, 起们[i])
    i = i + 1
  }
  若 len(出) == 0 {
    返回 ()
  }
  返回 序从(子们, 文, 出, k + 1)
}

// 重复：先往深里吞（贪婪），再往回退。已 是已经吞了几次。
//
// 那个「下[i] 必须大于 位」是一条保护：子节点若匹配空串（比如 (a*) 里的 a*），
// 无限递归会让这一层永远走不完。代价是「能空匹配的重复最多吞一次」，
// 而 JS 在那种模式上给出的也是同样的匹配位置 —— 这条写在这里，因为它是个取舍。
函数 复从(子: Int, 文: String, 位: Int, 少: Int, 多: Int, 已: Int) -> (Int,) {
  变 出 = ()
  若 已 < 多 {
    定 下 = 匹(子, 文, 位)
    变 i = 0
    当 i < len(下) {
      若 下[i] > 位 {
        出 = 出 + 复从(子, 文, 下[i], 少, 多, 已 + 1)
      }
      i = i + 1
    }
  }
  若 已 >= 少 {
    出 = 出 + (位,)
  }
  返回 出
}

// 从 起 往后找第一个匹配。交回 {有, 起, 止}。
//
// 位置先到先得：这是「最左」那一条，而同一个起点上的多个答案里取第一个 ——
// 那是贪婪的结果，因为 匹 已经把更长的排在前面。
函数 式_找(树: Int, 文: String, 起: Int) {
  变 i = 起
  当 i <= len(文) {
    定 止们 = 匹(树, 文, i)
    若 len(止们) > 0 {
      返回 {有: 真, 起: i, 止: 止们[0]}
    }
    i = i + 1
  }
  返回 {有: 假, 起: 0, 止: 0}
}

// 全部匹配：从上一个的止位继续，空匹配时前进一格（否则会停在同一格不动）。
函数 式_全找(树: Int, 文: String) {
  变 出 = ()
  变 i = 0
  当 i <= len(文) {
    定 一 = 式_找(树, 文, i)
    若 !一.有 {
      返回 出
    }
    出 = 出 + ((一.起, 一.止),)
    若 一.止 > 一.起 {
      i = 一.止
    } 否则 {
      i = 一.起 + 1
    }
  }
  返回 出
}

// 一次便当：编译 + 找。匹配失败或模式读不完都交回 有: 假。
函数 式_有(式: String, 文: String) -> Bool {
  定 编 = 式_编译(式)
  若 !编.有 {
    返回 假
  }
  返回 式_找(编.树, 文, 0).有
}
