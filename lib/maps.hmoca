// 集合库：map 与 set，底是内置索引（index_new / index_set / index_get / index_has /
// index_len / index_keys）。
//
// 为什么底是索引而不是记录：lib/tables.hmoca 拿记录当字典，而记录的字段名必须是
// 标识符形状（字母、数字、下划线，不以数字开头）。码点 "0041"、路径
// "data/ucd/Blocks.txt" 都放不进去 —— 索引的键是任意字符串，两种都行。
//
// 为什么是薄封装：索引本身够用，缺的只有两件 —— 「取不到时怎么办」与「删一个键」。
// 前者用 {有, 值} 表达（不抛，库层不该逼人先问）；后者靠重建，因为索引没有删除。
//
// 名字全带前缀（表_ 与 集_）：这一门语言的模块合并没有命名空间，重名不报错，
// 只会让某个调用点到另一个函数。lib/tables.hmoca 已经有 删 与 有几件，
// 而 2026-11-04 早些时候 self/wide.hmoca 的 乘二 与 self/f64.hmoca 的 乘二
// 就撞过一次，代价是 vmrun 二十二项里红十八项。

// ---- map ----

// 一张空表。
公开 函数 表新() {
  返回 index_new()
}

// 放一个键值。键已经在就覆盖，键的位置保持第一次放进去的样子。
公开 函数 表放(表: Int, 键: String, 值: Int) {
  返回 index_set(表, 键, 值)
}

公开 函数 表有(表: Int, 键: String) -> Bool {
  返回 index_has(表, 键)
}

// 取：交回 {有, 值}。取不到时值是空元组 —— 调用方要么看 有，要么接受空。
公开 函数 表取(表: Int, 键: String) {
  若 index_has(表, 键) {
    返回 {有: 真, 值: index_get(表, 键)}
  }
  返回 {有: 假, 值: ()}
}

公开 函数 表数(表: Int) -> Int {
  返回 index_len(表)
}

// 键的元组，按第一次放进去的顺序。
公开 函数 表键(表: Int) {
  返回 index_keys(表)
}

// 拷一份：索引是引用（index_set 就地改），要一份独立的时候只能重建。
// 这一条与 design/INDEX.txt 的旧说法冲突，2026-11-04 实测之后改了那份文档 ——
// 两台机器上 index_set 都是就地改，交回同一个只是为了 `表 = index_set(表, k, v)`
// 这种链式写法成立，不是说它交回了一个新值。集并 一开始写成 变 出 = a，
// 于是「并」把左边的集也改掉了，探针里交集的键多出一个 —— 就是这么发现的。
公开 函数 表拷(表: Int) {
  变 新 = index_new()
  定 键们 = index_keys(表)
  变 i = 0
  当 i < len(键们) {
    新 = index_set(新, 键们[i], index_get(表, 键们[i]))
    i = i + 1
  }
  返回 新
}

// 删一个键：索引没有删除，于是重建一份跳过它的。
// 顺序保持 —— index_keys 给的就是「第一次放进去的顺序」，重建之后也保持。
// 键本来就不在时交回一张内容相同的新表：删不存在的东西不是失败。
公开 函数 表删(表: Int, 键: String) {
  变 新 = index_new()
  定 键们 = index_keys(表)
  变 i = 0
  当 i < len(键们) {
    若 键们[i] != 键 {
      新 = index_set(新, 键们[i], index_get(表, 键们[i]))
    }
    i = i + 1
  }
  返回 新
}

// ---- set ----
//
// set 底上就是「键 → 真」的 map。它不需要别的表示，因为索引的键唯一。

公开 函数 集新() {
  返回 表新()
}

公开 函数 集加(集: Int, 键: String) {
  返回 表放(集, 键, 真)
}

公开 函数 集有(集: Int, 键: String) -> Bool {
  返回 表有(集, 键)
}

公开 函数 集去(集: Int, 键: String) {
  返回 表删(集, 键)
}

公开 函数 集数(集: Int) -> Int {
  返回 表数(集)
}

公开 函数 集元(集: Int) {
  返回 表键(集)
}

// 并：a 的键全在，再补 b 里多出来的。
// 顺序是「a 的顺序在前，b 里新的按 b 的顺序接在后面」—— 这一条写在这里，
// 因为集合没有顺序，而键的元组有，两者必须说清哪一个说了算。
//
// 第一版写成 变 出 = a：索引是引用，于是 index_set(出, ...) 就地改了 a，
// 接着用同一个 a 算交集，交集的键就多出一个。现在先用 表拷。
公开 函数 集并(a: Int, b: Int) {
  变 出 = 表拷(a)
  定 键们 = index_keys(b)
  变 i = 0
  当 i < len(键们) {
    若 index_has(出, 键们[i]) == 假 {
      出 = index_set(出, 键们[i], 真)
    }
    i = i + 1
  }
  返回 出
}

// 交：留下两边都有的，顺序按 a。
公开 函数 集交(a: Int, b: Int) {
  变 出 = index_new()
  定 键们 = index_keys(a)
  变 i = 0
  当 i < len(键们) {
    若 index_has(b, 键们[i]) {
      出 = index_set(出, 键们[i], 真)
    }
    i = i + 1
  }
  返回 出
}

// 差：a 有而 b 没有的，顺序按 a。
公开 函数 集差(a: Int, b: Int) {
  变 出 = index_new()
  定 键们 = index_keys(a)
  变 i = 0
  当 i < len(键们) {
    若 index_has(b, 键们[i]) == 假 {
      出 = index_set(出, 键们[i], 真)
    }
    i = i + 1
  }
  返回 出
}
