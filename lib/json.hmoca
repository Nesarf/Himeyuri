// JSON：解析与生成。
//
// 为什么每一个值都带标记 —— 一条不得不接受的限制：
// 这门语言没有类型反射。一个数、一个字符串、一个空元组，在库这一层分辨不出来
// （str 能把它们都写成字，但写出来之后回不去）。所以 JSON 的值一律用一条记录表示：
//
//   {数: 1.5}  {串: "ab"}  {真: 1}  {假: 1}  {空: 1}
//   {对象: ((键, 值), …)}  {数组: (值, …)}
//
// 真与假带的是占位值（语言里 1 就是 1），只是为了让「有这一类」这件事在记录上看得见。
// 对象用对表而不是记录：JSON 的键可以是任意字符串，而记录的字段名必须是标识符能写的形状。
// 需要记录时自己用 record_new 转，那是调用方的事，这一份不做。
//
// 三条老规矩照旧：没有复合条件（嵌套 若）、没有 break（标志收尾）、没有整数除法。

fn 错(话: String) {
  返回 {ok: false, 错: 话}
}

// 四类空白：空格、制表、换行、回车。
fn 是空白(c: String) -> Bool {
  若 c == " " { 返回 true }
  若 c == "\t" { 返回 true }
  若 c == "\n" { 返回 true }
  若 c == "\r" { 返回 true }
  返回 false
}

fn 跳空(文: String, i: Int) -> Int {
  若 i >= len(文) { 返回 i }
  若 是空白(文[i]) { 返回 跳空(文, i + 1) }
  返回 i
}

fn 是数字(c: String) -> Bool {
  定 o = ord(c)
  若 o < 48 { 返回 false }
  若 o > 57 { 返回 false }
  返回 true
}

fn 数位从(文: String, i: Int) -> Int {
  若 i >= len(文) { 返回 i }
  若 是数字(文[i]) { 返回 数位从(文, i + 1) }
  返回 i
}

// 十六进制一位的值，认不出就 -1。
fn 十六位(c: String) -> Int {
  定 o = ord(c)
  若 o >= 48 {
    若 o <= 57 { 返回 o - 48 }
  }
  若 o >= 97 {
    若 o <= 102 { 返回 o - 87 }
  }
  若 o >= 65 {
    若 o <= 70 { 返回 o - 55 }
  }
  返回 0 - 1
}

fn 十的幂(n: Int) -> Int {
  若 n < 0 { 返回 1 / 十的幂(0 - n) }
  var 出 = 1
  var i = 0
  当 i < n {
    出 = 出 * 10
    i = i + 1
  }
  返回 出
}

fn 小数点处(s: String) -> Int {
  var i = 0
  当 i < len(s) {
    若 s[i] == "." { 返回 i }
    i = i + 1
  }
  返回 0 - 1
}

fn 指数处(s: String) -> Int {
  var i = 0
  当 i < len(s) {
    若 s[i] == "e" { 返回 i }
    若 s[i] == "E" { 返回 i }
    i = i + 1
  }
  返回 0 - 1
}

// 一段小数文字 → 数。
//
// 负数这里有一处必须分开：-2.5 的整数部分是 -2，而它要「减去」那半个，
// 写成加法就成了 -1.5 —— 第一版正是这样，断言把这件事钉了出来。
fn 小数值(s: String) -> Int {
  定 位 = 小数点处(s)
  若 位 < 0 { 返回 to_int(s) }
  定 整 = slice(s, 0, 位)
  定 小 = slice(s, 位 + 1, len(s))
  定 值 = to_int(小) / 十的幂(len(小))
  若 s[0] == "-" { 返回 to_int(整) - 值 }
  返回 to_int(整) + 值
}

// 一段数字文字 → 数。负数、小数、指数三种都要处理。
fn 值从文(s: String) -> Int {
  定 指 = 指数处(s)
  若 指 >= 0 {
    定 尾 = slice(s, 0, 指)
    定 次 = to_int(slice(s, 指 + 1, len(s)))
    返回 小数值(尾) * 十的幂(次)
  }
  返回 小数值(s)
}

// 认一个词（true / false / null）。对不上就是错。
fn 认词(文: String, i: Int, 词: String) {
  定 末 = i + len(词)
  若 末 > len(文) { 返回 错("这里该是 " + 词) }
  若 slice(文, i, 末) != 词 { 返回 错("这里该是 " + 词) }
  返回 {ok: true, next: 末}
}

// 四个十六进制位 → 一个码点。认不出就 -1。
fn 四位的码点(文: String, i: Int) -> Int {
  若 i + 4 > len(文) { 返回 0 - 1 }
  定 a = 十六位(文[i])
  定 b = 十六位(文[i + 1])
  定 c = 十六位(文[i + 2])
  定 d = 十六位(文[i + 3])
  若 a < 0 { 返回 0 - 1 }
  若 b < 0 { 返回 0 - 1 }
  若 c < 0 { 返回 0 - 1 }
  若 d < 0 { 返回 0 - 1 }
  返回 a * 4096 + b * 256 + c * 16 + d
}

// 串：i 已经在开头的引号之后。acc 是已经收下的部分。
fn 解析串(文: String, i: Int, acc: String) {
  若 i >= len(文) { 返回 错("字符串没有收尾的引号") }
  定 c = 文[i]
  若 c == "\"" { 返回 {ok: true, 值: {串: acc}, next: i + 1} }
  若 c == "\\" { 返回 转义后(文, i + 1, acc) }
  返回 解析串(文, i + 1, acc + c)
}

fn 转义后(文: String, i: Int, acc: String) -> Int {
  若 i >= len(文) { 返回 错("转义没有收尾") }
  定 c = 文[i]
  若 c == "\"" { 返回 解析串(文, i + 1, acc + "\"") }
  若 c == "\\" { 返回 解析串(文, i + 1, acc + "\\") }
  若 c == "/" { 返回 解析串(文, i + 1, acc + "/") }
  若 c == "n" { 返回 解析串(文, i + 1, acc + "\n") }
  若 c == "t" { 返回 解析串(文, i + 1, acc + "\t") }
  若 c == "r" { 返回 解析串(文, i + 1, acc + "\r") }
  若 c == "b" { 返回 解析串(文, i + 1, acc + chr(8)) }
  若 c == "f" { 返回 解析串(文, i + 1, acc + chr(12)) }
  若 c == "u" {
    定 码 = 四位的码点(文, i + 1)
    若 码 < 0 { 返回 错("\\u 后面要四个十六进制位") }
    返回 解析串(文, i + 5, acc + chr(码))
  }
  返回 错("不认这个转义：" + c)
}

// 数：符号、整数位、可选的小数、可选的指数。
fn 解析数(文: String, i: Int) {
  定 起 = i
  var j = i
  若 j < len(文) {
    若 文[j] == "-" { j = j + 1 }
  }
  定 整末 = 数位从(文, j)
  若 整末 == j { 返回 错("这里该是一个数") }
  j = 整末
  若 j < len(文) {
    若 文[j] == "." {
      定 小末 = 数位从(文, j + 1)
      若 小末 == j + 1 { 返回 错("小数点后面没有数字") }
      j = 小末
    }
  }
  若 j < len(文) {
    若 文[j] == "e" {
      j = 指数后(文, j + 1)
    } 否则 {
      若 文[j] == "E" { j = 指数后(文, j + 1) }
    }
  }
  定 字 = slice(文, 起, j)
  返回 {ok: true, 值: {数: 值从文(字)}, next: j}
}

// 指数那一截：可选的符号，然后至少要一位数字。
fn 指数后(文: String, i: Int) -> Int {
  var j = i
  若 j < len(文) {
    若 文[j] == "+" { j = j + 1 }
    若 文[j] == "-" { j = j + 1 }
  }
  定 末 = 数位从(文, j)
  若 末 == j { 返回 i }
  返回 末
}

// 一个值。i 已经跳过空白。
fn 解析值(文: String, i: Int) {
  若 i >= len(文) { 返回 错("文到头了，这里该有一个值") }
  定 c = 文[i]
  若 c == "{" { 返回 解析对象(文, i + 1, ()) }
  若 c == "[" { 返回 解析数组(文, i + 1, ()) }
  若 c == "\"" { 返回 解析串(文, i + 1, "") }
  若 c == "t" {
    定 r = 认词(文, i, "true")
    若 r.ok == false { 返回 r }
    返回 {ok: true, 值: {真: 1}, next: r.next}
  }
  若 c == "f" {
    定 r = 认词(文, i, "false")
    若 r.ok == false { 返回 r }
    返回 {ok: true, 值: {假: 1}, next: r.next}
  }
  若 c == "n" {
    定 r = 认词(文, i, "null")
    若 r.ok == false { 返回 r }
    返回 {ok: true, 值: {空: 1}, next: r.next}
  }
  返回 解析数(文, i)
}

// 数组：i 已经在开头的方括号之后。
fn 解析数组(文: String, i: Int, acc: Int) {
  定 j = 跳空(文, i)
  若 j >= len(文) { 返回 错("数组没有收尾的方括号") }
  若 文[j] == "]" { 返回 {ok: true, 值: {数组: acc}, next: j + 1} }
  定 r = 解析值(文, j)
  若 r.ok == false { 返回 r }
  定 加过 = acc + (r.值,)
  定 k = 跳空(文, r.next)
  若 k >= len(文) { 返回 错("数组没有收尾的方括号") }
  若 文[k] == "," { 返回 解析数组(文, k + 1, 加过) }
  若 文[k] == "]" { 返回 {ok: true, 值: {数组: 加过}, next: k + 1} }
  返回 错("数组里少了逗号或收尾的方括号")
}

// 对象：i 已经在开头的花括号之后。
fn 解析对象(文: String, i: Int, acc: Int) {
  定 j = 跳空(文, i)
  若 j >= len(文) { 返回 错("对象没有收尾的花括号") }
  若 文[j] == "}" { 返回 {ok: true, 值: {对象: acc}, next: j + 1} }
  若 文[j] != "\"" { 返回 错("对象的键必须写成字符串") }
  定 k = 解析串(文, j + 1, "")
  若 k.ok == false { 返回 k }
  定 m = 跳空(文, k.next)
  若 m >= len(文) { 返回 错("对象里少了冒号") }
  若 文[m] != ":" { 返回 错("对象里少了冒号") }
  定 v = 解析值(文, 跳空(文, m + 1))
  若 v.ok == false { 返回 v }
  定 加过 = acc + ((k.值.串, v.值),)
  定 n = 跳空(文, v.next)
  若 n >= len(文) { 返回 错("对象没有收尾的花括号") }
  若 文[n] == "," { 返回 解析对象(文, n + 1, 加过) }
  若 文[n] == "}" { 返回 {ok: true, 值: {对象: 加过}, next: n + 1} }
  返回 错("对象里少了逗号或收尾的花括号")
}

// 入口：整份文都要读掉。尾部还剩下东西就是错 —— 那不是 JSON，是一段以 JSON 开头的文字。
pub fn 解析(文: String) {
  定 i = 跳空(文, 0)
  定 r = 解析值(文, i)
  若 r.ok == false { 返回 r }
  定 尾 = 跳空(文, r.next)
  若 尾 != len(文) { 返回 错("值的后面还有东西") }
  返回 {ok: true, 值: r.值}
}

// ---- 生成 ----

// 一个字符要不要转义。JSON 只要求转义引号、反斜杠与控制字符。
fn 要转义(c: String) -> Bool {
  定 o = ord(c)
  若 o < 32 { 返回 true }
  若 c == "\"" { 返回 true }
  若 c == "\\" { 返回 true }
  返回 false
}

fn 写串从(s: String, i: Int, acc: String) -> String {
  若 i >= len(s) { 返回 acc }
  定 c = s[i]
  若 要转义(c) {
    若 c == "\"" { 返回 写串从(s, i + 1, acc + "\\\"") }
    若 c == "\\" { 返回 写串从(s, i + 1, acc + "\\\\") }
    若 c == "\n" { 返回 写串从(s, i + 1, acc + "\\n") }
    若 c == "\t" { 返回 写串从(s, i + 1, acc + "\\t") }
    若 c == "\r" { 返回 写串从(s, i + 1, acc + "\\r") }
    返回 写串从(s, i + 1, acc + "\\u" + 四位十六进制(ord(c)))
  }
  返回 写串从(s, i + 1, acc + c)
}

fn 写串(s: String) -> String {
  返回 "\"" + 写串从(s, 0, "") + "\""
}

// 一个 0 到 65535 的数写成四位十六进制（大写）。
fn 四位十六进制(n: Int) -> String {
  定 位 = "0123456789abcdef"
  定 a = (n - n % 4096) / 4096
  定 b = (n % 4096 - n % 256) / 256
  定 c = (n % 256 - n % 16) / 16
  定 d = n % 16
  返回 slice(位, a, a + 1) + slice(位, b, b + 1) + slice(位, c, c + 1) + slice(位, d, d + 1)
}

fn 写对表(项: Int, i: Int, acc: String) -> String {
  若 i >= len(项) { 返回 acc }
  var 前 = ""
  若 i > 0 { 前 = "," }
  定 这 = 写串(项[i][0]) + ":" + 生成(项[i][1])
  返回 写对表(项, i + 1, acc + 前 + 这)
}

fn 写元组(项: Int, i: Int, acc: String) -> String {
  若 i >= len(项) { 返回 acc }
  var 前 = ""
  若 i > 0 { 前 = "," }
  返回 写元组(项, i + 1, acc + 前 + 生成(项[i]))
}

// 生成：按标记分派。没有标记的值交回空串 —— 那是「调用方给错了」，
// 而这一层不猜（猜一个形状，就是把一个错误变成一个更像真话的错）。
pub fn 生成(v: Int) -> String {
  若 field_has(v, "数") { 返回 str(v.数) }
  若 field_has(v, "串") { 返回 写串(v.串) }
  若 field_has(v, "真") { 返回 "true" }
  若 field_has(v, "假") { 返回 "false" }
  若 field_has(v, "空") { 返回 "null" }
  若 field_has(v, "对象") { 返回 "{" + 写对表(v.对象, 0, "") + "}" }
  若 field_has(v, "数组") { 返回 "[" + 写元组(v.数组, 0, "") + "]" }
  返回 ""
}
