// 有理数：分子与分母各一个大整数。
//
// 为什么立在 self/bigint.hmoca 上：design/OPEN.txt 第十二条把这件事定了规格 ——
// 「标准库给有理数（立在 self/bigint.hmoca 上）与区间数，核心不引入第三套数字」。
// 所以这一页不是新的一种数字类型，而是「两个大整数 + 一条规矩」，而那条规矩是约分。
//
// 形状：一个记录 {分, 母}，两个字段都是 bigint 的 11 字数组。
// 不变式：母恒为正；分与母互质；零写成 0/1 而不是 0/任何数。
// 这三条由 造 保证，而别处只读不写 —— 于是「两个相等的有理数形状一样」成立，
// 比 也就可以逐字比过去，不必先通分。
//
// 约分要 gcd，而 bigint 没有取模（只有 模乘，那是「乘完约简」的意思）。
// 于是这里的 gcd 用相减：gcd(a,b) 在 a>b 时是 gcd(a-b,b)，相等时就是它自己。
// 代价写在这里：两个接近的大数会退化成几百次减法。今天的有理数用不到那种规模，
// 而真要那种规模，该先给 bigint 补一个 取模，不是在这里绕。
//
// 四条老规矩照旧（见 lib/strings.hmoca 开头）：没有复合条件、没有 break、
// 没有整数除法（除号给浮点）。所以下面的循环都靠一个标志或一个递减的计数收尾。
//
// 还有一条：没有错误值可交回。分母为零时这里的约定是「交出零」，而调用方得自己知道 ——
// 与 lib/numbers.hmoca 里「负数开方交回 -1」同一个毛病，同一个待办。
引入 "../self/bigint.hmoca"

函数 大零() {
  返回 从数(0)
}

函数 大一() {
  返回 从数(1)
}

函数 正(值: Int) -> Int {
  // bigint 没有符号位：它的「负数」是模运算里的一个余数。所以这里的 正 只判断
  // 「是不是零」，别处也只用到这一件事。
  返回 比(值, 大零())
}

函数 大gcd(a: Int, b: Int) {
  变 甲 = a
  变 乙 = b
  变 卫 = 0
  // gcd(a, 0) 就是 a。这一条必须每轮都查，不能只在入口查一次：
  // 入口时 乙 可能不为零，而「换」那一步会把它变成零 —— 之后 甲 = 减(甲, 0) 不再变小，
  // 循环就停在那里了。2026-11-03 撞到：减有理(一甲, 一甲) 走 gcd(0, 9) → 换 → gcd(9, 0)，
  // 而它把整套判据卡在 35 秒的步数上限上。
  当 卫 < 100000 {
    若 正(乙) == 0 {
      返回 甲
    }
    定 关系 = 比(甲, 乙)
    若 关系 == 0 {
      返回 甲
    }
    若 关系 < 0 {
      定 换 = 甲
      甲 = 乙
      乙 = 换
    }
    甲 = 减(甲, 乙)
    卫 = 卫 + 1
  }
  // 十万次减法还没收敛：那说明这一对数字的规模超出了这一页的打算。
  // 交回 1 会让约分失效而不出错，比交回一个错的公约数安全。
  返回 大一()
}

// 造：从两个大整数造一个有理数，顺手约好、定好符号。
// 分母为零时交回零 —— 见文件头那条「没有错误值」。
公开 函数 造(分: Int, 母: Int) {
  若 正(母) == 0 {
    返回 {分: 大零(), 母: 大一()}
  }
  定 约 = 大gcd(分, 母)
  定 新分 = 除尽(分, 约)
  定 新母 = 除尽(母, 约)
  若 新母[0] > 8388608 {
    // 分母落在模运算的「负」半边：把两个都取反，于是母恒为正。
    返回 {分: 减(大零(), 新分), 母: 减(大零(), 新母)}
  }
  返回 {分: 新分, 母: 新母}
}

// 从两个普通数造一个有理数。2 的 53 次方以内 —— 那是 从数 的边界。
公开 函数 从两数(a: Int, b: Int) {
  返回 造(从数(a), 从数(b))
}

// 除尽：a 一定能被 b 整除时，交回整数那个商。
// 用不了除号（它给双精度），所以走「减到零，数减了几次」—— 只在约分这一步用，
// 而约分之后的分母比原数小得多，所以它比看上去便宜。
函数 除尽(a: Int, b: Int) {
  变 余 = a
  变 次 = 0
  当 正(余) != 0 {
    若 比(余, b) < 0 {
      // 除不尽：交回 a 本身，让调用方看见原样，而不是悄悄给一个错商。
      返回 a
    }
    余 = 减(余, b)
    次 = 次 + 1
    若 次 > 100000 {
      返回 a
    }
  }
  返回 从数(次)
}

公开 函数 分子(值: Int) -> Int {
  返回 值.分
}

公开 函数 分母(值: Int) -> Int {
  返回 值.母
}

公开 函数 加有理(a: Int, b: Int) {
  定 左 = 乘(a.分, b.母)
  定 右 = 乘(b.分, a.母)
  定 上 = 加(左, 右)
  定 下 = 乘(a.母, b.母)
  返回 造(上, 下)
}

公开 函数 减有理(a: Int, b: Int) {
  定 左 = 乘(a.分, b.母)
  定 右 = 乘(b.分, a.母)
  定 上 = 减(左, 右)
  定 下 = 乘(a.母, b.母)
  返回 造(上, 下)
}

公开 函数 乘有理(a: Int, b: Int) {
  返回 造(乘(a.分, b.分), 乘(a.母, b.母))
}

公开 函数 比有理(a: Int, b: Int) -> Int {
  // 两个既约有理数，比大小可以逐边比：a/b 与 c/d 的大小关系等于 ad 与 cb 的关系，
  // 而两个分母都为正，所以乘过去不改方向。
  返回 比(乘(a.分, b.母), 乘(b.分, a.母))
}

公开 函数 等有理(a: Int, b: Int) -> Bool {
  返回 比有理(a, b) == 0
}

// 成串：给判据与调试用。写成「分/母」，零写成「0」。
// 分子分母都用 bigint 的 成数（双精度范围以内）—— 这一页只承诺到这个范围。
公开 函数 成串(值: Int) -> String {
  定 上 = 成数(值.分)
  定 下 = 成数(值.母)
  若 下 == 1 {
    返回 str(上)
  }
  返回 str(上) + "/" + str(下)
}
