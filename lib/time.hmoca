// 时间库：毫秒数 ↔ 年月日时分秒，以及 ISO 8601 的一进一出。
//
// 为什么要有它：语言里已经有 now_ms（拿当前毫秒）与 sleep_ms（等），但没有任何东西
// 把那个整数字变成人能读的日子 —— 也没有东西把一份日子变回毫秒。缺的正是中间这一层。
//
// 边界写在最前面：**只做 UTC**。时区与夏时制要一张会变的表（IANA 的 tzdata），
// 而那张表不是这一门语言该内置的常量 —— 它会过期。所以这里的一切都按 UTC 算，
// 而需要的偏移由调用方自己加：时_分解(时_现在() + 八小时) 就是东八区的钟面。
//
// 算法是 Howard Hinnant 那套「400 年一周期」的整数日历（days_from_civil /
// civil_from_days）。选它而不是查表，理由有两条：它是全整数运算（这一门语言的数是
// 双精度，浮点累积会漂）；它把闰年规则写成了算术，于是 1900 与 2000 这两个世纪边界
// 不必特判。负的毫秒（1970 之前）也在这套算术里成立，因为除法一律走 floor。
//
// 名字全带 时_ 前缀：模块合并没有命名空间，重名不报错，只把调用指到另一个函数。

// 一个 24 位字宽的名字在这里用不上，所以直接把常数写在函数里。

函数 时_闰(年: Int) -> Bool {
  若 年 % 4 != 0 {
    返回 假
  }
  若 年 % 100 != 0 {
    返回 真
  }
  返回 年 % 400 == 0
}

函数 时_月长(年: Int, 月: Int) -> Int {
  若 月 == 2 {
    若 时_闰(年) {
      返回 29
    }
    返回 28
  }
  若 月 == 4 || 月 == 6 || 月 == 9 || 月 == 11 {
    返回 30
  }
  返回 31
}

// 日数 → {年, 月, 日}。日数以 1970-01-01 为零点（那一天是 0）。
//
// 三步：先定 400 年周期，再定周期内第几年，最后在年内找月份。
// 那个 146097 是一个 400 年周期的天数：400 乘 365 加 97 个闰日。
函数 时_日数到日(日数: Int) {
  定 z = 日数 + 719468
  定 期 = floor(z / 146097)
  定 余 = z - 期 * 146097
  定 年余 = floor((余 - floor(余 / 1460) + floor(余 / 36524) - floor(余 / 146096)) / 365)
  变 年 = 年余 + 期 * 400
  定 年日 = 余 - (365 * 年余 + floor(年余 / 4) - floor(年余 / 100))
  定 月段 = floor((5 * 年日 + 2) / 153)
  定 日 = 年日 - floor((153 * 月段 + 2) / 5) + 1
  变 月 = 月段 + 3
  若 月段 >= 10 {
    月 = 月段 - 9
  }
  若 月 <= 2 {
    年 = 年 + 1
  }
  返回 {年: 年, 月: 月, 日: 日}
}

// {年, 月, 日} → 日数。与时_日数到日互为逆运算，判据里往返两边都验。
函数 时_日到日数(年: Int, 月: Int, 日: Int) -> Int {
  变 y = 年
  若 月 <= 2 {
    y = y - 1
  }
  定 期 = floor(y / 400)
  定 年余 = y - 期 * 400
  变 月段 = 月 - 3
  若 月 <= 2 {
    月段 = 月 + 9
  }
  定 年日 = floor((153 * 月段 + 2) / 5) + 日 - 1
  定 周期日 = 年余 * 365 + floor(年余 / 4) - floor(年余 / 100) + 年日
  返回 期 * 146097 + 周期日 - 719468
}

// 毫秒 → {年, 月, 日, 时, 分, 秒, 毫, 星期}。星期以周日为 0..6。
//
// 负毫秒要小心：floor 与「取余」在负数上不是同一个东西。这里先算 日数 = floor(毫秒/86400000)，
// 再用 毫秒 - 日数*86400000 拿当天位移 —— 那个差一定落在 [0, 86400000)，
// 于是后面的除法不必再管符号。
函数 时_分解(毫秒: Int) {
  定 日数 = floor(毫秒 / 86400000)
  定 日内 = 毫秒 - 日数 * 86400000
  定 日 = 时_日数到日(日数)
  定 时 = floor(日内 / 3600000)
  定 分 = floor((日内 - 时 * 3600000) / 60000)
  定 秒 = floor((日内 - 时 * 3600000 - 分 * 60000) / 1000)
  定 毫 = 日内 - 时 * 3600000 - 分 * 60000 - 秒 * 1000
  // 1970-01-01 是星期四。加 4 再取模，把「那天的星期几」变成可减的偏移。
  定 星期 = (日数 + 4) - floor((日数 + 4) / 7) * 7
  返回 {年: 日.年, 月: 日.月, 日: 日.日, 时: 时, 分: 分, 秒: 秒, 毫: 毫, 星期: 星期}
}

// 反过来：八个整数 → 毫秒。
函数 时_合成(年: Int, 月: Int, 日: Int, 时: Int, 分: Int, 秒: Int, 毫: Int) -> Int {
  定 日数 = 时_日到日数(年, 月, 日)
  返回 日数 * 86400000 + 时 * 3600000 + 分 * 60000 + 秒 * 1000 + 毫
}

函数 时_补零(数: Int, 位: Int) -> String {
  变 出 = str(数)
  当 len(出) < 位 {
    出 = "0" + 出
  }
  返回 出
}

// 毫秒 → ISO 8601 的一串（总是 UTC，末尾一个 Z）。毫秒那三位一定写出来。
//
// 只做这一种形状：模板化的格式化是另一件事（它要一套占位符语法），而这一种
// 已经够让两个东西对答案 —— 判据拿它跟 JS 的 toISOString 逐字比。
函数 时_成文(毫秒: Int) -> String {
  定 时 = 时_分解(毫秒)
  变 出 = 时_补零(时.年, 4) + "-" + 时_补零(时.月, 2) + "-" + 时_补零(时.日, 2)
  出 = 出 + "T" + 时_补零(时.时, 2) + ":" + 时_补零(时.分, 2) + ":" + 时_补零(时.秒, 2)
  出 = 出 + "." + 时_补零(时.毫, 3) + "Z"
  返回 出
}

// 一进：只认 时_成文 交出的那一种形状（YYYY-MM-DDTHH:MM:SS.mmmZ），也认省略毫秒的写法。
//
// 不做完整的 ISO 8601 解析：偏移量（+08:00）与星期、周号那些形状都留给调用方 ——
// 解析的边界越窄，错的形状越少。认不出的串交回 {有: 假}，而不是猜一个日子出来。
函数 时_解析(串: String) {
  定 长 = len(串)
  若 长 < 20 {
    返回 {有: 假, 毫秒: 0}
  }
  若 slice(串, 4, 5) != "-" || slice(串, 7, 8) != "-" || slice(串, 10, 11) != "T" {
    返回 {有: 假, 毫秒: 0}
  }
  若 slice(串, 13, 14) != ":" || slice(串, 16, 17) != ":" {
    返回 {有: 假, 毫秒: 0}
  }
  若 slice(串, 19, 20) != "." || slice(串, 23, 24) != "Z" {
    返回 {有: 假, 毫秒: 0}
  }
  定 年 = to_int(slice(串, 0, 4))
  定 月 = to_int(slice(串, 5, 7))
  定 日 = to_int(slice(串, 8, 10))
  定 时 = to_int(slice(串, 11, 13))
  定 分 = to_int(slice(串, 14, 16))
  定 秒 = to_int(slice(串, 17, 19))
  定 毫 = to_int(slice(串, 20, 23))
  返回 {有: 真, 毫秒: 时_合成(年, 月, 日, 时, 分, 秒, 毫)}
}

// 现在：毫秒，与 now_ms 同一个来源。这一层只是给它一个好读的名字。
函数 时_现在() -> Int {
  返回 now_ms()
}
