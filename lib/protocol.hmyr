// 帧：长度前缀 + 类型字节 + 载荷，整数按小端写。
//
// 这一份的规矩来自 oak-barrels 的协议第 3 节：一帧是 u32 的长度（它数类型字节加载荷）、
// 一个类型字节、然后是载荷。小端是它选定的，因为两边都按那一个方向读字节。
//
// 为什么一个语言库要有这个：跨进程说一句话，第一件要商量的就是「到哪儿停」。
// 靠换行、靠固定长度都不稳；长度前缀是唯一不靠内容猜边界的做法。
//
// 这里没有字节类型，所以字节用「0 到 255 的整数元组」表示。代价是每个字节占一个值，
// 好处是不必先给语言加一个字节类型 —— 那是另一格。

import "./tuples.hmyr"

// 一个非负整数写成四个字节，小端：低字节在前。
fn 四字节(n: Int) -> (Int,) {
  let 一 = n % 256
  let 二 = ((n - 一) / 256) % 256
  let 三 = ((n - 一 - 二 * 256) / 65536) % 256
  let 四 = ((n - 一 - 二 * 256 - 三 * 65536) / 16777216) % 256
  return (一, 二, 三, 四)
}

// 四个字节读回一个整数。
fn 读四(a: Int, b: Int, c: Int, d: Int) -> Int {
  return a + b * 256 + c * 65536 + d * 16777216
}

// 编一帧。长度数的是「类型字节加载荷」，所以它等于载荷个数加一。
fn 编帧(类型: Int, 载荷: (Int,)) -> (Int,) {
  let n = len(载荷) + 1
  return 四字节(n) + (类型,) + 载荷
}

// 解一帧。短于五个字节就没有完整的一帧，那是一条拒绝，不是一帧空数据。
fn 解帧(字节: (Int,)) -> Int {
  if len(字节) < 5 {
    return {ok: false, 原因: "一帧至少五个字节：长度四个，类型一个"}
  }
  let n = 读四(字节[0], 字节[1], 字节[2], 字节[3])
  let 类型 = 字节[4]
  let 载荷 = 子段(字节, 5, len(字节))
  return {ok: true, 长度: n, 类型: 类型, 载荷: 载荷}
}

// 这一帧自称多长，与实际给的字节数对不对得上。
// 对不上就是流断在半帧上 —— 那不是一条完整的消息，读的人该等更多字节。
fn 完整(字节: (Int,)) -> Bool {
  if len(字节) < 4 {
    return false
  }
  let n = 读四(字节[0], 字节[1], 字节[2], 字节[3])
  if len(字节) - 4 == n {
    return true
  }
  return false
}
