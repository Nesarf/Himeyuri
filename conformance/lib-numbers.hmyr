import "../lib/numbers.hmyr"

// 一条断言：通过了交回 0，不通过交回它的编号。
fn 检(好: Bool, 号: Int) -> Int {
  if 好 {
    return 0
  }
  return 号
}

fn main() -> Int {
  let a = 检(绝对值(0 - 5) == 5, 1)
  if a != 0 {
    return a
  }
  let b = 检(绝对值(7) == 7, 2)
  if b != 0 {
    return b
  }
  let c = 检(符号(0 - 3) == 0 - 1, 3)
  if c != 0 {
    return c
  }
  let d = 检(符号(0) == 0, 4)
  if d != 0 {
    return d
  }
  let e = 检(最小值(3, 8) == 3, 5)
  if e != 0 {
    return e
  }
  let f = 检(最大值(3, 8) == 8, 6)
  if f != 0 {
    return f
  }
  let g = 检(夹住(15, 1, 10) == 10, 7)
  if g != 0 {
    return g
  }
  let h = 检(夹住(0 - 5, 1, 10) == 1, 8)
  if h != 0 {
    return h
  }
  let i = 检(夹住(5, 1, 10) == 5, 9)
  if i != 0 {
    return i
  }
  let j = 检(是偶数(4), 10)
  if j != 0 {
    return j
  }
  let k = 检(是偶数(7) == false, 11)
  if k != 0 {
    return k
  }
  let l = 检(整除(7, 2) == 3, 12)
  if l != 0 {
    return l
  }
  let m = 检(整除(0 - 7, 2) == 0 - 3, 13)
  if m != 0 {
    return m
  }
  let n = 检(幂(2, 10) == 1024, 14)
  if n != 0 {
    return n
  }
  let o = 检(幂(5, 0) == 1, 15)
  if o != 0 {
    return o
  }
  let p = 检(阶乘(5) == 120, 16)
  if p != 0 {
    return p
  }
  let q = 检(最大公约数(12, 18) == 6, 17)
  if q != 0 {
    return q
  }
  let r = 检(最大公约数(0 - 12, 18) == 6, 18)
  if r != 0 {
    return r
  }
  let s = 检(最小公倍数(4, 6) == 12, 19)
  if s != 0 {
    return s
  }
  let t = 检(平方根(16) == 4, 20)
  if t != 0 {
    return t
  }
  let u = 检(平方根(0 - 4) == 0 - 1, 21)
  if u != 0 {
    return u
  }
  // 二的平方根不是整数，所以比一段区间：绝对值(差) < 万分之一。
  let 差 = 绝对值(平方根(2) - 1.41421356)
  let v = 检(差 < 0.0001, 22)
  if v != 0 {
    return v
  }
  // 25 占 200 是百分之十二点五 —— 这里不停在整数上，因为它算的就是双精度。
  let w = 检(百分比(25, 200) == 12.5, 23)
  if w != 0 {
    return w
  }
  // 指数字面量。自举层刚认它：不认的时候 1e3 会被切成「1」与标识符 e3，
  // 于是这一条会以「没有这个名字：e3」的形式红掉。
  let x = 检(1e3 == 1000, 24)
  if x != 0 {
    return x
  }
  let y = 检(2.5e-1 == 0.25, 25)
  if y != 0 {
    return y
  }
  let z = 检(1E2 == 100, 26)
  if z != 0 {
    return z
  }
  return 0
}
