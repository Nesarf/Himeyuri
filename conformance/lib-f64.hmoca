引入 "../self/f64.hmoca"

// 由位（八个字节 → 一个数）的验收。
//
// 判据的形状与 conformance/lib-rational.hmoca 一样：全过交回零，否则交回那一条的编号。
// 而这一份验的东西与那一份不同 —— 它不写字面量，只验往返。
//
// 为什么不写期望值：写 1e-320 那种期望要用字面量，而自举那一层的 数字值 现在把
// 次正规读成零（design/OPEN.txt 2026-11-04 那一条）。于是「期望值自己就是错的」，
// 判据永远绿、测了等于没测。
//
// 往返不需要字面量：数的八字节由 f64_bytes 给（那个内置是世界的方向），
// 由位 把它读回数，f64_bytes 再把数写回八字节 —— 逐字节相同就是对的。
// 它同时盯住两件事：读错了一个位，或者写回时规范化了不该规范的东西。
//
// 一个刻意的例外：负零（0x8000000000000000）。由位 现在交回正零，因为语言里没有
// 造出负零的入口（见 self/f64.hmoca 的说明）。所以那一条不在这里，等那个入口有了
// 再加进来 —— 现在加，它只会红在「还没做的东西」上，而那正是这一页最不该有的红。

函数 检(好: Bool, 号: Int) -> Int {
  若 好 {
    返回 0
  }
  返回 号
}

// 一个位模式（八个字节）往返一次，回来的是不是同样八个字节。
函数 往返(八: Int) -> Bool {
  定 回 = f64_bytes(由位(八))
  若 len(回) != 8 {
    返回 假
  }
  变 i = 0
  变 同 = 真
  当 i < 8 {
    若 to_int(回[i]) != to_int(八[i]) {
      同 = 假
    }
    i = i + 1
  }
  返回 同
}

函数 main() -> Int {
  // 一、最常见的两个：1.0 与 -1.0。
  //    1.0 的位模式是 0x3FF0000000000000，小端就是低四字节全零、高四字节 00 00 F0 3F。
  定 a = 检(往返((0, 0, 0, 0, 0, 0, 240, 63)), 1)
  若 a != 0 { 返回 a }
  定 b = 检(往返((0, 0, 0, 0, 0, 0, 240, 191)), 2)
  若 b != 0 { 返回 b }

  // 二、正规数的两头：最小的正规是 0x0010000000000000，最大的是 0x7FEFFFFFFFFFFFFF。
  //    这两条盯的是指数的边界 —— 少减一格偏移就都错，而错的方向相反。
  定 c = 检(往返((0, 0, 0, 0, 0, 0, 16, 0)), 3)
  若 c != 0 { 返回 c }
  定 d = 检(往返((255, 255, 255, 255, 255, 255, 239, 127)), 4)
  若 d != 0 { 返回 d }

  // 三、次正规的两头：最小的是 0x0000000000000001，最大的是 0x000FFFFFFFFFFFFF。
  //    这一节是整个由位 里最容易做错的地方 —— 指数为零时 M 就是尾数本身，
  //    不带那一位隐含的 1，也不减偏移。
  定 e = 检(往返((1, 0, 0, 0, 0, 0, 0, 0)), 5)
  若 e != 0 { 返回 e }
  定 f = 检(往返((255, 255, 255, 255, 255, 255, 15, 0)), 6)
  若 f != 0 { 返回 f }

  // 四、无穷与零。
  定 g = 检(往返((0, 0, 0, 0, 0, 0, 240, 127)), 7)
  若 g != 0 { 返回 g }
  定 h = 检(往返((0, 0, 0, 0, 0, 0, 240, 255)), 8)
  若 h != 0 { 返回 h }
  定 i0 = 检(往返((0, 0, 0, 0, 0, 0, 0, 0)), 9)
  若 i0 != 0 { 返回 i0 }

  // 五、一批扫过去的位模式：尾数从 1 涨到 4096，指数从 0 到 2046 各取几个。
  //    逐条验太笨，而这一节要的是「不是只有那几个特例对」。
  变 尾 = 1
  变 坏数 = 0
  当 尾 <= 4096 {
    定 低0 = 尾 % 256
    定 低1 = floor(尾 / 256) % 256
    定 低2 = floor(尾 / 65536) % 256
    定 八 = (低0, 低1, 低2, 0, 0, 0, 0, 0)
    若 !往返(八) {
      坏数 = 坏数 + 1
    }
    尾 = 尾 * 2
  }
  若 坏数 != 0 { 返回 10 }

  // 指数从 0 扫到 2046。位模式的高 32 位等于 指数 乘 2 的 20 次方，而 2 的 20 次方
  // 能被 65536 整除，所以它的四个字节只看得出后两个：(0, 0, (指乘16) 取 256 的余, 指除16)。
  变 指 = 1
  变 坏指 = 0
  当 指 <= 2046 {
    定 八2 = (0, 0, 0, 0, 0, 0, (指 * 16) % 256, floor(指 / 16))
    若 !往返(八2) {
      坏指 = 坏指 + 1
    }
    指 = 指 + 137
  }
  若 坏指 != 0 { 返回 11 }

  返回 0
}
