引入 "../lib/rational.hmoca"

// 一条断言：通过了交回 0，不通过交回它的编号 —— 与 conformance/lib-numbers.hmoca 同一条规矩，
// 于是失败能说出是哪一条，而不是只说「假」。
函数 检(好: Bool, 号: Int) -> Int {
  若 好 {
    返回 0
  }
  返回 号
}

函数 main() -> Int {
  // 一、三分之一加三分之二，正好是一。这一条是整个类型存在的理由：
  // 双精度上 1/3 + 2/3 是 0.9999999999999999，而这里不是。
  定 一甲 = 从两数(1, 3)
  定 一乙 = 从两数(2, 3)
  定 和 = 加有理(一甲, 一乙)
  定 a = 检(等有理(和, 从两数(1, 1)), 1)
  若 a != 0 {
    返回 a
  }

  // 二、三分之一乘三，也正好是一 —— 这一条盯的是乘法之后的约分。
  定 乘后 = 乘有理(一甲, 从两数(3, 1))
  定 b = 检(等有理(乘后, 从两数(1, 1)), 2)
  若 b != 0 {
    返回 b
  }

  // 三、二分之一小于三分之二。
  定 c = 检(比有理(从两数(1, 2), 从两数(2, 3)) < 0, 3)
  若 c != 0 {
    返回 c
  }

  // 四、规范化的形状：六分之四要变成三分之二，而且分母为正。
  定 六四 = 从两数(4, 6)
  定 d = 检(成串(六四) == "2/3", 4)
  若 d != 0 {
    返回 d
  }

  // 五、相减到零。三分之一减三分之一是零，而零写成 0/1。
  定 差 = 减有理(一甲, 一甲)
  定 e = 检(成串(差) == "0", 5)
  若 e != 0 {
    返回 e
  }

  返回 0
}
