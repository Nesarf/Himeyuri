引入 "../lib/maps.hmoca"

// 集合库（map 与 set）的探针：把一串操作的结果逐行打出来。
//
// 判据在 JS 那一边（test/maps.test.mjs），拿 Map 与 Set 算同一个序列。
// 为什么不在这里自判：这一份要验的是「与宿主的 Map/Set 同一个行为」，
// 而对手在另一门语言里 —— 自己判自己，只能说明两边一起错成一样，这个仓库吃过那个亏。
//
// 行序就是判据的读法，改它要连着 test/maps.test.mjs 一起改。

函数 真假(b: Bool) -> String {
  若 b {
    返回 "真"
  }
  返回 "假"
}

// 键的元组 → 逗号连起来的一串。集合没有顺序，而键的元组有 ——
// 两边的顺序都按「第一次放进去的顺序」，所以这一列能逐字比。
函数 串键(元: Int) -> String {
  变 出 = ""
  变 i = 0
  当 i < len(元) {
    若 i > 0 {
      出 = 出 + ","
    }
    出 = 出 + str(元[i])
    i = i + 1
   }
  返回 出
}

函数 main() -> Int 效果串(process) {
  // 一、map 的基本四件事
  变 表 = 表新()
  表 = 表放(表, "a", 1)
  表 = 表放(表, "b", 2)
  表 = 表放(表, "c", 3)
  print("表数=" + str(表数(表)) + chr(10))
  print("表键=" + 串键(表键(表)) + chr(10))

  // 二、覆盖：键的位置保持第一次的样子
  表 = 表放(表, "b", 20)
  print("覆盖后数=" + str(表数(表)) + chr(10))
  print("覆盖后键=" + 串键(表键(表)) + chr(10))
  print("覆盖后取b=" + str(表取(表, "b").值) + chr(10))

  // 三、删：顺序保持，删不存在的不是失败
  表 = 表删(表, "b")
  print("删后数=" + str(表数(表)) + chr(10))
  print("删后键=" + 串键(表键(表)) + chr(10))
  print("删后有b=" + 真假(表有(表, "b")) + chr(10))
  print("删不存在的数=" + str(表数(表删(表, "zz"))) + chr(10))

  // 四、取不到：有 为假，不抛
  定 缺 = 表取(表, "zz")
  print("取无此键=" + 真假(缺.有) + chr(10))

  // 五、任意字符串当键 —— 这是这一份与 lib/tables.hmoca 的分界
  表 = 表放(表, "0041", 9)
  表 = 表放(表, "data/ucd/Blocks.txt", 7)
  print("任意键数=" + str(表数(表)) + chr(10))
  print("码点键=" + str(表取(表, "0041").值) + chr(10))
  print("路径键=" + str(表取(表, "data/ucd/Blocks.txt").值) + chr(10))

  // 六、set：加、去、数
  变 甲 = 集新()
  甲 = 集加(甲, "x")
  甲 = 集加(甲, "y")
  甲 = 集加(甲, "z")
  print("集数=" + str(集数(甲)) + chr(10))
  甲 = 集去(甲, "y")
  print("去后数=" + str(集数(甲)) + chr(10))
  print("去后有y=" + 真假(集有(甲, "y")) + chr(10))

  // 七、并交差：顺序按左边的第一次放进去的顺序
  变 左 = 集新()
  左 = 集加(左, "a")
  左 = 集加(左, "b")
  左 = 集加(左, "c")
  变 右 = 集新()
  右 = 集加(右, "b")
  右 = 集加(右, "c")
  右 = 集加(右, "d")
  print("并数=" + str(集数(集并(左, 右))) + chr(10))
  print("并键=" + 串键(集元(集并(左, 右))) + chr(10))
  print("交数=" + str(集数(集交(左, 右))) + chr(10))
  print("交键=" + 串键(集元(集交(左, 右))) + chr(10))
  print("差数=" + str(集数(集差(左, 右))) + chr(10))
  print("差键=" + 串键(集元(集差(左, 右))) + chr(10))

  // 八、索引是引用：两个名字指向同一份时，改动互相看得见。
  // 这一节是 2026-11-04 那次别名 bug 的判据 —— 那一版的 集并 写成 变 出 = a，
  // 于是并集把左边的集也改掉了，而「交」用的是同一个左边，键就多出一个。
  变 原 = 集新()
  原 = 集加(原, "k")
  变 别名 = 原
  别名 = 集加(别名, "m")
  print("别名后原数=" + str(集数(原)) + chr(10))
  变 独立 = 表拷(原)
  独立 = 集加(独立, "n")
  print("拷贝后原数=" + str(集数(原)) + chr(10))
  print("拷贝后独立数=" + str(集数(独立)) + chr(10))
  返回 0
}
