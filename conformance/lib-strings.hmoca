import "../lib/strings.hmoca"

// 一条断言：通过了交回 0，不通过交回它的编号。
// 编号而不是布尔，是为了在启动器上跑的时候，失败能说出是哪一条。
fn 检(好: Bool, 号: Int) -> Int {
  若 好 {
    返回 0
  }
  返回 号
}

fn main() -> Int {
  定 a = 检(大写("abc") == "ABC", 1)
  若 a != 0 {
    返回 a
  }
  定 b = 检(小写("ABC") == "abc", 2)
  若 b != 0 {
    返回 b
  }
  定 c = 检(大写("aBc1") == "ABC1", 3)
  若 c != 0 {
    返回 c
  }
  定 d = 检(修剪("  ab  ") == "ab", 4)
  若 d != 0 {
    返回 d
  }
  定 e = 检(修剪("\t\nab\r\n") == "ab", 5)
  若 e != 0 {
    返回 e
  }
  定 f = 检(修剪("   ") == "", 6)
  若 f != 0 {
    返回 f
  }
  定 g = 检(开始于("hello", "he"), 7)
  若 g != 0 {
    返回 g
  }
  定 h = 检(开始于("hello", "lo") == false, 8)
  若 h != 0 {
    返回 h
  }
  定 i = 检(结束于("hello", "lo"), 9)
  若 i != 0 {
    返回 i
  }
  定 j = 检(结束于("hello", "he") == false, 10)
  若 j != 0 {
    返回 j
  }
  定 k = 检(查找("hello", "ll") == 2, 11)
  若 k != 0 {
    返回 k
  }
  定 l = 检(查找("hello", "x") == 0 - 1, 12)
  若 l != 0 {
    返回 l
  }
  定 m = 检(含("hello", "ell"), 13)
  若 m != 0 {
    返回 m
  }
  定 n = 检(含("hello", "xyz") == false, 14)
  若 n != 0 {
    返回 n
  }
  定 o = 检(重复("ab", 3) == "ababab", 15)
  若 o != 0 {
    返回 o
  }
  定 p = 检(替换("a-b-c", "-", "+") == "a+b+c", 16)
  若 p != 0 {
    返回 p
  }
  定 q = 检(替换("aaa", "aa", "b") == "ba", 17)
  若 q != 0 {
    返回 q
  }
  定 r = 检(左填("7", 3, "0") == "007", 18)
  若 r != 0 {
    返回 r
  }
  定 s = 检(右填("7", 3, ".") == "7..", 19)
  若 s != 0 {
    返回 s
  }
  定 t = 检(十六进制(255) == "ff", 20)
  若 t != 0 {
    返回 t
  }
  定 u = 检(十六进制(0) == "0", 21)
  若 u != 0 {
    返回 u
  }
  定 v = 检(十六进制(4096) == "1000", 22)
  若 v != 0 {
    返回 v
  }
  // 切分与连接。段数是运行时的，而返回类型只写了 (String,)：类型系统不校验元组长度，
  // 这一条钉的是行为，不是类型。
  定 段 = 切分("a-b-c", "-")
  定 w = 检(len(段) == 3, 23)
  若 w != 0 {
    返回 w
  }
  定 x = 检(段[0] == "a", 24)
  若 x != 0 {
    返回 x
  }
  定 y = 检(段[2] == "c", 25)
  若 y != 0 {
    返回 y
  }
  定 z = 检(len(切分("abc", "-")) == 1, 26)
  若 z != 0 {
    返回 z
  }
  定 空段 = 切分("a--b", "-")
  定 aa = 检(len(空段) == 3, 27)
  若 aa != 0 {
    返回 aa
  }
  定 ab = 检(空段[1] == "", 28)
  若 ab != 0 {
    返回 ab
  }
  定 ac = 检(连接(段, "-") == "a-b-c", 29)
  若 ac != 0 {
    返回 ac
  }
  定 ad = 检(连接((), "-") == "", 30)
  若 ad != 0 {
    返回 ad
  }
  定 ae = 检(len(分行("a\nb")) == 2, 31)
  若 ae != 0 {
    返回 ae
  }
  定 af = 检(切分("abc", "")[0] == "abc", 32)
  若 af != 0 {
    返回 af
  }
  返回 0
}
