引入 "../self/vm.hmoca"

// 第四台机器的第三个台阶：让 HMYR 写的 VM 去跑自举层自己。
//
// 这一份做的事很小：装载一份自举字节码（runtime/run.hmoks），点名调它的
// 命令行入口，把 argv 交给它 —— 剩下的事全在客人那边：它会去读那份 .hmoca、
// 用自举的词法与语法读一遍、编成字节码、再跑。这一份不参与，只看它走到哪。
//
// 为什么单独一个探针，而不是并进 vm-run：那一边的判据是「同一个值」，
// 而这一边今天要答的是「还差几跳」。差几跳这个数每天会变（补一个内置就少一跳），
// 所以它打在屏幕上而不是写死成期望 —— 写死的那个数第二天就变成假话。
//
// 用法：hmyr vm-boot.hmoks <自举 .hmoks> <一份 .hmoca> [入口名 [实参…]]
//
// 失败时打一行「探针停在 <入口名>：……」，那句话就是墙的位置：内置不认识 报的是缺的
// 那个名字，指令不认识 报的是那条指令。两者要分得开，因为它们各自指着一件不同的活。
//
// 入口名与实参都可省。省了就是整条自举链（命令行入口，靠 argv 拿目标）；
// 点名一个更小的函数并塞给它实参，问的就是另一个问题 —— 「是整层跑不动，
// 还是这一个函数跑不动」。两类都报同一句话时，靠的就是这一格分开它们。
函数 main() -> Int 效果串(file, process) {
  定 参 = argv()
  若 len(参) < 3 {
    print("用法：vm-boot <自举 .hmoks> <一份 .hmoca> [入口名 [实参…]]" + chr(10))
    返回 2
  }
  定 字节 = read_bytes(参[1])
  定 程序 = 装载(字节)
  若 !程序.ok {
    print("装载失败：" + 程序.说 + chr(10))
    返回 1
  }
  // 客人看到的命令行：argv[0] 是「谁在跑」，argv[1] 是它要跑的目标。
  定 客参 = ("hmyr", 参[2])
  定 入口名 = "命令行入口"
  若 len(参) >= 4 {
    入口名 = 参[3]
  }
  // 第五个起都是给入口的实参。它们本来就是串，不再转。
  变 实参 = ()
  变 i = 4
  当 i < len(参) {
    实参 = 实参 + (参[i],)
    i = i + 1
  }
  定 果 = 跑入口带参(程序, 客参, 入口名, 实参)
  若 !果.ok {
    print("探针停在 " + 入口名 + "：" + 果.说 + chr(10))
    返回 1
  }
  print(入口名 + " 跑完，值 " + str(果.值) + chr(10))
  返回 0
}
