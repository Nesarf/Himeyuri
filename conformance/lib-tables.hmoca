引入 "../lib/tables.hmoca"

fn 检(好: Bool, 号: Int) -> Int {
  若 好 {
    返回 0
  }
  返回 号
}

fn 造(a: Int, b: Int) -> Int {
  返回 record_new((("a", a), ("b", b)))
}

fn main() -> Int {
  定 t = 造(1, 2)
  定 a = 检(有几件(t) == 2, 1)
  若 a != 0 {
    返回 a
  }
  定 名 = 键们(t)
  定 b = 检(len(名) == 2, 2)
  若 b != 0 {
    返回 b
  }
  定 c = 检(名[0] == "a", 3)
  若 c != 0 {
    返回 c
  }
  定 d = 检(名[1] == "b", 4)
  若 d != 0 {
    返回 d
  }
  定 加过 = 置入(t, "c", 3)
  定 e = 检(有几件(加过) == 3, 5)
  若 e != 0 {
    返回 e
  }
  定 f = 检(field_get(加过, "c") == 3, 6)
  若 f != 0 {
    返回 f
  }
  // 原来的表没被动过：记录不可变，置入交回的是一条新的。
  定 g = 检(有几件(t) == 2, 7)
  若 g != 0 {
    返回 g
  }
  // 同名覆盖：件数不变，值换了。
  定 盖过 = 置入(t, "a", 9)
  定 h = 检(有几件(盖过) == 2, 8)
  若 h != 0 {
    返回 h
  }
  定 i = 检(field_get(盖过, "a") == 9, 9)
  若 i != 0 {
    返回 i
  }
  定 删过 = 删(t, "a")
  定 j = 检(有几件(删过) == 1, 10)
  若 j != 0 {
    返回 j
  }
  定 k = 检(field_has(删过, "a") == 假, 11)
  若 k != 0 {
    返回 k
  }
  定 l = 检(field_get(删过, "b") == 2, 12)
  若 l != 0 {
    返回 l
  }
  // 删一个不存在的键不是失败。
  定 m = 检(有几件(删(t, "zz")) == 2, 13)
  若 m != 0 {
    返回 m
  }
  定 n = 检(取或(t, "a", 0) == 1, 14)
  若 n != 0 {
    返回 n
  }
  定 o = 检(取或(t, "zz", 7) == 7, 15)
  若 o != 0 {
    返回 o
  }
  // 合并：右边赢。
  定 左 = 造(1, 2)
  定 右 = 造(9, 8)
  定 合 = 合并(左, 右)
  定 p = 检(有几件(合) == 2, 16)
  若 p != 0 {
    返回 p
  }
  定 q = 检(field_get(合, "a") == 9, 17)
  若 q != 0 {
    返回 q
  }
  定 r = 检(field_get(合, "b") == 8, 18)
  若 r != 0 {
    返回 r
  }
  定 s = 检(是空表(空表()), 19)
  若 s != 0 {
    返回 s
  }
  定 u = 检(是空表(t) == 假, 20)
  若 u != 0 {
    返回 u
  }
  返回 0
}
