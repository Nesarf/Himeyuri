引入 "../lib/tuples.hmoca"

函数 检(好: Bool, 号: Int) -> Int {
  若 好 {
    返回 0
  }
  返回 号
}

函数 main() -> Int {
  定 原 = (3, 1, 2)
  定 排过 = 排序(原)
  定 a = 检(排过[0] == 1, 1)
  若 a != 0 {
    返回 a
  }
  定 b = 检(排过[1] == 2, 2)
  若 b != 0 {
    返回 b
  }
  定 c = 检(排过[2] == 3, 3)
  若 c != 0 {
    返回 c
  }
  定 d = 检(len(原) == 3, 4)
  若 d != 0 {
    返回 d
  }
  // 原来的那个没被改动：元组不可变，排出来的是一串新的。
  定 e = 检(原[0] == 3, 5)
  若 e != 0 {
    返回 e
  }
  定 反 = 反转((1, 2, 3))
  定 f = 检(反[0] == 3, 6)
  若 f != 0 {
    返回 f
  }
  定 g = 检(反[2] == 1, 7)
  若 g != 0 {
    返回 g
  }
  定 h = 检(和((1, 2, 3, 4)) == 10, 8)
  若 h != 0 {
    返回 h
  }
  定 i = 检(和(()) == 0, 9)
  若 i != 0 {
    返回 i
  }
  定 j = 检(最小((4, 2, 9)) == 2, 10)
  若 j != 0 {
    返回 j
  }
  定 k = 检(最大((4, 2, 9)) == 9, 11)
  若 k != 0 {
    返回 k
  }
  定 l = 检(最小(()) == 0, 12)
  若 l != 0 {
    返回 l
  }
  定 m = 检(含((1, 2, 3), 2), 13)
  若 m != 0 {
    返回 m
  }
  定 n = 检(含((1, 2, 3), 5) == 假, 14)
  若 n != 0 {
    返回 n
  }
  定 o = 检(len(子段((1, 2, 3, 4), 1, 3)) == 2, 15)
  若 o != 0 {
    返回 o
  }
  定 p = 检(子段((1, 2, 3, 4), 1, 3)[0] == 2, 16)
  若 p != 0 {
    返回 p
  }
  // 越界的起止不报错，只是少拿几个。
  定 q = 检(len(子段((1, 2, 3), 0 - 2, 2)) == 2, 17)
  若 q != 0 {
    返回 q
  }
  定 接 = 接起来((1, 2), (3,))
  定 r = 检(len(接) == 3, 18)
  若 r != 0 {
    返回 r
  }
  定 s = 检(接[2] == 3, 19)
  若 s != 0 {
    返回 s
  }
  定 串排 = 串排序(("pear", "apple", "fig"))
  定 t = 检(串排[0] == "apple", 20)
  若 t != 0 {
    返回 t
  }
  定 u = 检(串排[2] == "pear", 21)
  若 u != 0 {
    返回 u
  }
  定 v = 检(串含(串排, "fig"), 22)
  若 v != 0 {
    返回 v
  }
  // 空表与单元素是排序的两条边界。
  定 w = 检(len(排序(())) == 0, 23)
  若 w != 0 {
    返回 w
  }
  定 x = 检(排序((7,))[0] == 7, 24)
  若 x != 0 {
    返回 x
  }
  // 有重复时也要稳住：三个二排完还是三个二。
  定 y = 检(len(排序((2, 2, 2))) == 3, 25)
  若 y != 0 {
    返回 y
  }
  返回 0
}
