import "../lib/json.hmoca"

fn 检(好: Bool, 号: Int) -> Int {
  if 好 {
    return 0
  }
  return 号
}

fn main() -> Int {
  let a = 检(解析("1").值.数 == 1, 1)
  if a != 0 {
    return a
  }
  let b = 检(解析("-2.5").值.数 == 0 - 2.5, 2)
  if b != 0 {
    return b
  }
  let c = 检(解析("1e3").值.数 == 1000, 3)
  if c != 0 {
    return c
  }
  let d = 检(解析("\"ab\"").值.串 == "ab", 4)
  if d != 0 {
    return d
  }
  // 转义：反斜杠 n 要变成真的换行。
  let 转 = 解析("\"a\\nb\"")
  let e = 检(len(转.值.串) == 3, 5)
  if e != 0 {
    return e
  }
  let f = 检(转.值.串[1] == chr(10), 6)
  if f != 0 {
    return f
  }
  let g = 检(field_has(解析("true").值, "真"), 7)
  if g != 0 {
    return g
  }
  let h = 检(field_has(解析("false").值, "假"), 8)
  if h != 0 {
    return h
  }
  let i = 检(field_has(解析("null").值, "空"), 9)
  if i != 0 {
    return i
  }
  let 列 = 解析("[1, 2, 3]")
  let j = 检(len(列.值.数组) == 3, 10)
  if j != 0 {
    return j
  }
  let k = 检(列.值.数组[2].数 == 3, 11)
  if k != 0 {
    return k
  }
  let 对 = 解析("{\"a\": 1, \"b\": 2}")
  let l = 检(len(对.值.对象) == 2, 12)
  if l != 0 {
    return l
  }
  let m = 检(对.值.对象[0][0] == "a", 13)
  if m != 0 {
    return m
  }
  let n = 检(对.值.对象[1][1].数 == 2, 14)
  if n != 0 {
    return n
  }
  // 嵌套：对象里有数组，数组里有对象。
  let 套 = 解析("{\"a\": [1, {\"b\": 2}]}")
  let o = 检(len(套.值.对象[0][1].数组) == 2, 15)
  if o != 0 {
    return o
  }
  let p = 检(套.值.对象[0][1].数组[1].对象[0][1].数 == 2, 16)
  if p != 0 {
    return p
  }
  // 生成：四条基本形状。
  let q = 检(生成({数: 1.5}) == "1.5", 17)
  if q != 0 {
    return q
  }
  let r = 检(生成({串: "ab"}) == "\"ab\"", 18)
  if r != 0 {
    return r
  }
  let s = 检(生成({真: 1}) == "true", 19)
  if s != 0 {
    return s
  }
  let t = 检(生成({空: 1}) == "null", 20)
  if t != 0 {
    return t
  }
  // 字符串里的引号要转义。
  let u = 检(生成({串: "a\"b"}) == "\"a\\\"b\"", 21)
  if u != 0 {
    return u
  }
  // 往返：解析再生成，形状不变。
  let 原 = "{\"a\":[1,2],\"b\":true}"
  let w = 检(生成(解析(原).值) == 原, 22)
  if w != 0 {
    return w
  }
  // 坏输入：空文、半边数组、缺值、尾部多余。
  let x = 检(解析("").ok == false, 23)
  if x != 0 {
    return x
  }
  let y = 检(解析("[1").ok == false, 24)
  if y != 0 {
    return y
  }
  let z = 检(解析("{\"a\"}").ok == false, 25)
  if z != 0 {
    return z
  }
  let aa = 检(解析("1 2").ok == false, 26)
  if aa != 0 {
    return aa
  }
  // 空数组与空对象也要认。
  let ab = 检(len(解析("[]").值.数组) == 0, 27)
  if ab != 0 {
    return ab
  }
  let ac = 检(len(解析("{}").值.对象) == 0, 28)
  if ac != 0 {
    return ac
  }
  return 0
}
