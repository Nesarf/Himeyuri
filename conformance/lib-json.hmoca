引入 "../lib/json.hmoca"

fn 检(好: Bool, 号: Int) -> Int {
  若 好 {
    返回 0
  }
  返回 号
}

fn main() -> Int {
  定 a = 检(解析("1").值.数 == 1, 1)
  若 a != 0 {
    返回 a
  }
  定 b = 检(解析("-2.5").值.数 == 0 - 2.5, 2)
  若 b != 0 {
    返回 b
  }
  定 c = 检(解析("1e3").值.数 == 1000, 3)
  若 c != 0 {
    返回 c
  }
  定 d = 检(解析("\"ab\"").值.串 == "ab", 4)
  若 d != 0 {
    返回 d
  }
  // 转义：反斜杠 n 要变成真的换行。
  定 转 = 解析("\"a\\nb\"")
  定 e = 检(len(转.值.串) == 3, 5)
  若 e != 0 {
    返回 e
  }
  定 f = 检(转.值.串[1] == chr(10), 6)
  若 f != 0 {
    返回 f
  }
  定 g = 检(field_has(解析("true").值, "真"), 7)
  若 g != 0 {
    返回 g
  }
  定 h = 检(field_has(解析("false").值, "假"), 8)
  若 h != 0 {
    返回 h
  }
  定 i = 检(field_has(解析("null").值, "空"), 9)
  若 i != 0 {
    返回 i
  }
  定 列 = 解析("[1, 2, 3]")
  定 j = 检(len(列.值.数组) == 3, 10)
  若 j != 0 {
    返回 j
  }
  定 k = 检(列.值.数组[2].数 == 3, 11)
  若 k != 0 {
    返回 k
  }
  定 对 = 解析("{\"a\": 1, \"b\": 2}")
  定 l = 检(len(对.值.对象) == 2, 12)
  若 l != 0 {
    返回 l
  }
  定 m = 检(对.值.对象[0][0] == "a", 13)
  若 m != 0 {
    返回 m
  }
  定 n = 检(对.值.对象[1][1].数 == 2, 14)
  若 n != 0 {
    返回 n
  }
  // 嵌套：对象里有数组，数组里有对象。
  定 套 = 解析("{\"a\": [1, {\"b\": 2}]}")
  定 o = 检(len(套.值.对象[0][1].数组) == 2, 15)
  若 o != 0 {
    返回 o
  }
  定 p = 检(套.值.对象[0][1].数组[1].对象[0][1].数 == 2, 16)
  若 p != 0 {
    返回 p
  }
  // 生成：四条基本形状。
  定 q = 检(生成({数: 1.5}) == "1.5", 17)
  若 q != 0 {
    返回 q
  }
  定 r = 检(生成({串: "ab"}) == "\"ab\"", 18)
  若 r != 0 {
    返回 r
  }
  定 s = 检(生成({真: 1}) == "true", 19)
  若 s != 0 {
    返回 s
  }
  定 t = 检(生成({空: 1}) == "null", 20)
  若 t != 0 {
    返回 t
  }
  // 字符串里的引号要转义。
  定 u = 检(生成({串: "a\"b"}) == "\"a\\\"b\"", 21)
  若 u != 0 {
    返回 u
  }
  // 往返：解析再生成，形状不变。
  定 原 = "{\"a\":[1,2],\"b\":true}"
  定 w = 检(生成(解析(原).值) == 原, 22)
  若 w != 0 {
    返回 w
  }
  // 坏输入：空文、半边数组、缺值、尾部多余。
  定 x = 检(解析("").ok == false, 23)
  若 x != 0 {
    返回 x
  }
  定 y = 检(解析("[1").ok == false, 24)
  若 y != 0 {
    返回 y
  }
  定 z = 检(解析("{\"a\"}").ok == false, 25)
  若 z != 0 {
    返回 z
  }
  定 aa = 检(解析("1 2").ok == false, 26)
  若 aa != 0 {
    返回 aa
  }
  // 空数组与空对象也要认。
  定 ab = 检(len(解析("[]").值.数组) == 0, 27)
  若 ab != 0 {
    返回 ab
  }
  定 ac = 检(len(解析("{}").值.对象) == 0, 28)
  若 ac != 0 {
    返回 ac
  }
  返回 0
}
