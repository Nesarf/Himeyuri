import "../lib/protocol.hmoca"

fn 检(好: Bool, 号: Int) -> Int {
  若 好 {
    返回 0
  }
  返回 号
}

fn main() -> Int {
  定 帧 = 编帧(1, (7, 8))
  // 长度字段数的是「类型加一个载荷」＝三；整帧是四加三，七个字节。
  定 a = 检(len(帧) == 7, 1)
  若 a != 0 {
    返回 a
  }
  定 b = 检(帧[0] == 3, 2)
  若 b != 0 {
    返回 b
  }
  定 c = 检(帧[1] == 0, 3)
  若 c != 0 {
    返回 c
  }
  定 d = 检(帧[4] == 1, 4)
  若 d != 0 {
    返回 d
  }
  定 e = 检(帧[5] == 7, 5)
  若 e != 0 {
    返回 e
  }
  定 f = 检(帧[6] == 8, 6)
  若 f != 0 {
    返回 f
  }
  定 解 = 解帧(帧)
  定 g = 检(解.ok, 7)
  若 g != 0 {
    返回 g
  }
  定 h = 检(解.长度 == 3, 8)
  若 h != 0 {
    返回 h
  }
  定 i = 检(解.类型 == 1, 9)
  若 i != 0 {
    返回 i
  }
  定 j = 检(len(解.载荷) == 2, 10)
  若 j != 0 {
    返回 j
  }
  定 k = 检(解.载荷[1] == 8, 11)
  若 k != 0 {
    返回 k
  }
  定 l = 检(完整(帧), 12)
  若 l != 0 {
    返回 l
  }
  // 半帧：长度说七，只有五个字节——那是一条等他再说的话，不是一条完整消息。
  定 半 = (7, 0, 0, 0, 1)
  定 m = 检(完整(半) == false, 13)
  若 m != 0 {
    返回 m
  }
  // 短于五个字节的，连类型都没有。
  定 短 = 解帧((1, 2, 3))
  定 n = 检(短.ok == false, 14)
  若 n != 0 {
    返回 n
  }
  // 空载荷也要编得出来：长度为一。
  定 空帧 = 编帧(9, ())
  定 o = 检(len(空帧) == 5, 15)
  若 o != 0 {
    返回 o
  }
  定 p = 检(空帧[0] == 1, 16)
  若 p != 0 {
    返回 p
  }
  定 空解 = 解帧(空帧)
  定 q = 检(len(空解.载荷) == 0, 17)
  若 q != 0 {
    返回 q
  }
  // 长度到四字节的上界附近也要编得对：三百这一档跨了第一个字节。
  定 大 = 编帧(2, 三百个零())
  定 r = 检(大[0] == 44, 18)
  若 r != 0 {
    返回 r
  }
  定 s = 检(大[1] == 1, 19)
  若 s != 0 {
    返回 s
  }
  返回 0
}

// 两百九十九个零：让载荷个数到三百（299 加类型那一个字节），长度写出来是 44 与 1。
fn 三百个零() -> (Int,) {
  var 出 = ()
  var i = 0
  当 i < 299 {
    出 = 出 + (0,)
    i = i + 1
  }
  返回 出
}
