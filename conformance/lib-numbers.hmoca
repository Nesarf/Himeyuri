引入 "../lib/numbers.hmoca"

// 一条断言：通过了交回 0，不通过交回它的编号。
fn 检(好: Bool, 号: Int) -> Int {
  若 好 {
    返回 0
  }
  返回 号
}

fn main() -> Int {
  定 a = 检(绝对值(0 - 5) == 5, 1)
  若 a != 0 {
    返回 a
  }
  定 b = 检(绝对值(7) == 7, 2)
  若 b != 0 {
    返回 b
  }
  定 c = 检(符号(0 - 3) == 0 - 1, 3)
  若 c != 0 {
    返回 c
  }
  定 d = 检(符号(0) == 0, 4)
  若 d != 0 {
    返回 d
  }
  定 e = 检(最小值(3, 8) == 3, 5)
  若 e != 0 {
    返回 e
  }
  定 f = 检(最大值(3, 8) == 8, 6)
  若 f != 0 {
    返回 f
  }
  定 g = 检(夹住(15, 1, 10) == 10, 7)
  若 g != 0 {
    返回 g
  }
  定 h = 检(夹住(0 - 5, 1, 10) == 1, 8)
  若 h != 0 {
    返回 h
  }
  定 i = 检(夹住(5, 1, 10) == 5, 9)
  若 i != 0 {
    返回 i
  }
  定 j = 检(是偶数(4), 10)
  若 j != 0 {
    返回 j
  }
  定 k = 检(是偶数(7) == 假, 11)
  若 k != 0 {
    返回 k
  }
  定 l = 检(整除(7, 2) == 3, 12)
  若 l != 0 {
    返回 l
  }
  定 m = 检(整除(0 - 7, 2) == 0 - 3, 13)
  若 m != 0 {
    返回 m
  }
  定 n = 检(幂(2, 10) == 1024, 14)
  若 n != 0 {
    返回 n
  }
  定 o = 检(幂(5, 0) == 1, 15)
  若 o != 0 {
    返回 o
  }
  定 p = 检(阶乘(5) == 120, 16)
  若 p != 0 {
    返回 p
  }
  定 q = 检(最大公约数(12, 18) == 6, 17)
  若 q != 0 {
    返回 q
  }
  定 r = 检(最大公约数(0 - 12, 18) == 6, 18)
  若 r != 0 {
    返回 r
  }
  定 s = 检(最小公倍数(4, 6) == 12, 19)
  若 s != 0 {
    返回 s
  }
  定 t = 检(平方根(16) == 4, 20)
  若 t != 0 {
    返回 t
  }
  定 u = 检(平方根(0 - 4) == 0 - 1, 21)
  若 u != 0 {
    返回 u
  }
  // 二的平方根不是整数，所以比一段区间：绝对值(差) < 万分之一。
  定 差 = 绝对值(平方根(2) - 1.41421356)
  定 v = 检(差 < 0.0001, 22)
  若 v != 0 {
    返回 v
  }
  // 25 占 200 是百分之十二点五 —— 这里不停在整数上，因为它算的就是双精度。
  定 w = 检(百分比(25, 200) == 12.5, 23)
  若 w != 0 {
    返回 w
  }
  // 指数字面量。自举层刚认它：不认的时候 1e3 会被切成「1」与标识符 e3，
  // 于是这一条会以「没有这个名字：e3」的形式红掉。
  定 x = 检(1e3 == 1000, 24)
  若 x != 0 {
    返回 x
  }
  定 y = 检(2.5e-1 == 0.25, 25)
  若 y != 0 {
    返回 y
  }
  定 z = 检(1E2 == 100, 26)
  若 z != 0 {
    返回 z
  }
  返回 0
}
