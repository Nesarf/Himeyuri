引入 "../lib/time.hmoca"

// 时间库的探针：给一组毫秒，逐行打出四样东西 ——
//
//   分解出来的 ISO 串 | 星期几 | 合成回来的毫秒 | 解析回 ISO 串的毫秒
//
// 判据在 JS 那一边（test/lib-time.test.mjs），拿 Date 的 toISOString / getUTCDay
// 当对手。为什么不在这里自判：这一份要验的是「与宿主同一个日历」，而对手在另一门
// 语言里 —— 自己判自己，只能说明两边一起错成一样。
//
// 样本挑的是边界：零、负一、闰日、世纪边界（1900 与 2000）、月末、一天的最后毫秒。

函数 一行(毫秒: Int) -> String {
  定 时 = 时_分解(毫秒)
  定 回 = 时_合成(时.年, 时.月, 时.日, 时.时, 时.分, 时.秒, 时.毫)
  定 串 = 时_成文(毫秒)
  定 解 = 时_解析(串)
  变 解毫 = 0 - 1
  若 解.有 {
    解毫 = 解.毫秒
  }
  返回 串 + "|" + str(时.星期) + "|" + str(回) + "|" + str(解毫)
}

函数 main() -> Int 效果串(process) {
  定 样本 = (0, 0 - 1, 1, 86399999, 86400000, 1700000000000,
             951782400000, 0 - 2208988800000, 4102444800000,
             0 - 86400001, 253402300799999, 1234567890123)
  变 i = 0
  当 i < len(样本) {
    print(一行(样本[i]) + chr(10))
    i = i + 1
  }
  // 最后一行：认不出的串必须交回 有=假，而不是猜一个日子。
  定 坏 = 时_解析("不是日子")
  若 坏.有 {
    print("坏串被当成了日子" + chr(10))
  } 否则 {
    print("坏串被拒绝" + chr(10))
  }
  返回 0
}
