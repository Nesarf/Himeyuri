引入 "../self/vm.hmoca"

// 执行那一层的入口：装载一份 .hmoks，跑它的 main，把返回值打出来。
//
// 用法：hmyr vm-run.hmoks <一份 .hmoks>
//
// 为什么把结果打成一行而不是在程序里自己判：对照物在 JS 那一边（src/vm.mjs），
// 而「两边跑出同一个值」只有把两个值摊开来比才说得清。程序里写期望值等于把 JS 的
// 答案抄一遍，抄错了就一起错 —— 这一条与 conformance/vm-load.hmoca 同一个立场。
//
// 失败时打一行「跑失败：……」并以 1 退出：装载对了而执行错了是另一类问题，
// 而这两类在输出里要分得开。
函数 main() -> Int 效果串(file, process) {
  定 参 = argv()
  若 len(参) < 2 {
    print("用法：vm-run <一份 .hmoks>" + chr(10))
    返回 2
  }
  定 字节 = read_bytes(参[1])
  定 程序 = 装载(字节)
  若 !程序.ok {
    print("装载失败：" + 程序.说 + chr(10))
    返回 1
  }
  // 客人自己的 argv 这里就传这一份：探针的命令行是「vm-run <一份 .hmoks>」，
  // 而客人看到的东西与它同源。真有区别时（客人带自己的参数）要另外造一份传进去。
  定 果 = 跑主函数(程序, 参)
  若 !果.ok {
    print("跑失败：" + 果.说 + chr(10))
    返回 1
  }
  print(str(果.值) + chr(10))
  返回 0
}
