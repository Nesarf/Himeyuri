// write_text 的验收。路径写死在一个临时的位置，因为目标程序现在还看不到 argv ——
// 那是另一处缺口（记在 design/LIB.txt 的「还缺什么」里）。
fn main() -> Int effects(file) {
  let 路 = "E:/DaShaoHuo/cache/tmp/hmyr-write-text.txt"
  let 文 = "写着玩的"
  let n = write_text(路, 文)
  if n != 4 {
    return 1
  }
  let 回 = read_text(路, "utf8")
  if 回 != 文 {
    return 2
  }
  return 0
}
