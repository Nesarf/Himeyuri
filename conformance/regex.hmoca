引入 "../lib/regex.hmoca"

// 正则库的探针：一条模式、一段文本，打出找到的位置。
//
// 每行三样：模式 | 文本 | 结果。结果是 "起,止"，或者 "无"。
// 判据在 JS 那一边（test/lib-regex.test.mjs），拿 RegExp.exec 当对手 ——
// 位置比「有没有匹配」更能验出问题：一个错位的引擎也常常「有匹配」。
//
// 样本挑的是各处要命的地方：字面量、量词的贪婪、需要回退的那一条（a*ab 对 aaab）、
// 字符类的范围与否定、锚点两侧、选择、\d、点、以及带分组的重复。

函数 一行(式: String, 文: String) -> String {
  定 编 = 式_编译(式)
  若 !编.有 {
    返回 式 + "|" + 文 + "|编译失败"
  }
  定 找 = 式_找(编.树, 文, 0)
  若 !找.有 {
    返回 式 + "|" + 文 + "|无"
  }
  返回 式 + "|" + 文 + "|" + str(找.起) + "," + str(找.止)
}

函数 main() -> Int 效果串(process) {
  定 样本 = (("abc", "xxabcyy"), ("a*b", "aaab"), ("a*ab", "aaab"),
            ("[a-c]+", "zzabc"), ("[^a]+", "aaXYZ"), ("^ab", "abc"),
            ("^ab", "xab"), ("ab$", "xab"), ("ab$", "abc"),
            ("a|bc", "zbc"), ("\\d+", "ab123"), ("a.c", "abc"),
            ("(ab)+", "ababc"), ("b*", "aaab"), ("x?", "abc"),
            ("[0-9][0-9]", "a42b"))
  变 i = 0
  当 i < len(样本) {
    print(一行(样本[i][0], 样本[i][1]) + chr(10))
    i = i + 1
  }
  // 最后两行：认不出的模式要交回 有: 假，全找要给出全部位置。
  定 坏 = 式_编译("[abc")
  若 坏.有 {
    print("坏模式被接受了" + chr(10))
  } 否则 {
    print("坏模式被拒绝" + chr(10))
  }
  定 编 = 式_编译("a")
  定 全 = 式_全找(编.树, "banana")
  变 出 = ""
  变 k = 0
  当 k < len(全) {
    若 k > 0 {
      出 = 出 + ";"
    }
    出 = 出 + str(全[k][0]) + "-" + str(全[k][1])
    k = k + 1
  }
  print("全找=" + 出 + chr(10))
  返回 0
}
