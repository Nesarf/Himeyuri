引入 "../lib/regex.hmoca"

// 正则库的探针：一条模式、一段文本，打出找到的位置与各组捕获到的范围。
//
// 每行四样：模式 | 文本 | 整段匹配的 起,止 | 各组 起,止（用 ; 分开，未参与是 -1,-1）
//
// 判据在 JS 那一边（test/lib-regex.test.mjs），拿 RegExp.exec 当对手 ——
// 位置比「有没有匹配」更能验出问题：一个错位的引擎也常常「有匹配」。
//
// 样本分两类。第一类验语法：字面量、量词、字符类、锚点、选择、\d、点、分组。
// 第二类验这次新加的两样：捕获组（含非捕获组、嵌套号序、空组、未参与组）
// 与懒惰量词（a+? 只吞一个、a.*?b 停在第一个 b）。

函数 组串(找: Int, 组数: Int) -> String {
  若 组数 == 0 {
    返回 "-"
  }
  变 出 = ""
  变 k = 0
  当 k < 组数 {
    若 k > 0 {
      出 = 出 + ";"
    }
    出 = 出 + str(找.组们[k * 2]) + "," + str(找.组们[k * 2 + 1])
    k = k + 1
  }
  返回 出
}

函数 一行(式: String, 文: String) -> String {
  定 编 = 式_编译(式)
  若 !编.有 {
    返回 式 + "|" + 文 + "|编译失败|-"
  }
  定 找 = 式_找(编.树, 文, 0, 编.组数)
  若 !找.有 {
    返回 式 + "|" + 文 + "|无|-"
  }
  返回 式 + "|" + 文 + "|" + str(找.起) + "," + str(找.止) + "|" + 组串(找, 编.组数)
}

函数 main() -> Int 效果串(process) {
  定 样本 = (("abc", "xxabcyy"), ("a*b", "aaab"), ("a*ab", "aaab"),
            ("[a-c]+", "zzabc"), ("[^a]+", "aaXYZ"), ("^ab", "abc"),
            ("^ab", "xab"), ("ab$", "xab"), ("ab$", "abc"),
            ("a|bc", "zbc"), ("\\d+", "ab123"), ("a.c", "abc"),
            ("(ab)+", "ababc"), ("b*", "aaab"), ("x?", "abc"),
            ("[0-9][0-9]", "a42b"),
            ("(a+)(b+)", "aabbb"), ("(?:ab)+c", "ababc"), ("(a|b)+", "abab"),
            ("a(b*)c", "ac"), ("(x)?y", "y"), ("((a)(b))", "ab"),
            ("a+?", "aaa"), ("a.*?b", "axxbxxb"), ("(a+?)(a+)", "aaa"),
            ("[a-z]+", "ABCdef"), ("\\w+", "ab_1-x"), ("^(a+)(b+)$", "aabb"))
  变 i = 0
  当 i < len(样本) {
    print(一行(样本[i][0], 样本[i][1]) + chr(10))
    i = i + 1
  }
  // 认不出的模式要交回 有: 假；全找要给出全部位置。
  定 坏 = 式_编译("[abc")
  若 坏.有 {
    print("坏模式被接受了" + chr(10))
  } 否则 {
    print("坏模式被拒绝" + chr(10))
  }
  定 编 = 式_编译("a")
  定 全 = 式_全找(编.树, "banana", 编.组数)
  变 出 = ""
  变 k = 0
  当 k < len(全) {
    若 k > 0 {
      出 = 出 + ";"
    }
    出 = 出 + str(全[k][0]) + "-" + str(全[k][1])
    k = k + 1
  }
  print("全找=" + 出 + chr(10))
  返回 0
}
