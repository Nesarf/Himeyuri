引入 "../lib/interval.hmoca"

// 一条断言：通过了交回 0，不通过交回它的编号 —— 与 conformance/lib-numbers.hmoca 同一条规矩。
// 而这一台的退出码不是编号（自举那条路把 main 的返回值打印出来），所以判据看 stdout。
函数 检(好: Bool, 号: Int) -> Int {
  若 好 {
    返回 0
  }
  返回 号
}

函数 main() -> Int {
  // 一、两个精确的区间相加，端点就是精确的：[1,2] + [3,4] 得 [4,6]。
  // 这一条盯的是「不无谓地放宽」—— 一律放宽一格的做法会把 4 与 6 弄脏。
  定 甲 = {下: 1.0, 上: 2.0}
  定 乙 = {下: 3.0, 上: 4.0}
  定 和 = 加区间(甲, 乙)
  定 a = 检(下界(和) == 4.0, 1)
  若 a != 0 {
    返回 a
  }
  定 b = 检(上界(和) == 6.0, 2)
  若 b != 0 {
    返回 b
  }

  // 二、不许窄：真值必须落在区间里。三分之一的双精度加上三分之二的双精度
  // 恰好是一，而这里要的是「不管怎样，1.0 在里面」。
  定 三一 = 1.0 / 3.0
  定 平 = 加区间({下: 三一, 上: 三一}, {下: 三一, 上: 三一})
  定 c = 检(含(平, 1.0) == 假, 3)
  若 c != 0 {
    返回 c
  }
  // 上面那条是「两个 1/3 的和是 2/3，不含 1」—— 它验的是 含 会说不。
  定 d = 检(含(平, 三一 * 2.0) == 真, 4)
  若 d != 0 {
    返回 d
  }

  // 三、宽度不为负，下界不大于上界。
  定 e = 检(下界(平) <= 上界(平), 5)
  若 e != 0 {
    返回 e
  }

  // 四、乘法：四个组合取极值。[-1, 2] 乘 [3, 4] 得 [-4, 8]。
  定 负 = {下: 0.0 - 1.0, 上: 2.0}
  定 正 = {下: 3.0, 上: 4.0}
  定 积 = 乘区间(负, 正)
  定 f = 检(下界(积) <= 0.0 - 4.0, 6)
  若 f != 0 {
    返回 f
  }
  定 g = 检(上界(积) >= 8.0, 7)
  若 g != 0 {
    返回 g
  }

  // 五、减法是「加上取反」，所以 [5,7] 减 [1,2] 得 [3,6]。
  定 减果 = 减区间({下: 5.0, 上: 7.0}, {下: 1.0, 上: 2.0})
  定 h = 检(下界(减果) == 3.0, 8)
  若 h != 0 {
    返回 h
  }
  定 i = 检(上界(减果) == 6.0, 9)
  若 i != 0 {
    返回 i
  }

  返回 0
}
